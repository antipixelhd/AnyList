[Unit]
Description=AnyList preview @BRANCH@ backend
After=network.target postgresql.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=/srv/anylist-preview/@BRANCH@/checkout/backend
EnvironmentFile=/etc/anylist-preview/@BRANCH@.env
ExecStart=/srv/anylist-preview/@BRANCH@/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port @BACKEND_PORT@
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/anylist-preview/@BRANCH@
UMask=0077

[Install]
WantedBy=multi-user.target
