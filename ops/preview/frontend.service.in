[Unit]
Description=AnyList preview @BRANCH@ frontend
After=network.target anylist-preview-@BRANCH@-backend.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=/srv/anylist-preview/@BRANCH@/checkout/frontend
EnvironmentFile=/etc/anylist-preview/@BRANCH@.env
Environment=NODE_ENV=@NODE_ENV@
Environment=HOST=127.0.0.1
Environment=PORT=@FRONTEND_PORT@
ExecStart=@FRONTEND_COMMAND@
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/anylist-preview/@BRANCH@
UMask=0077

[Install]
WantedBy=multi-user.target
