[Unit]
Description=AnyList preview @BRANCH@ frontend
After=network.target anylist-preview-@BRANCH@-backend.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=/srv/anylist-preview/@BRANCH@/checkout/frontend
EnvironmentFile=/etc/anylist-preview/@BRANCH@.env
ExecStart=/usr/bin/node node_modules/astro/bin/astro.mjs dev --host 127.0.0.1 --port @FRONTEND_PORT@
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/anylist-preview/@BRANCH@
UMask=0077

[Install]
WantedBy=multi-user.target
