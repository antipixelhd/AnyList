---
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/tracker.css';
import '../styles/checkbox.css';
import '../styles/action-controls.css';
import '../styles/footer.css';
import '../styles/profile-theme.css';
import Icon from '../components/Icon.astro';
import AppBar from '../components/AppBar.astro';
import QuickRating from '../components/QuickRating.astro';
import AttentionPrompt from '../components/AttentionPrompt.astro';
import PwaRuntime from '../components/PwaRuntime.astro';
import NavigationRuntime from '../components/NavigationRuntime.astro';
import MotionRuntime from '../components/MotionRuntime.astro';
import ProfileThemeRuntime from '../components/ProfileThemeRuntime.astro';
import { themeVariables, viewerProfileTheme } from '../lib/profile-theme';
import { ClientRouter } from 'astro:transitions';

const { title = 'Settings' } = Astro.props;
const { user } = Astro.locals;
const viewerTheme = await viewerProfileTheme(Astro.locals.token);
const activeColor = viewerTheme.applySiteWide ? viewerTheme.profileColor : undefined;
const pathname = Astro.url.pathname;
const settingsLinks = [
  { href: '/user-settings', label: 'Profile', description: 'Identity and privacy', icon: 'user' },
  { href: '/settings', label: 'Account', description: 'Preferences and security', icon: 'gear' },
  { href: '/connections', label: 'Connections', description: 'Sync providers and imports', icon: 'plug' },
];
if (user?.is_admin) {
  settingsLinks.push({ href: '/admin', label: 'Administration', description: 'Instance access and defaults', icon: 'sliders' });
}
---
<!doctype html>
<html lang="en" transition:animate="none" style={activeColor ? themeVariables(activeColor) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0b1622" />
    <title>{title} · AnyList</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials" />
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={['tracker', 'settings-app', { 'connections-settings-page': pathname === '/connections' }]} data-cache-user={user?.id ?? 'anonymous'} data-theme-viewer-color={viewerTheme.profileColor} data-theme-site-wide={String(viewerTheme.applySiteWide)} data-theme-active={activeColor ? '' : undefined} style={activeColor ? `--blue: ${activeColor}` : undefined}>
    <a class="skip-link" href="#settings-content">Skip to settings</a>
    <AppBar />

    <div class="settings-heading">
      <div>
        <span class="eyebrow">Your account</span>
        <h1>{title}</h1>
        <p>Manage how AnyList looks, behaves, and connects to your services.</p>
      </div>
    </div>

    <div class="settings-shell">
      <nav class="settings-nav" aria-label="Settings sections">
        {settingsLinks.map((item) => {
          const active = pathname === item.href;
          return (
            <a href={item.href} class:list={{ active }} aria-current={active ? 'page' : undefined}>
              <Icon name={item.icon} fixedWidth />
              <span class="settings-nav-copy"><strong>{item.label}</strong><small>{item.description}</small></span>
            </a>
          );
        })}
      </nav>
      <main id="settings-content" class="settings-content"><slot /></main>
    </div>
    {user && <QuickRating />}
    {user && <AttentionPrompt />}
    <footer class="page-footer"><div class="page-footer-inner">AnyList</div></footer>
    <PwaRuntime />
    <NavigationRuntime />
    <MotionRuntime />
    <ProfileThemeRuntime />
  </body>
</html>
