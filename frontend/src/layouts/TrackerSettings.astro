---
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/tracker.css';
import '../styles/checkbox.css';
import '../styles/action-controls.css';
import '../styles/footer.css';
import '../styles/profile-theme.css';
import Icon from '../components/Icon.astro';
import AppBar from '../components/AppBar.astro';
import QuickRating from '../components/QuickRating.astro';
import AttentionPrompt from '../components/AttentionPrompt.astro';
import PwaRuntime from '../components/PwaRuntime.astro';
import NavigationRuntime from '../components/NavigationRuntime.astro';
import MotionRuntime from '../components/MotionRuntime.astro';
import StyledSelectRuntime from '../components/StyledSelectRuntime.astro';
import ProfileThemeRuntime from '../components/ProfileThemeRuntime.astro';
import { themeVariables, viewerProfileTheme } from '../lib/profile-theme';
import { ClientRouter } from 'astro:transitions';
import { settingsGroups, isSettingsLinkActive } from '../lib/settings-navigation';

const { title = 'Settings' } = Astro.props;
const { user } = Astro.locals;
const viewerTheme = await viewerProfileTheme(Astro.locals.token);
const activeColor = viewerTheme.applySiteWide ? viewerTheme.profileColor : undefined;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en" style={activeColor ? themeVariables(activeColor) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0b1622" />
    <title>{title} · AnyList</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials" />
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={['tracker', 'settings-app', { 'connections-settings-page': pathname === '/connections' }]} data-cache-user={user?.id ?? 'anonymous'} data-theme-viewer-color={viewerTheme.profileColor} data-theme-site-wide={String(viewerTheme.applySiteWide)} data-theme-active={activeColor ? '' : undefined} style={activeColor ? `--blue: ${activeColor}` : undefined}>
    <a class="skip-link" href="#settings-content">Skip to settings</a>
    <AppBar />

    <div class="settings-shell">
      <header class="settings-heading">
        <h1>Settings</h1>
        <button type="button" class="settings-menu-toggle" aria-label="Show settings categories" aria-expanded="false" aria-controls="settings-categories"><Icon name="ellipsis" /></button>
      </header>
      <nav id="settings-categories" class="settings-nav" aria-label="Settings categories">
        {settingsGroups.map(group => <div class="settings-nav-group">
          <p class="settings-nav-heading">{group.label}</p>
          {group.links.map(item => {
            const active = isSettingsLinkActive(item.href, Astro.url);
            return <a href={item.href} class:list={{ active }} aria-current={active ? 'page' : undefined}>{item.label}</a>;
          })}
        </div>)}
        {user?.is_admin && <div class="settings-nav-group"><p class="settings-nav-heading">Instance</p><a href="/admin" class:list={{ active: pathname === '/admin' }} aria-current={pathname === '/admin' ? 'page' : undefined}>Administration</a></div>}
      </nav>
      <main id="settings-content" class="settings-content" aria-labelledby="settings-category-title">
        <h2 id="settings-category-title" class="settings-category-title">{title}</h2>
        <slot />
      </main>
    </div>
    {user && <QuickRating />}
    {user && <AttentionPrompt />}
    <footer class="page-footer"><div class="page-footer-inner">AnyList</div></footer>
    <PwaRuntime />
    <NavigationRuntime />
    <MotionRuntime />
    <StyledSelectRuntime />
    <ProfileThemeRuntime />
    <noscript><style>.settings-nav { display: grid; } .settings-menu-toggle { display: none; }</style></noscript>
  </body>
</html>

<script>
  function closeCategories(focus = false) {
    const button = document.querySelector<HTMLButtonElement>('.settings-menu-toggle');
    document.querySelector('.settings-shell')?.removeAttribute('data-menu-open');
    button?.setAttribute('aria-expanded', 'false');
    button?.setAttribute('aria-label', 'Show settings categories');
    if (focus) button?.focus();
  }
  document.addEventListener('click', event => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('.settings-menu-toggle');
    if (!button) return;
    const open = button.getAttribute('aria-expanded') !== 'true';
    document.querySelector('.settings-shell')?.toggleAttribute('data-menu-open', open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', `${open ? 'Hide' : 'Show'} settings categories`);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && document.querySelector('.settings-shell[data-menu-open]')) closeCategories(true);
  });
  document.addEventListener('astro:page-load', () => closeCategories());
</script>
