---
import '../styles/typography.css';
import '../styles/tracker.css';
import '../styles/checkbox.css';
import '../styles/action-controls.css';
import '../styles/footer.css';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/profile-theme.css';
import AppBar from '../components/AppBar.astro';
import ReloadScrollRestoration from '../components/ReloadScrollRestoration.astro';
import PrimaryFontPreloads from '../components/PrimaryFontPreloads.astro';
import SharePreview from '../components/SharePreview.astro';
import PwaRuntime from '../components/PwaRuntime.astro';
import QuickRating from '../components/QuickRating.astro';
import AttentionPrompt from '../components/AttentionPrompt.astro';
import NavigationRuntime from '../components/NavigationRuntime.astro';
import MotionRuntime from '../components/MotionRuntime.astro';
import StyledSelectRuntime from '../components/StyledSelectRuntime.astro';
import ProfileThemeRuntime from '../components/ProfileThemeRuntime.astro';
import ProfileImageFallback from '../components/ProfileImageFallback.astro';
import ToastRuntime from '../components/ToastRuntime.astro';
import DateTimeRuntime from '../components/DateTimeRuntime.astro';
import BrowseRegionRuntime from '../components/BrowseRegionRuntime.astro';
import { profileColor, themeVariables, viewerProfileTheme } from '../lib/profile-theme';
import { ClientRouter } from 'astro:transitions';
import type {ResponsiveArtworkAttributes} from '../lib/responsive-artwork';
const {shareDescription, title = 'AnyList', favicon = '/favicon-96x96.png', listLanding = false, ownerProfileColor, ownerIsViewer = false, predictionArtwork = [], preloadArtwork = []} = Astro.props;
const viewerTheme = await viewerProfileTheme(Astro.locals.token);
const ownerColor = ownerProfileColor ? profileColor(ownerProfileColor) : undefined;
const activeColor = ownerColor ?? (viewerTheme.applySiteWide ? viewerTheme.profileColor : undefined);
const searchColor = viewerTheme.applySiteWide ? viewerTheme.profileColor : '#3db4f2';
---
<!doctype html>
<html lang="en" style={activeColor ? themeVariables(activeColor) : undefined}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0b1622"/><title>{title} · AnyList</title><PrimaryFontPreloads /><SharePreview {title} description={shareDescription} /><link rel="icon" href={favicon}/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials"/><ProfileImageFallback />{preloadArtwork.map((image:ResponsiveArtworkAttributes & {priority?:'high'|'low'|'auto'})=><link rel="preload" as="image" href={image.src} imagesrcset={image.srcset} imagesizes={image.sizes} fetchpriority={image.priority||'auto'}/>)}<ReloadScrollRestoration /><ClientRouter fallback="swap" /></head>
<body class="tracker" data-cache-user={Astro.locals.user?.id ?? 'anonymous'} data-list-landing={listLanding ? '' : undefined} data-theme-owner-color={ownerColor} data-theme-owner-self={String(ownerIsViewer)} data-theme-viewer-color={viewerTheme.profileColor} data-theme-site-wide={String(viewerTheme.applySiteWide)} data-theme-active={activeColor ? '' : undefined} style={`--quick-search-blue: ${searchColor};${activeColor ? ` --blue: ${activeColor};` : ''}`}>
  <a class="skip-link" href="#content">Skip to content</a>
  <slot name="navigation"><AppBar initiallyHidden={listLanding} /></slot>
  <main id="content"><slot /></main>
  <QuickRating />
  {Astro.locals.user && <AttentionPrompt />}
  <PwaRuntime />
  <NavigationRuntime />
  <MotionRuntime />
  <StyledSelectRuntime />
  <ProfileThemeRuntime />
  <ToastRuntime />
  <DateTimeRuntime />
  <BrowseRegionRuntime />
  <script id="page-prediction" type="application/json" set:html={JSON.stringify({user:String(Astro.locals.user?.id ?? 'anonymous'),artwork:predictionArtwork}).replaceAll('<','\\u003c')} />
  <SiteFooter />
</body></html>
