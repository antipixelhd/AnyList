---
import '../styles/tracker.css';
import AppBar from '../components/AppBar.astro';
const {title = 'Media Tracker'} = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · Media Tracker</title><link rel="icon" href="/favicon.svg"/></head>
<body class="tracker">
  <a class="skip-link" href="#content">Skip to content</a>
  <AppBar />
  <main id="content"><slot /></main>
  <footer class="page-footer">Media Tracker <span>Keep a little history of the stories you love.</span></footer>
</body></html>
