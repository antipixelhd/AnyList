---
import '../styles/tracker.css';
import {tracker} from '../lib/tracker';
import Icon from '../components/Icon.astro';
const {title = 'Media Tracker'} = Astro.props;
const {user} = Astro.locals;
const profile = user ? `/user/${encodeURIComponent(user.username)}` : '/login';
let combineLists=true;
if(user){try{combineLists=(await tracker('preferences',Astro.locals.token)).combine_lists!==false;}catch{}}
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · Media Tracker</title><link rel="icon" href="/favicon.svg"/></head>
<body class="tracker">
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="topbar"><a class="brand" href="/home"><span class="brand-mark">M<span>t</span></span><span>Media Tracker</span></a>
    <nav aria-label="Main navigation"><a href="/home">Home</a>{combineLists?<a href={`${profile}/list`}>Movie/Series List</a>:<><a href={`${profile}/movies`}>Movie List</a><a href={`${profile}/series`}>Series List</a></>}<a href="/browse">Browse</a></nav>
    <div class="account-nav">{user ? <><a href={profile}>{user.display_name || user.username}</a><a href="/settings" aria-label="Settings"><Icon name="gear" /></a></> : <a href="/login">Sign in</a>}</div>
  </header>
  <main id="content"><slot /></main>
  <footer class="page-footer">Media Tracker <span>Keep a little history of the stories you love.</span></footer>
</body></html>
