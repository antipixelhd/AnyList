---
import '../styles/tracker.css';
import '../styles/checkbox.css';
import '../styles/action-controls.css';
import '../styles/footer.css';
import '../styles/profile-theme.css';
import AppBar from '../components/AppBar.astro';
import PwaRuntime from '../components/PwaRuntime.astro';
import QuickRating from '../components/QuickRating.astro';
import AttentionPrompt from '../components/AttentionPrompt.astro';
import NavigationRuntime from '../components/NavigationRuntime.astro';
import ProfileThemeRuntime from '../components/ProfileThemeRuntime.astro';
import { profileColor, themeVariables, viewerProfileTheme } from '../lib/profile-theme';
import { ClientRouter } from 'astro:transitions';
const {title = 'AnyList', listLanding = false, ownerProfileColor, ownerIsViewer = false} = Astro.props;
const viewerTheme = await viewerProfileTheme(Astro.locals.token);
const ownerColor = ownerProfileColor ? profileColor(ownerProfileColor) : undefined;
const activeColor = ownerColor ?? (viewerTheme.applySiteWide ? viewerTheme.profileColor : undefined);
---
<!doctype html>
<html lang="en" style={activeColor ? themeVariables(activeColor) : undefined}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0b1622"/><title>{title} · AnyList</title><link rel="icon" href="/favicon.svg"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials"/><ClientRouter fallback="swap" />{listLanding && <><style is:inline>{`.tracker[data-list-landing]:not([data-list-ready]) #content{visibility:hidden}`}</style><noscript><style is:inline>{`.tracker[data-list-landing] #content{visibility:visible!important}`}</style></noscript></>}</head>
<body class:list={['tracker', { 'notifications-page': Astro.url.pathname === '/recent-events' }]} data-cache-user={Astro.locals.user?.id ?? 'anonymous'} data-list-landing={listLanding ? '' : undefined} data-theme-owner-color={ownerColor} data-theme-owner-self={String(ownerIsViewer)} data-theme-viewer-color={viewerTheme.profileColor} data-theme-site-wide={String(viewerTheme.applySiteWide)} data-theme-active={activeColor ? '' : undefined} style={activeColor ? `--blue: ${activeColor}` : undefined}>
  <a class="skip-link" href="#content">Skip to content</a>
  <AppBar initiallyHidden={listLanding} />
  <main id="content"><slot /></main>
  <QuickRating />
  {Astro.locals.user && <AttentionPrompt />}
  <PwaRuntime />
  <NavigationRuntime />
  <ProfileThemeRuntime />
  <footer class="page-footer"><div class="page-footer-inner">AnyList</div></footer>
</body></html>
