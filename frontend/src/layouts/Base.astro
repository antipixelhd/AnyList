---
import ShellControlsRuntime from "../components/ShellControlsRuntime.astro";
import ResponsiveArtworkRuntime from "../components/ResponsiveArtworkRuntime.astro";
import PlaybackRuntime from "../components/PlaybackRuntime.astro";
import MediaActionsRuntime from "../components/MediaActionsRuntime.astro";
import MediaRequestRuntime from "../components/MediaRequestRuntime.astro";
import InstallPromptRuntime from "../components/InstallPromptRuntime.astro";
import InteractionRuntime from "../components/InteractionRuntime.astro";
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/checkbox.css";
import "../styles/action-controls.css";
import BrandMark from "../components/BrandMark.astro";
import { api } from "../lib/api";
import { themeVariables, viewerProfileTheme } from "../lib/profile-theme";

interface Props { title: string; hideNav?: boolean; fullBleed?: boolean }
const { title, hideNav, fullBleed = false } = Astro.props;
const { user, token } = Astro.locals;
const viewerTheme = await viewerProfileTheme(token);
const siteColor = viewerTheme.applySiteWide ? viewerTheme.profileColor : undefined;

let pendingRequestCount = 0;
let radarrCustomizeOnAdd = false;
let sonarrCustomizeOnAdd = false;
if (user?.is_admin && token) {
  try {
    const data = await api.admin.getPendingCount(token);
    pendingRequestCount = data.pending;
  } catch {}
  try {
    const settings = Astro.locals.settings ?? await api.auth.getSettings(token);
    radarrCustomizeOnAdd = settings.radarr_customize_on_add === true;
    sonarrCustomizeOnAdd = settings.sonarr_customize_on_add === true;
  } catch {}
}

// Anonymous visitors get Movies/Shows nav links too, but only once the admin
// has enabled logged-out navigation (the pages themselves 302 to /login
// otherwise - see middleware.ts).
let showAnonNavLinks = false;
if (!user) {
  const status = await api.profile.publicAccessStatus().catch(() => ({ enable_logged_out_navigation: false }));
  showAnonNavLinks = status.enable_logged_out_navigation;
}
const blurExplicit = Astro.cookies.get("blur_explicit")?.value !== "false";
const use24h = Astro.cookies.get("time_format_24h")?.value === "true";

const pathname = Astro.url.pathname;
// Pre-fills the nav search box with the query already being viewed, so
// landing on /search (or a live-search edit that replaces the URL, see
// search.astro) doesn't leave the box looking empty.
const navSearchValue = pathname === "/search" ? (Astro.url.searchParams.get("q") ?? "") : "";
const loginNextUrl = `/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
const activeMovies = pathname.startsWith('/movies') || pathname.startsWith('/collection/movies') || pathname.startsWith('/trending/movies') || pathname.startsWith('/media/movie');
const activeShows  = pathname.startsWith('/shows') || pathname.startsWith('/collection/shows') || pathname.startsWith('/show') || pathname.startsWith('/trending/shows');
const activeHistory = pathname.startsWith('/history') || pathname === '/next-up';
const activeLists  = pathname.startsWith('/lists') || pathname.startsWith('/list/');
const activeHome   = !activeMovies && !activeShows && !activeHistory && !activeLists;

const navLink = (active: boolean) =>
  active
    ? 'text-zinc-100 font-semibold'
    : 'text-zinc-400 hover:text-zinc-100 transition-colors';

const bottomNavItem = (active: boolean) =>
  `flex flex-col items-center justify-center gap-1 flex-1 py-2 text-[10px] font-bold uppercase tracking-wider transition-colors active:bg-zinc-800/70 active:scale-95 ${active ? 'text-blue-400' : 'text-zinc-500'}`;
---
<!doctype html>
<html lang="en" class={blurExplicit ? "blur-explicit" : ""} style={siteColor ? themeVariables(siteColor) : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>{title} · AnyList</title>
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials" />
  <!-- theme-color: dark default, overridden when light class is applied via JS -->
  <meta name="theme-color" content="#09090b" id="theme-color-meta" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="AnyList" />
  <style>
    /* Inline so icons render correctly on first paint before external CSS loads */
    #sun-icon { display: none; }
    html.light #sun-icon { display: inline; }
    html.light #moon-icon { display: none; }
  </style>
  <script is:inline>
    // Theme initialization to avoid FOUC
    const theme = (() => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return 'dark';
      }
      return 'light';
    })();

    if (theme === 'light') {
      document.documentElement.classList.add('light');
    } else {
      document.documentElement.classList.remove('light');
    }

    // Accent color initialization to avoid FOUC
    const accent = localStorage.getItem('accentTheme');
    if (accent && accent !== 'blue') {
      document.documentElement.setAttribute('data-accent', accent);
    } else {
      document.documentElement.removeAttribute('data-accent');
    }

    // Poster/backdrop image fallback — registered here (head, inline) so the
    // capture-phase listener is active before any <img> tags are parsed and
    // start loading. Covers TMDB/TheTVDB images loaded directly and via the
    // backend image / rating-poster proxy.
    (function () {
      var svgIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.25"><rect width="20" height="20" x="2" y="2" rx="2.18" ry="2.18"/><line x1="7" x2="7" y1="2" y2="22"/><line x1="17" x2="17" y1="2" y2="22"/><line x1="2" x2="22" y1="7" y2="7"/><line x1="2" x2="22" y1="12" y2="12"/><line x1="2" x2="22" y1="17" y2="17"/></svg>';
      function applyFallback(img) {
        if (!img.src.includes('image.tmdb.org') && !img.src.includes('artworks.thetvdb.com') && !img.src.includes('/api/proxy/media/')) return;
        img.style.display = 'none';
        // Decorative images (alt="") — just hide, no placeholder needed
        if (!img.alt) return;
        var parent = img.parentElement;
        if (!parent || parent.querySelector('.tmdb-img-fallback')) return;
        // Ensure parent is a positioning context so absolute inset-0 stays contained
        if (getComputedStyle(parent).position === 'static') parent.style.position = 'relative';
        var fb = document.createElement('div');
        fb.className = 'tmdb-img-fallback';
        fb.innerHTML = svgIcon;
        parent.appendChild(fb);
      }
      document.addEventListener('error', function (e) {
        if (e.target && e.target.tagName === 'IMG') applyFallback(e.target);
      }, true);
      // Safety net: catch images that already failed by the time DOM is ready
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('img').forEach(function (img) {
          if (img.complete && img.naturalWidth === 0 && img.src) applyFallback(img);
        });
      });
    })();
  </script>

  <script define:vars={{ __hasRpdb: Astro.locals.hasRpdbKey === true }}>
    // Whether this viewer has an RPDB key - a plain flag, never the key. The
    // key stays server-side; rating posters go through /api/proxy/media/rating-poster.
    window.__HAS_RPDB__ = __hasRpdb;

    // Inline counterpart of lib/posters.ts, for define:vars scripts that can't import.
    window.ratingPosterUrl = function (fallback, item, enabled) {
      var fb = fallback ?? null;
      if (!enabled || !fb || fb.indexOf('/api/proxy/media/image/') !== 0) return fb;
      var type = item.type ?? item.media_type;
      var isEpisode = type === 'episode';
      if (type !== 'movie' && type !== 'series' && !isEpisode) return fb;
      if (type === 'series' && item.season_number != null) return fb;
      var tmdbId = isEpisode ? item.show_tmdb_id : item.tmdb_id;
      var tvdbId = isEpisode ? item.show_tvdb_id : item.tvdb_id;
      var mediaType = type === 'movie' ? 'movie' : 'series';
      var provider;
      var id;
      if (Number.isInteger(tmdbId) && tmdbId > 0) {
        provider = 'tmdb';
        id = mediaType + '-' + tmdbId;
      } else if (Number.isInteger(tvdbId) && tvdbId > 0) {
        provider = 'tvdb';
        id = mediaType + '-' + tvdbId;
      } else if (!isEpisode && /^tt\d+$/.test(item.imdb_id || '')) {
        provider = 'imdb';
        id = item.imdb_id;
      } else {
        return fb;
      }
      return '/api/proxy/media/rating-poster/' + provider + '/' + id + '?fallback=' + encodeURIComponent(fb);
    };
  </script>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen overflow-x-hidden" data-cache-user={user?.id ?? 'anonymous'} data-theme-viewer-color={viewerTheme.profileColor} data-theme-site-wide={String(viewerTheme.applySiteWide)}>
  {!hideNav && (
    <nav class="px-4 md:px-6 py-3 md:py-4 text-sm relative z-30 bg-zinc-950 md:bg-transparent">
      <!-- Default bar -->
      <div id="nav-default" class="flex items-center justify-between gap-3 safe-area-top">
        <!-- Left: logo + desktop links -->
        <div class="flex items-center gap-6 min-w-0">
          <a href="/" class="flex items-center gap-2 text-zinc-100 font-bold text-lg tracking-tight shrink-0 group active:opacity-70 transition-opacity">
            <BrandMark size={32}/>
            <span>AnyList</span>
          </a>
          {(user || showAnonNavLinks) && (
            <div class="hidden md:flex items-center gap-6 text-sm">
              <a href="/movies" class={navLink(activeMovies)}>Movies</a>
              <a href="/shows" class={navLink(activeShows)}>Shows</a>
              <a href="/lists" class={navLink(activeLists)}>Lists</a>
              {user && (
                <a href="/history" class={navLink(activeHistory)}>History</a>
              )}
            </div>
          )}
          {(user || showAnonNavLinks) && (
            <form action="/search" method="GET" class="relative hidden md:block">
              <input
                id="desktop-search-input"
                type="text"
                name="q"
                value={navSearchValue}
                placeholder="Search movies & shows..."
                class="bg-zinc-900 border border-zinc-800 rounded-full px-4 py-2 w-64 text-sm focus:outline-none focus:ring-1 focus:ring-zinc-700 focus:border-zinc-700 transition-all placeholder:text-zinc-400"
              />
              <kbd id="desktop-search-hint" class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-zinc-400 font-sans pointer-events-none border border-zinc-800 rounded px-1.5 py-0.5 bg-zinc-950">/</kbd>
              <svg id="desktop-search-spinner" class="hidden absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 animate-spin text-zinc-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </form>
          )}
        </div>
        <!-- Right: mobile search icon + theme + user -->
        <div class="flex items-center gap-2">
          {(user || showAnonNavLinks) && (
            <button id="mobile-search-open" class="md:hidden p-3 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-zinc-100 transition-colors" aria-label="Search">
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </button>
          )}
          <!-- Theme toggle -->
          <button id="theme-toggle" class="p-3 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-zinc-100 transition-all hover:scale-110 active:scale-95" aria-label="Toggle Theme">
            <span id="sun-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            </span>
            <span id="moon-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </span>
          </button>
          <!-- User menu (click-toggled) -->
          {user ? (
            <div class="relative">
              <button id="user-menu-btn" class="relative flex items-center gap-1.5 text-zinc-400 hover:text-zinc-100 transition-colors p-3 rounded-xl bg-zinc-900 border border-zinc-800 cursor-pointer sm:p-1 sm:bg-transparent sm:border-transparent">
                <span class="hidden sm:inline font-medium text-zinc-100 text-sm">{user.display_name}</span>
                {pendingRequestCount > 0 && (
                  <span class="absolute -top-1 -right-1 sm:top-0 sm:right-0 w-2.5 h-2.5 bg-blue-500 rounded-full border-2 border-zinc-950"></span>
                )}
                <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:hidden text-zinc-400"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                <svg id="user-chevron" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 hidden sm:block transition-transform duration-200"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div id="user-menu" class="hidden absolute top-full right-0 mt-2 sm:mt-3 w-48 z-50">
                <div class="bg-zinc-900 border border-zinc-800 rounded-xl shadow-2xl p-2 text-base">
                  <a href="/discover" class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                    Discover
                  </a>
                  <a href="/calendar" class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    Calendar
                  </a>
                  <a href={`/user/${encodeURIComponent(user.username)}/`} class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                    Profile
                  </a>
                  <a href={`/user/${encodeURIComponent(user.username)}/stats`} class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
                    Statistics
                  </a>
                  <a href="/progress" class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><line x1="4" x2="20" y1="7" y2="7"/><line x1="4" x2="14" y1="12" y2="12"/><line x1="4" x2="9" y1="17" y2="17"/></svg>
                    Progress
                  </a>
                  <a href="/dropped" class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><circle cx="12" cy="12" r="10"/><line x1="8" x2="16" y1="12" y2="12"/></svg>
                    Dropped
                  </a>
                  <div class="h-px bg-zinc-800 my-1 mx-1"></div>
                  <a href="/user-settings" class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Profile Settings
                  </a>
                  <a href="/connections" class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    Connections
                  </a>
                  <a href="/settings" class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    Settings
                  </a>
                  {user.is_admin && (
                    <a href="/admin" class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.79 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                      Admin
                    </a>
                  )}
                  {user.is_admin && (
                    <a href="/requests" class="flex items-center justify-between px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                      <span class="flex items-center gap-2.5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                        Requests
                      </span>
                      {pendingRequestCount > 0 && (
                        <span class="ml-2 min-w-[1.25rem] h-5 px-1.5 flex items-center justify-center text-[10px] font-bold bg-blue-500 text-white rounded-full">{pendingRequestCount}</span>
                      )}
                    </a>
                  )}
                  <a href="/about" class="flex items-center gap-2.5 px-3 py-2 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    About
                  </a>
                  <div class="h-px bg-zinc-800 my-1 mx-1"></div>
                  <form method="POST" action="/logout" style="margin:0">
                    <button type="submit" class="flex items-center gap-2.5 w-full text-left px-3 py-2 text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition cursor-pointer">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                      Logout
                    </button>
                  </form>
                </div>
              </div>
            </div>
          ) : (
            <a href={loginNextUrl} class="text-sm font-bold text-white bg-blue-600 hover:bg-blue-500 transition-colors px-4 py-3 rounded-xl">Login</a>
          )}
        </div>
      </div>

      {(user || showAnonNavLinks) && (
        <div id="nav-search" class="hidden items-center gap-2 safe-area-top">
          <button id="mobile-search-close" class="p-2 text-zinc-400 hover:text-zinc-100 transition-colors shrink-0" aria-label="Close search">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
          <form action="/search" method="GET" class="flex-1 flex items-center gap-2">
            <div class="relative flex-1">
              <input
                id="mobile-search-input"
                type="text"
                name="q"
                value={navSearchValue}
                placeholder="Search movies & shows..."
                class="w-full bg-zinc-900 border border-zinc-800 rounded-full px-4 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 transition-all placeholder:text-zinc-500"
              />
              <svg id="mobile-search-spinner" class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 animate-spin text-zinc-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </div>
            <button type="submit" class="self-stretch px-4 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold rounded-full transition-colors shrink-0">Go</button>
          </form>
        </div>
      )}
    </nav>
  )}

  {pathname === "/" && <div id="now-playing-section"></div>}

  <main class:list={[
    fullBleed ? "" : "px-6 md:px-6 pb-24 md:pb-8 max-w-screen-xl mx-auto",
    fullBleed ? "" : pathname === "/" ? "pt-0 md:pt-8" : "pt-6 md:pt-8"
  ]}>
    {hideNav && !fullBleed && <div class="safe-area-top" />}
    <slot />
  </main>

  <!-- Mobile bottom nav -->
  {!hideNav && (user || showAnonNavLinks) && (
    <nav id="bottom-nav" class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-zinc-900 border-t border-zinc-800 flex items-stretch safe-area-bottom">
      <a href="/" class={bottomNavItem(activeHome)}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <a href="/movies" class={bottomNavItem(activeMovies)}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
        Movies
      </a>
      <a href="/shows" class={bottomNavItem(activeShows)}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="15" x="2" y="7" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>
        Shows
      </a>
      <a href="/lists" class={bottomNavItem(activeLists)}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        Lists
      </a>
      {user && (
        <a href="/history" class={bottomNavItem(activeHistory)}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          History
        </a>
      )}
    </nav>
  )}

  <!-- Rating popover (shared, reused across cards - centered modal, same convention as watch-history-modal/list-popover) -->
  <div id="rating-popover" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
      <div class="px-5 pt-5 pb-4 border-b border-zinc-800 flex items-center justify-between gap-3">
        <span class="text-base font-bold text-zinc-100">Your rating</span>
        <button id="rating-popover-close" class="text-zinc-500 hover:text-zinc-200 transition cursor-pointer shrink-0" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="rating-popover-item" class="hidden px-5 py-4 border-b border-zinc-800 flex items-center gap-4">
        <img id="rating-popover-poster" src="" alt="" class="hidden shrink-0 w-10 h-14 rounded object-cover bg-zinc-800" />
        <div class="min-w-0">
          <p id="rating-popover-item-title" class="text-sm font-semibold text-zinc-100 truncate"></p>
          <p id="rating-popover-item-sub" class="hidden text-xs text-zinc-400 truncate mt-0.5"></p>
        </div>
      </div>
      <div class="px-6 py-7">
        <div id="rating-stars" class="flex items-center justify-center gap-2"></div>
      </div>
      <div class="border-t border-zinc-800">
        <button id="rating-remove" class="hidden w-full px-3 py-2.5 text-sm text-red-400 hover:bg-zinc-800 transition flex items-center justify-center gap-2 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          Remove rating
        </button>
      </div>
    </div>
  </div>

  <!-- List popover (shared, reused across cards - now a centered modal, same convention as watch-history-modal) -->
  <div id="list-popover" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
      <div class="px-5 pt-5 pb-4 border-b border-zinc-800 flex items-center justify-between gap-3">
        <span class="text-base font-bold text-zinc-100">Add to list</span>
        <button id="list-popover-close" class="text-zinc-500 hover:text-zinc-200 transition cursor-pointer shrink-0" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="list-popover-items" class="max-h-56 overflow-y-auto py-1 list-popover-scroll"></div>
      <div class="border-t border-zinc-800">
        <button id="list-popover-create" class="w-full px-3 py-2 text-sm text-blue-400 hover:bg-zinc-800 transition text-left flex items-center gap-2 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Create new list
        </button>
      </div>
    </div>
  </div>

  <!-- Rewatch modal (shared, centered - same convention as drop-modal/watch-history-modal) -->
  <div id="rewatch-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
      <div class="px-5 pt-5 pb-4 border-b border-zinc-800 flex items-center justify-between gap-3">
        <h3 class="text-base font-bold text-zinc-100">Rewatching</h3>
        <button id="rewatch-modal-close" class="text-zinc-500 hover:text-zinc-200 transition cursor-pointer shrink-0" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="px-5 pt-4 pb-5 space-y-2.5">
        <button id="rewatch-modal-restart" class="w-full px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm rounded-xl transition-all cursor-pointer active:scale-95">
          Restart rewatch
        </button>
        <button id="rewatch-modal-cancel" class="w-full px-4 py-2.5 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-400 font-bold text-sm rounded-xl transition-all cursor-pointer active:scale-95">
          Cancel rewatch
        </button>
      </div>
    </div>
  </div>

  <!-- Drop modal (shared, centered - same convention as watch-history-modal) -->
  <div id="drop-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
      <div class="px-5 pt-5 pb-4 border-b border-zinc-800 flex items-center justify-between gap-3">
        <h3 id="drop-modal-title" class="text-base font-bold text-zinc-100">Drop</h3>
        <button id="drop-modal-close" class="text-zinc-500 hover:text-zinc-200 transition cursor-pointer shrink-0" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="px-5 pt-4 pb-5 space-y-3">
        <p id="drop-modal-body" class="text-sm text-zinc-400"></p>
        <button id="drop-modal-hide" class="w-full px-4 py-2.5 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 text-amber-400 font-bold text-sm rounded-xl transition-all cursor-pointer active:scale-95">
          Hide from Next Up
        </button>
        <button id="drop-modal-drop" class="w-full px-4 py-2.5 bg-rose-600 hover:bg-rose-500 text-white font-bold text-sm rounded-xl transition-all cursor-pointer active:scale-95">
          Drop
        </button>
      </div>
    </div>
  </div>

  <!-- Customize-on-add modal (shared, centered - same convention as rating/list popovers; admin-only feature) -->
  <div id="customize-add-popover" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
      <div class="px-5 pt-5 pb-4 border-b border-zinc-800 flex items-center justify-between gap-3">
        <span id="customize-add-title" class="text-base font-bold text-zinc-100">Add options</span>
        <button id="customize-add-close" class="text-zinc-500 hover:text-zinc-200 transition cursor-pointer shrink-0" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="customize-add-loading" class="px-5 py-10 text-center text-sm text-zinc-500">Loading options…</div>
      <div id="customize-add-body" class="hidden px-5 py-5 space-y-4">
        <div class="space-y-1.5">
          <label for="customize-add-root-folder" class="block text-sm font-medium text-zinc-400">Root Folder</label>
          <select id="customize-add-root-folder" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"></select>
        </div>
        <div class="space-y-1.5">
          <label for="customize-add-quality-profile" class="block text-sm font-medium text-zinc-400">Quality Profile</label>
          <select id="customize-add-quality-profile" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"></select>
        </div>
        <div class="space-y-1.5">
          <span class="block text-sm font-medium text-zinc-400">Tags</span>
          <div id="customize-add-tags" class="flex flex-wrap gap-2 min-h-[42px] p-2 bg-zinc-950 border border-zinc-800 rounded-lg"></div>
        </div>
        <label id="customize-add-season-folder-row" class="hidden flex items-center justify-between gap-3 p-3 bg-zinc-950 border border-zinc-800 rounded-lg cursor-pointer hover:bg-zinc-800/60 transition-colors">
          <span class="text-sm text-zinc-300">Use season folders</span>
          <input type="checkbox" id="customize-add-season-folder" class="sr-only peer" />
          <div class="relative w-10 h-5 bg-zinc-700 peer-checked:bg-blue-600 rounded-full transition-colors pointer-events-none shrink-0 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-5"></div>
        </label>
        <div id="customize-add-error" class="hidden text-sm text-red-400"></div>
      </div>
      <div id="customize-add-footer" class="hidden border-t border-zinc-800 px-5 py-4 flex gap-2">
        <button id="customize-add-cancel" class="flex-1 px-4 py-2.5 text-sm bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-semibold rounded-lg transition cursor-pointer">Cancel</button>
        <button id="customize-add-confirm" class="flex-1 px-4 py-2.5 text-sm bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg transition cursor-pointer">Add</button>
      </div>
    </div>
  </div>

  <!-- Watch history modal -->
  <div id="watch-history-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
      <div class="px-5 pt-5 pb-4 border-b border-zinc-800 flex items-center justify-between gap-3">
        <h3 id="watch-history-modal-title" class="text-base font-bold text-zinc-100">Watch History</h3>
        <button id="watch-history-modal-close" class="text-zinc-500 hover:text-zinc-200 transition cursor-pointer shrink-0" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="watch-history-modal-events" class="watch-history-scroll max-h-52 overflow-y-auto divide-y divide-zinc-800/50"></div>
      <div class="px-4 pt-3 pb-4 border-t border-zinc-800 space-y-2.5">
        <button id="watch-history-unwatch-btn" class="hidden w-full px-4 py-2.5 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-400 font-bold text-sm rounded-xl transition-all cursor-pointer active:scale-95 disabled:opacity-50 disabled:pointer-events-none">
          Mark as unwatched
        </button>
        <p id="watch-history-add-play-label" class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Add a play</p>
        <div class="grid grid-cols-2 gap-2">
          <button id="watch-history-now-btn" class="px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-blue-600 text-white">Just now</button>
          <button id="watch-history-airdate-btn" class="hidden px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-zinc-800 text-zinc-400 border border-zinc-700 hover:text-zinc-200">Air Date</button>
          <button id="watch-history-custom-btn" class="px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-zinc-800 text-zinc-400 border border-zinc-700 hover:text-zinc-200">Custom</button>
          <button id="watch-history-unknown-btn" class="px-3 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer bg-zinc-800 text-zinc-400 border border-zinc-700 hover:text-zinc-200">Unknown</button>
        </div>
        <input type="datetime-local" id="watch-history-date-input" class="hidden w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-xl text-sm text-zinc-200 focus:outline-none focus:border-green-500 [color-scheme:dark]" />
        <button id="watch-history-log-btn" class="w-full px-4 py-2.5 bg-green-600 hover:bg-green-500 text-white font-bold text-sm rounded-xl transition-all cursor-pointer active:scale-95">
          Mark as watched
        </button>
      </div>
    </div>
  </div>


  <!-- Create list modal -->
  <div id="create-list-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl p-6 w-full max-w-sm mx-4">
      <h3 class="text-base font-bold text-zinc-100 mb-4">Create new list</h3>
      <input id="create-list-name" type="text" placeholder="List name" maxlength="100"
        class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-3 text-sm text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:border-blue-500 mb-4" />
      <div class="flex gap-2 justify-end">
        <button id="create-list-cancel" class="px-4 py-2 text-sm text-zinc-400 hover:text-zinc-100 transition cursor-pointer">Cancel</button>
        <button id="create-list-confirm" class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg transition cursor-pointer">Create</button>
      </div>
    </div>
  </div>

  <!-- PWA install banner -->
  <div id="pwa-banner" class="hidden fixed bottom-14 left-0 right-0 z-[60] p-4 md:bottom-6 md:left-auto md:right-6 md:max-w-sm">
    <div class="bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl p-4 flex items-start gap-3">
      <img src="/web-app-manifest-192x192.png" alt="" aria-hidden="true" class="w-12 h-12 rounded-xl shrink-0" />
      <div class="flex-1 min-w-0">
        <p class="text-sm font-bold text-zinc-100">Install AnyList</p>
        <p id="pwa-banner-msg" class="text-xs text-zinc-400 mt-0.5 leading-snug">Add to your home screen for the full app experience.</p>
      </div>
      <button id="pwa-dismiss" aria-label="Dismiss" class="text-zinc-400 hover:text-zinc-300 transition shrink-0 cursor-pointer mt-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <div id="pwa-install-wrap" class="hidden">
        <button id="pwa-install-btn" class="shrink-0 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-lg transition cursor-pointer">Install</button>
      </div>
    </div>
  </div>

  <!-- Confirm dialog -->
  <div id="confirm-dialog" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-zinc-900 border border-zinc-700 rounded-2xl shadow-2xl p-6 w-full max-w-sm mx-4">
      <h3 id="confirm-title" class="text-base font-bold text-zinc-100 mb-2"></h3>
      <p id="confirm-body" class="text-sm text-zinc-400 mb-6"></p>
      <div class="flex gap-2 justify-end">
        <button id="confirm-cancel" class="px-4 py-2 text-sm text-zinc-400 hover:text-zinc-100 transition cursor-pointer">Cancel</button>
        <button id="confirm-ok" class="px-4 py-2 text-sm bg-red-600 hover:bg-red-500 text-white font-semibold rounded-lg transition cursor-pointer">Confirm</button>
      </div>
    </div>
  </div>

  <ShellControlsRuntime />

  <ResponsiveArtworkRuntime />

  <PlaybackRuntime token={token} use24h={use24h} isAdmin={user?.is_admin === true} radarrCustomizeOnAdd={radarrCustomizeOnAdd} sonarrCustomizeOnAdd={sonarrCustomizeOnAdd} />

  <MediaActionsRuntime />
  <MediaRequestRuntime />
  <InstallPromptRuntime />

  <script>
    document.getElementById('bottom-nav')?.addEventListener('touchstart', () => {
      navigator.vibrate?.(10);
    }, { passive: true });
  </script>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch((err) => {
          console.warn('[SW] Registration failed:', err);
        });
      });
    }
  </script>

  <InteractionRuntime />

  <style>
    .watch-history-scroll {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .watch-history-scroll::-webkit-scrollbar {
      display: none;
    }
    .list-popover-scroll {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .list-popover-scroll::-webkit-scrollbar {
      display: none;
    }
  </style>
</body>
</html>
