---
import {api} from '../../../lib/api';
const {type,id}=Astro.params;
const externalId=Number(id);
if (!Number.isSafeInteger(externalId)||externalId<=0) return Astro.redirect('/browse',302);
if (type==='movie') {
  return Astro.redirect(Astro.locals.user?`/discover-title?type=movie&id=${externalId}`:'/browse?type=movie',302);
}
if (type==='episode') {
  const episode=await api.media.get('episode',externalId,Astro.locals.token).catch(()=>null);
  const showId=Number(episode?.show_tmdb_id);
  if (Astro.locals.user&&Number.isSafeInteger(showId)&&showId>0) return Astro.redirect(`/discover-title?type=series&id=${showId}`,302);
  const query=episode?.show_title?`&q=${encodeURIComponent(episode.show_title)}`:'';
  return Astro.redirect(`/browse?type=series${query}`,302);
}
return Astro.redirect('/browse',302);
---