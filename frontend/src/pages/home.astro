---
import Tracker from '../layouts/Tracker.astro';
import ActivityCard from '../components/ActivityCard.astro';
import Icon from '../components/Icon.astro';
import {tracker} from '../lib/tracker';
import {responsiveArtwork} from '../lib/responsive-artwork';
let activities:any[]=[],error='',seriesInProgress:any[]=[],upcomingSeasons:any[]=[],watchingCount:number|null=null;
if(!Astro.locals.user)return Astro.redirect('/browse');
const profile=`/user/${encodeURIComponent(Astro.locals.user.username)}`;
const [activityResult,listResult,upcomingResult]=await Promise.allSettled([
  tracker('activity',Astro.locals.token),
  tracker(`profile/${encodeURIComponent(Astro.locals.user.username)}/all`,Astro.locals.token),
  tracker('upcoming-seasons',Astro.locals.token),
]);
if(activityResult.status==='fulfilled')activities=activityResult.value.results;
else error=activityResult.reason.message;
if(listResult.status==='fulfilled'){
  const watching=listResult.value.entries.filter((entry:any)=>entry.status==='watching');
  seriesInProgress=watching.filter((entry:any)=>entry.type==='series');
  watchingCount=watching.length;
}
if(upcomingResult.status==='fulfilled')upcomingSeasons=upcomingResult.value.results||[];
const seriesCards=seriesInProgress.map((entry:any)=>({
  ...entry,
  airing:entry.currently_airing===true,
  canIncrement:entry.released_episodes!==undefined&&entry.progress<entry.released_episodes,
  caughtUp:entry.released_episodes!==undefined&&entry.progress>=entry.released_episodes,
  latest:entry.latest_released_position?.replace(/(S\d+)(E\d+)/,'$1 $2')||'',
  artwork:responsiveArtwork(entry.poster,{size:'w185',sizes:'85px',route:'direct'}),
}));
const upcomingSeasonCards=upcomingSeasons.map((entry:any)=>({
  ...entry,
  seasonNumber:Number(entry.season_number),
  releaseDate:String(entry.release_date||''),
  artworkFallback:entry.season_artwork_fallback===true,
  artwork:responsiveArtwork(entry.season_poster_path||entry.poster,{size:'w185',sizes:'85px',route:'direct'}),
}));
const formatReleaseDate=(value:string)=>{
  const [year,month,day]=value.split('-').map(Number);
  if(!year||!month||!day)return value;
  return new Date(Date.UTC(year,month-1,day)).toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'});
};
---
<Tracker title="Home"><div class="page-width dashboard home-dashboard" data-username={Astro.locals.user.username} data-watching-count={watchingCount??''}>
  <header class="page-intro"><div><span class="eyebrow">Following feed</span><h1>Welcome back, {Astro.locals.user.display_name || Astro.locals.user.username}</h1><p>See the latest updates from the public profiles you follow.</p></div><a class="button-primary" href="/browse" data-find-title hidden={watchingCount!==0}>Find your next title</a></header>
  <div class="home-columns"><aside class="series-progress" aria-labelledby="series-progress-heading"><div class="section-heading"><h2 id="series-progress-heading">Series in Progress</h2></div>
    {seriesCards.length ? <div class="series-progress-grid" data-progress-grid>{seriesCards.map((entry:any)=><article class={entry.airing?'progress-card airing':'progress-card'} data-progress-card data-media-id={entry.id} data-progress={entry.progress} data-released={entry.released_episodes??''} data-season-position={entry.season_position||''} data-latest-position={entry.latest} data-next-air={entry.next_release_date||''}>
        <a class="progress-card-poster" href={`/title/${entry.id}`} aria-label={`View ${entry.title}`}>
          {entry.artwork?.src&&<img src={entry.artwork.src} srcset={entry.artwork.srcset} sizes={entry.artwork.sizes} alt="" loading="lazy"/>}
          {entry.airing&&<span class="progress-card-airing-label"><strong data-latest-episode>{entry.latest||'Latest episode'}</strong><span data-countdown>Release date unavailable</span></span>}
          {entry.airing&&<span class="progress-card-catchup" data-catchup-bar data-caught-up={String(entry.caughtUp)} data-known={String(entry.released_episodes!==undefined)} aria-hidden="true"></span>}
        </a>
        <button class="progress-card-quick-action" type="button" data-progress-action={entry.id} data-next-progress={entry.progress+1} disabled={!entry.canIncrement} aria-label={entry.canIncrement?`Mark next episode of ${entry.title} watched`:entry.caughtUp?`${entry.title} is caught up`:`Progress unavailable for ${entry.title}`}>
          <span data-current-position>{entry.season_position||'0'}</span>{entry.canIncrement&&<span class="progress-card-plus" aria-hidden="true">+</span>}
        </button>
        <div class="progress-card-details" aria-label={`${entry.title} progress`}>
          <strong class="progress-card-behind" data-episodes-behind>{entry.canIncrement?`${entry.released_episodes-entry.progress} ${entry.released_episodes-entry.progress===1?'episode':'episodes'} behind`:entry.caughtUp?'Caught up':'Progress unavailable'}</strong>
          <a class="progress-card-title" href={`/title/${entry.id}`}>{entry.title}</a>
          <span class="progress-card-progress-label">Progress: <span data-progress-count>{entry.progress}</span>/<span data-released-count>{entry.released_episodes??'?'}</span></span>
        </div>
      </article>)}</div> : <p class="series-progress-empty" data-progress-empty>Series you mark as Watching will appear here.</p>}
    <section class="upcoming-releases" aria-labelledby="upcoming-releases-heading" data-upcoming-releases>
      <div class="section-heading"><h2 id="upcoming-releases-heading">Upcoming releases</h2></div>
      {upcomingSeasonCards.length ? <div class="series-progress-grid upcoming-releases-grid" data-upcoming-grid>{upcomingSeasonCards.map((entry:any)=><article class="progress-card upcoming-season-card" data-upcoming-card data-media-id={entry.id} data-season-number={entry.seasonNumber} data-release-date={entry.releaseDate} data-season-poster={entry.season_poster_path||''} data-artwork-fallback={String(entry.artworkFallback)} data-artwork-retry={String(entry.artwork_retry===true)}>
        <a class="progress-card-poster" href={`/title/${entry.id}`} aria-label={`View ${entry.title}, Season ${entry.seasonNumber}`}>
          {entry.artwork?.src?<img src={entry.artwork.src} srcset={entry.artwork.srcset} sizes={entry.artwork.sizes} alt="" loading="lazy"/>:<span class="upcoming-poster-placeholder" aria-hidden="true">Season {entry.seasonNumber}</span>}
        </a>
        <div class="progress-card-details" aria-label={`${entry.title}: Season ${entry.seasonNumber}`}>
          <a class="progress-card-title" href={`/title/${entry.id}`}>{entry.title}: Season {entry.seasonNumber}</a>
          <span class="upcoming-release-date">Release date: <time datetime={entry.releaseDate}>{formatReleaseDate(entry.releaseDate)}</time></span>
          <strong class="upcoming-release-countdown" data-upcoming-countdown>Countdown unavailable</strong>
        </div>
      </article>)}</div> : <p class="series-progress-empty" data-upcoming-empty>Tracked series with confirmed upcoming season dates will appear here.</p>}
    </section>
  </aside><section class="activity-stream" aria-labelledby="activity-heading" data-activity-feed><div class="section-heading"><h2 id="activity-heading">Activity</h2><span>Following</span></div>
  {error?<p class="error-message" role="alert" data-activity-error>{error}</p>:activities.length?activities.map(a=><ActivityCard activity={a} showUser/>):<div class="empty-state" data-activity-empty><span class="empty-symbol"><Icon name="play" /></span><h2>Your following feed is quiet</h2><p>Follow public profiles to see their tracking updates here. Your own updates live on your profile.</p><a class="button-primary" href={`${profile}/social?section=search#social-search-input`}>Find people</a></div>}
  </section></div>
</div>
<template id="activity-card-template"><article class="visual-event" data-activity-card>
  <a class="event-cover"><img alt="" loading="lazy"/><span class="cover-placeholder" hidden><Icon name="play" /></span></a>
  <div class="event-body"><div class="event-meta"><div class="event-actor"><a class="event-avatar"><img alt="" loading="lazy"/><span aria-hidden="true"></span></a><a class="event-user"></a></div><time data-relative-time></time></div>
  <p class="event-action"><span></span> <a></a></p><div class="event-footer" hidden><span class="score-pill"><Icon name="star"/> <span data-rating-previous hidden><span data-rating-previous-value></span><span class="score-transition" aria-hidden="true">→</span></span><b data-rating-current></b><small>/10</small></span></div></div>
</article></template>
<template id="activity-empty-template"><div class="empty-state" data-activity-empty><span class="empty-symbol"><Icon name="play" /></span><h2>Your following feed is quiet</h2><p>Follow public profiles to see their tracking updates here. Your own updates live on your profile.</p><a class="button-primary" href={`${profile}/social?section=search#social-search-input`}>Find people</a></div></template>
</Tracker>

<script>
import {startVisibleRefresh, type VisibleRefreshHandle} from '../lib/visible-refresh';

let homeProgressListeners: AbortController | undefined;
let homeSeriesRefresh: VisibleRefreshHandle | undefined;
let homeUpcomingRefresh: VisibleRefreshHandle | undefined;
document.addEventListener('astro:page-load', () => {
  homeSeriesRefresh?.stop();
  homeSeriesRefresh = undefined;
  homeUpcomingRefresh?.stop();
  homeUpcomingRefresh = undefined;
  homeProgressListeners?.abort();
  homeProgressListeners = new AbortController();
  const {signal} = homeProgressListeners;
  const grid = document.querySelector<HTMLElement>('[data-progress-grid]') || document.createElement('div');
  const upcomingGrid = document.querySelector<HTMLElement>('[data-upcoming-grid]');

  const positionDetails = () => document.querySelectorAll<HTMLElement>('.series-progress-grid').forEach(cardGrid => cardGrid.querySelectorAll<HTMLElement>('.progress-card').forEach(card => {
    const right = card.getBoundingClientRect().right;
    const detailsWidth = card.querySelector<HTMLElement>('.progress-card-details')?.getBoundingClientRect().width || 290;
    card.classList.toggle('details-flipped', right + 16 + detailsWidth > window.innerWidth - 20);
  }));
  positionDetails();
  window.addEventListener('resize', positionDetails, {signal});

  const updateCountdowns = () => grid.querySelectorAll<HTMLElement>('[data-progress-card]').forEach(card => {
    const output = card.querySelector<HTMLElement>('[data-countdown]');
    const date = card.dataset.nextAir;
    if (!output || !date) return;
    const today = new Date().toISOString().slice(0, 10);
    if (date === today) { output.textContent = 'Next episode today'; return; }
    if (date < today) { output.textContent = 'Schedule updating'; return; }
    const days = Math.round((Date.parse(`${date}T00:00:00Z`) - Date.parse(`${today}T00:00:00Z`)) / 86_400_000);
    output.textContent = `Next episode in ${days}d`;
  });
  const updateUpcomingCountdowns = () => document.querySelectorAll<HTMLElement>('[data-upcoming-card]').forEach(card => {
    const output = card.querySelector<HTMLElement>('[data-upcoming-countdown]');
    const date = card.dataset.releaseDate;
    if (!output || !date) return;
    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
    const releaseDay = Date.parse(`${date}T00:00:00Z`);
    const todayDay = Date.parse(`${today}T00:00:00Z`);
    if (!Number.isFinite(releaseDay)) { output.textContent = 'Countdown unavailable'; return; }
    const days = Math.ceil((releaseDay - todayDay) / 86_400_000);
    output.textContent = days === 0 ? 'Releases today' : days > 0 ? `Releases in ${days} ${days === 1 ? 'day' : 'days'}` : 'Release date passed';
  });
  updateCountdowns();
  updateUpcomingCountdowns();
  const countdownTimer = window.setInterval(updateCountdowns, 60_000);
  const upcomingCountdownTimer = window.setInterval(updateUpcomingCountdowns, 60_000);
  signal.addEventListener('abort', () => window.clearInterval(countdownTimer), {once:true});
  signal.addEventListener('abort', () => window.clearInterval(upcomingCountdownTimer), {once:true});

  const syncCardProgress = (card:HTMLElement, updated:any) => {
    const progress = Number(updated.progress ?? card.dataset.progress ?? 0);
    const hasReleased = updated.released_episodes != null || card.dataset.released !== '';
    const released = Number(updated.released_episodes ?? card.dataset.released ?? 0);
    const canIncrement = hasReleased && released > progress;
    const caughtUp = hasReleased && !canIncrement;
    card.dataset.progress = String(progress);
    if (hasReleased && Number.isFinite(released)) card.dataset.released = String(released);
    card.dataset.seasonPosition = updated.season_position || '';
    card.querySelector<HTMLElement>('[data-current-position]')!.textContent = updated.season_position || '0';
    card.querySelector<HTMLElement>('[data-progress-count]')!.textContent = String(progress);
    card.querySelector<HTMLElement>('[data-released-count]')!.textContent = hasReleased ? String(released) : '?';
    card.querySelector<HTMLElement>('[data-episodes-behind]')!.textContent = canIncrement
      ? `${released-progress} ${released-progress===1?'episode':'episodes'} behind` : caughtUp ? 'Caught up' : 'Progress unavailable';
    card.querySelector<HTMLElement>('[data-catchup-bar]')?.setAttribute('data-caught-up', String(caughtUp));
    card.querySelector<HTMLElement>('[data-catchup-bar]')?.setAttribute('data-known', String(hasReleased));
    const button = card.querySelector<HTMLButtonElement>('[data-progress-action]')!;
    button.dataset.nextProgress = String(progress + 1);
    button.disabled = !canIncrement;
    button.title = canIncrement ? 'Mark next episode watched' : caughtUp ? 'Caught up' : 'Progress unavailable';
    const title = card.querySelector<HTMLElement>('.progress-card-title')?.textContent || 'this series';
    button.setAttribute('aria-label', canIncrement ? `Mark next episode of ${title} watched` : caughtUp ? `${title} is caught up` : `Progress unavailable for ${title}`);
    let plus = button.querySelector<HTMLElement>('.progress-card-plus');
    if (canIncrement && !plus) {
      plus = document.createElement('span'); plus.className = 'progress-card-plus'; plus.setAttribute('aria-hidden','true'); plus.textContent = '+'; button.append(plus);
    } else if (!canIncrement) plus?.remove();
    if ('latest_released_position' in updated) {
      const latest = String(updated.latest_released_position || '').replace(/(S\d+)(E\d+)/,'$1 $2');
      card.dataset.latestPosition = latest;
      const label = card.querySelector<HTMLElement>('[data-latest-episode]');
      if (label) label.textContent = latest || 'Latest episode';
    }
    if ('next_release_date' in updated) card.dataset.nextAir = updated.next_release_date || '';
  };

  grid.querySelectorAll<HTMLButtonElement>('[data-progress-action]').forEach(button => button.addEventListener('click', async () => {
    const card = button.closest<HTMLElement>('[data-progress-card]');
    if (!card || button.disabled) return;
    button.dataset.updating = 'true';
    button.disabled = true;
    button.title = 'Updating episode progress…';
    try {
      const response = await fetch(`/api/proxy/tracking/entry/${button.dataset.progressAction}`, {
        method:'PATCH', headers:{'content-type':'application/json'},
        body:JSON.stringify({progress:Number(button.dataset.nextProgress)}), signal,
      });
      if (!response.ok) throw new Error((await response.json().catch(()=>null))?.detail || 'Could not update episode progress.');
      const updated = await response.json();
      if (updated.status !== 'watching') {
        card.remove();
        if (!grid.querySelector('[data-progress-card]')) {
          const empty = document.createElement('p');
          empty.className = 'series-progress-empty';
          empty.textContent = 'Series you mark as Watching will appear here.';
          grid.replaceWith(empty);
        }
        const dashboard = document.querySelector<HTMLElement>('.home-dashboard');
        if (dashboard?.dataset.watchingCount) {
          const count = Math.max(0, Number(dashboard.dataset.watchingCount) - 1);
          dashboard.dataset.watchingCount = String(count);
          const browse = dashboard.querySelector<HTMLElement>('[data-find-title]');
          if (browse) browse.hidden = count !== 0;
        }
        document.dispatchEvent(new CustomEvent('anylist:data-changed'));
        return;
      }
      syncCardProgress(card,updated);
      document.dispatchEvent(new CustomEvent('anylist:data-changed'));
    } catch (error) {
      button.disabled = false;
      button.title = error instanceof Error ? error.message : 'Could not update episode progress.';
      button.setAttribute('aria-label', `${button.title} Try again`);
    } finally {
      delete button.dataset.updating;
    }
  }, {signal}));

  const dashboard = document.querySelector<HTMLElement>('.home-dashboard');
  const username = dashboard?.dataset.username;
  if (!dashboard || !username) return;
  homeSeriesRefresh = startVisibleRefresh({intervalMs:60_000, refresh:async refreshSignal => {
    if (grid.querySelector('[data-updating="true"]')) return;
    const response = await fetch(`/api/proxy/tracking/profile/${encodeURIComponent(username)}/all`, {cache:'no-store',signal:refreshSignal});
    if (!response.ok) return;
    const entries = (await response.json()).entries;
    if (!Array.isArray(entries)) return;
    const watching = entries.filter((entry:any) => entry.status === 'watching');
    dashboard.dataset.watchingCount = String(watching.length);
    const browse = dashboard.querySelector<HTMLElement>('[data-find-title]');
    if (browse) browse.hidden = watching.length !== 0;
    const series = watching.filter((entry:any) => entry.type === 'series');
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-progress-card]'));
    const byId = new Map(series.map((entry:any) => [String(entry.id), entry]));
    if (cards.length !== series.length || cards.some(card => !byId.has(card.dataset.mediaId || ''))) {
      window.location.reload();
      return;
    }
    for (const card of cards) {
      const entry = byId.get(card.dataset.mediaId || '') as any;
      if (card.classList.contains('airing') !== (entry.currently_airing === true)) {
        window.location.reload();
        return;
      }
      syncCardProgress(card,entry);
    }
    updateCountdowns();
  }});
  homeUpcomingRefresh = startVisibleRefresh({intervalMs:60_000, refresh:async refreshSignal => {
    const response = await fetch('/api/proxy/tracking/upcoming-seasons', {cache:'no-store',signal:refreshSignal});
    if (!response.ok) return;
    const results = (await response.json()).results;
    if (!Array.isArray(results)) return;
    const actual = Array.from(upcomingGrid?.querySelectorAll<HTMLElement>('[data-upcoming-card]') || []).map(card => [
      card.dataset.mediaId, card.dataset.seasonNumber, card.dataset.releaseDate, card.dataset.seasonPoster,
      card.dataset.artworkFallback, card.dataset.artworkRetry,
    ].join('|')).sort();
    const expected = results.map((entry:any) => [
      String(entry.id), String(entry.season_number), String(entry.release_date || ''), String(entry.season_poster_path || ''),
      String(entry.season_artwork_fallback === true), String(entry.artwork_retry === true),
    ].join('|')).sort();
    if (actual.length !== expected.length || actual.some((signature,index) => signature !== expected[index])) window.location.reload();
  }});
  document.addEventListener('anylist:data-changed', () => {
    void homeSeriesRefresh?.refresh();
    void homeUpcomingRefresh?.refresh();
  }, {signal});
});
</script>
<script>
import {activityAction,activityRating,activityTime,scoreLabel} from '../lib/tracker';
import {applyResponsiveArtwork} from '../lib/responsive-artwork';
import {startVisibleRefresh, type VisibleRefreshHandle} from '../lib/visible-refresh';

let activityFeedRefresh: VisibleRefreshHandle|undefined;

document.addEventListener('astro:page-load',()=>{
  activityFeedRefresh?.stop();
  activityFeedRefresh=undefined;
  const feed=document.querySelector<HTMLElement>('[data-activity-feed]');
  const template=document.querySelector<HTMLTemplateElement>('#activity-card-template');
  const emptyTemplate=document.querySelector<HTMLTemplateElement>('#activity-empty-template');
  if(!feed||!template)return;

  const updateTimes=()=>document.querySelectorAll<HTMLTimeElement>('[data-relative-time]').forEach(time=>{
    if(!time.dateTime)return;
    const value=activityTime(time.dateTime);
    time.textContent=value.label;time.title=value.exact;
  });

  const render=(activity:any)=>{
    const card=template.content.firstElementChild!.cloneNode(true) as HTMLElement;
    card.dataset.activityKey=activity.key;card.dataset.createdAt=activity.created_at;
    const mediaHref=`/title/${activity.media.id}`;
    const cover=card.querySelector<HTMLAnchorElement>('.event-cover')!;
    cover.href=mediaHref;cover.setAttribute('aria-label',`View ${activity.media.title}`);
    const coverImage=cover.querySelector('img')!;const coverFallback=cover.querySelector<HTMLElement>('.cover-placeholder')!;
    if(activity.media.poster){applyResponsiveArtwork(coverImage,activity.media.poster,{size:'w342',sizes:'(max-width:700px) 56px, 64px',route:'direct'});coverImage.alt='';coverFallback.hidden=true;}else{coverImage.removeAttribute('src');coverImage.removeAttribute('srcset');coverImage.removeAttribute('sizes');coverFallback.hidden=false;}
    const profileHref=`/user/${encodeURIComponent(activity.username)}`;
    const avatar=card.querySelector<HTMLAnchorElement>('.event-avatar')!;
    avatar.href=profileHref;avatar.setAttribute('aria-label',`View ${activity.display_name}'s profile`);
    const avatarImage=avatar.querySelector('img')!;const avatarFallback=avatar.querySelector('span')!;
    if(activity.has_avatar){avatarImage.src=`/api/proxy/profile/avatar/${activity.user_id}`;avatarFallback.remove();}
    else{avatarImage.remove();avatarFallback.textContent=(activity.display_name||activity.username||'?').trim().charAt(0).toUpperCase();}
    const user=card.querySelector<HTMLAnchorElement>('.event-user')!;user.href=profileHref;user.textContent=activity.display_name;
    const time=card.querySelector<HTMLTimeElement>('time')!;const relative=activityTime(activity.created_at);
    time.dateTime=relative.datetime;time.textContent=relative.label;time.title=relative.exact;
    const action=card.querySelector<HTMLElement>('.event-action span')!;action.textContent=activityAction(activity);
    const title=card.querySelector<HTMLAnchorElement>('.event-action>a')!;title.href=mediaHref;title.textContent=activity.media.title;
    const footer=card.querySelector<HTMLElement>('.event-footer')!;
    const rating=activityRating(activity);
    if(rating){
      footer.hidden=false;
      const previous=footer.querySelector<HTMLElement>('[data-rating-previous]')!;
      previous.hidden=rating.previous==null;
      if(rating.previous!=null)previous.querySelector<HTMLElement>('[data-rating-previous-value]')!.textContent=scoreLabel(rating.previous);
      footer.querySelector<HTMLElement>('[data-rating-current]')!.textContent=scoreLabel(rating.current);
      footer.querySelector('.score-pill')!.setAttribute('aria-label',rating.label);
    }
    return card;
  };

  const reconcile=(activities:any[])=>{
    feed.querySelector('[data-activity-error]')?.remove();
    const cards=new Map(Array.from(feed.querySelectorAll<HTMLElement>('[data-activity-card]')).map(card=>[card.dataset.activityKey,card]));
    const visibleKeys=new Set(activities.map(activity=>activity.key));
    cards.forEach((card,key)=>{if(!visibleKeys.has(key))card.remove();});
    if(activities.length)feed.querySelector('[data-activity-empty]')?.remove();
    activities.forEach(activity=>{
      const existing=cards.get(activity.key);
      const card=existing?.dataset.createdAt===activity.created_at?existing:render(activity);
      if(card!==existing)existing?.remove();
      feed.append(card);
    });
    if(!activities.length&&!feed.querySelector('[data-activity-empty]')&&emptyTemplate)
      feed.append(emptyTemplate.content.firstElementChild!.cloneNode(true));
  };

  const refresh=async(signal:AbortSignal)=>{
    updateTimes();
    try{
      const response=await fetch('/api/proxy/tracking/activity',{cache:'no-store',signal});
      if(response.ok)reconcile((await response.json()).results||[]);
    }catch(error){if(!signal.aborted)console.debug('Activity refresh deferred.',error);}
  };

  activityFeedRefresh=startVisibleRefresh({refresh,intervalMs:60_000});
  updateTimes();
});
</script>
