---
import AccountNameSettings from "../components/settings/AccountNameSettings.astro";
import TrackerSettings from "../layouts/TrackerSettings.astro";
import Icon from "../components/Icon.astro";
import { api } from "../lib/api";
import type { TotpBackupCode } from "../lib/api";

const { token } = Astro.locals;
const me = await api.auth.me(token!);
const security = await api.auth.accountSecurity(token!);
let backupCodes: TotpBackupCode[] = [];
if (me.totp_enabled) {
  try {
    const res = await api.auth.totp2faBackupCodes(token!);
    backupCodes = res.codes;
  } catch {
    // non-fatal — codes panel will just be empty
  }
}
---

<TrackerSettings title="Account">
  <div
    id="app-data"
    data-token={token}
    class="hidden"
    aria-hidden="true"
  ></div>
  <div data-account-settings-page class="max-w-4xl mx-auto">
    <div id="js-message" class="hidden fixed right-4 z-[200] max-w-sm p-4 rounded-lg shadow-2xl border"></div>

    <div class="settings-stack">
      <AccountNameSettings username={me.username} />

      <!-- Security -->
      <section id="2fa-section">
        <h2 class="section-headline mb-4 border-b border-zinc-800 pb-2">Security</h2>
        <h3 class="text-base font-semibold text-zinc-300 mb-3">Two-Factor Authentication</h3>

        {!me.totp_enabled ? (
          <div class="space-y-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-zinc-900/40 border border-zinc-800 rounded-2xl p-6">
              <div>
                <h3 class="font-semibold text-zinc-100 mb-1">Authenticator App</h3>
                <p class="text-sm text-zinc-400">Protect your account with a time-based one-time password (TOTP) from any authenticator app.</p>
              </div>
              <button
                type="button"
                id="enable-2fa-btn"
                class="w-full sm:w-auto sm:shrink-0 px-6 py-3 button-primary font-bold rounded-xl transition-colors cursor-pointer text-sm"
              >
                Enable 2FA
              </button>
            </div>

            <!-- Setup panel (hidden until "Enable 2FA" is clicked) -->
            <div id="2fa-setup-panel" class="hidden border border-zinc-700 rounded-2xl p-6 space-y-5 bg-zinc-900/30">
              <div class="text-sm text-zinc-400">
                Scan the QR code with your authenticator app (Google Authenticator, Authy, etc.), then enter the 6-digit code to confirm.
              </div>

              <div class="flex flex-col md:flex-row gap-6 items-start">
                <div class="shrink-0">
                  <canvas id="totp-qr-canvas" class="rounded-lg bg-white p-2" width="160" height="160"></canvas>
                </div>
                <div class="space-y-3 flex-1">
                  <div>
                    <p class="text-xs text-zinc-500 mb-1">Manual entry key</p>
                    <code id="totp-secret-display" class="block bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-300 font-mono text-sm tracking-widest break-all select-all"></code>
                  </div>
                  <div class="space-y-2">
                    <label for="totp-verify-code" class="block text-sm font-medium text-zinc-400">Verification Code</label>
                    <input
                      type="text"
                      id="totp-verify-code"
                      autocomplete="one-time-code"
                      inputmode="numeric"
                      maxlength="6"
                      placeholder="000000"
                      class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                    />
                  </div>
                  <div class="flex gap-3">
                    <button
                      type="button"
                      id="confirm-enable-2fa-btn"
                      class="px-5 py-2 button-primary font-bold rounded-lg transition-colors cursor-pointer text-sm disabled:opacity-50"
                    >
                      Verify &amp; Enable
                    </button>
                    <button
                      type="button"
                      id="cancel-2fa-setup-btn"
                      class="px-5 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 rounded-lg text-sm transition-colors cursor-pointer"
                    >
                      Cancel
                    </button>
                  </div>
                  <p id="2fa-setup-error" class="hidden text-sm text-red-400"></p>
                </div>
              </div>
            </div>

            <!-- Backup codes shown after successful enable (hidden initially) -->
            <div id="2fa-new-codes-panel" class="hidden border border-green-500/30 bg-green-500/5 rounded-2xl p-6 space-y-4">
              <div class="flex items-center gap-2 text-green-400 font-semibold">
                <Icon name="circle-check" class="w-5 h-5" />
                2FA Enabled
              </div>
              <p class="text-sm text-zinc-400">Save these backup codes somewhere safe. Each can only be used once. They cannot be shown again — regenerate them in settings if needed.</p>
              <div id="2fa-new-codes-grid" class="grid grid-cols-2 gap-2"></div>
              <button
                type="button"
                id="2fa-new-codes-done-btn"
                class="px-5 py-2 button-primary font-bold rounded-lg transition-colors cursor-pointer text-sm"
              >
                Done — reload page
              </button>
            </div>
          </div>
        ) : (
          <div class="space-y-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-zinc-900/40 border border-zinc-800 rounded-2xl p-6">
              <div class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-green-500 shrink-0"></span>
                <div>
                  <h3 class="font-semibold text-zinc-100">2FA is enabled</h3>
                  <p class="text-sm text-zinc-400">Your account is protected with an authenticator app.</p>
                </div>
              </div>
              <button
                type="button"
                id="disable-2fa-btn"
                class="shrink-0 px-5 py-2 bg-red-600/10 hover:bg-red-600/20 text-red-400 border border-red-500/30 font-bold rounded-lg text-sm transition-colors cursor-pointer"
              >
                Disable 2FA
              </button>
            </div>

            <!-- Disable confirmation (hidden initially) -->
            <div id="2fa-disable-panel" class="hidden border border-zinc-700 rounded-2xl p-6 space-y-4 bg-zinc-900/30">
              <p class="text-sm text-zinc-400">Enter your authenticator code or a backup code to disable 2FA.</p>
              <div class="flex gap-3 items-end">
                <div class="space-y-2 flex-1">
                  <label for="totp-disable-code" class="block text-sm font-medium text-zinc-400">Code</label>
                  <input
                    type="text"
                    id="totp-disable-code"
                    autocomplete="one-time-code"
                    placeholder="000000 or XXXX-XXXX"
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                  />
                </div>
                <button
                  type="button"
                  id="confirm-disable-2fa-btn"
                  class="px-5 py-2 bg-red-600 hover:bg-red-500 text-white font-bold rounded-lg text-sm transition-colors cursor-pointer disabled:opacity-50"
                >
                  Confirm
                </button>
                <button
                  type="button"
                  id="cancel-disable-2fa-btn"
                  class="px-5 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 rounded-lg text-sm transition-colors cursor-pointer"
                >
                  Cancel
                </button>
              </div>
              <p id="2fa-disable-error" class="hidden text-sm text-red-400"></p>
            </div>

            <!-- Backup codes -->
            <details data-motion-details class="group border border-zinc-800 rounded-2xl bg-zinc-900/20 overflow-hidden">
              <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none select-none hover:bg-zinc-900/40 transition-colors">
                <span class="font-medium text-zinc-300">Backup Codes</span>
                <Icon name="chevron-down" class="w-4 h-4 text-zinc-500 transition-transform group-open:rotate-180" />
              </summary>
              <div class="px-6 pb-6 space-y-4">
                <p class="text-sm text-zinc-500">Used codes are shown with strikethrough and cannot be reused. Keep these somewhere safe.</p>
                <div class="grid grid-cols-2 gap-2">
                  {backupCodes.map((bc) => (
                    <span class={`font-mono text-sm px-3 py-1.5 rounded-lg border ${bc.used ? "text-zinc-400 border-zinc-800 line-through" : "text-zinc-300 border-zinc-700 bg-zinc-900"}`}>
                      {bc.code}
                    </span>
                  ))}
                </div>
              </div>
            </details>
          </div>
        )}

        {security.oidc_enabled && <div class="mt-8">
          {security.oidc_fresh ? <p class="text-sm text-green-400">Account verified</p> :
            <a href="/oidc-start?reauth=true&next=%2Fsettings" class="inline-block rounded-lg border border-zinc-700 bg-zinc-800 px-4 py-2 text-sm font-semibold">Verify with {security.provider_name}</a>}
        </div>}
        <h3 class="text-base font-semibold text-zinc-300 mt-8 mb-3">{me.has_password ? "Change Password" : "Set Password"}</h3>
        <form id="password-form" class="space-y-6 max-w-md">
          <div class="space-y-4">
            {me.has_password && !security.oidc_fresh && <div class="space-y-2">
              <label for="current_password" class="block text-sm font-medium text-zinc-400">Current Password</label>
              <div class="relative group/field">
                <input
                  type="password"
                  name="current_password"
                  id="current_password"
                  autocomplete="current-password"
                  required
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle password visibility"
                >
                  <Icon name="eye" class="w-5 h-5 eye-icon" />
                  <Icon name="eye-slash" class="w-5 h-5 eye-slash-icon hidden" />
                </button>
              </div>
            </div>}
            <div class="space-y-2">
              <label for="new_password" class="block text-sm font-medium text-zinc-400">New Password</label>
              <div class="relative group/field">
                <input
                  type="password"
                  name="new_password"
                  id="new_password"
                  autocomplete="new-password"
                  required
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle password visibility"
                >
                  <Icon name="eye" class="w-5 h-5 eye-icon" />
                  <Icon name="eye-slash" class="w-5 h-5 eye-slash-icon hidden" />
                </button>
              </div>
            </div>
            <div class="space-y-2">
              <label for="confirm_password" class="block text-sm font-medium text-zinc-400">Confirm New Password</label>
              <div class="relative group/field">
                <input
                  type="password"
                  name="confirm_password"
                  id="confirm_password"
                  autocomplete="new-password"
                  required
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle password visibility"
                >
                  <Icon name="eye" class="w-5 h-5 eye-icon" />
                  <Icon name="eye-slash" class="w-5 h-5 eye-slash-icon hidden" />
                </button>
              </div>
            </div>
          </div>
          <div class="pt-2">
            <button
              disabled={!me.has_password && !security.oidc_fresh}
              id="update-password-btn"
              type="submit"
              class="bg-zinc-800 text-zinc-100 font-bold px-8 py-2 rounded-lg hover:bg-zinc-700 transition-colors cursor-pointer border border-zinc-700 disabled:opacity-50"
            >
              Update Password
            </button>
          </div>
        </form>
        {security.smtp_configured && me.has_password && <a href="/forgot-password" class="inline-block mt-3 text-sm text-zinc-400 hover:text-zinc-100">Forgot password?</a>}
        <h3 class="text-base font-semibold text-zinc-300 mt-8 mb-3">Email Address</h3>
        <p class="text-sm text-zinc-400 mb-4">{me.email}</p>
        {security.smtp_configured ? <form id="email-form" class="space-y-4 max-w-md">
          <label class="block text-sm font-medium text-zinc-400">New Email
            <input type="email" name="email" required maxlength="255" autocomplete="email" class="mt-2 w-full rounded-lg border border-zinc-800 bg-zinc-950 px-4 py-3 text-zinc-100" />
          </label>
          {me.has_password && !security.oidc_fresh && <label class="block text-sm font-medium text-zinc-400">Current Password
            <input type="password" name="current_password" required autocomplete="current-password" class="mt-2 w-full rounded-lg border border-zinc-800 bg-zinc-950 px-4 py-3 text-zinc-100" />
          </label>}
          <button type="submit" disabled={!me.has_password && !security.oidc_fresh} class="rounded-lg border border-zinc-700 bg-zinc-800 px-6 py-2 font-semibold text-zinc-100 disabled:opacity-50">Change Email</button>
        </form> : <p class="text-sm text-zinc-400">Contact an administrator to change your email address.</p>}
      </section>

      <!-- Export Data -->
      <section>
        <h2 class="section-headline mb-4 border-b border-zinc-800 pb-2">Export Data</h2>
        <div class="space-y-4 max-w-xl">
          <p class="text-sm text-zinc-400">Download your watch history, ratings, collection, lists, and comments as a zip.</p>
          <button
            type="button"
            id="export-data-btn"
            class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 rounded-lg text-sm transition-colors cursor-pointer disabled:opacity-50"
          >
            Download My Data
          </button>
        </div>
      </section>

      <!-- Danger Zone -->
      <section>
        <h2 class="text-2xl font-black text-red-500 tracking-tight mb-4 border-b border-red-500/20 pb-2">Danger Zone</h2>
        <div class="bg-red-500/5 border border-red-500/10 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="text-lg font-bold text-zinc-100 mb-1">Delete Account</h3>
            <p class="text-zinc-400 text-sm">Once you delete your account, there is no going back. All your data will be permanently removed.</p>
          </div>
          <button
            type="button"
            id="delete-account-btn"
            class="px-6 py-3 bg-red-600 hover:bg-red-500 text-zinc-100 font-bold rounded-xl transition-all shadow-lg shadow-red-600/20 active:scale-95 whitespace-nowrap cursor-pointer"
          >
            Delete Account
          </button>
        </div>
      </section>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <!-- Data Export Modal -->
  <div id="export-data-modal" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-8 max-w-md w-full shadow-2xl">
      <h2 class="text-2xl font-bold text-zinc-100 mb-2">Export your data</h2>
      <p class="text-zinc-400 mb-6 text-sm leading-relaxed">Choose what to include in the export.</p>
      <div class="space-y-2 mb-6">
        {[
          { key: "watched", label: "Watch History" },
          { key: "ratings", label: "Ratings" },
          { key: "collection", label: "Collection" },
          { key: "lists", label: "Lists" },
          { key: "comments", label: "Comments" },
        ].map(({ key, label }) => (
          <button
            type="button"
            data-export-option={key}
            class="export-option w-full flex items-center justify-between px-4 py-3 bg-zinc-800 hover:bg-zinc-700 border-2 border-transparent rounded-xl transition-colors cursor-pointer"
          >
            <span class="text-sm font-medium text-zinc-100">{label}</span>
            <Icon name="check" class="check-icon w-5 h-5 text-blue-500" />
          </button>
        ))}
      </div>

      <p class="text-xs text-amber-400/90 mb-2 leading-relaxed flex items-start gap-1.5">
        <Icon name="error" class="text-red-500 w-4 h-4 shrink-0 mt-0.5" />
        <span>These include API keys and tokens in <strong>plain text</strong> — only enable if you understand the risk.</span>
      </p>
      <div class="space-y-2 mb-8">
        {[
          { key: "api_keys", label: "Api Keys" },
          { key: "media_connections", label: "Media & Cloud Connections" },
          { key: "scrobble_connections", label: "Scrobble-only Connections" },
          { key: "connections", label: "Connections" },
        ].map(({ key, label }) => (
          <button
            type="button"
            data-export-option={key}
            data-secret="true"
            class="export-option w-full flex items-center justify-between px-4 py-3 bg-zinc-800 hover:bg-zinc-700 border-2 border-transparent rounded-xl transition-colors cursor-pointer"
          >
            <span class="text-sm font-medium text-zinc-100">{label}</span>
            <Icon name="check" class="check-icon w-5 h-5 text-amber-500 invisible" />
          </button>
        ))}
      </div>
      <div class="flex gap-3">
        <button type="button" id="export-data-modal-cancel" class="flex-1 px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer">Cancel</button>
        <button type="button" id="export-data-modal-confirm" class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-blue-600">Export</button>
      </div>
    </div>
  </div>


  <div id="delete-modal" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-8 max-w-md w-full shadow-2xl">
      <h2 class="text-2xl font-bold text-zinc-100 mb-2">Are you sure?</h2>
      <p class="text-zinc-400 mb-8 text-sm leading-relaxed">
        This will permanently delete your account and remove all your data. This action cannot be undone.
      </p>
      <div class="flex gap-3">
        <button type="button" id="cancel-delete" class="flex-1 px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer">
          Cancel
        </button>
        <button type="button" id="confirm-delete" class="flex-1 px-6 py-3 bg-red-600 hover:bg-red-500 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer">
          Yes, delete
        </button>
      </div>
    </div>
  </div>

</TrackerSettings>
<script>
  import { errorMessage, showMessage } from '../lib/settings-feedback';
  import type { PersonalDataSelection } from '../lib/api';
  import { showOverlay, hideOverlay } from '../lib/ui-motion';
  const appData = document.getElementById('app-data');
  const token = appData?.dataset.token ?? '';


  function showExportDataModal(): Promise<PersonalDataSelection | null> {
    return new Promise(resolve => {
      const modal = document.getElementById('export-data-modal');
      const confirmBtn = document.querySelector<HTMLButtonElement>('#export-data-modal-confirm');
      const cancelBtn = document.querySelector<HTMLButtonElement>('#export-data-modal-cancel');
      const options = Array.from(document.querySelectorAll<HTMLButtonElement>('.export-option'));
      if (!modal || !confirmBtn || !cancelBtn || options.length === 0) { resolve(null); return; }

      // The plaintext-secret options (data-secret="true") start unselected;
      // everything else is preselected by default.
      const selected = new Set(
        options.filter(o => o.getAttribute('data-secret') !== 'true').map(o => o.getAttribute('data-export-option')!)
      );

      const syncOptionUI = () => {
        options.forEach(opt => {
          const isOn = selected.has(opt.getAttribute('data-export-option')!);
          const isSecret = opt.getAttribute('data-secret') === 'true';
          const icon = opt.querySelector('.check-icon');
          icon?.classList.toggle('invisible', !isOn);
          opt.classList.toggle(isSecret ? 'border-amber-500' : 'border-blue-500', isOn);
          opt.classList.toggle('border-transparent', !isOn);
        });
        confirmBtn.disabled = selected.size === 0;
      };
      syncOptionUI();

      const optionHandlers = options.map(opt => {
        const handler = () => {
          const name = opt.getAttribute('data-export-option')!;
          if (selected.has(name)) selected.delete(name); else selected.add(name);
          syncOptionUI();
        };
        opt.addEventListener('click', handler);
        return { opt, handler };
      });

      showOverlay(modal);

      const cleanup = (result: PersonalDataSelection | null) => {
        void hideOverlay(modal);
        confirmBtn.removeEventListener('click', onConfirm);
        cancelBtn.removeEventListener('click', onCancel);
        optionHandlers.forEach(({ opt, handler }) => opt.removeEventListener('click', handler));
        resolve(result);
      };
      const onConfirm = () => cleanup({
        watched: selected.has('watched'),
        ratings: selected.has('ratings'),
        collection: selected.has('collection'),
        lists: selected.has('lists'),
        comments: selected.has('comments'),
        api_keys: selected.has('api_keys'),
        media_connections: selected.has('media_connections'),
        scrobble_connections: selected.has('scrobble_connections'),
        connections: selected.has('connections'),
      });
      const onCancel = () => cleanup(null);
      confirmBtn.addEventListener('click', onConfirm, { once: true });
      cancelBtn.addEventListener('click', onCancel, { once: true });
    });
  }

  function setupActions() {
    // Delete Account Logic
    const deleteBtn = document.querySelector<HTMLButtonElement>('#delete-account-btn');
    const modal = document.getElementById('delete-modal');
    const cancelBtn = document.querySelector<HTMLButtonElement>('#cancel-delete');
    const confirmBtn = document.querySelector<HTMLButtonElement>('#confirm-delete');
    if (deleteBtn && modal && cancelBtn && confirmBtn) {
      deleteBtn.onclick = () => {
        showOverlay(modal);
      };

      cancelBtn.onclick = () => {
        void hideOverlay(modal);
      };

      confirmBtn.onclick = async () => {
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Deleting...';
        try {
          const res = await fetch(`/api/proxy/auth/me`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.ok) {
            window.location.href = '/logout';
          } else {
            const data = await res.json();
            throw new Error(data.detail || 'Failed to delete account');
          }
        } catch (e) {
          showMessage(errorMessage(e), 'error');
          void hideOverlay(modal);
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Yes, delete';
        }
      };
    }
  }


  function setupPasswordForm() {
    const form = document.querySelector<HTMLFormElement>('#password-form');
    const updateBtn = document.querySelector<HTMLButtonElement>('#update-password-btn');
    if (!form || !updateBtn || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (updateBtn.disabled) return;

      const formData = new FormData(form);
      const current_password = formData.get('current_password') || null;
      const new_password = formData.get('new_password');
      const confirm_password = formData.get('confirm_password');

      if (new_password !== confirm_password) {
        showMessage('New passwords do not match', 'error');
        return;
      }

      updateBtn.disabled = true;
      const originalText = updateBtn.textContent;
      updateBtn.textContent = 'Updating...';

      try {
        const res = await fetch(`/api/proxy/auth/change-password`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ current_password, new_password }),
        });

        if (res.ok) {
          window.location.assign('/login?password_reset=true');
        } else {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to update password');
        }
      } catch (e) {
        showMessage(errorMessage(e), 'error');
      } finally {
        updateBtn.disabled = false;
        updateBtn.textContent = originalText;
      }
    });
  }

  function setupEmailForm() {
    const form = document.querySelector<HTMLFormElement>('#email-form');
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      if (button.disabled) return;
      const data = new FormData(form);
      button.disabled = true;
      try {
        const res = await fetch('/api/proxy/auth/change-email', {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: data.get('email'), current_password: data.get('current_password') || null }),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.detail || 'Could not change email');
        showMessage(result.message);
        form.reset();
      } catch (error) {
        showMessage(errorMessage(error), 'error');
      } finally {
        button.disabled = false;
      }
    });
  }

  function setupExportData() {
    const btn = document.querySelector<HTMLButtonElement>('#export-data-btn');
    if (!btn || btn.dataset.initialized) return;
    btn.dataset.initialized = 'true';

    btn.addEventListener('click', async () => {
      const selection = await showExportDataModal();
      if (!selection) return;

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Preparing…';

      try {
        const params = new URLSearchParams({
          watched: String(selection.watched),
          ratings: String(selection.ratings),
          collection: String(selection.collection),
          lists: String(selection.lists),
          comments: String(selection.comments),
          api_keys: String(selection.api_keys),
          media_connections: String(selection.media_connections),
          scrobble_connections: String(selection.scrobble_connections),
          connections: String(selection.connections),
        });
        const res = await fetch(`/api/proxy/export/data?${params}`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || 'Export failed');
        }
        const cd = res.headers.get('Content-Disposition');
        const filename = cd?.match(/filename="([^"]+)"/)?.[1] ?? 'media-tracker-export.zip';
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
        showMessage('Export downloaded successfully!');
      } catch (e) {
        showMessage(e instanceof Error ? e.message : 'Export failed', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  }

  setupActions();
  setupPasswordForm();
  setupEmailForm();

  setupExportData();

  document.addEventListener('astro:after-swap', () => {
    setupActions();
    setupPasswordForm();
    setupEmailForm();
    setupExportData();
  });


</script>

<script>
  import QRCode from 'qrcode';
  import { escapeHtml as esc, showMessage, errorMessage } from '../lib/settings-feedback';

  const appData = document.getElementById('app-data') as HTMLElement | null;
  const token: string = appData?.dataset.token ?? '';

  let pendingTotpSecret = '';

  function show2faSetupError(msg: string) {
    const el = document.getElementById('2fa-setup-error');
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  function hide2faSetupError() {
    document.getElementById('2fa-setup-error')?.classList.add('hidden');
  }

  function show2faDisableError(msg: string) {
    const el = document.getElementById('2fa-disable-error');
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  function setup2fa() {
    const section = document.getElementById('2fa-section');
    if (!section || section.dataset.initialized) return;
    section.dataset.initialized = 'true';
    pendingTotpSecret = '';
    // Enable flow
    const enableBtn = document.querySelector<HTMLButtonElement>('#enable-2fa-btn');
    const setupPanel = document.getElementById('2fa-setup-panel');
    const cancelSetupBtn = document.querySelector<HTMLButtonElement>('#cancel-2fa-setup-btn');
    const confirmEnableBtn = document.querySelector<HTMLButtonElement>('#confirm-enable-2fa-btn');
    const verifyInput = document.querySelector<HTMLInputElement>('#totp-verify-code');
    const secretDisplay = document.getElementById('totp-secret-display');
    const qrCanvas = document.querySelector<HTMLCanvasElement>('#totp-qr-canvas');
    const newCodesPanel = document.getElementById('2fa-new-codes-panel');
    const newCodesGrid = document.getElementById('2fa-new-codes-grid');
    const newCodesDoneBtn = document.querySelector<HTMLButtonElement>('[id="2fa-new-codes-done-btn"]');

    enableBtn?.addEventListener('click', async () => {
      enableBtn.textContent = 'Loading...';
      (enableBtn as HTMLButtonElement).disabled = true;
      hide2faSetupError();

      try {
        const res = await fetch(`/api/proxy/auth/2fa/setup`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to start 2FA setup');
        }
        const data = await res.json() as { provisioning_uri: string; secret: string };
        pendingTotpSecret = data.secret;

        if (secretDisplay) secretDisplay.textContent = data.secret;

        if (qrCanvas) {
          await QRCode.toCanvas(qrCanvas, data.provisioning_uri, {
            width: 160,
            margin: 1,
            color: { dark: '#000000', light: '#ffffff' },
          });
        }

        setupPanel?.classList.remove('hidden');
      } catch (e: unknown) {
        showMessage(errorMessage(e), 'error');
      } finally {
        enableBtn.textContent = 'Enable 2FA';
        (enableBtn as HTMLButtonElement).disabled = false;
      }
    });

    cancelSetupBtn?.addEventListener('click', () => {
      setupPanel?.classList.add('hidden');
      pendingTotpSecret = '';
      hide2faSetupError();
      if (verifyInput) verifyInput.value = '';
    });

    confirmEnableBtn?.addEventListener('click', async () => {
      const code = verifyInput?.value.trim() ?? '';
      if (!code || !pendingTotpSecret) return;

      confirmEnableBtn.disabled = true;
      const orig = confirmEnableBtn.textContent;
      confirmEnableBtn.textContent = 'Verifying...';
      hide2faSetupError();

      try {
        const res = await fetch(`/api/proxy/auth/2fa/enable`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ secret: pendingTotpSecret, code }),
        });
        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.detail || 'Invalid code');
        }
        const data = await res.json() as { codes: { id: number; code: string; used: boolean }[] };

        setupPanel?.classList.add('hidden');

        if (newCodesGrid) {
          newCodesGrid.innerHTML = data.codes
            .map(bc => `<span class="font-mono text-sm px-3 py-1.5 rounded-lg border border-zinc-700 bg-zinc-900 text-zinc-300">${esc(bc.code)}</span>`)
            .join('');
        }
        newCodesPanel?.classList.remove('hidden');
      } catch (e: unknown) {
        show2faSetupError(e instanceof Error ? e.message : 'Failed to enable 2FA');
      } finally {
        confirmEnableBtn.disabled = false;
        confirmEnableBtn.textContent = orig;
      }
    });

    newCodesDoneBtn?.addEventListener('click', () => {
      window.location.reload();
    });

    // Disable flow
    const disableBtn = document.querySelector<HTMLButtonElement>('#disable-2fa-btn');
    const disablePanel = document.getElementById('2fa-disable-panel');
    const cancelDisableBtn = document.querySelector<HTMLButtonElement>('#cancel-disable-2fa-btn');
    const confirmDisableBtn = document.querySelector<HTMLButtonElement>('#confirm-disable-2fa-btn');
    const disableCodeInput = document.querySelector<HTMLInputElement>('#totp-disable-code');

    disableBtn?.addEventListener('click', () => {
      disablePanel?.classList.remove('hidden');
      disableBtn.classList.add('hidden');
    });

    cancelDisableBtn?.addEventListener('click', () => {
      disablePanel?.classList.add('hidden');
      disableBtn?.classList.remove('hidden');
      if (disableCodeInput) disableCodeInput.value = '';
      document.getElementById('2fa-disable-error')?.classList.add('hidden');
    });

    confirmDisableBtn?.addEventListener('click', async () => {
      const code = disableCodeInput?.value.trim() ?? '';
      if (!code) return;

      confirmDisableBtn.disabled = true;
      const orig = confirmDisableBtn.textContent;
      confirmDisableBtn.textContent = 'Disabling...';
      document.getElementById('2fa-disable-error')?.classList.add('hidden');

      try {
        const res = await fetch(`/api/proxy/auth/2fa/disable`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to disable 2FA');
        }
        window.location.reload();
      } catch (e: unknown) {
        show2faDisableError(e instanceof Error ? e.message : 'Failed to disable 2FA');
        confirmDisableBtn.disabled = false;
        confirmDisableBtn.textContent = orig;
      }
    });
  }

  setup2fa();
  document.addEventListener('astro:after-swap', setup2fa);
</script>
