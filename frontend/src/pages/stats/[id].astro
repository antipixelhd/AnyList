---
import Tracker from '../../layouts/Tracker.astro';
import { api } from '../../lib/api';

const id = Number(Astro.params.id);
let error = 'These statistics are unavailable.';
if (Number.isSafeInteger(id) && id > 0) {
  try {
    const profile = await api.profile.getPublic(id, Astro.locals.token);
    return Astro.redirect(`/user/${encodeURIComponent(profile.username)}/stats`, 302);
  } catch (cause) {
    if (cause instanceof Error && cause.message.includes('403')) error = 'This profile is private.';
    else if (cause instanceof Error && cause.message.includes('404')) error = 'User not found.';
  }
}
---
<Tracker title="Statistics unavailable"><div class="page-width"><p class="error-message" role="alert">{error}</p></div></Tracker>
