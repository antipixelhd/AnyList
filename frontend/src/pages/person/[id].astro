---
import Tracker from '../../layouts/Tracker.astro';
import { tracker, artwork } from '../../lib/tracker';
import { metadataKey } from '../../lib/catalogue-key';
import { personAge, personDate, type PersonDetail } from '../../lib/person-page-data';
const key = metadataKey(Astro.params.id);
Astro.response.headers.set('Cache-Control', 'private, no-store');
let person: PersonDetail | null = null, error = '';
try {
  if (!key) throw new Error('Not found.');
  person = await tracker(`staff/${encodeURIComponent(key)}`, Astro.locals.token);
} catch (cause) { error = (cause as Error).message; Astro.response.status = error === 'Not found.' ? 404 : 503; }
const portrait = artwork(person?.image || null, 'w342');
const age = person ? personAge(person.birthday, person.deathday) : null;
const facts = person ? [
  ['Born', personDate(person.birthday)], ['Died', personDate(person.deathday)],
  [person.deathday ? 'Age at death' : 'Age', age === null ? null : String(age)], ['Place of birth', person.place_of_birth],
].filter(([,value]) => value) : [];
---
<Tracker title={person?.name || 'Person'}>
  <div class="page-width person-page">
    {person ? <>
      <header class="person-header">
        <div class="person-portrait">{portrait ? <img src={portrait} alt={person.name} /> : <span aria-hidden="true">{person.name.slice(0,1)}</span>}</div>
        <div><h1>{person.name}</h1>{person.roles.length > 0 && <p class="person-roles">{person.roles.slice(0,3).join(' / ')}</p>}
          {facts.length > 0 && <dl>{facts.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
        </div>
      </header>
      {person.biography && <section class="person-biography"><h2>Biography</h2><p>{person.biography}</p></section>}
      {person.works.length > 0 && <section class="person-works"><h2>Works</h2><div class="person-works-grid">{person.works.map(work => {
        const poster = artwork(work.poster, 'w342');
        return <a href={work.href} title={`${work.title}${work.roles.length ? ` – ${work.roles.join(' / ')}` : ''}`}>
          <div class="person-work-poster">{poster ? <img src={poster} alt="" loading="lazy" /> : <span aria-hidden="true">{work.title.slice(0,1)}</span>}</div>
          <h3>{work.title}</h3><p>{work.roles.join(' / ')}</p>
        </a>;
      })}</div></section>}
    </> : <p class="error-message" role="alert">{error}</p>}
  </div>
</Tracker>
<style>
  .person-page { padding-block:48px 80px; }
  .person-header { display:flex; gap:36px; align-items:center; }
  .person-portrait { flex:0 0 160px; height:240px; overflow:hidden; border-radius:6px; background:var(--panel); color:var(--muted); display:grid; place-items:center; font-size:48px; }
  .person-portrait img { width:100%; height:100%; object-fit:cover; }
  h1 { color:var(--bright); font-size:clamp(28px,4vw,42px); margin:0 0 16px; }
  .person-roles { color:var(--muted); margin:0 0 24px; }
  dl { margin:0; display:flex; flex-wrap:wrap; gap:20px 32px; } dl>div { display:flex; flex-direction:column; gap:6px; }
  dt { color:var(--muted); font-size:12px; } dd { margin:0; color:var(--text); }
  .person-biography { max-width:820px; margin-top:40px; } .person-biography p { white-space:pre-line; line-height:1.7; color:var(--text); }
  h2 { color:var(--bright); font-size:22px; margin-bottom:24px; }
  .person-works { margin-top:48px; } .person-works-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:28px; }
  .person-works-grid a { min-width:0; text-decoration:none; } .person-work-poster { aspect-ratio:2/3; border-radius:5px; overflow:hidden; background:var(--panel); display:grid; place-items:center; color:var(--muted); font-size:32px; }
  .person-work-poster img { width:100%; height:100%; object-fit:cover; }
  h3 { color:var(--text); font-size:15px; line-height:1.4; margin:12px 0 6px; transition:color 200ms ease; } a:is(:hover,:focus-visible) h3 { color:var(--accent); }
  .person-works-grid p { color:var(--muted); font-size:12px; line-height:1.4; margin:0; }
  @media(max-width:1000px) { .person-works-grid { grid-template-columns:repeat(4,minmax(0,1fr)); } }
  @media(max-width:650px) { .person-page { padding-top:30px; } .person-header { gap:22px; align-items:flex-start; } .person-portrait { flex-basis:100px; height:150px; } dl { gap:14px; } .person-works-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; } }
  @media(prefers-reduced-motion:reduce) { h3 { transition:none; } }
</style>
