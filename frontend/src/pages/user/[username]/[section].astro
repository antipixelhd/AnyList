---
import Tracker from '../../../layouts/Tracker.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import ProfileListFilters from '../../../components/ProfileListFilters.astro';
import ScreenListRows from '../../../components/ScreenListRows.astro';
import ProfileListTableHead from '../../../components/ProfileListTableHead.astro';
import {tracker,trackerFailure,statuses} from '../../../lib/tracker';
import {profileListQuery} from '../../../lib/profile-list-query';
import {viewerMediaPreferences} from '../../../lib/viewer-media-preferences';
import {profileListPageSize} from '../../../lib/profile-list-window';
import '../../../styles/virtual-profile-list.css';
import '../../../styles/stats-loading.css';
const {username,section}=Astro.params;
if(!['movies','series','list'].includes(section!))return Astro.redirect('/404');
const isCombined=section==='list',mediaType=isCombined?'all':section==='movies'?'movie':'series';
const endpoint=`profile/${encodeURIComponent(username!)}/${mediaType}`;
const {default_sort:defaultSort}=await viewerMediaPreferences(Astro.locals);
const query=profileListQuery(Astro.url.searchParams,statuses,defaultSort);
const request=new URLSearchParams(query);request.set('limit',String(profileListPageSize));
let data:any=null,error='';
try{data=await tracker(`${endpoint}/list?${request}`,Astro.locals.token);}
catch(cause){const failure=trackerFailure(cause);error=failure.message;Astro.response.status=failure.status;}
const owner=data?.profile?.owner===true,entries=data?.results||[];
const count=Object.values(data?.status_counts||{}).reduce((sum:number,value)=>sum+Number(value),0);
---
<Tracker title={`${username}'s ${isCombined?'Movie/Series':section==='movies'?'Movie':'Series'} List`} listLanding={!!data} ownerProfileColor={data?.profile?.profile_color} ownerIsViewer={owner}>
  {data?<>
    <ProfileHeader profile={data.profile} active={section}/>
    <div class="list-shell" data-virtual-list data-list-domain="screen" data-screen-scope={mediaType} data-list-endpoint={endpoint} data-list-total={data.total} data-list-counts={JSON.stringify(data.group_counts)} data-owner={String(owner)} data-status-counts={JSON.stringify(data.status_counts)}>
      <ProfileListFilters {statuses} counts={data.status_counts} genres={data.genres} years={data.years} status={query.get('status')||'all'} sort={query.get('sort')||'title'} {defaultSort} query={query.get('q')||''} genre={query.get('genre')||''} year={query.get('year')||''} favorites={query.has('favorites')}/>
      <div class="list-content">
        <div class="list-toolbar"><span id="result-count" class="sr-only" aria-live="polite">{data.total} entries</span><span id="progress-feedback" class="sr-only" aria-live="assertive"></span></div>
        <div id="entry-groups">
          {statuses.map(([status,label])=><section class="status-section" data-list-group={status} data-group={status} hidden={!data.group_counts[status]}><h2>{label}</h2><div class="entry-table">
            <ProfileListTableHead combined={isCombined}/>
            <div data-list-window={status} style={`--list-rows:${data.group_counts[status]||0}`}><ScreenListRows entries={entries.filter((entry:any)=>entry.status===status)} {owner} {isCombined}/></div>
          </div></section>)}
        </div>
        <div id="list-empty" class="empty-state" hidden={!!data.total}><h2>{count?'No matching titles':'Every list starts with a story'}</h2><p>{count?'Try a different search or filter.':owner?'Find a movie or series and add it to your list.':'There are no entries in this list yet.'}</p>{owner&&<a class="button-primary" href="/browse">Browse titles</a>}</div>
      </div>
    </div>
    <div id="cover-preview" aria-hidden="true" hidden><img alt=""/></div>
    <template data-list-row-template><ScreenListRows entries={[{id:1,title:'',type:'series',status:'completed',progress:0,notes:'Note',rewatch_count:1,new_episodes:1}]} {owner} {isCombined} template/></template>
    <script id="virtual-list-page" type="application/json" set:html={JSON.stringify(data).replaceAll('<','\\u003c')}/>
    <script is:inline data-astro-rerun>
      (()=>{if(performance.getEntriesByType('navigation')[0]?.type!=='navigate'||history.state)return;const tabs=document.querySelector('.profile-tabs');if(tabs)window.scrollTo(0,window.scrollY+tabs.getBoundingClientRect().top);})();
    </script>
  </>:<div class="page-width"><p class="error-message" role="alert">{error}</p></div>}
</Tracker>
<script>import '../../../lib/profile-shell';</script>
