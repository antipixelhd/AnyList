---
import Tracker from '../../../layouts/Tracker.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import TrackingEditor from '../../../components/TrackingEditor.astro';
import Icon from '../../../components/Icon.astro';
import {tracker, statuses, artwork, scoreLabel} from '../../../lib/tracker';
const {username, section} = Astro.params;
if (!['movies','series','list'].includes(section!)) return Astro.redirect('/404');
const isCombined=section==='list';
const mediaType = isCombined ? 'all' : section === 'movies' ? 'movie' : 'series';
let data: any = null, error = '';
try {data = await tracker(`profile/${encodeURIComponent(username!)}/${mediaType}`, Astro.locals.token);} catch(e) {error = (e as Error).message;}
const entries = data?.entries || [];
const genres = [...new Set(entries.flatMap((e: any) => e.genres))].sort();
const years = [...new Set(entries.map((e:any)=>e.year).filter(Boolean))].sort().reverse();
const profile = `/user/${encodeURIComponent(username!)}`;
const viewerPrefs = Astro.locals.token ? await tracker('preferences', Astro.locals.token).catch(() => ({default_sort:'title'})) : {default_sort:'title'};
---
<Tracker title={`${username}'s ${isCombined ? 'Movie/Series' : section === 'movies' ? 'Movie' : 'Series'} List`}>
  {data ? <>
    <ProfileHeader profile={{...data.profile,owner:data.owner,following:data.following}} active={section}/>
    <div class="list-shell">
      <button class="mobile-filter-toggle button-secondary" aria-expanded="false" aria-controls="list-filters">Filters & sorting</button>
      <aside class="filters" id="list-filters" aria-label="List filters">
        <label class="filter-search"><Icon name="search"/><input id="list-search" type="search" placeholder="Filter titles" aria-label="Search this list"/></label>
        <h2>Lists</h2><div class="status-filters"><button data-status="all" class="selected">All <span>{entries.length}</span></button>{statuses.map(([s,label])=><button data-status={s}>{label}<span>{entries.filter((e:any)=>e.status===s).length}</span></button>)}</div>
        <h2>Filters</h2><select id="genre-filter" aria-label="Genre"><option value="">All genres</option>{genres.map(g=><option>{g}</option>)}</select>
        <select id="year-filter" aria-label="Release year"><option value="">All years</option>{years.map(y=><option>{y}</option>)}</select>
        <select id="favorite-filter" aria-label="Favorites"><option value="">All entries</option><option value="yes">Favorites only</option></select>
        <h2>Sort</h2><select id="sort-filter" aria-label="Sort list"><option value="title" selected={viewerPrefs.default_sort==='title'}>Title</option><option value="score" selected={viewerPrefs.default_sort==='score'}>Score</option><option value="progress" selected={viewerPrefs.default_sort==='progress'}>Progress</option><option value="updated" selected={viewerPrefs.default_sort==='updated'}>Recently updated</option></select>
        <button class="button-secondary" id="reset-filters">Reset filters</button>
      </aside>
      <div class="list-content"><div class="list-toolbar"><span id="result-count" aria-live="polite">{entries.length} entries</span><span id="progress-feedback" class="sr-only" aria-live="assertive"></span><div class="view-switch" aria-label="List presentation"><button data-view="list" aria-pressed="true" aria-label="Compact list"><Icon name="list"/></button><button data-view="grid" aria-pressed="false" aria-label="Cover grid"><Icon name="grid"/></button></div></div>
      <div id="entry-groups">
      {statuses.map(([status,label]) => {const group = entries.filter((e:any)=>e.status===status); return group.length > 0 && <section class="status-section" data-group={status}><h2>{label} <span>{group.length}</span></h2><div class="entry-table">
        <div class:list={['entry-head',{'combined-row':isCombined}]}><span>Title</span><span>Score</span><span>Progress</span>{isCombined&&<span>Type</span>}</div>
        {group.map((entry:any)=><article class:list={['entry-row',{'combined-row':isCombined}]} data-title={entry.title.toLowerCase()} data-score={entry.score ?? -1} data-progress={entry.progress} data-year={entry.year} data-genres={JSON.stringify(entry.genres)} data-favorite={entry.favorite?'yes':'no'} data-updated={entry.updated_at}>
          <div class="entry-title"><div class="entry-thumbnail" data-preview-src={artwork(entry.poster)}>{artwork(entry.poster) ? <img class="entry-cover" src={artwork(entry.poster)} alt="" loading="lazy"/> : <span class="entry-cover"/>}{data.owner&&<button class="row-menu" data-edit-entry={entry.id} aria-label={`Edit ${entry.title}`}><Icon name="ellipsis"/></button>}</div><a href={`/title/${entry.id}`}>{entry.title}{entry.favorite&&<span class="row-favorite" aria-label="Favorite"><Icon name="heart"/></span>}</a></div>
          <span class="entry-score">{data.owner?<button class="entry-score-button" data-quick-rate-id={entry.id} data-quick-rate-title={entry.title} data-quick-rate-poster={artwork(entry.poster)} data-quick-rate-score={entry.score??''} data-quick-rate-mode={entry.rating_mode??'manual'} aria-label={`Rate ${entry.title}`}><span data-score-label>{scoreLabel(entry.score)}</span></button>:scoreLabel(entry.score)}</span>
          <span class="entry-progress">
            <span data-progress-label>{entry.type==='movie' ? entry.status==='completed'?'Watched':'—' : entry.released_episodes===undefined?entry.progress:(entry.season_position||'—')}</span>
            {data.owner && entry.type==='series' && entry.status==='watching' && entry.released_episodes!==undefined && (entry.progress < entry.released_episodes) && <button class="progress-increment" data-progress-increment={entry.id} data-next-progress={entry.progress+1} aria-label={`Mark the next episode of ${entry.title} watched`} title="Mark next episode watched"><Icon name="plus"/></button>}
            {entry.status==='completed'&&entry.new_seasons>0&&<small class="unwatched-indicator">{entry.new_seasons} new {entry.new_seasons===1?'season':'seasons'}</small>}
          </span>
          {isCombined&&<span class="entry-type">{entry.type==='movie'?'Movie':'Series'}</span>}
        </article>)}
      </div></section>})}
      </div>
      <div id="list-empty" class="empty-state" hidden={entries.length>0}><h2>{entries.length ? 'No matching titles' : 'Every list starts with a story'}</h2><p>{entries.length ? 'Try a different search or filter.' : data.owner ? 'Find a movie or series and add it to your list.' : 'There are no entries in this list yet.'}</p>{data.owner&&<a class="button-primary" href="/browse">Browse titles</a>}</div>
      </div>
    </div><div id="cover-preview" aria-hidden="true" hidden><img alt=""/></div><TrackingEditor/>
  </> : <div class="page-width"><p class="error-message" role="alert">{error}</p></div>}
</Tracker>
<script>
  const preview = document.querySelector<HTMLElement>('#cover-preview');
  const previewImage = preview?.querySelector('img');
  let previewDismissed = false;
  function hidePreview() { if (preview) preview.hidden = true; }
  function showPreview(row: HTMLElement) {
    const thumbnail = row.querySelector<HTMLElement>('.entry-thumbnail');
    const source = thumbnail?.dataset.previewSrc;
    if (!preview || !previewImage || !source || previewDismissed || row.closest('.grid-view') || !matchMedia('(hover:hover) and (min-width:901px)').matches) return;
    const rect = thumbnail!.getBoundingClientRect();
    const width = 174, height = 248, gap = 18;
    previewImage.src = source;
    preview.style.left = `${Math.max(8, Math.min(innerWidth-width-8, rect.left-width-gap >= 8 ? rect.left-width-gap : rect.right+gap))}px`;
    preview.style.top = `${Math.max(8, Math.min(innerHeight-height-8, rect.top-(height-rect.height)/2))}px`;
    preview.hidden = false;
  }
  document.querySelectorAll<HTMLElement>('.entry-row').forEach(row => {
    row.addEventListener('pointerenter',()=>{previewDismissed=false;showPreview(row);});
    row.addEventListener('pointerleave',hidePreview);
    row.addEventListener('focusin',()=>{previewDismissed=false;showPreview(row);});
    row.addEventListener('focusout',hidePreview);
    row.addEventListener('click',hidePreview);
  });
  previewImage?.addEventListener('error',hidePreview);
  document.addEventListener('keydown',event=>{if(event.key==='Escape'){previewDismissed=true;hidePreview();}});
  window.addEventListener('scroll',hidePreview,true);
  window.addEventListener('resize',hidePreview);
  const groups = document.querySelector('#entry-groups');
  document.querySelectorAll<HTMLButtonElement>('[data-progress-increment]').forEach(button=>button.addEventListener('click',async()=>{
    const previousLabel=button.closest('.entry-progress')?.querySelector<HTMLElement>('[data-progress-label]')?.textContent;
    button.disabled=true;
    try {
      const response=await fetch(`/api/proxy/tracking/entry/${button.dataset.progressIncrement}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({progress:Number(button.dataset.nextProgress)})});
      if(!response.ok) throw new Error((await response.json().catch(()=>null))?.detail||'Could not update episode progress.');
      location.reload();
    } catch(error) {
      button.disabled=false;
      button.title=error instanceof Error?error.message:'Could not update episode progress.';
      button.setAttribute('aria-label',`${button.title} Try again`);
      document.querySelector('#progress-feedback')!.textContent=button.title;
      const label=button.closest('.entry-progress')?.querySelector<HTMLElement>('[data-progress-label]');
      if(label&&previousLabel) label.textContent=previousLabel;
    }
  }));
  if (groups) {
    let status = 'all';
    const input = (id:string) => document.getElementById(id) as HTMLInputElement;
    function filter() {
      hidePreview();
      let count = 0;
      const query = input('list-search').value.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>('[data-group]').forEach(group=> {
        const table = group.querySelector('.entry-table')!;
        const rows = Array.from(group.querySelectorAll<HTMLElement>('.entry-row'));
        const sort = input('sort-filter').value;
        rows.sort((a,b)=>sort==='title' ? a.dataset.title!.localeCompare(b.dataset.title!) : sort==='updated' ? b.dataset.updated!.localeCompare(a.dataset.updated!) : Number(b.dataset[sort]) - Number(a.dataset[sort]));
        let visible = 0;
        rows.forEach(row=> {
          table.append(row);
          row.hidden = (status !== 'all' && status!==group.dataset.group) || !row.dataset.title!.includes(query) || !!(input('genre-filter').value && !JSON.parse(row.dataset.genres!).includes(input('genre-filter').value)) || !!(input('year-filter').value && row.dataset.year!==input('year-filter').value) || !!(input('favorite-filter').value && row.dataset.favorite!=='yes');
          if (!row.hidden) visible++;
        });
        group.hidden = visible===0;
        group.querySelector('h2 span')!.textContent = String(visible);
        count+=visible;
      });
      document.querySelector('#result-count')!.textContent=`${count} entries`;
      (document.querySelector('#list-empty') as HTMLElement).hidden=count>0;
    }
    document.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(button=>button.addEventListener('click',()=>{status=button.dataset.status!;document.querySelectorAll('[data-status]').forEach(b=>b.classList.toggle('selected',b===button));filter();}));
    ['list-search','genre-filter','year-filter','sort-filter','favorite-filter'].forEach(id=>input(id).addEventListener('input',filter));
    document.querySelector('#reset-filters')!.addEventListener('click',()=>{['list-search','genre-filter','year-filter','favorite-filter'].forEach(id=>input(id).value='');input('sort-filter').value='title';document.querySelector<HTMLButtonElement>('[data-status=all]')!.click();});
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button=>button.addEventListener('click',()=>{hidePreview();groups.classList.toggle('grid-view',button.dataset.view==='grid');document.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
    document.querySelector('.mobile-filter-toggle')!.addEventListener('click',event=>{const open=document.querySelector('#list-filters')!.classList.toggle('open');(event.currentTarget as HTMLElement).setAttribute('aria-expanded',String(open));});
    document.addEventListener('media-tracker:rating-changed', filter);
    filter();
  }
</script>
