---
import Tracker from '../../../layouts/Tracker.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import Icon from '../../../components/Icon.astro';
import {tracker, statuses, scoreLabel} from '../../../lib/tracker';
import {responsiveArtwork} from '../../../lib/responsive-artwork';
const {username, section} = Astro.params;
if (!['movies','series','list'].includes(section!)) return Astro.redirect('/404');
const isCombined=section==='list';
const mediaType = isCombined ? 'all' : section === 'movies' ? 'movie' : 'series';
let data: any = null, error = '';
try {data = await tracker(`profile/${encodeURIComponent(username!)}/${mediaType}`, Astro.locals.token);} catch(e) {error = (e as Error).message;}
const profile = `/user/${encodeURIComponent(username!)}`;
const viewerPrefs = Astro.locals.token ? await tracker('preferences', Astro.locals.token).catch(() => ({default_sort:'title'})) : {default_sort:'title'};
const defaultSort = ['title','score','progress','updated'].includes(viewerPrefs.default_sort) ? viewerPrefs.default_sort : 'title';
const entries = [...(data?.entries || [])].sort((a:any,b:any) => defaultSort === 'title'
  ? a.title.toLowerCase().localeCompare(b.title.toLowerCase())
  : defaultSort === 'updated'
    ? String(b.updated_at || '').localeCompare(String(a.updated_at || ''))
    : Number(b[defaultSort] ?? -1) - Number(a[defaultSort] ?? -1));
const genres = [...new Set(entries.flatMap((e: any) => e.genres))].sort();
const years = [...new Set(entries.map((e:any)=>e.year).filter(Boolean).map(String))].sort();
const requestedStatus=Astro.url.searchParams.get('status')||'all';
const initialStatus=['all',...statuses.map(([value])=>value)].includes(requestedStatus)?requestedStatus:'all';
const today = new Date().toISOString().slice(0, 10);
const canIncrement = (entry: any) => entry.type === 'movie'
  ? entry.progress < 1 && (!entry.release_date || entry.release_date.slice(0, 10) <= today)
  : entry.released_episodes !== undefined && entry.progress < entry.released_episodes;
const compactImageSizes='(max-width:650px) 32px, 42px';
const quickRatePoster=(path:any)=>responsiveArtwork(path,{size:'w185',sizes:'42px',route:'direct'})?.src || '';
const availabilityLabel=(reason:string|undefined)=>reason==='airing'?'Currently airing':'New season available';
const rewatchLabel=(count:number)=>`${count} ${count===1?'rewatch':'rewatches'}`;
---
<Tracker title={`${username}'s ${isCombined ? 'Movie/Series' : section === 'movies' ? 'Movie' : 'Series'} List`} listLanding={!!data} ownerProfileColor={data?.profile?.profile_color} ownerIsViewer={data?.owner === true}>
  {data ? <>
    <ProfileHeader profile={{...data.profile,owner:data.owner,following:data.following,follows_you:data.follows_you,combine_lists:data.combine_lists}} active={section}/>
    <div class="list-shell" data-initial-status={initialStatus}>
      <button class="mobile-filter-toggle button-secondary" aria-expanded="false" aria-controls="list-filters"><Icon name="sliders"/> <span>Filters & sorting</span><span id="mobile-filter-count" class="filter-count" hidden>0</span></button>
      <aside class="filters" id="list-filters" aria-label="List filters">
        <div class="mobile-filter-heading"><strong>Filters & sorting</strong><button type="button" class="button-quiet" data-close-filters aria-label="Close filters"><Icon name="close"/></button></div>
        <label class="filter-search"><Icon name="search"/><input id="list-search" type="search" placeholder="Filter titles" aria-label="Search this list"/></label>
        <h2>Lists</h2><div class="status-filters"><button data-status="all" class:list={{selected:initialStatus==='all'}}>All <span>{entries.length}</span></button>{statuses.map(([s,label])=><button data-status={s} class:list={{selected:initialStatus===s}}>{label}<span>{entries.filter((e:any)=>e.status===s).length}</span></button>)}</div>
        <h2>Filters</h2>
        <label class="filter-control"><span>Genre</span><select id="genre-filter"><option value="">All genres</option>{genres.map(g=><option>{g}</option>)}</select></label>
        <label class="filter-year filter-control"><span class="filter-year-heading"><span>Year</span><output id="year-value" for="year-filter">Any year</output></span><input id="year-filter" type="range" min="0" max={years.length} step="1" value="0" data-years={JSON.stringify(years)} aria-label="Release year" aria-valuetext="Any year" disabled={years.length===0}/></label>
        <label class="filter-control"><span>Favorites</span><select id="favorite-filter"><option value="">All entries</option><option value="yes">Favorites only</option></select></label>
        <h2>Sort</h2><label class="filter-control"><span>Order</span><select id="sort-filter"><option value="title" selected={defaultSort==='title'}>Title</option><option value="score" selected={defaultSort==='score'}>Score</option><option value="progress" selected={defaultSort==='progress'}>Progress</option><option value="updated" selected={defaultSort==='updated'}>Recently updated</option></select></label>
        <button class="button-secondary" id="reset-filters" data-default-sort={defaultSort}>Reset filters</button>
      </aside>
      <div class="list-content">
      <div class="list-toolbar"><span id="result-count" class="sr-only" aria-live="polite">{entries.length} entries</span><span id="progress-feedback" class="sr-only" aria-live="assertive"></span><div class="view-switch" aria-label="List presentation"><button data-view="list" aria-pressed="true" aria-label="Compact list"><Icon name="list"/></button><button data-view="grid" aria-pressed="false" aria-label="Cover grid"><Icon name="grid"/></button></div></div>
      <div id="entry-groups">
      {statuses.map(([status,label]) => {const group = entries.filter((e:any)=>e.status===status); return <section class="status-section" data-group={status} hidden={group.length===0 || initialStatus !== 'all' && initialStatus !== status}><h2>{label}</h2><div class="entry-table">
        <div class:list={['entry-head',{'combined-row':isCombined}]}><span class="entry-cover-column" aria-hidden="true"></span><span class="entry-title-column">Title</span><span>Score</span><span>Progress</span>{isCombined&&<span>Type</span>}</div>
        {group.map((entry:any)=><article class:list={['entry-row',{'combined-row':isCombined}]} data-title={entry.title.toLowerCase()} data-score={entry.score ?? -1} data-progress={entry.progress} data-media-type={entry.type} data-year={entry.year} data-genres={JSON.stringify(entry.genres)} data-favorite={entry.favorite?'yes':'no'} data-updated={entry.updated_at}>
          <div class="entry-thumbnail" data-preview-src={entry.poster||undefined} data-artwork-path={entry.poster||undefined}><span class="entry-availability" role="img" aria-label={availabilityLabel(entry.availability_reason)} title={availabilityLabel(entry.availability_reason)} hidden={!entry.availability_dot}></span>{(() => {const image=responsiveArtwork(entry.poster,{size:'w342',sizes:compactImageSizes,route:'direct'}); return image?.src ? <img class="entry-cover" src={image.src} srcset={image.srcset} sizes={image.sizes} alt="" loading="lazy"/> : <span class="entry-cover"/>})()}{data.owner&&<button class="row-menu" data-edit-entry={entry.id} aria-label={`Edit ${entry.title}`}><Icon name="ellipsis"/></button>}</div><div class="entry-title"><a class="entry-title-link" href={`/title/${entry.id}`}>{entry.title}{entry.favorite&&<span class="row-favorite" aria-label="Favorite"><Icon name="heart"/></span>}</a>{entry.rewatch_count>0&&<span class="entry-rewatch" role="img" tabindex="0" aria-label={rewatchLabel(entry.rewatch_count)} data-rewatch-label={rewatchLabel(entry.rewatch_count)}><Icon name="arrows-rotate"/></span>}</div>
          <span class="entry-score">{data.owner?<button class="entry-score-button" data-quick-rate-id={entry.id} data-quick-rate-title={entry.title} data-quick-rate-poster={quickRatePoster(entry.poster)} data-quick-rate-score={entry.score??''} data-quick-rate-mode={entry.rating_mode??'manual'} aria-label={`Rate ${entry.title}`}><span data-score-label>{scoreLabel(entry.score)}</span></button>:scoreLabel(entry.score)}</span>
          <span class="entry-progress">
            <span data-progress-label>{entry.type==='movie' ? entry.progress : entry.released_episodes===undefined?entry.progress:(entry.season_position||'—')}</span>
            {data.owner && canIncrement(entry) && <button type="button" class="progress-increment" data-progress-increment={entry.id} data-next-progress={entry.type==='movie'?1:entry.progress+1} aria-label={entry.type==='movie'?`Mark ${entry.title} watched`:`Mark the next episode of ${entry.title} watched`} title={entry.type==='movie'?'Mark movie watched':'Mark next episode watched'}>+</button>}
            {entry.status==='completed'&&entry.new_seasons>0&&<small class="unwatched-indicator">{entry.new_seasons} new {entry.new_seasons===1?'season':'seasons'}</small>}
          </span>
          {isCombined&&<span class="entry-type">{entry.type==='movie'?'Movie':'Series'}</span>}
        </article>)}
      </div></section>})}
      </div>
      <div id="list-empty" class="empty-state" hidden={entries.length>0}><h2>{entries.length ? 'No matching titles' : 'Every list starts with a story'}</h2><p>{entries.length ? 'Try a different search or filter.' : data.owner ? 'Find a movie or series and add it to your list.' : 'There are no entries in this list yet.'}</p>{data.owner&&<a class="button-primary" href="/browse">Browse titles</a>}</div>
      </div>
    </div><div id="cover-preview" aria-hidden="true" hidden><img alt=""/></div><script id="list-editor-entries" type="application/json" set:html={JSON.stringify(entries).replace(/</g, '\\u003c')}></script>
    <script is:inline data-astro-rerun>
      (() => {
        const tabs = document.querySelector('.profile-tabs');
        if (tabs) window.scrollTo(0, window.scrollY + tabs.getBoundingClientRect().top);
      })();
    </script>
  </> : <div class="page-width"><p class="error-message" role="alert">{error}</p></div>}
</Tracker>
<script>
import {applyResponsiveArtwork} from '../../../lib/responsive-artwork';
import {reveal,dismiss} from '../../../lib/ui-motion';
let pageListeners: AbortController;
document.addEventListener('astro:page-load', () => {
  pageListeners?.abort();
  pageListeners = new AbortController();
  if (!document.querySelector('#entry-groups')) return;
  const preview = document.querySelector<HTMLElement>('#cover-preview');
  const previewImage = preview?.querySelector<HTMLImageElement>('img');
  const compactImageOptions={size:'w342',sizes:'(max-width:650px) 32px, 42px',route:'direct' as const};
  const gridImageOptions={size:'w342',sizes:'(max-width:650px) calc((100vw - 54px) / 2), (max-width:900px) 180px, 215px',route:'direct' as const};
  const updateEntryImages=(grid:boolean) => document.querySelectorAll<HTMLElement>('.entry-thumbnail').forEach(thumbnail => {
    const image=thumbnail.querySelector<HTMLImageElement>('.entry-cover');
    const source=thumbnail.dataset.artworkPath;
    if(image && source) applyResponsiveArtwork(image,source,grid?gridImageOptions:compactImageOptions);
  });
  let previewDismissed = false;
  function syncAvailability(row: HTMLElement, updated: any) {
    const indicator = row.querySelector<HTMLElement>('.entry-availability');
    if (!indicator) return;
    const label = updated.availability_reason === 'airing' ? 'Currently airing' : 'New season available';
    indicator.hidden = updated.availability_dot !== true;
    indicator.title = label;
    indicator.setAttribute('aria-label', label);
  }
  function hidePreview() { if (preview) preview.hidden = true; }
  function showPreview(row: HTMLElement) {
    const thumbnail = row.querySelector<HTMLElement>('.entry-thumbnail');
    const source = thumbnail?.dataset.previewSrc;
    if (!preview || !previewImage || !source || previewDismissed || row.closest('.grid-view') || !matchMedia('(hover:hover) and (min-width:901px)').matches) return;
    const rect = thumbnail!.getBoundingClientRect();
    const width = 174, height = 248, gap = 18;
    applyResponsiveArtwork(previewImage,source,{size:'w500',sizes:'174px',route:'direct'});
    preview.style.left = `${Math.max(8, Math.min(innerWidth-width-8, rect.left-width-gap >= 8 ? rect.left-width-gap : rect.right+gap))}px`;
    preview.style.top = `${Math.max(8, Math.min(innerHeight-height-8, rect.top-(height-rect.height)/2))}px`;
    preview.hidden = false;
    reveal(preview);
  }
  document.querySelectorAll<HTMLElement>('.entry-row').forEach(row => {
    row.addEventListener('pointerenter',()=>{previewDismissed=false;showPreview(row);});
    row.addEventListener('pointerleave',()=>{
      hidePreview();
      if (!document.querySelector<HTMLDialogElement>('#tracking-editor')?.open) delete row.dataset.editorDeselected;
    });
    row.addEventListener('focusin',()=>{previewDismissed=false;showPreview(row);});
    row.addEventListener('focusout',hidePreview);
    row.addEventListener('click',hidePreview);
  });
  previewImage?.addEventListener('error',hidePreview);
  document.addEventListener('keydown',event=>{if(event.key==='Escape'){previewDismissed=true;hidePreview();}},{signal:pageListeners.signal});
  window.addEventListener('scroll',hidePreview,{capture:true,signal:pageListeners.signal});
  window.addEventListener('resize',hidePreview,{signal:pageListeners.signal});
  const groups = document.querySelector('#entry-groups');
  let refreshList = () => {};
  document.querySelectorAll<HTMLButtonElement>('[data-progress-increment]').forEach(button=>button.addEventListener('click',async()=>{
    const row=button.closest<HTMLElement>('.entry-row')!;
    button.dataset.defaultTitle ||= button.title;
    button.dataset.defaultLabel ||= button.getAttribute('aria-label') || '';
    button.disabled=true;
    try {
      const response=await fetch(`/api/proxy/tracking/entry/${button.dataset.progressIncrement}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({progress:Number(button.dataset.nextProgress)})});
      if(!response.ok) throw new Error((await response.json().catch(()=>null))?.detail||'Could not update episode progress.');
      const updated=await response.json();
      row.dataset.progress=String(updated.progress);
      row.dataset.updated=updated.updated_at||new Date().toISOString();
      syncAvailability(row, updated);
      const label=row.querySelector<HTMLElement>('[data-progress-label]')!;
      label.textContent=row.dataset.mediaType==='movie'?String(updated.progress):(updated.season_position||'—');
      const indicator=row.querySelector<HTMLElement>('.unwatched-indicator');
      if(indicator) indicator.remove();
      if(updated.status==='completed'&&updated.new_seasons>0){
        const notice=document.createElement('small');notice.className='unwatched-indicator';
        notice.textContent=`${updated.new_seasons} new ${updated.new_seasons===1?'season':'seasons'}`;
        row.querySelector('.entry-progress')!.append(notice);
      }
      if(row.closest<HTMLElement>('[data-group]')?.dataset.group!==updated.status){
        groups?.querySelector<HTMLElement>(`[data-group="${updated.status}"] .entry-table`)?.append(row);
      }
      if(row.dataset.mediaType==='movie'||updated.progress>=updated.released_episodes) button.remove();
      else {button.dataset.nextProgress=String(updated.progress+1);button.disabled=false;}
      button.title=button.dataset.defaultTitle || '';
      button.setAttribute('aria-label',button.dataset.defaultLabel || '');
      document.dispatchEvent(new CustomEvent('anylist:data-changed'));
      refreshList();
      document.querySelector('#progress-feedback')!.textContent=button.title;
    } catch(error) {
      button.disabled=false;
      button.title=error instanceof Error?error.message:'Could not update episode progress.';
      button.setAttribute('aria-label',`${button.title} Try again`);
      document.querySelector('#progress-feedback')!.textContent=button.title;
    }
  }));
  if (groups) {
    let status = document.querySelector<HTMLElement>('.list-shell')?.dataset.initialStatus || 'all';
    const input = (id:string) => document.getElementById(id) as HTMLInputElement;
    const resetButton=document.querySelector<HTMLButtonElement>('#reset-filters')!;
    const defaultSort=resetButton.dataset.defaultSort||'title';
    const mobileCount=document.querySelector<HTMLElement>('#mobile-filter-count')!;
    const yearSlider=input('year-filter');
    const yearOutput=document.querySelector<HTMLOutputElement>('#year-value')!;
    const availableYears=JSON.parse(yearSlider.dataset.years||'[]') as string[];
    function selectedYear(){const position=Number(yearSlider.value);return position>0?availableYears[position-1]:'';}
    function updateFilterControls() {
      const position=Number(yearSlider.value);
      const yearLabel=position>0?availableYears[position-1]:'Any year';
      yearOutput.value=yearLabel;
      yearOutput.textContent=yearLabel;
      yearSlider.setAttribute('aria-valuetext',yearLabel);
      const active=[status!=='all',input('list-search').value.trim()!=='',input('genre-filter').value!=='',selectedYear()!=='',input('favorite-filter').value!=='',input('sort-filter').value!==defaultSort].filter(Boolean).length;
      mobileCount.textContent=String(active);
      mobileCount.hidden=active===0;
      resetButton.disabled=active===0;
      document.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.status===status)));
    }
    function filter() {
      hidePreview();
      let count = 0;
      const query = input('list-search').value.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>('[data-group]').forEach(group=> {
        const table = group.querySelector('.entry-table')!;
        const rows = Array.from(group.querySelectorAll<HTMLElement>('.entry-row'));
        const sort = input('sort-filter').value;
        rows.sort((a,b)=>sort==='title' ? a.dataset.title!.localeCompare(b.dataset.title!) : sort==='updated' ? b.dataset.updated!.localeCompare(a.dataset.updated!) : Number(b.dataset[sort]) - Number(a.dataset[sort]));
        let visible = 0;
        rows.forEach(row=> {
          table.append(row);
          row.hidden = (status !== 'all' && status!==group.dataset.group) || !row.dataset.title!.includes(query) || !!(input('genre-filter').value && !JSON.parse(row.dataset.genres!).includes(input('genre-filter').value)) || !!(selectedYear() && row.dataset.year!==selectedYear()) || !!(input('favorite-filter').value && row.dataset.favorite!=='yes');
          if (!row.hidden) visible++;
        });
        group.hidden = visible===0;
        count+=visible;
      });
      document.querySelector('#result-count')!.textContent=`${count} entries`;
      (document.querySelector('#list-empty') as HTMLElement).hidden=count>0;
      document.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(button=>{
        const total=button.dataset.status==='all'?document.querySelectorAll('.entry-row').length:groups.querySelectorAll(`[data-group="${button.dataset.status}"] .entry-row`).length;
        button.querySelector('span')!.textContent=String(total);
      });
      updateFilterControls();
    }
    refreshList=filter;
    document.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(button=>button.addEventListener('click',()=>{status=button.dataset.status!;document.querySelectorAll('[data-status]').forEach(b=>b.classList.toggle('selected',b===button));filter();}));
    ['list-search','genre-filter','year-filter','sort-filter','favorite-filter'].forEach(id=>input(id).addEventListener('input',filter));
    resetButton.addEventListener('click',()=>{['list-search','genre-filter','favorite-filter'].forEach(id=>input(id).value='');yearSlider.value='0';input('sort-filter').value=defaultSort;document.querySelector<HTMLButtonElement>('[data-status=all]')!.click();});
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button=>button.addEventListener('click',()=>{hidePreview();const grid=button.dataset.view==='grid';groups.classList.toggle('grid-view',grid);updateEntryImages(grid);document.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
    const mobileToggle=document.querySelector<HTMLButtonElement>('.mobile-filter-toggle')!;
    const filters=document.querySelector<HTMLElement>('#list-filters')!;
    function setFiltersOpen(open:boolean){
      mobileToggle.setAttribute('aria-expanded',String(open));
      if(open){filters.classList.add('open');reveal(filters);input('list-search').focus();}
      else{void dismiss(filters).then(current=>{if(current)filters.classList.remove('open');});mobileToggle.focus();}
    }
    mobileToggle.addEventListener('click',()=>setFiltersOpen(mobileToggle.getAttribute('aria-expanded')!=='true'));
    document.querySelector('[data-close-filters]')!.addEventListener('click',()=>setFiltersOpen(false));
    document.addEventListener('keydown',event=>{if(event.key==='Escape'&&filters.classList.contains('open'))setFiltersOpen(false);},{signal:pageListeners.signal});
    document.addEventListener('media-tracker:rating-changed', filter,{signal:pageListeners.signal});
    updateEntryImages(groups.classList.contains('grid-view'));
    filter();
    document.body.setAttribute('data-list-ready', '');
  }
});
</script>
