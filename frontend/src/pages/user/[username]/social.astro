---
import Tracker from '../../../layouts/Tracker.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import {tracker} from '../../../lib/tracker';
import {plainBioExcerpt} from '../../../lib/profile-markdown';
const username=Astro.params.username!;
let profile:any=null,error='',results:any[]=[];
const query=Astro.url.searchParams.get('q')?.trim()||'';
try{
  profile=await tracker(`people/${encodeURIComponent(username)}`,Astro.locals.token);
  if(Astro.locals.user&&query)results=(await tracker(`people-search?q=${encodeURIComponent(query)}`,Astro.locals.token)).results;
}catch(e){error=(e as Error).message;}
const following=(profile?.people||[]).filter((person:any)=>person.following);
const followers=(profile?.people||[]).filter((person:any)=>person.follower);
---
<Tracker title={`${profile?.display_name||username} · Social`}>
{profile?<><ProfileHeader profile={profile} active="social"/><div class="page-width">
  <header class="page-intro"><div><span class="eyebrow">One-way following</span><h1>Social</h1><p>Find public profiles and choose whose activity and ratings you want to see.</p></div></header>
  {Astro.locals.user&&<form class="people-search" method="get"><input type="search" name="q" value={query} placeholder="Search public profiles" aria-label="Search public profiles"/><button class="button-primary">Search</button></form>}
  {query&&<section><h2>Search results</h2>{results.length?<div class="people-list">{results.map((person:any)=><article class="person-row">
    {person.has_avatar?<img class="person-avatar" src={`/api/proxy/profile/avatar/${person.id}`} alt=""/>:<span class="person-avatar" aria-hidden="true">{person.display_name[0].toUpperCase()}</span>}
    <a class="person-copy" href={`/user/${encodeURIComponent(person.username)}`}><strong>{person.display_name}</strong><span>@{person.username}{person.bio&&` · ${plainBioExcerpt(person.bio)}`}</span></a>
    {!person.owner&&<button class={person.following?'button-secondary':'button-primary'} data-follow={person.username} data-active={person.following?'yes':'no'}>{person.following?'Following':'Follow'}</button>}
  </article>)}</div>:<p class="section-empty">No public profiles match that search.</p>}</section>}
  <div class="social-columns"><section><h2>Following <span class="count-pill">{profile.counts.following}</span></h2>{following.length?<div class="people-list">{following.map((person:any)=><a class="person-row" href={`/user/${encodeURIComponent(person.username)}`}><span class="person-avatar" aria-hidden="true">{person.display_name[0].toUpperCase()}</span><span class="person-copy"><strong>{person.display_name}</strong><span>@{person.username}</span></span></a>)}</div>:<p class="section-empty">No public profiles followed yet.</p>}</section>
  <section><h2>Followers <span class="count-pill">{profile.counts.followers}</span></h2>{followers.length?<div class="people-list">{followers.map((person:any)=><a class="person-row" href={`/user/${encodeURIComponent(person.username)}`}><span class="person-avatar" aria-hidden="true">{person.display_name[0].toUpperCase()}</span><span class="person-copy"><strong>{person.display_name}</strong><span>@{person.username}</span></span></a>)}</div>:<p class="section-empty">No public followers to show.</p>}</section></div>
</div></>:<div class="page-width"><p class="error-message">{error}</p></div>}
</Tracker>
<script>
document.addEventListener('astro:page-load', () => {
document.querySelectorAll<HTMLButtonElement>('[data-follow]').forEach(button=>button.addEventListener('click',async()=>{
 button.disabled=true;const active=button.dataset.active==='yes';
 try{const response=await fetch(`/api/proxy/tracking/people/${encodeURIComponent(button.dataset.follow!)}/follow`,{method:active?'DELETE':'POST'});if(!response.ok)throw new Error();location.reload();}
 catch{button.textContent='Try again';button.disabled=false;}
}));
});
</script>
