---
import Tracker from '../../../layouts/Tracker.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import {tracker} from '../../../lib/tracker';
import {responsiveArtwork} from '../../../lib/responsive-artwork';
if(Astro.locals.user?.username!==Astro.params.username)return Astro.redirect('/login');
let profile:any=null,entries:any[]=[],error='';
try{[profile,{results:entries}]=await Promise.all([tracker(`people/${encodeURIComponent(Astro.params.username!)}`,Astro.locals.token),tracker('library',Astro.locals.token)]);}catch(e){error=(e as Error).message;}
---
<Tracker title="Library">{profile&&<ProfileHeader profile={profile} active="library"/>}<div class="page-width"><h1>Your streaming library</h1><p>Library membership is separate from your movie and series lists. Only you can see this tab.</p>
{error?<p class="error-message">{error}</p>:entries.length?<div class="card-grid">{entries.map(m=>{const image=responsiveArtwork(m.poster,{size:'w342',sizes:'(max-width:650px) calc((100vw - 57px) / 2), 190px',route:'direct'});return <a class="media-card" href={`/title/${m.id}`}>{image?.src&&<img src={image.src} srcset={image.srcset} sizes={image.sizes} alt="" loading="lazy"/>}<h2>{m.title}</h2><small>{m.type==='movie'?'Movie':'Series'}</small></a>})}</div>:<div class="empty-state"><h2>Your library is empty</h2><p>Add a movie or series from its title page.</p><a class="button-primary" href="/browse">Browse titles</a></div>}</div></Tracker>
