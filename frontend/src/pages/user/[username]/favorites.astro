---
import FavoriteCard from "../../../components/FavoriteCard.astro";
import Tracker from '../../../layouts/Tracker.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import {tracker,trackerFailure} from '../../../lib/tracker';
import {profileMediaGroups} from '../../../lib/profile-media-groups';
import {viewerMediaPreferences} from '../../../lib/viewer-media-preferences';
import '../../../styles/profile-overview.css';
import '../../../styles/favorites-page.css';

type Favorite = {id:number;type:string;title:string;poster:string|null};
const screenPageSize = 30;
let profile: any = null, error = '',favoriteGames:{items:Favorite[];total:number}|null=null,screenFavorites:Favorite[]=[];
Astro.response.headers.set('Cache-Control','private, no-store');
const preferences=await viewerMediaPreferences(Astro.locals);
const requestedPage=Number(Astro.url.searchParams.get('page')||1);
const page=Number.isSafeInteger(requestedPage)&&requestedPage>0&&requestedPage<=100000?requestedPage:1;
try {
  const query = new URLSearchParams({show_screen:String(preferences.show_movies_series),show_games:String(preferences.show_games),game_offset:String((page-1)*50)});
  const favorites = await tracker(`people/${encodeURIComponent(Astro.params.username!)}/favorites?${query}`, Astro.locals.token);
  profile = favorites.profile;
  screenFavorites = favorites.screen;
  favoriteGames = favorites.games;
  if(favoriteGames){
    const last=Math.max(1,Math.ceil(favoriteGames.total/50));
    if(page>last)return Astro.redirect(`${Astro.url.pathname}?page=${last}#game-favorites`);
  }
} catch (cause) {
  const failure=trackerFailure(cause);error=failure.message;
  profile=null;Astro.response.status=failure.status;
}
const favorites=[...screenFavorites,...(favoriteGames?.items||[])];
const gamePages = Math.ceil((favoriteGames?.total ?? 0) / 50);
const favoriteGroups = profileMediaGroups(favorites, profile?.combine_lists !== false);
const showAll = Astro.url.searchParams.get('all') === '1';
const allUrl = new URL(Astro.url);allUrl.searchParams.set('all','1');
const remaining = Object.fromEntries(favoriteGroups.filter(group=>!showAll&&group.type!=='game'&&group.items.length>screenPageSize)
  .map(group=>[group.type,group.items.slice(screenPageSize)]));

---
<Tracker title={`${profile?.display_name ?? 'Profile'} Favorites`} ownerProfileColor={profile?.profile_color} ownerIsViewer={profile?.owner === true}>
  {profile ? <>
    <ProfileHeader profile={profile} active="favorites" />
    <div class="page-width favorites-page" data-profile-tab-content data-profile-owner={String(profile.owner === true)} data-favorite-domain="mixed" data-favorites-owner={String(profile.owner)}>
      {Object.keys(remaining).length>0&&<>
        <script type="application/json" data-favorites-remaining set:html={JSON.stringify(remaining).replaceAll('<','\\u003c')} />
        <template data-favorites-card-template><FavoriteCard item={{id:0,type:'movie',title:'',poster:null}} owner={profile.owner} /></template>
      </>}

      <p class="error-message" role="alert" data-favorites-error hidden={!error}>{error}</p>
      <p class="favorites-instructions" data-favorites-instructions hidden>Drag cards to arrange them. Focus a card and use the arrow keys to move it.</p>
      <span class="sr-only" aria-live="polite" data-favorites-feedback></span>
      <div class="favorites-groups" data-favorites-grid hidden={favorites.length === 0}>
        {favoriteGroups.map((group, index) => <section class="favorites-group" data-favorites-group={group.type} id={group.type==='game'?'game-favorites':undefined}>
          <div class="favorites-group-heading">
            <h2 class="favorites-group-title">{group.heading}</h2>
            {profile.owner && index === 0 && <div class="favorites-actions" hidden={favorites.length === 0}>
              <button type="button" class="button-secondary favorites-cancel" data-favorites-cancel hidden>Cancel</button>
              <button type="button" class="button-primary favorites-reorder" data-favorites-reorder>Reorder</button>
            </div>}
          </div>
          <div class="favorite-posters favorites-grid">
        {(showAll||group.type==='game'?group.items:group.items.slice(0,screenPageSize)).map(item => <FavoriteCard item={item} owner={profile.owner}/>)}
          </div>
          {remaining[group.type]&&<a href={allUrl.pathname+allUrl.search} class="button-secondary favorites-more" data-favorites-more={screenPageSize} aria-label={`Show more ${group.heading} favorites`}>Show more</a>}
        </section>)}
      </div>
      <div class="empty-state" data-favorites-empty hidden={favorites.length > 0||!!error}>
        <h2>No favorites yet</h2>
        <p>{profile.owner ? 'Mark a title as a favorite to see it here.' : `${profile.display_name} has not added any favorites.`}</p>
        {profile.owner && <a class="button-primary" href="/browse">Browse titles</a>}
      </div>
      {gamePages>1&&<nav class="game-list-pagination" aria-label="Favorite games pages">{page>1?<a class="button-secondary" href={`${Astro.url.pathname}?page=${page-1}#game-favorites`} rel="prev">Previous</a>:<span/>}<span>Page {page} of {gamePages}</span>{page<gamePages?<a class="button-secondary" href={`${Astro.url.pathname}?page=${page+1}#game-favorites`} rel="next">Next</a>:<span/>}</nav>}
    </div>
  </> : <div class="page-width"><p class="error-message" role="alert">{error}</p></div>}
</Tracker>
<script>
import {favoriteKey,favoriteOrderChanges,favoriteOrderSaved} from '../../../lib/favorite-order';
import {showActionFailure} from '../../../lib/action-failure';
import {editorStore,type EditorTitle} from '../../../lib/editor-store';
import {responsiveArtwork} from '../../../lib/responsive-artwork';
import {trackedWorkHref} from '../../../lib/tracker';
type Favorite = {id:number;type:string;title:string;poster:string|null};
let favoritePageListeners: AbortController;
function mountFavorites() {
  favoritePageListeners?.abort();
  favoritePageListeners = new AbortController();
  const page = document.querySelector<HTMLElement>('.favorites-page');
  const grid = page?.querySelector<HTMLElement>('[data-favorites-grid]');
  if (!page || !grid) return;
  const cardKey=(card:HTMLElement)=>favoriteKey(card.dataset.favoriteType,card.dataset.mediaId);
  const reorder = page.querySelector<HTMLButtonElement>('[data-favorites-reorder]');
  const cancel = page.querySelector<HTMLButtonElement>('[data-favorites-cancel]');
  const actions = page.querySelector<HTMLElement>('.favorites-actions');
  const instructions = page.querySelector<HTMLElement>('[data-favorites-instructions]')!;
  const error = page.querySelector<HTMLElement>('[data-favorites-error]')!;
  const feedback = page.querySelector<HTMLElement>('[data-favorites-feedback]')!;
  let savedOrder = [...grid.querySelectorAll<HTMLElement>('[data-favorite-card]')].map(cardKey);
  let dragging: HTMLElement | null = null;
  let refreshFavorites = () => {};
  const cards = () => [...grid.querySelectorAll<HTMLElement>('[data-favorite-card]')];
  const order = () => cards().map(cardKey);
  const groups = [...grid.querySelectorAll<HTMLElement>('[data-favorites-group]')];
  const remaining = JSON.parse(page.querySelector('[data-favorites-remaining]')?.textContent || '{}') as Record<string, Favorite[]>;
  const cardTemplate = page.querySelector<HTMLTemplateElement>('[data-favorites-card-template]');
  function createCard(item: Favorite) {
    const card = cardTemplate!.content.firstElementChild!.cloneNode(true) as HTMLElement;
    card.dataset.mediaId = String(item.id);
    card.dataset.favoriteType = item.type;
    card.dataset.title = item.title;
    const link = card.querySelector<HTMLAnchorElement>('.favorite-poster')!;
    link.href = trackedWorkHref(item);
    link.title = item.title;
    link.setAttribute('aria-label', item.title);
    const image = responsiveArtwork(item.poster, {size:'w342',sizes:'(max-width:650px) 30vw, 150px',route:'direct'});
    if (image) {
      const poster = document.createElement('img');
      poster.alt = '';
      poster.loading = 'lazy';
      if (image.srcset) poster.srcset = image.srcset;
      if (image.sizes) poster.sizes = image.sizes;
      poster.src = image.src;
      link.replaceChildren(poster);
    }
    const remove = card.querySelector<HTMLButtonElement>('[data-favorite-remove]');
    if (remove) {
      remove.dataset.favoriteRemove = String(item.id);
      remove.title = `Remove ${item.title} from favorites`;
      remove.setAttribute('aria-label', remove.title);
    }
    return card;
  }
  function showMore(group: HTMLElement, count: number) {
    const queued = remaining[group.dataset.favoritesGroup!];
    if (!queued?.length || count <= 0) return;
    const added = queued.splice(0,count).map(createCard);
    group.querySelector('.favorites-grid')!.append(...added);
    group.querySelector<HTMLElement>('[data-favorites-more]')!.hidden = queued.length === 0;
    savedOrder = order();
    return added[0];
  }
  const previousCounts = JSON.parse(page.dataset.favoritesVisible || '{}') as Record<string,number>;
  for (const group of groups) {
    const more = group.querySelector<HTMLAnchorElement>('[data-favorites-more]');
    if (!more) continue;
    const shown = group.querySelector('.favorites-grid')!.childElementCount;
    showMore(group, (previousCounts[group.dataset.favoritesGroup!] || 0) - shown);
    more.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const first = showMore(group, Number(more.dataset.favoritesMore));
      if (event.detail === 0) first?.querySelector<HTMLAnchorElement>('.favorite-poster')?.focus();
    }, {signal:favoritePageListeners.signal});
  }
  const report = (message: string) => { feedback.textContent = message; };
  const setReordering = (active: boolean) => {
    page.dataset.reordering = String(active);
    if (reorder) reorder.textContent = active ? 'Save Order' : 'Reorder';
    if (cancel) cancel.hidden = !active;
    instructions.hidden = !active;
    cards().forEach(card => { if (active) card.tabIndex = 0; else card.removeAttribute('tabindex'); });
    error.hidden = true;
    if (!active) queueMicrotask(() => refreshFavorites());
  };
  const updateEmpty = () => {
    const hasCards = cards().length > 0;
    grid.hidden = !hasCards;
    page.querySelector<HTMLElement>('[data-favorites-empty]')!.hidden = hasCards;
    const visibleGroups = [...page.querySelectorAll<HTMLElement>('[data-favorites-group]')].filter(group => {
      group.hidden = !group.querySelector('[data-favorite-card]:not([hidden])');
      return !group.hidden;
    });
    if (actions) {
      actions.hidden = !hasCards;
      if (hasCards) visibleGroups[0]?.querySelector('.favorites-group-heading')?.append(actions);
    }
  };

  if (page.dataset.profileOwner === 'true') {
    let revision = 0, dirty = false, loading = false;
    const signal = favoritePageListeners.signal;
    refreshFavorites = () => {
      if (!dirty || loading || editorStore.hasPendingWrites() || signal.aborted || page.dataset.reordering === 'true') return;
      loading = true; const version = revision;
      void (async () => {
        try {
          const response = await fetch(location.href, {cache:'no-store', signal});
          if (!response.ok) throw new Error('Unable to refresh favorites.');
          const fresh = new DOMParser().parseFromString(await response.text(), 'text/html');
          if (signal.aborted) return;
          if (version !== revision || editorStore.hasPendingWrites() || page.dataset.reordering === 'true') { loading = false; refreshFavorites(); return; }
          const next = fresh.querySelector<HTMLElement>('.favorites-page[data-profile-owner="true"]');
          if (!next) throw new Error('Favorites refresh incomplete.');
          if (page.isConnected) {
            next.dataset.favoritesVisible = JSON.stringify(Object.fromEntries(groups.map(group=>[
              group.dataset.favoritesGroup,group.querySelector('.favorites-grid')!.childElementCount,
            ])));
            page.replaceWith(next); dirty = false; document.dispatchEvent(new Event('anylist:favorites-reconciled'));
          }
        } catch { if (!signal.aborted) location.reload(); }
        finally { loading = false; }
      })();
    };
    document.addEventListener('anylist:editor-state', () => { revision++; if (dirty) refreshFavorites(); }, {signal});
    document.addEventListener('anylist:editor-committed', () => { dirty = true; refreshFavorites(); }, {signal});
  }

  reorder?.addEventListener('click', async () => {
    if (page.dataset.reordering !== 'true') {
      groups.forEach(group => showMore(group, Infinity));
      setReordering(true);
      return;
    }
    const current = order();
    if (current.join(',') === savedOrder.join(',')) { setReordering(false); return; }
    reorder.disabled = true;
    if (cancel) cancel.disabled = true;
    error.hidden = true;
    try {
      for(const change of favoriteOrderChanges(current,savedOrder)){
        const response=await fetch(change.path,{
          method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(change.body),
        });
        if(!response.ok){
          const details=await response.json().catch(()=>null);
          throw new Error(typeof details?.detail==='string'?details.detail:'Could not save favorite order.');
        }
        savedOrder=favoriteOrderSaved(savedOrder,current,change.path);
      }
      savedOrder = current;
      setReordering(false);
      report('Favorite order saved.');
    } catch (cause) {
      showActionFailure('favorite-order',null,cause);
    } finally {
      reorder.disabled = false;
      if (cancel) cancel.disabled = false;
    }
  }, {signal: favoritePageListeners.signal});

  cancel?.addEventListener('click', () => {
    const byId = new Map(cards().map(card => [cardKey(card), card]));
    grid.querySelectorAll<HTMLElement>('.favorites-grid').forEach(groupGrid => {
      savedOrder.forEach(id => { const card = byId.get(id); if (card?.parentElement === groupGrid) groupGrid.append(card); });
    });
    setReordering(false);
    report('Favorite order unchanged.');
  }, {signal: favoritePageListeners.signal});

  page.addEventListener('click', async event => {
    if (page.dataset.reordering === 'true' && (event.target as HTMLElement).closest('.favorite-card')) {
      event.preventDefault();
      return;
    }
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-favorite-remove]');
    if (!button || page.dataset.reordering === 'true') return;
    button.disabled = true;
    error.hidden = true;
    try {
      if(button.closest<HTMLElement>('[data-favorite-card]')?.dataset.favoriteType==='game'){
        const title=await editorStore.loadSubject({kind:'game',catalogue_id:Number(button.dataset.favoriteRemove)});
        await editorStore.write(title,{favorite:false});
      }else{
      const response = await fetch(`/api/proxy/tracking/entry/${button.dataset.favoriteRemove}`, {
        method: 'PATCH', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({favorite: false}),
      });
      if (!response.ok) {
        const details = await response.json().catch(() => null);
        throw new Error(typeof details?.detail === 'string' ? details.detail : 'Could not remove this favorite.');
      }
      }
      const card = button.closest<HTMLElement>('[data-favorite-card]')!;
      const group = card.closest<HTMLElement>('[data-favorites-group]')!;
      const title = card.dataset.title || 'Title';
      card.remove();
      if (!group.querySelector('[data-favorite-card]')) {
        showMore(group, Number(group.querySelector<HTMLElement>('[data-favorites-more]')?.dataset.favoritesMore || 0));
      }
      savedOrder = order();
      updateEmpty();
      report(`${title} removed from favorites.`);
      document.dispatchEvent(new CustomEvent('anylist:data-changed'));

    } catch (cause) {
      showActionFailure('favorite',button.closest<HTMLElement>('[data-favorite-card]')?.dataset.title,cause);
      button.disabled = false;
    }
  }, {signal: favoritePageListeners.signal});
  document.addEventListener('anylist:editor-state',event=>{
    const title=(event as CustomEvent<EditorTitle>).detail;
    if(page.dataset.favoritesOwner!=='true'||title.type!=='game')return;
    const card=grid.querySelector<HTMLElement>(`[data-favorite-card][data-favorite-type="game"][data-media-id="${title.id}"]`);
    if(card){card.hidden=!title.favorite;updateEmpty();}
  },{signal:favoritePageListeners.signal});

  page.addEventListener('pointerdown', event => {
    if (page.dataset.reordering !== 'true' || event.button !== 0) return;
    const card = (event.target as HTMLElement).closest<HTMLElement>('[data-favorite-card]');
    if (!card) return;
    event.preventDefault();
    dragging = card;
    card.classList.add('is-dragging');
    card.setPointerCapture(event.pointerId);
  }, {signal: favoritePageListeners.signal});
  page.addEventListener('pointermove', event => {
    if (!dragging) return;
    const target = document.elementFromPoint(event.clientX, event.clientY)?.closest<HTMLElement>('[data-favorite-card]');
    if (!target || target === dragging || target.parentElement !== dragging.parentElement) return;
    const current = [...dragging.parentElement!.querySelectorAll<HTMLElement>('[data-favorite-card]')];
    if (current.indexOf(dragging) < current.indexOf(target)) target.after(dragging);
    else target.before(dragging);
  }, {signal: favoritePageListeners.signal});
  const stopDragging = () => { dragging?.classList.remove('is-dragging'); dragging = null; };
  page.addEventListener('pointerup', stopDragging, {signal: favoritePageListeners.signal});
  page.addEventListener('pointercancel', stopDragging, {signal: favoritePageListeners.signal});
  page.addEventListener('keydown', event => {
    if (page.dataset.reordering !== 'true') return;
    if (event.key === 'Escape') { cancel?.click(); return; }
    if (!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(event.key)) return;
    const card = (event.target as HTMLElement).closest<HTMLElement>('[data-favorite-card]');
    if (!card) return;
    const current = [...card.parentElement!.querySelectorAll<HTMLElement>('[data-favorite-card]')];
    const index = current.indexOf(card);
    const direction = event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1;
    const neighbor = current[index + direction];
    if (!neighbor) return;
    event.preventDefault();
    if (direction < 0) neighbor.before(card); else neighbor.after(card);
    card.focus();
    report(`${card.dataset.title} moved to position ${index + direction + 1}.`);
  }, {signal: favoritePageListeners.signal});
}
document.addEventListener('astro:page-load', mountFavorites);
document.addEventListener('anylist:favorites-reconciled', mountFavorites);
</script>
