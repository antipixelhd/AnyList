---
import Tracker from '../../../layouts/Tracker.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import ActivityCard from '../../../components/ActivityCard.astro';
import Icon from '../../../components/Icon.astro';
import ProfileOverviewLeft from '../../../components/ProfileOverviewLeft.astro';
import {tracker,trackerFailure} from '../../../lib/tracker';
import type { ProfileStats } from '../../../lib/profile-stats-data';
import '../../../styles/profile-overview.css';
import {viewerMediaPreferences} from '../../../lib/viewer-media-preferences';
import {profileMediaDomains} from '../../../lib/media-domains';
import {gameListEditorTitle} from '../../../lib/game-list-data';
import {mergeActivityFeeds} from '../../../lib/activity-feed';
const preferences=await viewerMediaPreferences(Astro.locals);
const ownHint=Astro.locals.user?.username===Astro.params.username;
let profile:any=null,error='';
try{profile=await tracker(`people/${encodeURIComponent(Astro.params.username!)}${ownHint&&!preferences.show_movies_series?'/header':''}`,Astro.locals.token);}catch(e){const failure=trackerFailure(e);error=failure.message;Astro.response.status=failure.status;}
const domains=profileMediaDomains(profile?.owner===true,preferences);
let movieStats: ProfileStats | null = null, seriesStats: ProfileStats | null = null;
let gameFavorites:any[]|null=null;
let activities:any[]=[],gameActivityFailed=false;
if (profile) {
  const summaries=domains.show_movies_series?Promise.all(['movie', 'series'].map(type =>
    tracker(`profile/${encodeURIComponent(Astro.params.username!)}/stats/summary?media_type=${type}`, Astro.locals.token).catch(() => null)
  )):Promise.resolve([null,null]);
  const [screen,games,gameActivity]=await Promise.all([summaries,domains.show_games?tracker(`games/users/${encodeURIComponent(Astro.params.username!)}/favorites?limit=8`,Astro.locals.token).catch(()=>null):Promise.resolve(null),domains.show_games?tracker(`games/users/${encodeURIComponent(Astro.params.username!)}/activity?limit=12`,Astro.locals.token).catch(()=>null):Promise.resolve({results:[]})]);
  [movieStats,seriesStats]=screen;
  gameFavorites=games?games.results.map(gameListEditorTitle):null;
  activities=mergeActivityFeeds([domains.show_movies_series?profile.recent_activity||[]:[],gameActivity?.results||[]],12);
  gameActivityFailed=domains.show_games&&gameActivity==null;
}
---
<Tracker title={profile?.display_name||'Profile'} ownerProfileColor={profile?.profile_color} ownerIsViewer={profile?.owner === true}>{profile?<><ProfileHeader profile={profile}/><main class="page-width profile-overview" data-profile-owner={String(profile.owner === true)}>
  <ProfileOverviewLeft profile={profile} movieStats={movieStats} seriesStats={seriesStats} {domains} {gameFavorites}/>
  <section class="overview-activity activity-stream" aria-labelledby="profile-activity"><div class="section-heading"><h2 id="profile-activity">Recent activity</h2></div>
    {gameActivityFailed&&<p class="section-empty" role="status">Game activity is temporarily unavailable.</p>}
    {activities.length?activities.map((a:any)=><ActivityCard activity={a}/>):!gameActivityFailed&&<div class="empty-state"><span class="empty-symbol"><Icon name="play"/></span><h2>No recent activity</h2><p>Tracking updates and ratings will appear here.</p></div>}
  </section>
</main></>:<main class="page-width"><p class="error-message" role="alert">{error}</p></main>}</Tracker>

<script>
import {editorStore} from '../../../lib/editor-store';
let overviewListeners: AbortController;
document.addEventListener('astro:page-load', () => {
  overviewListeners?.abort(); overviewListeners = new AbortController();
  const signal = overviewListeners.signal;
  document.addEventListener('astro:before-swap', () => overviewListeners.abort(), {once:true, signal});
  if (!document.querySelector('.profile-overview[data-profile-owner="true"]')) return;
  let revision = 0, dirty = false, loading = false;
  const refresh = () => {
    if (!dirty || loading || editorStore.hasPendingWrites() || signal.aborted) return;
    loading = true; const version = revision;
    void (async () => {
      try {
        const response = await fetch(location.href, {cache:'no-store', signal});
        if (!response.ok) throw new Error('Unable to refresh profile.');
        const fresh = new DOMParser().parseFromString(await response.text(), 'text/html');
        if (signal.aborted) return;
        if (version !== revision || editorStore.hasPendingWrites()) { loading = false; refresh(); return; }
        const current = document.querySelector('.profile-overview[data-profile-owner="true"]');
        const next = fresh.querySelector('.profile-overview[data-profile-owner="true"]');
        if (!current || !next) throw new Error('Profile refresh incomplete.');
        current.replaceWith(next); dirty = false;
      } catch { if (!signal.aborted) location.reload(); }
      finally { loading = false; }
    })();
  };
  document.addEventListener('anylist:editor-state', () => { revision++; if (dirty) refresh(); }, {signal});
  document.addEventListener('anylist:editor-committed', () => { dirty = true; refresh(); }, {signal});
});
</script>
