---
import Tracker from '../../../../layouts/Tracker.astro';
import ProfileHeader from '../../../../components/ProfileHeader.astro';
import ProfileStatsDomains from '../../../../components/ProfileStatsDomains.astro';
import ProfileSectionSelector from '../../../../components/ProfileSectionSelector.astro';
import StatsMetricChart from '../../../../components/StatsMetricChart.astro';
import StatsDistribution from '../../../../components/StatsDistribution.astro';
import StatsMediaGroupCard from '../../../../components/StatsMediaGroupCard.astro';
import StatsPersonCard from '../../../../components/StatsPersonCard.astro';
import Icon from '../../../../components/Icon.astro';
import {tracker} from '../../../../lib/tracker';
import {gameStatsQuery,gameStatsSections,gameHeadlines,gameChartRows,gameCard,signedNumber,type GameStatsResponse,type GameOverview,type GameStatsGroup} from '../../../../lib/game-statistics-data';
import '../../../../styles/stats-overview.css';
import '../../../../styles/stats-genres.css';
import '../../../../styles/stats-actors.css';
const username=Astro.params.username!;
const query=gameStatsQuery(Astro.url.searchParams);
Astro.response.headers.set('Cache-Control','private, no-store');
let data:GameStatsResponse|null=null,error='';
try{data=await tracker(`games/users/${encodeURIComponent(username)}/statistics?${new URLSearchParams({section:query.section,sort:query.sort,page:String(query.page)})}`,Astro.locals.token);}
catch(cause){error=(cause as Error).message;}
const overview=data?.status==='ready'&&query.section==='overview'?data.data as GameOverview:null;
const groups=data?.status==='ready'&&query.section!=='overview'?data.data as GameStatsGroup[]:[];
const head=gameHeadlines(overview),icons=['display','check','hourglass','star','percent','list'];
const chartRows=(key:'scores'|'hours'|'release_years'|'completion_years')=>gameChartRows(overview?.[key]||[]);
const emptyGroup={key:'',label:'',games:0,recorded_seconds:null,known_time_games:0,mean_score:null,rated_games:0,href:null,image:null,roles:[],top_titles:[]};
const statuses=(overview?.statuses||[]).map(row=>({key:row.key,label:row.label,titles:row.games,percent:overview?.totals.listed_games?row.games/overview.totals.listed_games*100:0}));
---
<Tracker title={`${username}'s Games Statistics`} ownerProfileColor={data?.profile.profile_color} ownerIsViewer={data?.owner===true} preloadBodyFonts>
{data?<>
  <ProfileHeader profile={{...data.profile,owner:data.owner,following:data.following,follows_you:data.follows_you,combine_lists:data.combine_lists}} active="stats"/>
  <section class="page-width stats-overview-page" id="game-statistics" data-username={username} data-initial={JSON.stringify(data)} data-sort={query.sort} aria-label="Games statistics">
    <aside class="overview-sidebar"><button type="button" class="overview-menu-toggle" data-stats-menu-toggle aria-label="Show statistics sections" aria-expanded="false" aria-controls="statistics-sections"><span>Statistics</span><Icon name="ellipsis"/></button><div id="statistics-sections"><ProfileSectionSelector heading="Statistics" ariaLabel="Games statistics sections" options={gameStatsSections.map(([id,label])=>({id,label}))} active={query.section} width="100%"/></div></aside>
    <div class="stats-overview-content">
      <ProfileStatsDomains username={username} owner={data.owner} active="game" gameAvailable={overview?overview.totals.listed_games>0:undefined}/>
      <header class="overview-heading"><h2 data-game-stats-heading>{gameStatsSections.find(([key])=>key===query.section)?.[1]}</h2></header>
      <p class="overview-error error-message" role="alert" data-game-stats-error hidden></p>
      <p class="overview-sr-only" role="status" aria-live="polite" data-game-stats-announcement></p>
      <div class="overview-pending" role="status" hidden={data.status==='ready'}><p data-game-stats-state>{data.status==='error'?'Statistics are unavailable. A retry is scheduled.':'Preparing statistics…'}</p><button type="button" data-game-stats-retry>Check again</button></div>
      <div class="overview-results" hidden={data.status!=='ready'}>
        <div data-game-stats-overview hidden={query.section!=='overview'}>
          <dl class="overview-totals" aria-label="Primary game statistics">{head.map((metric,index)=><div title={metric.detail}><dt><span class="overview-total-icon" aria-hidden="true"><Icon name={icons[index]}/></span><span data-headline-label={index}>{metric.label}</span></dt><dd data-headline-value={index}>{metric.value}</dd></div>)}</dl>
          <div class="overview-chart-grid"><StatsMetricChart id="game-scores" title="Scores" rows={chartRows('scores')} score countLabel="Games" categoryLabel="Score interval" emptyLabel="No rated games."/><StatsMetricChart id="game-hours" title="Recorded time" rows={chartRows('hours')} countLabel="Games" categoryLabel="Hours interval" emptyLabel="No recorded time."/></div>
          <div class="overview-distribution-grid"><StatsDistribution id="statuses" title="List status" rows={statuses} countLabel="games" emptyLabel="No games."/>
            <section class="overview-distribution"><h3>Planned</h3><dl class="overview-totals game-stats-secondary"><div><dt><span data-game-secondary-label>Games</span></dt><dd data-game-planned-count>{overview?.planned.games??'—'}</dd></div><div><dt><span>Main + Sides hours</span></dt><dd data-game-planned-hours>{overview?.planned.estimated_seconds==null?'—':`${overview.planned.known_estimate_games<overview.planned.games?'≥ ':''}${(overview.planned.estimated_seconds/3600).toLocaleString(undefined,{maximumFractionDigits:1})}`}</dd></div></dl></section>
            <section class="overview-distribution"><h3>Replays</h3><dl class="overview-totals game-stats-secondary"><div><dt><span>Recorded replays</span></dt><dd data-game-replays>{overview?.totals.replay_games?overview.totals.replays:'—'}</dd></div></dl></section>
          </div>
          <div class="overview-chart-grid overview-years"><StatsMetricChart id="game-release-years" title="Release year" rows={chartRows('release_years')} countLabel="Games" categoryLabel="Release year" emptyLabel="No known release years."/><StatsMetricChart id="game-completion-years" title="Completion year" rows={chartRows('completion_years')} countLabel="Games" categoryLabel="Completion year" showHours={false} emptyLabel="No dated completions."/></div>
          <p class="stats-genres-empty" data-game-undated hidden={!overview?.coverage.undated_completions}>{overview?.coverage.undated_completions||0} completions have no date.</p>
          <section class="overview-chart"><header class="overview-chart-heading"><h3>First completion vs estimate</h3></header><div class="overview-table-scroll"><table class="game-comparison-table"><thead><tr><th>Estimate</th><th>Games</th><th>Hours difference</th><th>Difference</th></tr></thead><tbody data-game-comparisons>{(overview?.comparisons||[]).map(row=><tr><th scope="row">{row.label}</th><td>{row.games}</td><td>{signedNumber(row.mean_difference_seconds,3600)}</td><td>{row.mean_relative_percent==null?'—':`${signedNumber(row.mean_relative_percent)}%`}</td></tr>)}</tbody></table></div></section>
        </div>
        <div data-game-stats-groups hidden={query.section==='overview'}>
          <div class="stats-genres-toolbar"><div class="overview-metrics" role="group" aria-label="Sort game statistics">{[['count','Count'],['mean_score','Mean Score'],['time','Time Played']].map(([key,label])=><button type="button" data-game-stats-sort={key} aria-pressed={query.sort===key}>{label}</button>)}</div></div>
          <div class:list={['stats-genres-grid',{'stats-actors-grid':query.section==='actors'||query.section==='staff'}]} data-game-stats-grid>{groups.map((row,index)=>query.section==='actors'||query.section==='staff'?<StatsPersonCard person={gameCard(row)} rank={(query.page-1)*24+index+1} mode="media" prefix="staff" timeLabel="Time Played"/>:<StatsMediaGroupCard group={gameCard(row)} rank={(query.page-1)*24+index+1} href={row.href} prefix="studio" timeLabel="Time Played"/>)}</div>
          <p class="stats-genres-empty" data-game-groups-empty hidden={groups.length>0}>No played games in this section.</p>
          <div class="contributor-pagination game-stats-pagination"><a data-game-stats-page="-1" href={query.page>1?`?${new URLSearchParams({...query,page:String(query.page-1)})}`:undefined} aria-disabled={query.page<=1?"true":"false"}>Previous</a><span data-game-stats-page-label>Page {query.page}</span><a data-game-stats-page="1" href={data.has_more?`?${new URLSearchParams({...query,page:String(query.page+1)})}`:undefined} aria-disabled={!data.has_more?"true":"false"}>Next</a></div>
        </div>
      </div>
      <template data-game-group-template><StatsMediaGroupCard group={gameCard(emptyGroup)} rank={0} href={null} prefix="studio" timeLabel="Time Played"/></template>
      <template data-game-person-template><StatsPersonCard person={gameCard(emptyGroup)} rank={0} mode="media" prefix="staff" timeLabel="Time Played"/></template>
      <template data-game-poster-template><a class="stats-genre-poster" href="#" draggable="false"><img alt="" loading="lazy" draggable="false"/><span class="stats-genre-placeholder" aria-hidden="true"></span><span class="stats-genre-tooltip" aria-hidden="true"></span></a></template>
    </div>
  </section>
</>:<div class="page-width"><p class="error-message" role="alert">{error}</p></div>}
</Tracker>
<script src="../../../../lib/game-statistics.ts"></script>
