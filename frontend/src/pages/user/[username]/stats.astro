---
import Tracker from '../../../layouts/Tracker.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import ProfileSectionSelector from '../../../components/ProfileSectionSelector.astro';
import Icon from '../../../components/Icon.astro';
import StatsMetricChart from '../../../components/StatsMetricChart.astro';
import StatsDistribution from '../../../components/StatsDistribution.astro';
import StatsGenreCard from '../../../components/StatsGenreCard.astro';
import StatsActorCard from '../../../components/StatsActorCard.astro';
import StatsStudioCard from '../../../components/StatsStudioCard.astro';
import '../../../styles/stats-overview.css';
import '../../../styles/stats-genres.css';
import '../../../styles/stats-actors.css';
import { tracker } from '../../../lib/tracker';
import type { OverviewResponse, Overview, MediaScope } from '../../../lib/stats-overview-data';
import { headlineValues } from '../../../lib/stats-overview-data';
import { genreSort, rankedGenres } from '../../../lib/stats-genres-data';
import { actorArtwork, hasCharacterImages, rankedActors } from '../../../lib/stats-actors-data';
import { rankedStudios } from '../../../lib/stats-studios-data';

const { username } = Astro.params;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const requested = Astro.url.searchParams.get('media') || 'all';
const media: MediaScope = requested === 'movie' || requested === 'series' ? requested : 'all';
const selectedSection = Astro.url.searchParams.get('section');
const section = selectedSection === 'genres' || selectedSection === 'actors' || selectedSection === 'studios' ? selectedSection : 'overview';
const sort = genreSort(Astro.url.searchParams.get('sort'));
const actorSort = genreSort(Astro.url.searchParams.get('actor_sort'));
const studioSort = genreSort(Astro.url.searchParams.get('studio_sort'));
const artwork = actorArtwork(Astro.url.searchParams.get('artwork'));
let data: OverviewResponse | null = null, error = '';
try { data = await tracker(`profile/${encodeURIComponent(username!)}/stats/overview?media_type=${media}`, Astro.locals.token); }
catch (cause) { error = (cause as Error).message; }
const ready = data?.status === 'ready' && data.overview !== null;
const overview: Overview = data?.overview || {
  media_type: media, totals: { listed_titles: 0, watched_titles: 0, episode_plays: 0, distinct_episodes: 0, watch_minutes: 0, watch_days: 0, planned_minutes: 0, planned_days: 0, mean_score: null, standard_deviation: null, rated_titles: 0 },
  scores: [], episode_counts: [], statuses: [], formats: [], countries: [], release_years: [], watch_years: [], coverage: {},
};
const highlights = headlineValues(overview);
const headlineIcons = ['display', 'play', 'calendar', 'hourglass', 'percent', 'divide'];
const genreTemplate = { key: '', label: '', titles: 0, minutes: 0, mean_score: null, rated_titles: 0, runtime_missing_plays: 0, browse_filters: { movie: '', series: '' }, top_titles: [] };
const actorTemplate = { key: '', label: '', image: null, href: '#', titles: 0, minutes: 0, mean_score: null, rated_titles: 0, runtime_missing_plays: 0, top_titles: [] };
---
<Tracker title={`${username}'s Statistics`} ownerProfileColor={data?.profile?.profile_color} ownerIsViewer={data?.owner === true}>
  {data ? <>
    <ProfileHeader profile={{ ...data.profile, owner: data.owner, following: data.following, follows_you: data.follows_you, combine_lists: data.combine_lists }} active="stats" />
    <section class="page-width stats-overview-page" id="statistics-overview" data-username={username} data-initial={JSON.stringify(data)} data-media={media} data-section={section} data-genre-sort={sort} data-studio-sort={studioSort} data-actor-sort={actorSort} data-actor-artwork={artwork} aria-label="Statistics">
      <aside class="overview-sidebar"><ProfileSectionSelector heading="Statistics" ariaLabel="Statistics sections" options={[{id: 'overview', label: 'Overview'}, {id: 'genres', label: 'Genres'}, {id: 'actors', label: 'Actors'}, {id: 'studios', label: 'Studios'}]} active={section} width="100%" /></aside>
      <div class="stats-overview-content">
      <header class="overview-heading"><h2 data-stats-heading>{section === 'studios' ? 'Studios' : section === 'actors' ? 'Actors' : section === 'genres' ? 'Genres' : 'Overview'}</h2><nav class="overview-media" aria-label="Statistics media type">
        {[['all', 'All'], ['movie', 'Movies'], ['series', 'Series']].map(([value, label]) => <a href={`?${new URLSearchParams({media: value, section, sort, actor_sort: actorSort, studio_sort: studioSort, artwork})}`} data-overview-media={value} aria-current={value === media ? 'page' : undefined}>{label}</a>)}
      </nav></header>
      <p class="overview-error error-message" role="alert" hidden></p>
      <div class="overview-pending" role="status" hidden={ready}><p data-overview-state>{data.status === 'error' ? 'Statistics are unavailable. A retry is scheduled.' : 'Preparing statistics…'}</p><button type="button" data-overview-retry>Check again</button></div>
      <span class="overview-sr-only" data-overview-announcement role="status" aria-live="polite"></span>
      <div class="overview-results" hidden={!ready}>
        <div data-stats-panel="overview" hidden={section !== 'overview'}>
        <dl class="overview-totals" aria-label="Primary statistics">{highlights.map((metric, index) => <div title={metric.detail}><dt><span class="overview-total-icon" aria-hidden="true"><Icon name={headlineIcons[index]} /></span><span data-headline-label={index}>{metric.label}</span></dt><dd data-headline-value={index}>{metric.value}</dd></div>)}</dl>
        <div class="overview-chart-grid"><StatsMetricChart id="scores" title="Scores" rows={overview.scores} score /><StatsMetricChart id="episode_counts" title="Episode count" rows={overview.episode_counts} hidden={media === 'movie'} /></div>
        <div class="overview-distribution-grid"><StatsDistribution id="statuses" title="List status" data={overview} /><StatsDistribution id="formats" title="Format" data={overview} /><StatsDistribution id="countries" title="Country" data={overview} /></div>
        <div class="overview-chart-grid overview-years"><StatsMetricChart id="release_years" title="Release year" rows={overview.release_years} /><StatsMetricChart id="watch_years" title="Watch year" rows={overview.watch_years} /></div>
        </div>
        <div data-stats-panel="genres" hidden={section !== 'genres'}>
          <div class="stats-genres-toolbar"><div class="overview-metrics" role="group" aria-label="Sort genres">
            {[['count', 'Count'], ['mean_score', 'Mean Score'], ['time', 'Time Watched']].map(([value, label]) => <button type="button" data-genre-sort={value} aria-pressed={sort === value}>{label}</button>)}
          </div></div>
          <div class="stats-genres-grid" data-genres-grid>{rankedGenres(overview.genres || [], sort).map((genre, index) => <StatsGenreCard genre={genre} rank={index + 1} media={media} />)}</div>
          <p class="stats-genres-empty" data-genres-empty hidden={(overview.genres || []).length > 0}>No watched genres.</p>
        </div>
        <template data-genre-card-template><StatsGenreCard genre={genreTemplate} rank={0} media={media} /></template>
        <div data-stats-panel="actors" hidden={section !== 'actors'}>
          <div class="stats-actors-toolbar">
            <div class="overview-metrics" role="group" aria-label="Actor artwork">
              {[['media', 'Media'], ['characters', 'Characters']].map(([value, label]) => <button type="button" data-actor-artwork={value} aria-pressed={artwork === value} disabled={value === 'characters' && !hasCharacterImages(overview.actors || [])}>{label}</button>)}
            </div>
            <div class="overview-metrics" role="group" aria-label="Sort actors">
              {[['count', 'Count'], ['mean_score', 'Mean Score'], ['time', 'Time Watched']].map(([value, label]) => <button type="button" data-actor-sort={value} aria-pressed={actorSort === value}>{label}</button>)}
            </div>
          </div>
          <div class="stats-actors-grid" data-actors-grid>{rankedActors(overview.actors || [], actorSort).map((actor, index) => <StatsActorCard actor={actor} rank={index + 1} mode={artwork} />)}</div>
          <p class="stats-actors-empty" data-actors-empty hidden={(overview.actors || []).length > 0}>No actors yet.</p>
        </div>
        <template data-actor-card-template><StatsActorCard actor={actorTemplate} rank={0} mode={artwork} /></template>
        <div data-stats-panel="studios" hidden={section !== 'studios'}>
          <div class="stats-genres-toolbar"><div class="overview-metrics" role="group" aria-label="Sort studios">
            {[['count', 'Count'], ['mean_score', 'Mean Score'], ['time', 'Time Watched']].map(([value, label]) => <button type="button" data-studio-sort={value} aria-pressed={studioSort === value}>{label}</button>)}
          </div></div>
          <div class="stats-genres-grid" data-studios-grid>{rankedStudios(overview.studios || [], studioSort).map((studio, index) => <StatsStudioCard studio={studio} rank={index + 1} />)}</div>
          <p class="stats-genres-empty" data-studios-empty hidden={(overview.studios || []).length > 0}>No watched studios.</p>
        </div>
        <template data-studio-card-template><StatsStudioCard studio={{...actorTemplate, top_titles: []}} rank={0} /></template>
        <template data-genre-poster-template><a class="stats-genre-poster" href="#" draggable="false"><img alt="" loading="lazy" draggable="false" /><span class="stats-genre-placeholder" aria-hidden="true"></span><span class="stats-genre-tooltip" aria-hidden="true"></span></a></template>
      </div>
      </div>
    </section>
  </> : <div class="page-width"><p class="error-message" role="alert">{error}</p></div>}
</Tracker>
<script src="../../../lib/stats-overview.ts"></script>
