---
import GameListRows from '../../../components/GameListRows.astro';
import Tracker from '../../../layouts/Tracker.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import ProfileListFilters from '../../../components/ProfileListFilters.astro';
import ProfileListTableHead from '../../../components/ProfileListTableHead.astro';
import {tracker,trackerFailure} from '../../../lib/tracker';
import {gameStatuses} from '../../../lib/game-editor-data';
import {gameListQuery} from '../../../lib/game-list-data';
import {viewerMediaPreferences} from '../../../lib/viewer-media-preferences';
import '../../../styles/game-list.css';
import '../../../styles/virtual-profile-list.css';
import '../../../styles/stats-loading.css';
const preferences=await viewerMediaPreferences(Astro.locals);
const {query}=gameListQuery(Astro.url.searchParams,preferences.default_sort);
const request=new URLSearchParams(query);request.set('grouped','true');request.set('limit','100');
let data:any=null,error='';
try{data=await tracker(`games/users/${encodeURIComponent(Astro.params.username!)}/list?${request}`,Astro.locals.token);}
catch(cause){const failure=trackerFailure(cause);error=failure.message;Astro.response.status=failure.status;}
const entries=data?.results||[],owner=data?.profile?.owner===true;
const showAchievements=preferences.show_game_achievements;
---
<Tracker title={`${data?.profile?.display_name||Astro.params.username}'s Games List`} listLanding={!!data} ownerProfileColor={data?.profile?.profile_color} ownerIsViewer={owner}>
  {data?<>
    <ProfileHeader profile={data.profile} active="games"/>
    <div class="list-shell game-list-shell" data-virtual-list data-list-domain="game" data-list-endpoint={`games/users/${encodeURIComponent(Astro.params.username!)}`} data-list-total={data.total} data-list-counts={JSON.stringify(data.group_counts)} data-owner={String(owner)} data-show-achievements={String(showAchievements)} data-status={query.get('status')||''} data-favorites={String(query.has('favorites'))} data-sort={query.get('sort')} data-status-counts={JSON.stringify(data.status_counts)}>
      <ProfileListFilters statuses={gameStatuses} counts={data.status_counts} genres={data.genres} years={data.years} status={query.get('status')||'all'} sort={query.get('sort')||'title'} defaultSort={preferences.default_sort} query={query.get('q')||''} genre={query.get('genre')||''} year={query.get('year')||''} favorites={query.has('favorites')} progressLabel="Hours"/>

      <div class="list-content">
        <div class="list-toolbar"><span class="sr-only" aria-live="polite">{`${data.total} entries`}</span></div>
        <div id="entry-groups" class="game-entry-groups" data-game-groups>
          {gameStatuses.map(([status,label])=>{const rows=entries.filter((entry:any)=>entry.status===status);return <section class="status-section" data-list-group={status} hidden={!data.group_counts[status]}><h2>{label}</h2><div class="entry-table">
            <ProfileListTableHead game {showAchievements}/>
            <div data-list-window={status} style={`--list-rows:${data.group_counts[status]||0}`}><GameListRows entries={rows} {owner} {showAchievements}/></div>
          </div></section>})}
        </div>
        <div id="list-empty" class="empty-state" hidden={!!entries.length}><h2>No matching games</h2>{owner&&<a class="button-primary" href="/browse?media_type=game">Browse games</a>}</div>
      </div>
    </div>
    <div id="cover-preview" aria-hidden="true" hidden><img alt=""/></div>
    <template data-list-row-template><GameListRows entries={[{subject:{catalogue_id:1},title:"",notes:"Note",replay_count:1}]} {owner} {showAchievements} template/></template>
    <script id="virtual-list-page" type="application/json" set:html={JSON.stringify(data).replaceAll('<','\\u003c')}/>
    <script is:inline data-astro-rerun>
      (()=>{if(performance.getEntriesByType('navigation')[0]?.type!=='navigate'||history.state)return;const tabs=document.querySelector('.profile-tabs');if(tabs)window.scrollTo(0,window.scrollY+tabs.getBoundingClientRect().top);})();
    </script>
  </>:<div class="page-width"><p class="error-message" role="alert">{error}</p></div>}
</Tracker>
<script>import '../../../lib/profile-shell';</script>
