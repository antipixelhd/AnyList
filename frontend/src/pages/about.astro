---
import Tracker from "../layouts/Tracker.astro";
import { connectionIconHtml } from "../lib/connectionIcons";
import "../styles/global.css";

Astro.response.headers.set("Cache-Control", "no-store");

const creditGroups: { label: string; services: { name: string; type: string; url: string }[] }[] = [
  {
    label: "Metadata",
    services: [
      { name: "TMDB", type: "themoviedatabase", url: "https://www.themoviedb.org" },
      { name: "TheTVDB", type: "tvdb", url: "https://thetvdb.com" },
      { name: "MDBList", type: "mdblist", url: "https://mdblist.com" },
    ],
  },
  {
    label: "Media players and servers",
    services: [
      { name: "Stremio", type: "stremio", url: "https://www.stremio.com" },
      { name: "Nuvio", type: "nuvio", url: "https://nuvio.tv" },
      { name: "Plex", type: "plex", url: "https://www.plex.tv" },
      { name: "Jellyfin", type: "jellyfin", url: "https://jellyfin.org" },
      { name: "Emby", type: "emby", url: "https://emby.media" },
      { name: "Kodi", type: "kodi", url: "https://kodi.tv" },
    ],
  },
  {
    label: "Tracking services",
    services: [
      { name: "Trakt", type: "trakt", url: "https://trakt.tv" },
      { name: "Simkl", type: "simkl", url: "https://simkl.com" },
      { name: "Bingebase", type: "bingebase", url: "https://bingebase.com" },
    ],
  },
];

const currentVersion = process.env.APP_VERSION ?? "development";
---

<Tracker title="About">
  <main class="mx-auto max-w-4xl px-5 py-10 md:px-8 md:py-14">
    <header class="mb-10 flex items-center gap-5">
      <span aria-hidden="true" class="inline-flex h-16 w-16 items-center justify-center rounded-lg bg-gradient-to-br from-sky-400 to-indigo-500 text-2xl font-black tracking-[-0.12em] text-white shadow-xl shadow-sky-950/30">M<span class="text-sky-100">t</span></span>
      <div>
        <p class="mb-1 text-[11px] font-bold uppercase tracking-[0.16em] text-sky-400">Self-hosted media tracking</p>
        <h1 class="page-title">Media Tracker</h1>
        <p class="mt-1 text-sm text-zinc-500">Build {currentVersion}</p>
      </div>
    </header>

    <div class="space-y-8 text-zinc-400 leading-relaxed">
      <section class="rounded-md border border-zinc-800 bg-zinc-900/55 p-6 md:p-8">
        <h2 class="mb-3 text-lg font-semibold text-zinc-100">One place for the titles you watch</h2>
        <p class="m-0 max-w-2xl text-sm md:text-[15px]">
          Media Tracker combines movie and series lists, half-point ratings, episode progress,
          profiles, following, and provider synchronization in a private service for you and
          the people you invite.
        </p>
      </section>

      <section>
        <h2 class="section-headline mb-3">Project</h2>
        <p class="mb-4 text-sm">
          Media Tracker is built from the open-source Scrob project and remains licensed under
          the GNU General Public License v3. The interface and tracking model have been adapted
          for whole-show lists, season ratings, private profiles, social activity, and reviewed
          synchronization decisions.
        </p>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="https://github.com/ellite/scrob" target="_blank" rel="noopener noreferrer" class="rounded border border-zinc-700 bg-zinc-900 px-4 py-2 text-zinc-300 transition-colors hover:border-sky-500 hover:text-sky-300">Scrob upstream</a>
          <a href="https://github.com/ellite/scrob/blob/main/LICENSE.md" target="_blank" rel="noopener noreferrer" class="rounded border border-zinc-700 bg-zinc-900 px-4 py-2 text-zinc-300 transition-colors hover:border-sky-500 hover:text-sky-300">GNU GPL v3</a>
        </div>
      </section>

      <section>
        <h2 class="section-headline mb-2">Connected services</h2>
        <p class="mb-6 text-sm text-zinc-500">
          Connections are optional. Availability depends on the administrator configuration and
          each service's supported fields.
        </p>
        <div class="space-y-6">
          {creditGroups.map((group) => (
            <div>
              <h3 class="mb-2 text-[11px] font-bold uppercase tracking-[0.14em] text-zinc-500">{group.label}</h3>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                {group.services.map((service) => (
                  <a href={service.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 rounded border border-zinc-800 bg-zinc-900/45 px-3 py-2.5 text-zinc-300 transition-colors hover:border-zinc-600 hover:bg-zinc-900 hover:text-zinc-100">
                    <span class="flex shrink-0 items-center [&_svg]:size-5! [&_span]:size-5! [&_span]:rounded-md! [&_span]:text-[8px]!"><Fragment set:html={connectionIconHtml(service.type)} /></span>
                    <span class="truncate text-sm">{service.name}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <footer class="space-y-2 border-t border-zinc-800 pt-6 text-xs text-zinc-600">
        <p>Built with Astro, FastAPI, PostgreSQL, Tailwind CSS, and Font Awesome.</p>
        <p>
          This product uses the TMDB API but is not endorsed or certified by TMDB. Metadata may
          also be provided by TheTVDB. All service names, logos, and trademarks belong to their
          respective owners and identify interoperability only.
        </p>
      </footer>
    </div>
  </main>
</Tracker>
