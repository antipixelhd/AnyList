---
import Tracker from '../layouts/Tracker.astro';
import DetailLoadingFrame from '../components/DetailLoadingFrame.astro';
const type=Astro.url.searchParams.get('type');
const id=Number(Astro.url.searchParams.get('id'));
if(!['movie','series'].includes(type!)||!Number.isSafeInteger(id)||id<=0)return Astro.redirect('/browse');
---
<Tracker title="Loading title"><div id="resolve-title" data-type={type} data-id={id}><DetailLoadingFrame kind={type}/></div></Tracker>
<script>
import {navigate} from 'astro:transitions/client';
import {resolveTitleId} from '../lib/title-discovery';
import {mountDetailResolution} from '../lib/detail-resolution';
let controller:AbortController|undefined;
document.addEventListener('astro:page-load', () => {
  controller?.abort();
  const host=document.querySelector<HTMLElement>('#resolve-title');
  if(!host)return;
  const current=new AbortController();controller=current;
  mountDetailResolution(host,async signal=>`/title/${await resolveTitleId(host.dataset.type as 'movie'|'series',Number(host.dataset.id),signal)}`,
    url=>navigate(url,{history:'replace'}),current.signal);
  document.addEventListener('astro:before-preparation',()=>current.abort(),{once:true,signal:current.signal});
});
</script>
