---
import MediaDetailPage from '../../components/MediaDetailPage.astro';
import {tracker} from '../../lib/tracker';
import {localMediaId} from '../../lib/media-detail-data';
import {hasStreamingLibraryConnection} from '../../lib/streaming-library-availability';

const id = localMediaId(Astro.params.id);
let media = null, library = null, error = '', libraryError = '';
let canUseLibrary = false;
if (!id) { Astro.response.status = 404; error = 'Media not found.'; }
else {
  try { media = await tracker(`title/${id}`,Astro.locals.token); }
  catch (cause) { error = (cause as Error).message; Astro.response.status = error === 'Not found.' ? 404 : 503; }
  if (media && Astro.locals.user) {
    canUseLibrary = await hasStreamingLibraryConnection(Astro.locals.token);
    if (canUseLibrary) {
      try { library = await tracker(`library/${id}`,Astro.locals.token); }
      catch (cause) { libraryError = (cause as Error).message; }
    }
  }
}
---
<MediaDetailPage {media} {library} {error} {libraryError} {canUseLibrary}/>
