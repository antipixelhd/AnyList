---
import Tracker from '../../layouts/Tracker.astro';
import StatusControl from '../../components/StatusControl.astro';
import Icon from '../../components/Icon.astro';
import { tracker, scoreLabel } from '../../lib/tracker';
import { responsiveArtwork } from '../../lib/responsive-artwork';
import { hasStreamingLibraryConnection } from '../../lib/streaming-library-availability';

let title: any = null;
let library: any = null;
let error = '';
let libraryError = '';
const canUseStreamingLibrary = await hasStreamingLibraryConnection(Astro.locals.token);
try {
  title = await tracker(`title/${Astro.params.id}`, Astro.locals.token);
} catch (cause) {
  error = (cause as Error).message;
}
if (title && canUseStreamingLibrary) {
  try { library = await tracker(`library/${title.id}`, Astro.locals.token); }
  catch (cause) { libraryError = (cause as Error).message; }
}

const runtimeLabel = (minutes: number | null, suffix = '') => {
  if (!minutes) return null;
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  const value = hours ? `${hours}h${rest ? ` ${rest}m` : ''}` : `${rest}m`;
  return suffix ? `${value} ${suffix}` : value;
};
const names = (items: any[] = []) => items.map((item) => item?.name).filter(Boolean);
const percentLabel = (value: number | null) => value == null ? '—' : `${Math.round(value)}%`;
const personalScoreLabel = (value: number | null) => value == null || value === 0 ? '—' : `${value.toFixed(1)} / 10`;
const dateLabel = (value: string | null) => value
  ? new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(`${value.slice(0, 10)}T00:00:00`))
  : null;
const backdropImage = responsiveArtwork(title?.backdrop,{size:'w1280',sizes:'100vw',route:'direct'});
const posterImage = responsiveArtwork(title?.poster,{size:'w500',sizes:'(max-width:650px) 100px, 200px',route:'direct'});
const quickRatePoster = responsiveArtwork(title?.poster,{size:'w185',sizes:'42px',route:'direct'});
---
<Tracker title={title?.title || 'Title'}>
  {title ? (
    <>
      <div class="detail-banner">
        {backdropImage?.src && <img class="detail-banner-image" src={backdropImage.src} srcset={backdropImage.srcset} sizes={backdropImage.sizes} alt="" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center" />}
      </div>
      <div class="detail-layout">
        <aside class="detail-sidebar">
          {posterImage?.src ? (
            <img class="detail-poster" src={posterImage.src} srcset={posterImage.srcset} sizes={posterImage.sizes} alt={`${title.title} poster`} />
          ) : <div class="detail-poster detail-poster-placeholder" aria-hidden="true">{title.title.slice(0, 1)}</div>}
          {Astro.locals.user && (
            <div class="detail-controls">
              <StatusControl mediaId={title.id} status={title.entry?.status} type={title.type} />
              <button class="button-secondary favorite-toggle" type="button" aria-pressed={title.entry?.favorite?'true':'false'} data-favorite-toggle data-media={title.id} data-favorite={title.entry?.favorite?'true':'false'}><Icon name="heart"/><span data-favorite-label>{title.entry?.favorite?'Favorited':'Favorite'}</span></button>
              <p class="status-error" role="alert" data-favorite-error hidden></p>
              {canUseStreamingLibrary&&<button class="button-secondary library-toggle" type="button" aria-pressed={library?.desired?'true':'false'} aria-label={library?.desired?'Remove from library':'Add to library'} data-library-toggle data-media={title.id} data-desired={library?.desired?'true':'false'} disabled={!library}><Icon name="list"/><span data-library-label>{library?.desired?'In Library':'Add to library'}</span></button>}
              <p class="status-error" role="alert" data-library-error hidden={!libraryError}>{libraryError}</p>
            </div>
          )}

          <dl class="detail-facts">
            <dt>Format</dt><dd>{title.type === 'series' ? 'TV series' : 'Movie'}</dd>
            <dt>Released</dt><dd>{dateLabel(title.release_date) || title.year || 'Unknown'}</dd>
            <dt>Release status</dt><dd>{title.release_status || 'Unknown'}</dd>
            {title.type === 'movie' && title.runtime && <><dt>Runtime</dt><dd>{runtimeLabel(title.runtime)}</dd></>}
            {title.type === 'series' && title.episode_runtime && <><dt>Episode runtime</dt><dd>{runtimeLabel(title.episode_runtime, 'per episode')}</dd></>}
            {title.type === 'series' && title.season_count && <><dt>Seasons</dt><dd>{title.season_count}</dd></>}
            {title.type === 'series' && title.episode_count && <><dt>Episodes</dt><dd>{title.episode_count}</dd></>}
            {title.original_language && <><dt>Original language</dt><dd>{String(title.original_language).toUpperCase()}</dd></>}
            {names(title.networks).length > 0 && <><dt>Networks</dt><dd>{names(title.networks).join(', ')}</dd></>}
            {names(title.studios).length > 0 && <><dt>Studios</dt><dd>{names(title.studios).join(', ')}</dd></>}
            {names(title.creators).length > 0 && <><dt>Created by</dt><dd>{names(title.creators).join(', ')}</dd></>}
            <dt>Genres</dt><dd>{title.genres.join(', ') || '—'}</dd>
          </dl>

          <nav class="external-links" aria-label="External title links">
            {title.tmdb_id && <a href={`https://www.themoviedb.org/${title.type === 'series' ? 'tv' : 'movie'}/${title.tmdb_id}`} target="_blank" rel="noreferrer">TMDB <Icon name="external" /></a>}
            {title.imdb_id && <a href={`https://www.imdb.com/title/${title.imdb_id}/`} target="_blank" rel="noreferrer">IMDb <Icon name="external" /></a>}
          </nav>
        </aside>

        <div class="detail-body">
          <div class="detail-heading">
            <p class="detail-kicker">
              <span>{title.type === 'series' ? 'Series' : 'Movie'}</span>
              {title.year && <span>{title.year}</span>}
              {title.release_status && <span>{title.release_status}</span>}
            </p>
            <h1>{title.title}</h1>
            {title.original_title && title.original_title !== title.title && <p class="original-title">{title.original_title}</p>}
            {title.tagline && <p class="detail-tagline">“{title.tagline}”</p>}
          </div>

          <section class="ratings-overview" aria-label="Ratings">
            <div class="personal-scores">
              {Astro.locals.user ? (
                <button class="personal-score-button" aria-label={`Rate ${title.title}. Current score: ${personalScoreLabel(title.entry?.score ?? null)}`} data-quick-rate-id={title.id} data-quick-rate-title={title.title} data-quick-rate-poster={quickRatePoster?.src || ''} data-quick-rate-score={title.entry?.score??''} data-quick-rate-mode={title.entry?.rating_mode??'manual'}><span>Your score</span><strong data-score-label data-score-format="out-of-ten">{personalScoreLabel(title.entry?.score ?? null)}</strong><small data-rating-mode-label>{title.entry?.rating_mode === 'average' ? 'Rated-season average' : title.entry?.score ? 'Manual rating' : 'Unrated'}</small></button>
              ) : (
                <a class="personal-score-button" href={`/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`} aria-label={`Sign in to rate ${title.title}`}><span>Your score</span><strong>—</strong><small>Sign in to rate</small></a>
              )}
              <div><span>Following</span><strong>{scoreLabel(title.friends_average)}</strong><small>{title.friends.length ? `${title.friends.length} rated` : 'No ratings yet'}</small></div>
            </div>
            <div class="provider-scores" aria-label="External ratings">
              <div><span>TMDB</span><strong>{scoreLabel(title.tmdb_score)}</strong></div>
              <div><span>IMDb</span><strong>{scoreLabel(title.imdb_score)}</strong></div>
              <div><span>RT Critics</span><strong>{percentLabel(title.rt_critic_score)}</strong></div>
              <div><span>RT Audience</span><strong>{percentLabel(title.rt_audience_score)}</strong></div>
            </div>
          </section>

          <section class="detail-section synopsis-section" id="overview">
            <h2>Overview</h2>
            <p>{title.overview || 'No synopsis available yet.'}</p>
            {title.genres.length > 0 && <div class="genre-pills">{title.genres.map((genre: string) => <span>{genre}</span>)}</div>}
          </section>

          <section class="detail-section following-section" id="social">
            <div class="detail-section-heading">
              <div><span class="eyebrow">Social</span><h2>People you follow</h2></div>
              <strong>{scoreLabel(title.friends_average)}</strong>
            </div>
            {title.friends.length ? (
              <div class="following-scores">
                {title.friends.map((friend: any) => (
                  <a class="social-score" href={`/user/${encodeURIComponent(friend.username)}/${title.type === 'movie' ? 'movies' : 'series'}`}>
                    <span class="social-avatar" aria-hidden="true">{friend.username.slice(0, 1).toUpperCase()}</span>
                    <span><strong>{friend.username}</strong><small>{friend.status}</small></span>
                    <b>{scoreLabel(friend.score)}</b>
                  </a>
                ))}
              </div>
            ) : <p class="section-empty">No ratings from people you follow yet.</p>}
          </section>

          {title.type === 'series' && (
            <section class="detail-section seasons-section" id="seasons">
              <div class="detail-section-heading">
                <div><span class="eyebrow">Episode history</span><h2>Seasons</h2></div>
                {Astro.locals.user && <button class="button-secondary" id="refresh-episodes" data-media={title.id}>Refresh episode metadata</button>}
              </div>
              {title.seasons.length ? title.seasons.map((season: any) => {
                const seasonImage = responsiveArtwork(season.poster_path,{size:'w185',sizes:'64px',route:'direct'});
                return (
                <article class="season-card">
                  {seasonImage?.src ? (
                    <img src={seasonImage.src} srcset={seasonImage.srcset} sizes={seasonImage.sizes} alt="" />
                  ) : <div class="season-poster-placeholder" aria-hidden="true">S{season.season_number}</div>}
                  <div class="season-copy">
                    <h3>{season.name || `Season ${season.season_number}`}</h3>
                    <p class="season-meta">{season.episode_count} episodes {season.air_date && ` · ${season.air_date.slice(0, 4)}`}</p>
                    {season.overview && <p class="season-overview">{season.overview}</p>}
                    {Astro.locals.user && season.season_number > 0 && (
                      <div class="season-progress">
                        <small>{season.released_count === null ? 'Refresh to load episode progress' : `${season.watched_count} / ${season.released_count} released watched`}</small>
                        <div>
                          <button class="button-secondary" data-season-progress={season.season_number} data-watched="true" data-media={title.id} disabled={!season.released_count}>Mark watched</button>
                          <button class="button-secondary" data-season-progress={season.season_number} data-watched="false" data-media={title.id} disabled={!season.watched_count}>Mark unwatched</button>
                        </div>
                      </div>
                    )}
                  </div>
                  {Astro.locals.user && (
                    <div class="season-score"><label for={`season-score-${season.season_number}`}>Season score</label>
                      <span><span class="score-stepper" data-score-stepper><input id={`season-score-${season.season_number}`} type="number" step="0.1" min="0" max="10" placeholder="—" value={title.entry?.season_scores?.[String(season.season_number)] ?? ''} data-season={season.season_number} aria-label={`Season ${season.season_number} score`} /><span class="score-stepper-controls"><button type="button" data-score-step="up" aria-label={`Increase season ${season.season_number} score to the next half point`}><Icon name="chevron-down" rotate={180} /></button><button type="button" data-score-step="down" aria-label={`Decrease season ${season.season_number} score to the previous half point`}><Icon name="chevron-down" /></button></span></span><button class="button-secondary" data-save-season={season.season_number} data-media={title.id} data-has-seasons={Object.values(title.entry?.season_scores || {}).some(Boolean) ? 'yes' : 'no'}>Save</button></span>
                    </div>
                  )}
                </article>
                );
              }) : <p class="section-empty">Season metadata has not been loaded yet.</p>}
            </section>
          )}
          <p id="season-message" role="status"></p>
        </div>
      </div>
      <dialog class="editor" id="season-mode">
        <div class="editor-header"><h2>How should your show score work?</h2></div>
        <form method="dialog" class="season-mode-form">
          <p>Season scores stay independent. Other seasons won't be rated automatically.</p>
          <div class="season-mode-actions"><button class="button-primary" value="average">Average my rated seasons</button><button class="button-secondary" value="manual">Keep a separate show rating</button><button class="button-secondary" value="cancel">Cancel</button></div>
        </form>
      </dialog>
    </>
  ) : <div class="page-width"><p class="error-message">{error}</p></div>}
</Tracker>

<script>
import { setupScoreSteppers } from '../../lib/scoreStepper';
import { showDialog, closeDialog } from '../../lib/ui-motion';
let titlePageListeners: AbortController;
document.addEventListener('astro:page-load', () => {
titlePageListeners?.abort();
titlePageListeners = new AbortController();
if (!document.querySelector('[data-favorite-toggle], [data-library-toggle], #refresh-episodes')) return;
const seasons = document.querySelector<HTMLElement>('.seasons-section');
if (seasons) setupScoreSteppers(seasons);
document.querySelector<HTMLButtonElement>('#refresh-episodes')?.addEventListener('click',async(event)=>{
 const button=event.currentTarget as HTMLButtonElement;button.disabled=true;button.textContent='Loading episodes…';
 try{const res=await fetch(`/api/proxy/tracking/title/${button.dataset.media}/refresh-episodes`,{method:'POST'});if(!res.ok){const data=await res.json();throw new Error(data.detail||'Unable to refresh episodes');}location.reload();}
 catch(e){document.querySelector('#season-message')!.textContent=(e as Error).message;button.disabled=false;button.textContent='Refresh episode metadata';}
});
function coalescedToggle(button:HTMLButtonElement, initial:boolean, error:HTMLElement,
 render:(value:boolean)=>void, save:(value:boolean)=>Promise<boolean>, failureMessage:string){
 let desired=initial, confirmed=initial, revision=0, sending=false, timer=0;
 const schedule=()=>{
  clearTimeout(timer);
  if(sending)return;
  if(desired===confirmed){button.removeAttribute('aria-busy');return;}
  button.setAttribute('aria-busy','true');
  timer=window.setTimeout(flush,300);
 };
 async function flush(){
  if(sending||desired===confirmed)return;
  clearTimeout(timer);
  const sent=desired, sentRevision=revision;
  sending=true;
  try{
   const actual=await save(sent);
   confirmed=actual;
   if(revision===sentRevision)desired=actual;
   render(desired);
  }catch(cause){
   if(revision===sentRevision){
    desired=confirmed;render(desired);
    error.textContent=cause instanceof Error?cause.message:failureMessage;error.hidden=false;
   }
  }finally{
   sending=false;
   if(desired!==confirmed)schedule();
   else button.removeAttribute('aria-busy');
  }
 }
 button.addEventListener('click',()=>{
  desired=!desired;revision++;render(desired);error.hidden=true;schedule();
 },{signal:titlePageListeners.signal});
 const flushBeforeLeave=()=>{if(!sending)void flush();};
 window.addEventListener('pagehide',flushBeforeLeave,{signal:titlePageListeners.signal});
 document.addEventListener('astro:before-swap',flushBeforeLeave,{signal:titlePageListeners.signal});
}
const favoriteButton=document.querySelector<HTMLButtonElement>('[data-favorite-toggle]');
if(favoriteButton){
 const render=(value:boolean)=>{
  favoriteButton.dataset.favorite=String(value);
  favoriteButton.setAttribute('aria-pressed',String(value));
  favoriteButton.querySelector<HTMLElement>('[data-favorite-label]')!.textContent=value?'Favorited':'Favorite';
 };
 coalescedToggle(favoriteButton,favoriteButton.dataset.favorite==='true',document.querySelector<HTMLElement>('[data-favorite-error]')!,render,async value=>{
  const response=await fetch(`/api/proxy/tracking/entry/${favoriteButton.dataset.media}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({favorite:value}),keepalive:true});
  if(!response.ok){const data=await response.json().catch(()=>null);throw new Error(typeof data?.detail==='string'?data.detail:'Could not update this favorite.');}
  const entry=await response.json();
  document.dispatchEvent(new CustomEvent('anylist:data-changed'));
  return entry.favorite===true;
 },'Could not update this favorite.');
}
const libraryButton=document.querySelector<HTMLButtonElement>('[data-library-toggle]');
if(libraryButton&&!libraryButton.disabled){
 const render=(value:boolean)=>{
  libraryButton.dataset.desired=String(value);
  libraryButton.setAttribute('aria-pressed',String(value));
  libraryButton.setAttribute('aria-label',value?'Remove from library':'Add to library');
  libraryButton.querySelector<HTMLElement>('[data-library-label]')!.textContent=value?'In Library':'Add to library';
 };
 coalescedToggle(libraryButton,libraryButton.dataset.desired==='true',document.querySelector<HTMLElement>('[data-library-error]')!,render,async value=>{
  const response=await fetch(`/api/proxy/tracking/library/${libraryButton.dataset.media}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({in_library:value}),keepalive:true});
  if(!response.ok){const data=await response.json().catch(()=>null);throw new Error(typeof data?.detail==='string'?data.detail:'Could not update the streaming library.');}
  return (await response.json()).desired===true;
 },'Could not update the streaming library.');
}
document.querySelectorAll<HTMLButtonElement>('[data-season-progress]').forEach(button=>button.addEventListener('click',async()=>{
 button.disabled=true;
 const body={watched:button.dataset.watched==='true',confirm_rollback:false};
 const send=()=>fetch(`/api/proxy/tracking/entry/${button.dataset.media}/season/${button.dataset.seasonProgress}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
 try{
  let res=await send();
  if(res.status===409){
   const error=await res.json();
   if(String(error.detail).includes('Confirm to continue')){
    if(!confirm(error.detail)){button.disabled=false;return;}
    body.confirm_rollback=true;res=await send();
   }else throw new Error(error.detail);
  }
  if(!res.ok){const error=await res.json();throw new Error(error.detail||'Unable to update season.');}
  location.reload();
 }catch(e){document.querySelector('#season-message')!.textContent=(e as Error).message;button.disabled=false;}
}));
document.querySelectorAll<HTMLButtonElement>('[data-save-season]').forEach(button=>button.addEventListener('click',async()=>{
 const input=document.querySelector<HTMLInputElement>(`[data-season="${button.dataset.saveSeason}"]`)!;
 if(!input.reportValidity())return;
 const body:any={season_scores:{[button.dataset.saveSeason!]:Number(input.value||0)}};
 if(button.dataset.hasSeasons==='no'&&Number(input.value)>0){
  const dialog=document.querySelector<HTMLDialogElement>('#season-mode')!;
  dialog.returnValue='cancel';showDialog(dialog);
  const mode=await new Promise<string>(resolve=>dialog.addEventListener('close',()=>resolve(dialog.returnValue),{once:true}));
  if(!['manual','average'].includes(mode))return;
  body.rating_mode=mode;
 }
 button.disabled=true;
 try{const res=await fetch(`/api/proxy/tracking/entry/${button.dataset.media}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(!res.ok){const responseError=await res.json();throw new Error(typeof responseError.detail==='string'?responseError.detail:'Unable to save score.');}location.reload();}
 catch(e){document.querySelector('#season-message')!.textContent=(e as Error).message;button.disabled=false;}
}));
const seasonModeDialog=document.querySelector<HTMLDialogElement>('#season-mode');
seasonModeDialog?.addEventListener('click',event=>{if(event.target===seasonModeDialog)void closeDialog(seasonModeDialog,'cancel');});
if(new URLSearchParams(location.search).get('rate')==='1'){
 const button=document.querySelector<HTMLElement>('[data-quick-rate-id]');
 if(button)setTimeout(()=>button.click(),0);
}
});
</script>
