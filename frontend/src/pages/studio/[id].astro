---
import Tracker from '../../layouts/Tracker.astro';
import Icon from '../../components/Icon.astro';
import { tracker, artwork } from '../../lib/tracker';
import { countryLabel } from '../../lib/stats-overview-data';
const id = Astro.params.id || '';
const key = /^\d+$/.test(id) ? `tmdb:${id}` : id;
Astro.response.headers.set('Cache-Control', 'private, no-store');
let studio: {name: string; image: string | null; description: string | null; countries: string[]} | null = null;
let error = '';
try { studio = await tracker(`studios/${encodeURIComponent(key)}`, Astro.locals.token); }
catch (cause) { error = (cause as Error).message; Astro.response.status = error === 'Not found.' ? 404 : 503; }
const logo = artwork(studio?.image || null, 'w500');
---
<Tracker title={studio?.name || 'Studio'}>
  <div class="page-width studio-page">
    {studio ? <>
      <header class="studio-header">
        <div class="studio-logo">{logo ? <img src={logo} alt={`${studio.name} logo`} /> : <Icon name="film" />}</div>
        <div><span class="studio-type">Studio</span><h1>{studio.name}</h1>
          {studio.countries.length > 0 && <dl><div><dt>Country</dt><dd>{studio.countries.map(countryLabel).join(', ')}</dd></div></dl>}
        </div>
      </header>
      {studio.description && <section class="studio-description"><h2>About</h2><p>{studio.description}</p></section>}
    </> : <p class="error-message" role="alert">{error}</p>}
  </div>
</Tracker>
<style>
  .studio-page { padding-block:52px 80px; }
  .studio-header { display:flex; align-items:center; gap:36px; }
  .studio-logo { flex:0 0 180px; height:180px; display:grid; place-items:center; padding:22px; background:var(--panel); border-radius:8px; color:var(--muted); font-size:48px; }
  .studio-logo img { width:100%; height:100%; object-fit:contain; }
  .studio-type,dt { color:var(--muted); font-size:13px; }
  h1 { margin:8px 0 20px; color:var(--bright); font-size:clamp(28px,4vw,42px); line-height:1.15; }
  dl { margin:0; } dl>div { display:flex; gap:16px; } dd { margin:0; color:var(--text); }
  .studio-description { max-width:760px; margin-top:42px; } h2 { color:var(--bright); font-size:20px; } p { color:var(--text); line-height:1.7; white-space:pre-line; }
  @media(max-width:650px) { .studio-page { padding-top:30px; } .studio-header { gap:22px; align-items:flex-start; } .studio-logo { flex-basis:100px; height:100px; padding:14px; } }
</style>
