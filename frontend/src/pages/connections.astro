                <input
                  type="password"
                  id="scrob_api_key"
                  readonly
                  value={me.api_key}
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 font-mono text-sm focus:outline-none cursor-default select-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle key visibility"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
              <button
                type="button"
                id="copy-api-key-btn"
                title="Copy to clipboard"
                class="px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                </svg>
              </button>
            </div>
          </div>
          <button
            type="button"
            id="regenerate-api-key-btn"
            class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 rounded-lg text-sm transition-colors cursor-pointer disabled:opacity-50"
          >
            Regenerate Key
          </button>
        </div>
      </section>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="confirm-action-modal" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-8 max-w-md w-full shadow-2xl">
      <h2 id="confirm-action-title" class="text-2xl font-bold text-zinc-100 mb-2"></h2>
      <p id="confirm-action-body" class="text-zinc-400 mb-8 text-sm leading-relaxed"></p>
      <div class="flex gap-3">
        <button type="button" id="cancel-action" class="flex-1 px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer">Cancel</button>
        <button type="button" id="confirm-action" class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-zinc-100 font-bold rounded-xl transition-all cursor-pointer"></button>
      </div>
    </div>
  </div>

  <DataImportDialogs />

  <!-- Season remap / unmatched show match modal -->
  <div id="season-remap-modal" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl flex flex-col max-h-[90vh]">
      <div class="flex items-center justify-between px-6 py-5 border-b border-zinc-800 shrink-0">
        <div>
          <h2 id="remap-modal-title" class="text-lg font-bold text-zinc-100">Remap Season</h2>
          <p id="remap-source-label" class="text-sm text-zinc-400 mt-0.5"></p>
        </div>
        <button type="button" id="remap-close" class="text-zinc-500 hover:text-zinc-300 transition-colors cursor-pointer p-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div class="px-6 py-5 overflow-y-auto flex-1 space-y-5">
        <!-- Tab bar (match mode only) -->
        <div id="match-tab-bar" class="hidden flex gap-1 p-1 bg-zinc-950 rounded-xl">
          <button type="button" id="match-tab-tvdb" class="flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer bg-zinc-800 text-zinc-100">TVDB</button>
          <button type="button" id="match-tab-tmdb" class="flex-1 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors cursor-pointer text-zinc-400 hover:text-zinc-200">TMDB</button>
        </div>
        <!-- TMDB title search (remap mode) -->
        <div id="remap-tmdb-section">
          <label id="remap-tmdb-label" class="block text-sm font-medium text-zinc-400 mb-2">Search for the correct TMDB show</label>
          <div class="flex gap-2">
            <input type="text" id="remap-search-input" placeholder="Show title…" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2.5 text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            <button type="button" id="remap-search-btn" class="px-4 py-2.5 bg-zinc-700 hover:bg-zinc-600 text-zinc-100 text-sm font-medium rounded-lg transition-colors cursor-pointer shrink-0">Search</button>
          </div>
          <div id="remap-search-results" class="mt-2 space-y-1 max-h-48 overflow-y-auto scrollbar-hidden"></div>
        </div>
        <!-- TVDB title search (match mode) -->
        <div id="remap-tvdb-section" class="hidden">
          <label class="block text-sm font-medium text-zinc-400 mb-2">Search for the show on TVDB</label>
          <div class="flex gap-2">
            <input type="text" id="remap-tvdb-input" placeholder="Show title…" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2.5 text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            <button type="button" id="remap-tvdb-search-btn" class="px-4 py-2.5 bg-zinc-700 hover:bg-zinc-600 text-zinc-100 text-sm font-medium rounded-lg transition-colors cursor-pointer shrink-0">Search</button>
          </div>
          <div id="remap-tvdb-results" class="mt-2 space-y-1 max-h-48 overflow-y-auto scrollbar-hidden"></div>
        </div>
        <!-- Selected show + season input -->
        <div id="remap-selected-area" class="hidden">
          <div class="flex items-center gap-3 p-3 bg-zinc-800 rounded-xl mb-4">
            <img id="remap-selected-poster" src="" alt="" class="w-10 h-14 object-cover rounded-md bg-zinc-700 shrink-0" />
            <div class="flex-1 min-w-0">
              <p id="remap-selected-title" class="text-sm font-medium text-zinc-100 truncate"></p>
              <p id="remap-selected-year" class="text-xs text-zinc-500"></p>
            </div>
            <button type="button" id="remap-clear-selection" class="text-zinc-500 hover:text-zinc-300 cursor-pointer text-xs shrink-0">Change</button>
          </div>
          <div id="remap-seasons-area">
            <label id="remap-seasons-label" class="block text-sm font-medium text-zinc-400 mb-2">Select the target season</label>
            <div id="remap-seasons-list" class="space-y-1 overflow-y-auto" style="max-height: calc(var(--spacing) * 49)"></div>
            <p id="remap-seasons-loading" class="text-xs text-zinc-500 py-1 hidden">Loading seasons…</p>
          </div>
        </div>
        <p id="remap-error" class="text-sm text-red-400 hidden"></p>
      </div>
      <div class="px-6 py-4 border-t border-zinc-800 flex gap-3 shrink-0">
        <button type="button" id="remap-cancel" class="flex-1 px-4 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 text-sm font-medium rounded-xl transition-colors cursor-pointer">Cancel</button>
        <button type="button" id="remap-save" class="flex-1 px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-xl transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" disabled>Save &amp; Apply</button>
      </div>
    </div>
  </div>
</TrackerSettings>

<script>
  import { escapeHtml as esc, errorMessage, showMessage } from '../lib/settings-feedback';
  import { readTrackingServiceSettings } from '../lib/tracking-service-settings';
  import { wireCancelButton } from '../lib/sync-controls';
  import { createSyncJobMonitor } from '../lib/sync-job-monitor';
  import { createSyncProgressRenderer } from '../lib/sync-progress';
  import { mountDataImports } from '../lib/data-import-controls';
  import { mountSeasonRemap } from '../lib/season-remap-controller';
  let seasonRemap: ReturnType<typeof mountSeasonRemap>;
  let dataImports: ReturnType<typeof mountDataImports> | undefined;
  document.addEventListener('astro:before-swap', () => {
    dataImports?.stop();
    seasonRemap?.stop();
    seasonRemap = undefined;
  });
  import { arrCredentials, arrSettings, fetchArrProfiles, renderArrProfiles } from '../lib/arr-settings';
  import { showOverlay, hideOverlay, showCollapsible, hideCollapsible } from '../lib/ui-motion';

  document.addEventListener('click', event => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-warning-toggle]');
    const id = button?.dataset.warningToggle;
    const pane = id ? document.getElementById(id) : null;
    if (!button || !pane) return;
    const open = !pane.classList.contains('hidden') && !pane.inert;
    if (open) void hideCollapsible(pane);
    else showCollapsible(pane);
    button.querySelector('.warn-chevron')?.classList.toggle('rotate-180', !open);
    button.setAttribute('aria-expanded', String(!open));
  });

  const appData = document.getElementById('app-data');
  const token = appData?.dataset.token ?? '';

  const streamPullPreferences = [
    { key: 'sync_collection', label: 'Collection status' },
    { key: 'sync_watched', label: 'Watched status' },
    { key: 'sync_playback', label: 'Playback progress' },
  ];
  const streamPushPreferences = [
    { key: 'push_collection', label: 'Collection status' },
    { key: 'push_watched', label: 'Watched status' },
    { key: 'push_playback', label: 'Playback progress' },
  ];
  const activeConnectionJobs = new Set<string>();
  const connectionSaveWaiters = new Map<string, Set<() => void>>();

  function connectionCard(connId: string): HTMLElement | null {
    return document.querySelector<HTMLElement>(`[data-connection-id="${CSS.escape(connId)}"]`);
  }

  function selectedConnectionPreferences(card: HTMLElement | null, preferences: { key: string; label: string }[], saved = false): string[] {
    if (!card) return [];
    return preferences
      .filter(({ key }) => {
        const input = card.querySelector<HTMLInputElement>(`.conn-pref-checkbox[data-pref="${key}"]`);
        return saved ? input?.dataset.savedChecked === 'true' : !!input?.checked;
      })
      .map(({ label }) => label);
  }

  function connectionPreferencesChanged(card: HTMLElement | null, preferences: { key: string; label: string }[]): boolean {
    if (!card) return false;
    return preferences.some(({ key }) => {
      const input = card.querySelector<HTMLInputElement>(`.conn-pref-checkbox[data-pref="${key}"]`);
      return !!input && String(input.checked) !== input.dataset.savedChecked;
    });
  }

  function updateConnectionActionControls(connId: string) {
    const card = connectionCard(connId);
    if (!card) return;
    const busy = activeConnectionJobs.has(connId)
      || card.dataset.connectionOperationPending === 'true'
      || card.dataset.connectionSavePending === 'true';
    const pushSelection = selectedConnectionPreferences(card, streamPushPreferences);
    const pullSelection = selectedConnectionPreferences(card, streamPullPreferences);
    const hasUnsavedPush = connectionPreferencesChanged(card, streamPushPreferences);
    const hasUnsavedPull = connectionPreferencesChanged(card, streamPullPreferences);

    card.querySelectorAll<HTMLButtonElement>('[data-connection-job-control]').forEach(button => {
      const kind = button.dataset.connectionActionKind;
      const unavailable = button.dataset.configDisabled === 'true'
        || (kind === 'clear' && (pushSelection.length === 0 || hasUnsavedPush))
        || (kind === 'full-resync' && (pullSelection.length === 0 || hasUnsavedPull));
      button.disabled = busy || unavailable;
      button.classList.toggle('opacity-50', button.disabled);
      if (kind === 'clear') {
        button.title = pushSelection.length === 0
          ? 'Enable and save at least one outbound option first'
          : hasUnsavedPush
            ? 'Save outbound changes before clearing data so the selected fields match'
            : `Clear ${formatList(selectedConnectionPreferences(card, streamPushPreferences, true))} from ${button.dataset.connName || 'this connection'}`;
      } else if (kind === 'full-resync') {
        button.title = button.dataset.configDisabled === 'true'
          ? 'TMDB Read Access Token is required for sync'
          : pullSelection.length === 0
            ? 'Enable and save at least one pull option first'
            : hasUnsavedPull
              ? 'Save pull changes before starting a full resync'
              : `Discard the saved snapshot and start a fresh import from ${button.dataset.connName || 'this connection'}`;
      }
    });

    card.querySelectorAll<HTMLInputElement>('.conn-pref-checkbox').forEach(input => {
      input.disabled = busy;
    });
  }

  function setConnectionJobActive(connId: string, active: boolean) {
    if (active) activeConnectionJobs.add(connId);
    else activeConnectionJobs.delete(connId);
    updateConnectionActionControls(connId);
  }

  function setConnectionSavePending(connId: string, pending: boolean) {
    const card = connectionCard(connId);
    if (card) {
      card.dataset.connectionSavePending = String(pending);
      updateConnectionActionControls(connId);
    }
    if (!pending) {
      const waiters = connectionSaveWaiters.get(connId);
      waiters?.forEach(resolve => resolve());
      connectionSaveWaiters.delete(connId);
    }
  }

  function setConnectionOperationPending(connId: string, pending: boolean) {
    const card = connectionCard(connId);
    if (!card) return;
    card.dataset.connectionOperationPending = String(pending);
    updateConnectionActionControls(connId);
  }

  async function waitForConnectionSave(connId: string) {
    while (connectionCard(connId)?.dataset.connectionSavePending === 'true') {
      await new Promise<void>(resolve => {
        const waiters = connectionSaveWaiters.get(connId) ?? new Set<() => void>();
        waiters.add(resolve);
        connectionSaveWaiters.set(connId, waiters);
      });
    }
  }







  // ── Per-connection progress tracking ─────────────────────────────────────

  function renderConnProgress(connId: string, job: any) {
    const strip = document.getElementById(`conn-progress-${connId}`);
    const bar   = document.getElementById(`conn-job-bar-${connId}`);
    const pctEl = document.getElementById(`conn-job-pct-${connId}`);
    const label = document.getElementById(`conn-job-label-${connId}`);
    const items = document.getElementById(`conn-job-items-${connId}`);
    const statusEl = document.getElementById(`conn-job-status-${connId}`);
    const cancelBtn = document.getElementById(`conn-job-cancel-${connId}`) as HTMLButtonElement | null;
    if (!strip) return;

    if (!job) { strip.classList.add('hidden'); return; }

    strip.classList.remove('hidden');

    const isPush = job.job_type === 'push';
    const isClear = job.job_type === 'clear';
    const isFailed = job.status === 'failed';
    const isCancelled = job.status === 'cancelled';
    const isCompleted = job.status === 'completed';
    const isPending = job.status === 'pending';

    if (isFailed || isCancelled) {
      if (cancelBtn) cancelBtn.classList.add('hidden');
      if (bar) { bar.className = 'h-1.5 rounded-full transition-all duration-500 bg-red-500'; bar.style.width = '100%'; }
      if (label) label.textContent = isCancelled
        ? (isClear ? 'Clear cancelled' : isPush ? 'Push cancelled' : 'Pull cancelled')
        : (isClear ? 'Clear failed' : isPush ? 'Push failed' : 'Pull failed');
      if (pctEl) pctEl.textContent = '';
      if (items) items.textContent = isCancelled ? '' : String(job.error_message || 'Unknown error');
      if (statusEl) statusEl.textContent = '';
      return;
    }

    if (isCompleted) {
      if (cancelBtn) cancelBtn.classList.add('hidden');
      if (bar) { bar.className = `h-1.5 rounded-full transition-all duration-500 ${isClear ? 'bg-red-500' : isPush ? 'bg-amber-500' : 'bg-blue-600'}`; bar.style.width = '100%'; }
      if (label) label.textContent = isClear ? 'Clear complete' : isPush ? 'Push complete' : 'Pull complete';
      if (pctEl) pctEl.textContent = '100%';
      const s = job.stats;
      if (items) items.textContent = isClear
        ? `${job.processed_items ?? 0} items cleared`
        : s ? `${s.succeeded ?? 0} ok, ${s.failed ?? 0} failed` : `${job.processed_items} items`;
      if (statusEl) statusEl.textContent = '';
      return;
    }

    wireCancelButton(cancelBtn, job, token, message => showMessage(message, 'error'));
    // pending / running
    const pct = job.total_items > 0
      ? Math.min(100, Math.round((job.processed_items / job.total_items) * 100))
      : 0;
    const barColor = isClear ? 'bg-red-500' : isPush ? 'bg-amber-500' : 'bg-blue-600';

    if (bar) {
      bar.className = `h-1.5 rounded-full transition-all duration-500 ${barColor}${isPending || job.total_items === 0 ? ' animate-pulse' : ''}`;
      bar.style.width = isPending || job.total_items === 0 ? '100%' : `${pct}%`;
    }
    if (label) label.textContent = isPending
      ? (isClear ? 'Clear queued…' : isPush ? 'Push queued…' : 'Pull queued…')
      : (job.current_step || (isClear ? 'Clearing…' : isPush ? 'Pushing…' : 'Pulling…'));
    if (pctEl) pctEl.textContent = job.total_items > 0 ? `${pct}%` : '';
    if (items) items.textContent = job.total_items > 0
      ? `${job.processed_items} / ${job.total_items} items`
      : 'Loading…';
    if (statusEl) statusEl.textContent = '';
  }

  let jobMonitor: ReturnType<typeof createSyncJobMonitor> | undefined;

  function startConnPoller(connId: string) {
    void jobMonitor?.watch(`connection:${connId}`, {
      matches: job => String(job.connection_id) === connId,
      render: job => renderConnProgress(connId, job),
      onUpdate: active => setConnectionJobActive(connId, active),
      onDone: () => { void loadSyncWarnings(); void loadLastSynced(); },
      onError: () => {
        const status = document.getElementById(`conn-job-status-${connId}`);
        if (status) status.textContent = 'Status unavailable; retrying…';
      },
      recentMs: 30_000,
    });
  }

  // ── Simkl progress tracking ───────────────────────────────────────────────

  const renderSimklProgress = createSyncProgressRenderer('simkl', token, message => showMessage(message, 'error'));

  function startSimklPoller(jobId?: number) {
    void jobMonitor?.watch('simkl', {
      matches: job => job.source === 'simkl',
      render: renderSimklProgress,
      jobId,
      hideMs: 4000,
    });
  }

  // ── Trakt progress tracking ───────────────────────────────────────────────

  const renderTraktProgress = createSyncProgressRenderer('trakt', token, message => showMessage(message, 'error'));

  function startTraktPoller(jobId?: number) {
    void jobMonitor?.watch('trakt', {
      matches: job => job.source === 'trakt' && job.job_type !== 'import',
      render: renderTraktProgress,
      jobId,
      hideMs: 4000,
    });
  }

  // ── Trakt export-import progress (the "Import" section's upload box) ─────
  const renderTraktImportProgress = createSyncProgressRenderer('trakt-import', token, message => showMessage(message, 'error'));

  function startTraktImportPoller(jobId?: number) {
    void jobMonitor?.watch('trakt-import', {
      matches: job => job.source === 'trakt' && job.job_type === 'import',
      render: renderTraktImportProgress,
      jobId,
      hideMs: 4000,
    });
  }

  // ── Scrob export-import progress (the "Import" section's Scrob tab) ──────

  const renderScrobImportProgress = createSyncProgressRenderer('scrob-import', token, message => showMessage(message, 'error'));

  function startScrobImportPoller(jobId?: number) {
    void jobMonitor?.watch('manual-import', {
      matches: job => job.source === 'manual' && job.job_type === 'import',
      render: renderScrobImportProgress,
      jobId,
      hideMs: 4000,
    });
  }

  // ── Yamtrack/Floppy import progress (the "Import" section's Yamtrack tab) ──

  const renderYamtrackImportProgress = createSyncProgressRenderer('yamtrack-import', token, message => showMessage(message, 'error'));

  function startYamtrackImportPoller(jobId?: number) {
    void jobMonitor?.watch('yamtrack-import', {
      matches: job => job.source === 'yamtrack' && job.job_type === 'import',
      render: renderYamtrackImportProgress,
      jobId,
      hideMs: 4000,
    });
  }

  // ── MDBList progress tracking ─────────────────────────────────────────────
  const renderMdblistProgress = createSyncProgressRenderer('mdblist', token, message => showMessage(message, 'error'));

  function startMdblistPoller(jobId?: number) {
    void jobMonitor?.watch('mdblist', {
      matches: job => job.source === 'mdblist',
      render: renderMdblistProgress,
      jobId,
      hideMs: 8000,
    });
  }

  // ── Bingebase progress tracking ───────────────────────────────────────────

  const renderBingebaseProgress = createSyncProgressRenderer('bingebase', token, message => showMessage(message, 'error'));

  function startBingebasePoller(jobId?: number) {
    void jobMonitor?.watch('bingebase', {
      matches: job => job.source === 'bingebase',
      render: renderBingebaseProgress,
      jobId,
      hideMs: 4000,
    });
  }

  function setupJobMonitoring() {
    jobMonitor?.stop();
    jobMonitor = undefined;
    if (!document.querySelector('[data-connections-page]')) return;
    jobMonitor = createSyncJobMonitor(document.getElementById('app-data')?.dataset.token ?? '');
    const ids = new Set(Array.from(document.querySelectorAll<HTMLElement>('[data-connection-id]')).map(card => card.dataset.connectionId!));
    ids.forEach(startConnPoller);
    startSimklPoller();
    startTraktPoller();
    startTraktImportPoller();
    startScrobImportPoller();
    startYamtrackImportPoller();
    startMdblistPoller();
    startBingebasePoller();
  }
  setupJobMonitoring();

  // ── End progress tracking ─────────────────────────────────────────────────

  function formatList(items: string[]): string {
    if (items.length === 0) return '';
    if (items.length === 1) return items[0];
    if (items.length === 2) return `${items[0]} and ${items[1]}`;
    return `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`;
  }

  function showConfirmModal(title: string, body: string, confirmLabel: string, infoOnly = false): Promise<boolean> {
    return new Promise(resolve => {
      const modal = document.getElementById('confirm-action-modal');
      const titleEl = document.getElementById('confirm-action-title');
      const bodyEl = document.getElementById('confirm-action-body');
      const confirmBtn = document.querySelector<HTMLButtonElement>('#confirm-action');
      const cancelBtn = document.querySelector<HTMLButtonElement>('#cancel-action');
      if (!modal || !titleEl || !bodyEl || !confirmBtn || !cancelBtn) { resolve(false); return; }
      titleEl.textContent = title;
      bodyEl.textContent = body;
      confirmBtn.textContent = confirmLabel;
      cancelBtn.classList.toggle('hidden', infoOnly);
      showOverlay(modal);
      const cleanup = (result: boolean) => {
        void hideOverlay(modal);
        cancelBtn.classList.remove('hidden');
        confirmBtn.removeEventListener('click', onConfirm);
        cancelBtn.removeEventListener('click', onCancel);
        resolve(result);
      };
      const onConfirm = () => cleanup(infoOnly ? false : true);
      const onCancel = () => cleanup(false);
      confirmBtn.addEventListener('click', onConfirm, { once: true });
      cancelBtn.addEventListener('click', onCancel, { once: true });
    });
  }

  function setConnStatus(id: string, state: 'checking' | 'connected' | 'disconnected') {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('hidden');
    if (state === 'checking') {
      el.textContent = 'Checking…';
      el.className = 'conn-status-badge text-xs font-normal px-1.5 py-0.5 rounded bg-zinc-700 text-zinc-400';
    } else if (state === 'connected') {
      el.textContent = '● Connected';
      el.className = 'conn-status-badge text-xs font-normal px-1.5 py-0.5 rounded bg-green-500/15 text-green-400';
    } else if (state === 'disconnected') {
      el.textContent = '● Disconnected';
      el.className = 'conn-status-badge text-xs font-normal px-1.5 py-0.5 rounded bg-red-500/15 text-red-400';
    }
  }

  async function checkConnections() {
    if (!token) return;
    const traktConnected = !!document.querySelector<HTMLButtonElement>('#trakt-disconnect-btn');
    const simklConnected = !!document.querySelector<HTMLButtonElement>('#simkl-disconnect-btn');
    const mdblistConfigured = !!document.querySelector<HTMLInputElement>('#mdblist_api_key')?.value;
    const radarrConfigured = !!document.querySelector<HTMLInputElement>('#radarr_url')?.value;
    const sonarrConfigured = !!document.querySelector<HTMLInputElement>('#sonarr_url')?.value;
    const mediaServerIds = Array.from(document.querySelectorAll<HTMLElement>('[data-connection-id]'))
      .map(el => el.getAttribute('data-connection-id'))
      .filter(Boolean) as string[];
    if (!radarrConfigured && !sonarrConfigured && !traktConnected && !simklConnected && !mdblistConfigured && mediaServerIds.length === 0) return;

    if (radarrConfigured) setConnStatus('radarr-conn-status', 'checking');
    if (sonarrConfigured) setConnStatus('sonarr-conn-status', 'checking');
    if (traktConnected) setConnStatus('trakt-conn-status', 'checking');
    if (simklConnected) setConnStatus('simkl-conn-status', 'checking');
    if (mdblistConfigured) setConnStatus('mdblist-conn-status', 'checking');
    for (const id of mediaServerIds) setConnStatus(`conn-status-${id}`, 'checking');

    try {
      const res = await fetch('/api/proxy/auth/connection-status', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) return;
      const data = await res.json();

      for (const provider of ['radarr', 'sonarr'] as const) {
        const status = data[provider];
        if (!status?.configured) continue;
        setConnStatus(`${provider}-conn-status`, status.connected ? 'connected' : 'disconnected');
        if (status.connected) renderArrProfiles(provider, status);
      }
      if (data.trakt?.configured) {
        setConnStatus('trakt-conn-status', data.trakt.connected ? 'connected' : 'disconnected');
      }
      if (data.simkl?.configured) {
        setConnStatus('simkl-conn-status', data.simkl.connected ? 'connected' : 'disconnected');
      }
      if (data.mdblist?.configured) {
        setConnStatus('mdblist-conn-status', data.mdblist.connected ? 'connected' : 'disconnected');
      }
      for (const cs of (data.connections ?? [])) {
        setConnStatus(`conn-status-${cs.id}`, cs.connected ? 'connected' : 'disconnected');
        document.querySelector(`.nuvio-reauth[data-conn-id="${cs.id}"]`)?.classList.toggle('hidden', cs.connected);
        document.querySelector(`.stremio-reauth[data-conn-id="${cs.id}"]`)?.classList.toggle('hidden', cs.connected);
        if (cs.token) {
          const card = document.querySelector(`[data-connection-id="${cs.id}"]`);
          const tokenInput = card?.querySelector('.conn-token-input') as HTMLInputElement | null;
          if (tokenInput) tokenInput.value = cs.token;
        }
        if (cs.profiles?.length) {
          const card = document.querySelector(`[data-connection-id="${cs.id}"]`);
          const profileSelect = card?.querySelector('.conn-user-id-input') as HTMLSelectElement | null;
          if (profileSelect) {
            const selectedProfile = profileSelect.value;
            profileSelect.innerHTML = cs.profiles.map((profile: any) => {
              const pid = String(profile.profile_index !== undefined && profile.profile_index !== null ? profile.profile_index : (profile.id !== undefined ? profile.id : '0'));
              const pname = profile.name || `Profile ${pid}`;
              return `<option value="${esc(pid)}">${esc(pname)}</option>`;
            }).join('');
            if ([...profileSelect.options].some(option => option.value === selectedProfile)) {
              profileSelect.value = selectedProfile;
            }
          }
        }
        if (cs.connected) loadLibraries(String(cs.id));
      }
    } catch {
      // Non-fatal — status badges stay hidden
    }
  }

  async function loadLibraries(connId: string) {
    const card = document.querySelector(`[data-connection-id="${connId}"]`);
    const picker = card?.querySelector('.conn-library-picker');
    const connType = picker?.getAttribute('data-conn-type') ?? '';
    const listEl = card?.querySelector('.conn-libraries-list') as HTMLElement | null;
    if (!listEl) return;
    listEl.textContent = 'Loading…';
    listEl.classList.add('italic', 'text-zinc-500');
    try {
      const res = await fetch(`/api/proxy/sync/connection/${connId}/libraries`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (res.ok) {
        const data = await res.json();
        const idKey = connType === 'plex' ? 'key' : 'id';
        listEl.classList.remove('italic', 'text-zinc-500');
        if (!data.libraries?.length) {
          listEl.innerHTML = '<span class="not-italic text-zinc-500 text-sm">No supported libraries found.</span>';
          return;
        }
        listEl.innerHTML = data.libraries.map((lib: any) => `
          <label class="flex items-center gap-2 cursor-pointer group px-2 py-1.5 rounded-lg border border-transparent hover:bg-zinc-800/50 transition-colors">
            <input type="checkbox" class="library-checkbox w-4 h-4 rounded accent-blue-500 cursor-pointer" data-id="${esc(String(lib[idKey]))}" ${lib.selected ? 'checked' : ''} />
            <span class="text-zinc-300 group-hover:text-zinc-100 transition-colors not-italic">
              ${esc(lib.name)}
              <span class="text-zinc-400 text-xs ml-1">${lib.type === 'movies' || lib.type === 'movie' ? 'Movies' : 'Shows'}</span>
            </span>
          </label>
        `).join('');
        listEl.querySelectorAll('label').forEach(label => {
          const cb = label.querySelector('input') as HTMLInputElement;
          const updateStyle = () => {
            label.classList.toggle('bg-blue-500/10', cb.checked);
            label.classList.toggle('border-blue-500/30', cb.checked);
            label.classList.toggle('hover:bg-zinc-800/50', !cb.checked);
            label.classList.toggle('border-transparent', !cb.checked);
          };
          cb.addEventListener('change', updateStyle);
          updateStyle();
        });
      } else {
        listEl.classList.remove('italic');
        listEl.textContent = 'Could not load libraries.';
      }
    } catch {
      listEl.classList.remove('italic');
      listEl.textContent = 'Could not reach server.';
    }
  }

  async function persistMdblistPreferences(keys: string[]) {
    const preferences = Object.fromEntries(keys.map(key => {
      const input = document.querySelector<HTMLInputElement>(`input[name="${key}"]`);
      return [key, input?.checked ?? false];
    }));
    const res = await fetch('/api/proxy/auth/settings', {
      method: 'PATCH',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(preferences),
    });
    if (!res.ok) {
      const data = await res.json().catch(() => ({}));
      throw new Error(data.detail || 'Failed to save MDBList options');
    }
  }


  const postIntegrationCredentials = (path: string, credentials: Record<string, string>) =>
    fetch(path, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(credentials),
    });

  function setupActions() {
    const btns = document.querySelectorAll('[data-connections-page] .js-action-btn');
    btns.forEach(btn => {
      // Clean up previous listeners if any (important for Astro View Transitions)
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      if (btn.parentNode) {
        btn.parentNode.replaceChild(newBtn, btn);
      }
      
      newBtn.addEventListener('click', async () => {
        const action = newBtn.getAttribute('data-action');
        const actionConnId = newBtn.getAttribute('data-conn-id');
        const isConnectionSave = action === 'save_connection' && !!actionConnId;
        let connectionSaveSucceeded = false;
        let lockedConnectionId: string | null = null;
        if (isConnectionSave && actionConnId) setConnectionSavePending(actionConnId, true);
        newBtn.disabled = true;
        const originalHTML = newBtn.innerHTML;
        newBtn.textContent = '...';

        try {
          let url = '';
          let method = 'POST';
          let requestBody: Record<string, string> | undefined;
          let syncConnId: string | null = null; // set for sync/push actions to start progress poller
          const trackingSettings = readTrackingServiceSettings(action);

          if (action === 'test_connection') {
            const connId = newBtn.getAttribute('data-conn-id');
            const connType = newBtn.getAttribute('data-conn-type');
            const card = document.querySelector(`[data-connection-id="${connId}"]`);
            const u = (card?.querySelector('.conn-url-input') as HTMLInputElement)?.value || '';
            const t = (card?.querySelector('.conn-token-input') as HTMLInputElement)?.value || '';
            const ui = (card?.querySelector('.conn-user-id-input') as HTMLInputElement)?.value || '';
            if (connType === 'stremio') {
              const statusResponse = await fetch('/api/proxy/auth/connection-status', {
                headers: { 'Authorization': `Bearer ${token}` },
              });
              const statusData = await statusResponse.json();
              const connectionStatus = (statusData.connections || []).find(
                (entry: any) => String(entry.id) === String(connId)
              );
              if (statusResponse.ok && connectionStatus?.connected) {
                showMessage('Stremio connection successful!');
                if (connId) setConnStatus(`conn-status-${connId}`, 'connected');
                card?.querySelector('.stremio-reauth')?.classList.add('hidden');
              } else {
                if (connId) setConnStatus(`conn-status-${connId}`, 'disconnected');
                throw new Error('Stremio connection test failed');
              }
              return;
            }
            let testRes: Response;
            if (connType === 'nuvio') {
              testRes = await fetch('/api/proxy/auth/test-nuvio', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: u, token: t, profile_id: parseInt(ui) }),
              });
            } else {
              const testEndpoint = `/api/proxy/auth/test-${connType === 'plex' ? 'plex' : connType === 'emby' ? 'emby' : 'jellyfin'}`;
              const credentials: Record<string, string> = connType === 'plex'
                ? { url: u, token: t }
                : { url: u, token: t, user_id: ui };
              testRes = await postIntegrationCredentials(testEndpoint, credentials);
            }
            const testData = await testRes.json();
            if (testRes.ok) {
              showMessage(testData.message || 'Connection successful!');
              if (connId) setConnStatus(`conn-status-${connId}`, 'connected');
              if (connType === 'nuvio' && connId) {
                const saveTokenRes = await fetch(`/api/proxy/auth/connections/${connId}`, {
                  method: 'PATCH',
                  headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                  body: JSON.stringify({ token: testData.refresh_token }),
                });
                if (!saveTokenRes.ok) throw new Error('Nuvio session was validated but could not be saved');
                const savedConnection = await saveTokenRes.json();
                const tokenInput = card?.querySelector('.conn-token-input') as HTMLInputElement | null;
                if (tokenInput) tokenInput.value = savedConnection.token;
                card?.querySelector('.nuvio-reauth')?.classList.add('hidden');
              }
            } else {
              if (connId) setConnStatus(`conn-status-${connId}`, 'disconnected');
              throw new Error(testData.detail || 'Connection test failed');
            }
            return;
          } else if (action === 'save_connection') {
            const connId = newBtn.getAttribute('data-conn-id');
            const card = connId ? connectionCard(connId) : null;
            const body: Record<string, any> = {
              url: (card?.querySelector('.conn-url-input') as HTMLInputElement)?.value || undefined,
              token: (card?.querySelector('.conn-token-input') as HTMLInputElement)?.value || undefined,
              server_user_id: (card?.querySelector('.conn-user-id-input') as HTMLInputElement)?.value || null,
              server_username: (card?.querySelector('.conn-username-input') as HTMLInputElement)?.value || null,
              auto_sync_interval: (() => {
                const v = (card?.querySelector('.conn-auto-sync') as HTMLSelectElement)?.value;
                return v ? parseFloat(v) : null;
              })(),
            };
            card?.querySelectorAll('.conn-pref-checkbox').forEach((cb: any) => {
              body[cb.getAttribute('data-pref')] = cb.checked;
            });
            // Collect selected Plex monitored users
            const userPicker = card?.querySelector('.plex-user-picker');
            if (userPicker) {
              const selected = [...userPicker.querySelectorAll('.plex-user-checkbox:checked')].map((cb: any) => cb.getAttribute('data-user-id'));
              body.watchlist_monitored_users = selected;
            }
            const saveRes = await fetch(`/api/proxy/auth/connections/${connId}`, {
              method: 'PATCH',
              headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (!saveRes.ok) {
              const err = await saveRes.json();
              throw new Error(err.detail || 'Failed to save connection');
            }
            const savedConnection = await saveRes.json();
            const savedTokenInput = card?.querySelector('.conn-token-input') as HTMLInputElement | null;
            if (savedTokenInput && savedConnection.token) savedTokenInput.value = savedConnection.token;
            card?.querySelectorAll<HTMLInputElement>('.conn-pref-checkbox[data-saved-checked]').forEach(input => {
              input.dataset.savedChecked = String(input.checked);
            });
            // Save libraries if they've been loaded
            const libList = card?.querySelector('.conn-libraries-list');
            if (libList && libList.querySelector('.library-checkbox')) {
              const picker = card?.querySelector('.conn-library-picker');
              const pickerType = picker?.getAttribute('data-conn-type');
              const ids = [...libList.querySelectorAll('.library-checkbox:checked')].map((cb: any) => cb.getAttribute('data-id'));
              const libPayload = pickerType === 'plex' ? { library_keys: ids } : { library_ids: ids };
              await fetch(`/api/proxy/sync/connection/${connId}/libraries`, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(libPayload),
              });
            }
            connectionSaveSucceeded = true;
            showMessage('Connection saved!');
            return;
          } else if (action === 'save_scrobble_connection') {
            const connId = newBtn.getAttribute('data-conn-id');
            const card = document.querySelector(`[data-scrobble-conn-id="${connId}"]`);
            const body: Record<string, boolean> = {};
            card?.querySelectorAll('.scrobble-pref-checkbox').forEach(el => {
              const cb = el as HTMLInputElement;
              const pref = cb.getAttribute('data-pref');
              if (pref) body[pref] = cb.checked;
            });
            const res = await fetch(`/api/proxy/auth/scrobble-connections/${connId}`, {
              method: 'PATCH',
              headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (!res.ok) {
              const err = await res.json();
              throw new Error(err.detail || 'Failed to save');
            }
            showMessage('Saved.');
            return;
          } else if (trackingSettings) {
            const response = await fetch('/api/proxy/auth/settings', {
              method: 'PATCH',
              headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
              body: JSON.stringify(trackingSettings.body),
            });
            if (!response.ok) {
              const err = await response.json();
              throw new Error(err.detail || `Failed to save ${trackingSettings.name} settings`);
            }
            showMessage(`${trackingSettings.name} settings saved.`);
            return;
          } else if (action === 'push_bingebase') {
            const pushRes = await fetch('/api/proxy/bingebase/push', {
              method: 'POST',
              headers: { 'Authorization': `Bearer ${token}` }
            });
            const data = await pushRes.json();
            if (!pushRes.ok) throw new Error(data.detail || 'Bingebase push failed to start');
            showMessage('Bingebase history push started.');
            startBingebasePoller(data.job_id);
            return;
          } else if (action === 'save_radarr_settings' || action === 'save_sonarr_settings') {
            const provider = action === 'save_radarr_settings' ? 'radarr' : 'sonarr';
            const name = provider === 'radarr' ? 'Radarr' : 'Sonarr';
            const response = await fetch('/api/proxy/auth/settings', {
              method: 'PATCH',
              headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
              body: JSON.stringify(arrSettings(provider)),
            });
            if (!response.ok) {
              const data = await response.json().catch(() => ({}));
              throw new Error(typeof data.detail === 'string' ? data.detail : `Failed to save ${name} settings`);
            }
            showMessage(`${name} settings saved.`);
            return;
          } else if (action === 'delete_scrobble_connection') {
            const connId = newBtn.getAttribute('data-conn-id');
            const connName = newBtn.getAttribute('data-conn-name');
            if (!confirm(`Delete scrobble connection "${connName}"? This cannot be undone.`)) return;
            const delRes = await fetch(`/api/proxy/auth/scrobble-connections/${connId}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            if (!delRes.ok) {
              const err = await delRes.json();
              throw new Error(err.detail || 'Failed to delete scrobble connection');
            }
            document.querySelector(`[data-scrobble-conn-id="${connId}"]`)?.remove();
            showMessage('Scrobble connection deleted.');
            return;
          } else if (action === 'delete_connection') {
            const connId = newBtn.getAttribute('data-conn-id');
            const connName = newBtn.getAttribute('data-conn-name');
            if (!confirm(`Delete connection "${connName}"? This cannot be undone.`)) return;
            const delRes = await fetch(`/api/proxy/auth/connections/${connId}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            if (!delRes.ok) {
              const err = await delRes.json();
              throw new Error(err.detail || 'Failed to delete connection');
            }
            document.querySelector(`[data-connection-id="${connId}"]`)?.remove();
            showMessage('Connection deleted.');
            return;
          } else if (action === 'scan_libraries') {
            const connId = newBtn.getAttribute('data-conn-id');
            url = `/api/proxy/sync/connection/${connId}/scan`;
          } else if (action === 'full_resync_connection') {
            const connId = newBtn.getAttribute('data-conn-id');
            const connName = newBtn.getAttribute('data-conn-name') || 'Stremio';
            if (!connId) throw new Error('Connection ID is missing');
            await waitForConnectionSave(connId);
            const card = connectionCard(connId);
            const pulling = selectedConnectionPreferences(card, streamPullPreferences, true);
            if (pulling.length === 0 || connectionPreferencesChanged(card, streamPullPreferences)) {
              await showConfirmModal(
                'Save pull settings first',
                'Full resync uses the saved pull options. Enable at least one pull option and save the connection before starting it.',
                'Got it',
                true,
              );
              return;
            }
            lockedConnectionId = connId;
            setConnectionOperationPending(connId, true);
            const ok = await showConfirmModal(
              `Start a fresh import from ${connName}?`,
              `This discards ${connName}'s saved snapshot and imports a complete provider snapshot using ${formatList(pulling)}. Existing AnyList data stays in place, and the new reconciliation must be reviewed before outbound writes. No provider data is changed.`,
              'Full resync',
            );
            if (!ok) return;
            renderConnProgress(connId, { status: 'pending', job_type: 'pull', processed_items: 0, total_items: 0, updated_at: new Date().toISOString() });
            url = `/api/proxy/sync/connection/${connId}?full=true`;
            syncConnId = connId;
          } else if (action === 'sync_connection') {
            const connId = newBtn.getAttribute('data-conn-id');
            if (!connId) throw new Error('Connection ID is missing');
            const connName = newBtn.getAttribute('data-conn-name') || 'this server';
            const card = document.querySelector(`[data-connection-id="${connId}"]`);
            const pullPrefLabels: Record<string, string> = {
              sync_collection: 'collection status',
              sync_watched: 'watched status',
              sync_ratings: 'ratings',
              sync_playback: 'playback events',
              plex_sync_watchlist: 'watchlist',
            };
            const pulling: string[] = [];
            card?.querySelectorAll('.conn-pref-checkbox').forEach((el: any) => {
              const pref = el.getAttribute('data-pref');
              if (pref && pullPrefLabels[pref] && el.checked) pulling.push(pullPrefLabels[pref]);
            });
            const noPull = pulling.length === 0;
            const ok = await showConfirmModal(
              noPull ? 'Nothing to pull' : `Pull from ${connName}?`,
              noPull
                ? `Your current settings have nothing selected to pull from ${connName}. Enable at least one option in the "${connName} → AnyList" section.`
                : `This will import ${formatList(pulling)} from ${connName} into AnyList.`,
              noPull ? 'Got it' : 'Pull',
              noPull
            );
            if (!ok) return;
            // Show "queued" state immediately — don't wait for the first poll
            renderConnProgress(connId, { status: 'pending', job_type: 'pull', processed_items: 0, total_items: 0, updated_at: new Date().toISOString() });
            url = `/api/proxy/sync/connection/${connId}`;
            syncConnId = connId;
          } else if (action === 'push_upstream') {
            const connId = newBtn.getAttribute('data-conn-id');
            const connName = newBtn.getAttribute('data-conn-name') || 'this server';
            const card = document.querySelector(`[data-connection-id="${connId}"]`);
            const pushPrefLabels: Record<string, string> = {
              push_watched: 'watched status',
              push_collection: 'collection status',
              push_ratings: 'ratings',
              push_playback: 'playback progress',
              plex_push_watchlist: 'watchlist',
            };
            const pushing: string[] = [];
            card?.querySelectorAll('.conn-pref-checkbox').forEach((el: any) => {
              const pref = el.getAttribute('data-pref');
              if (pref && pushPrefLabels[pref] && el.checked) pushing.push(pushPrefLabels[pref]);
            });
            const noPush = pushing.length === 0;
            const ok = await showConfirmModal(
              noPush ? 'Nothing to push' : `Push to ${connName}?`,
              noPush
                ? `Your current settings have nothing selected to push to ${connName}. Enable at least one option in the "AnyList → ${connName}" section.`
                : `This will push your ${formatList(pushing)} from AnyList to ${connName}. Existing data on the server may be overwritten.`,
              noPush ? 'Got it' : 'Push',
              noPush
            );
            if (!ok) return;
            url = `/api/proxy/sync/connection/${connId}/push`;
            syncConnId = connId;
          } else if (action === 'clear_connection_data') {
            const connId = newBtn.getAttribute('data-conn-id');
            const connName = newBtn.getAttribute('data-conn-name') || 'this connection';
            if (!connId) throw new Error('Connection ID is missing');
            await waitForConnectionSave(connId);
            const card = connectionCard(connId);
            const selected = selectedConnectionPreferences(card, streamPushPreferences, true);
            if (selected.length === 0 || connectionPreferencesChanged(card, streamPushPreferences)) {
              await showConfirmModal(
                'Save outbound settings first',
                'Clear data uses the saved outbound options. Enable at least one outbound option and save the connection so the fields in this confirmation match what will be cleared.',
                'Got it',
                true,
              );
              return;
            }
            lockedConnectionId = connId;
            setConnectionOperationPending(connId, true);
            const ok = await showConfirmModal(
              `Clear selected data from ${connName}?`,
              `This clears ${formatList(selected)} from ${connName}. Your AnyList data and library state stay intact. A later Push restores the selected data from AnyList.`,
              'Clear data',
            );
            if (!ok) return;
            renderConnProgress(connId, { status: 'pending', job_type: 'clear', processed_items: 0, total_items: 0, updated_at: new Date().toISOString() });
            url = `/api/proxy/sync/connection/${connId}/clear-data`;
            syncConnId = connId;
          } else if (action === 'test_radarr' || action === 'test_sonarr') {
            const provider = action === 'test_radarr' ? 'radarr' : 'sonarr';
            const name = provider === 'radarr' ? 'Radarr' : 'Sonarr';
            setConnStatus(`${provider}-conn-status`, 'checking');
            try {
              const profiles = await fetchArrProfiles(provider, arrCredentials(provider), postIntegrationCredentials);
              renderArrProfiles(provider, profiles);
              setConnStatus(`${provider}-conn-status`, 'connected');
              showMessage(`${name} connection successful and profiles fetched!`);
            } catch (error) {
              setConnStatus(`${provider}-conn-status`, 'disconnected');
              throw error;
            }
            return;
          } else if (action === 'sync_trakt' || action === 'full_sync_trakt') {
            const fullResync = action === 'full_sync_trakt';
            const traktPullLabels: Record<string, string> = {
              trakt_sync_watched: 'watched history',
              trakt_sync_ratings: 'ratings',
              trakt_sync_lists: 'lists',
              trakt_sync_dropped: 'dropped shows',
            };
            const pulling: string[] = [];
            document.querySelectorAll('.sync-pref-checkbox').forEach((el: any) => {
              const name = el.getAttribute('name');
              if (name && traktPullLabels[name] && el.checked) pulling.push(traktPullLabels[name]);
            });
            const noPull = pulling.length === 0;
            const ok = await showConfirmModal(
              noPull ? 'Nothing to pull' : fullResync ? 'Full resync from Trakt?' : 'Pull from Trakt?',
              noPull
                ? 'Your current settings have nothing selected to pull from Trakt. Enable at least one option in the "Trakt → AnyList" section.'
                : fullResync
                  ? `This will scan your complete ${formatList(pulling)} on Trakt again. Existing AnyList events are retained and deduplicated.`
                  : `This will import new ${formatList(pulling)} from Trakt since the last successful pull.`,
              noPull ? 'Got it' : fullResync ? 'Full resync' : 'Pull',
              noPull
            );
            if (!ok) return;
            url = `/api/proxy/trakt/sync${fullResync ? '?full=true' : ''}`;
          } else if (action === 'sync_simkl') {
            const simklPullLabels: Record<string, string> = {
              simkl_sync_watched: 'watched history',
              simkl_sync_ratings: 'ratings',
              simkl_sync_lists: 'lists',
            };
            const pulling: string[] = [];
            document.querySelectorAll('.sync-pref-checkbox').forEach((el: any) => {
              const name = el.getAttribute('name');
              if (name && simklPullLabels[name] && el.checked) pulling.push(simklPullLabels[name]);
            });
            const noPull = pulling.length === 0;
            const ok = await showConfirmModal(
              noPull ? 'Nothing to pull' : 'Pull from Simkl?',
              noPull
                ? 'Your current settings have nothing selected to pull from Simkl. Enable at least one option in the "Simkl → AnyList" section.'
                : `This will import your ${formatList(pulling)} from Simkl into AnyList.`,
              noPull ? 'Got it' : 'Pull',
              noPull
            );
            if (!ok) return;
            url = `/api/proxy/simkl/sync`;
          } else if (action === 'push_simkl') {
            const simklPushLabels: Record<string, string> = {
              simkl_push_watched: 'watched history',
              simkl_push_ratings: 'ratings',
            };
            const pushing: string[] = [];
            document.querySelectorAll('.sync-pref-checkbox').forEach((el: any) => {
              const name = el.getAttribute('name');
              if (name && simklPushLabels[name] && el.checked) pushing.push(simklPushLabels[name]);
            });
            const noPush = pushing.length === 0;
            const ok = await showConfirmModal(
              noPush ? 'Nothing to push' : 'Push to Simkl?',
              noPush
                ? 'Your current settings have nothing selected to push to Simkl. Enable at least one option in the "AnyList → Simkl" section.'
                : `This will push your ${formatList(pushing)} from AnyList to Simkl. Existing data on Simkl may be overwritten.`,
              noPush ? 'Got it' : 'Push',
              noPush
            );
            if (!ok) return;
            url = `/api/proxy/simkl/push`;
          } else if (action === 'push_trakt') {
            const traktPushLabels: Record<string, string> = {
              trakt_push_watched: 'watched history',
              trakt_push_ratings: 'ratings',
              trakt_push_collection: 'collection',
              trakt_push_lists: 'lists',
            };
            const pushing: string[] = [];
            document.querySelectorAll('.sync-pref-checkbox').forEach((el: any) => {
              const name = el.getAttribute('name');
              if (name && traktPushLabels[name] && el.checked) pushing.push(traktPushLabels[name]);
            });
            const noPush = pushing.length === 0;
            const ok = await showConfirmModal(
              noPush ? 'Nothing to push' : 'Push to Trakt?',
              noPush
                ? 'Your current settings have nothing selected to push to Trakt. Enable at least one option in the "AnyList → Trakt" section.'
                : `This will push your ${formatList(pushing)} from AnyList to Trakt. Existing data on Trakt may be overwritten.`,
              noPush ? 'Got it' : 'Push',
              noPush
            );
            if (!ok) return;
            url = `/api/proxy/trakt/push`;
          } else if (action === 'sync_mdblist') {
            const labels: Record<string, string> = {
              mdblist_sync_watched: 'watched history',
              mdblist_sync_ratings: 'ratings',
              mdblist_sync_watchlist: 'watchlist',
              mdblist_sync_dropped: 'dropped shows',
            };
            const selected = Array.from(document.querySelectorAll<HTMLInputElement>('.sync-pref-checkbox'))
              .filter(el => el.checked && labels[el.name])
              .map(el => labels[el.name]);
            const empty = selected.length === 0;
            const ok = await showConfirmModal(
              empty ? 'Nothing to pull' : 'Pull from MDBList?',
              empty
                ? 'Enable at least one option in the "MDBList → AnyList" section.'
                : `This will import your ${formatList(selected)} from MDBList into AnyList.`,
              empty ? 'Got it' : 'Pull',
              empty
            );
            if (!ok) return;
            await persistMdblistPreferences(Object.keys(labels));
            url = '/api/proxy/mdblist/sync';
          } else if (action === 'push_mdblist') {
            const labels: Record<string, string> = {
              mdblist_push_watched: 'watched history',
              mdblist_push_ratings: 'ratings',
              mdblist_push_watchlist: 'watchlist',
              mdblist_push_collection: 'collection',
            };
            const selected = Array.from(document.querySelectorAll<HTMLInputElement>('.sync-pref-checkbox'))
              .filter(el => el.checked && labels[el.name])
              .map(el => labels[el.name]);
            const empty = selected.length === 0;
            const ok = await showConfirmModal(
              empty ? 'Nothing to push' : 'Push to MDBList?',
              empty
                ? 'Enable at least one option in the "AnyList → MDBList" section.'
                : `This will add or update your ${formatList(selected)} on MDBList. Existing remote items are retained.`,
              empty ? 'Got it' : 'Push',
              empty
            );
            if (!ok) return;
            await persistMdblistPreferences(Object.keys(labels));
            url = '/api/proxy/mdblist/push';
          }

          if (!url) throw new Error('This connection action is unavailable.');
          const res = await fetch(url, {
            method,
            headers: {
              'Authorization': `Bearer ${token}`,
              ...(requestBody ? { 'Content-Type': 'application/json' } : {}),
            },
            body: requestBody ? JSON.stringify(requestBody) : undefined,
          });
          const data = await res.json();

          if (res.ok) {

            showMessage(data.message || 'Action successful!', 'success');
            if (syncConnId) {
              setConnectionJobActive(syncConnId, true);
              startConnPoller(syncConnId);
            }
            if (action === 'sync_simkl' || action === 'push_simkl') startSimklPoller();
            if (action === 'sync_trakt' || action === 'full_sync_trakt' || action === 'push_trakt') startTraktPoller();
            if (action === 'sync_mdblist' || action === 'push_mdblist') startMdblistPoller();
          } else {
            if (syncConnId) renderConnProgress(syncConnId, null);
            throw new Error(data.detail || 'Action failed');
          }
        } catch (e) {
          if (actionConnId && action === 'clear_connection_data') renderConnProgress(actionConnId, null);
          if (actionConnId && action === 'full_resync_connection') renderConnProgress(actionConnId, null);
          showMessage(errorMessage(e), 'error');
        } finally {
          newBtn.innerHTML = originalHTML;
          if (lockedConnectionId) setConnectionOperationPending(lockedConnectionId, false);
          if (isConnectionSave && actionConnId) {
            if (connectionSaveSucceeded) updateConnectionActionControls(actionConnId);
            setConnectionSavePending(actionConnId, false);
          }
          if (newBtn.hasAttribute('data-connection-job-control') && actionConnId) {
            updateConnectionActionControls(actionConnId);
          } else {
            newBtn.disabled = false;
          }
        }
      });
    });

    document.querySelectorAll<HTMLInputElement>('.conn-pref-checkbox[data-conn-id]').forEach(input => {
      if (input.dataset.connectionActionBound !== 'true') {
        input.dataset.connectionActionBound = 'true';
        input.addEventListener('change', () => {
          const connId = input.dataset.connId;
          if (connId) updateConnectionActionControls(connId);
        });
      }
      const connId = input.dataset.connId;
      if (connId) updateConnectionActionControls(connId);
    });

    dataImports?.stop();
    if (document.querySelector('[data-connections-page]')) {
      dataImports = mountDataImports(document.getElementById('app-data')?.dataset.token ?? '', (format, jobId) => {
        if (format === 'trakt') {
          startTraktPoller();
          if (jobId) startTraktImportPoller(jobId);
        } else if (format === 'scrob' && jobId) startScrobImportPoller(jobId);
        else if (format === 'yamtrack' && jobId) startYamtrackImportPoller(jobId);
      });
    }

  }

  function setupConnections() {
    const apiKey = (document.querySelector<HTMLInputElement>('#scrob_api_key'))?.value ?? '';

    // Set webhook URLs and wire copy buttons for all existing connection cards
    document.querySelectorAll('[data-connection-id]').forEach(card => {
      const connId = card.getAttribute('data-connection-id');
      const webhookInput = card.querySelector('.conn-webhook-url') as HTMLInputElement | null;
      const connType = webhookInput?.getAttribute('data-conn-type') ?? '';
      if (webhookInput && connId && connType) {
        webhookInput.value = `${window.location.origin}/api/proxy/webhooks/${connType}/${connId}?api_key=${encodeURIComponent(apiKey)}`;
      }
      const copyBtn = card.querySelector('.conn-copy-webhook');
      if (copyBtn && webhookInput) {
        copyBtn.addEventListener('click', async () => {
          try {
            await copyToClipboard(webhookInput.value);
            flashCopied(copyBtn as HTMLElement);
          } catch {
            showMessage('Could not copy to clipboard', 'error');
          }
        });
      }
    });

    // Nuvio: an existing connection's saved refresh token can die (Nuvio
    // rotates it on every use and rejects reuse) with no way back except a
    // fresh email/password sign-in. This replaces the token in place and
    // saves immediately, rather than requiring delete-and-re-add.
    document.querySelectorAll('.nuvio-reauth').forEach(block => {
      const connId = block.getAttribute('data-conn-id');
      const connType = block.getAttribute('data-conn-type');
      const isArvio = connType === 'arvio';
      const card = block.closest('[data-connection-id]');
      const toggleBtn = block.querySelector('.nuvio-reauth-toggle');
      const form = block.querySelector<HTMLElement>('.nuvio-reauth-form');
      const emailInput = block.querySelector('.nuvio-reauth-email') as HTMLInputElement | null;
      const passwordInput = block.querySelector('.nuvio-reauth-password') as HTMLInputElement | null;
      const submitBtn = block.querySelector('.nuvio-reauth-submit') as HTMLButtonElement | null;
      const statusEl = block.querySelector('.nuvio-reauth-status') as HTMLElement | null;
      const tokenInput = card?.querySelector('.conn-token-input') as HTMLInputElement | null;
      const profileSelect = card?.querySelector('.conn-user-id-input') as HTMLSelectElement | null;

      toggleBtn?.addEventListener('click', () => {
        if (!form) return;
        const open = !form.classList.contains('hidden') && !form.inert;
        if (open) void hideCollapsible(form);
        else showCollapsible(form);
        toggleBtn.setAttribute('aria-expanded', String(!open));
      });

      submitBtn?.addEventListener('click', async () => {
        const email = emailInput?.value.trim() || '';
        const password = passwordInput?.value || '';
        if (statusEl) statusEl.textContent = '';
        if (!email || !password) {
          if (statusEl) statusEl.textContent = `Enter your ${isArvio ? 'ARVIO' : 'Nuvio'} email and password.`;
          return;
        }
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Signing in…'; }
        try {
          const loginEndpoint = isArvio ? '/api/proxy/auth/arvio-login' : '/api/proxy/auth/nuvio-login';
          const defaultUrl = isArvio ? 'https://auth.arvio.tv/.netlify/functions' : 'https://api.nuvio.tv';
          // Self-hosted Nuvio backends store a custom Cloud API URL on the
          // connection itself - re-auth must hit that URL, not the official
          // default, or it silently authenticates against the wrong backend.
          const reauthUrlInput = card?.querySelector('.conn-url-input') as HTMLInputElement | null;
          const reauthUrl = reauthUrlInput?.value.trim() || defaultUrl;
          const loginRes = await fetch(loginEndpoint, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password, url: reauthUrl }),
          });
          const loginData = await loginRes.json();
          if (!loginRes.ok) throw new Error(loginData.detail || `${isArvio ? 'ARVIO' : 'Nuvio'} sign-in failed`);

          const profiles = loginData.profiles || [];
          const previousProfileId = profileSelect?.value || '';
          if (profileSelect) {
            profileSelect.innerHTML = profiles.map((profile: any) => {
              const pid = String(profile.profile_index !== undefined && profile.profile_index !== null ? profile.profile_index : (profile.id !== undefined ? profile.id : '0'));
              const pname = profile.name || `Profile ${pid}`;
              return `<option value="${esc(pid)}">${esc(pname)}</option>`;
            }).join('');
            if (previousProfileId && [...profileSelect.options].some(option => option.value === previousProfileId)) {
              profileSelect.value = previousProfileId;
            }
          }
          if (!profileSelect?.value) throw new Error(`No ${isArvio ? 'ARVIO' : 'Nuvio'} profile is available for this account.`);

          const saveRes = await fetch(`/api/proxy/auth/connections/${connId}`, {
            method: 'PATCH',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: loginData.refresh_token, server_user_id: profileSelect.value }),
          });
          const saved = await saveRes.json();
          if (!saveRes.ok) throw new Error(saved.detail || 'Signed in, but the new session could not be saved');

          if (tokenInput) tokenInput.value = saved.token;
          if (connId) setConnStatus(`conn-status-${connId}`, 'connected');
          if (passwordInput) passwordInput.value = '';
          if (form) void hideCollapsible(form);
          toggleBtn?.setAttribute('aria-expanded', 'false');
          block.classList.add('hidden');
          showMessage(`${isArvio ? 'ARVIO' : 'Nuvio'} reconnected.`);
        } catch (err: any) {
          if (statusEl) statusEl.textContent = err.message || 'Sign-in failed';
        } finally {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Sign in'; }
        }
      });
    });

    // Stremio: a connection can also go stale (account key revoked, password
    // changed elsewhere) with no in-place recovery today. Reuse the same
    // link/QR flow as "add new", but pass this connection's id so the
    // backend updates it in place instead of rejecting with "already
    // connected".
    document.querySelectorAll('.stremio-reauth').forEach(block => {
      const connId = block.getAttribute('data-conn-id');
      const toggleBtn = block.querySelector('.stremio-reauth-toggle');
      const panel = block.querySelector<HTMLElement>('.stremio-reauth-panel');
      const startBtn = block.querySelector('.stremio-reauth-start') as HTMLButtonElement | null;
      const details = block.querySelector('.stremio-reauth-details');
      const urlLink = block.querySelector('.stremio-reauth-url') as HTMLAnchorElement | null;
      const codeEl = block.querySelector('.stremio-reauth-code');
      const qrImg = block.querySelector('.stremio-reauth-qr') as HTMLImageElement | null;
      const statusEl = block.querySelector('.stremio-reauth-status');
      let pollTimer: number | null = null;

      toggleBtn?.addEventListener('click', () => {
        if (!panel) return;
        const open = !panel.classList.contains('hidden') && !panel.inert;
        if (open) void hideCollapsible(panel);
        else showCollapsible(panel);
        toggleBtn.setAttribute('aria-expanded', String(!open));
      });

      startBtn?.addEventListener('click', async () => {
        if (pollTimer !== null) { window.clearTimeout(pollTimer); pollTimer = null; }
        startBtn.disabled = true;
        const originalLabel = startBtn.textContent;
        startBtn.textContent = 'Creating link…';
        try {
          const response = await fetch('/api/proxy/auth/stremio/link/start', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` },
          });
          const link = await response.json();
          if (!response.ok) throw new Error(link.detail || 'Could not create the Stremio link.');
          details?.classList.remove('hidden');
          if (urlLink) urlLink.href = link.link;
          if (codeEl) codeEl.textContent = link.code;
          if (qrImg) qrImg.src = link.qrcode;
          if (statusEl) statusEl.textContent = 'Waiting for authorization…';
          window.open(link.link, '_blank', 'noopener,noreferrer');
          const linkExpiresAt = Date.now() + 10 * 60 * 1000;

          const poll = async () => {
            try {
              if (Date.now() >= linkExpiresAt) {
                throw new Error('Stremio authorization expired. Try again.');
              }
              const pollResponse = await fetch('/api/proxy/auth/stremio/link/poll', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: link.code, connection_id: connId ? parseInt(connId) : undefined }),
              });
              const result = await pollResponse.json();
              if (!pollResponse.ok) throw new Error(result.detail || 'Stremio authorization failed.');
              if (result.status === 'connected') {
                pollTimer = null;
                if (statusEl) statusEl.textContent = 'Connected. Reloading…';
                showMessage('Stremio reconnected.');
                window.location.reload();
                return;
              }
              pollTimer = window.setTimeout(poll, 2000);
            } catch (error: any) {
              pollTimer = null;
              if (statusEl) statusEl.textContent = error.message;
              showMessage(error.message, 'error');
              startBtn.disabled = false;
              startBtn.textContent = originalLabel;
            }
          };
          pollTimer = window.setTimeout(poll, 1500);
          startBtn.textContent = 'Waiting…';
        } catch (error: any) {
          showMessage(error.message, 'error');
          startBtn.disabled = false;
          startBtn.textContent = originalLabel;
        }
      });
    });

    // Add Connection toggle
    const addBtn = document.querySelector<HTMLButtonElement>('#add-connection-btn');
    const addForm = document.getElementById('add-connection-form');
    const cancelBtn = document.querySelector<HTMLButtonElement>('#cancel-add-connection-btn');
    const connectStremioBtn = document.querySelector<HTMLButtonElement>('#connect-stremio-btn');
    let stremioPollTimer: number | null = null;

    // Login with Plex (auto-fills the URL / token / username fields)
    const plexLoginBtn = document.querySelector<HTMLButtonElement>('#plex-login-btn');
    const plexServerWrap = document.getElementById('plex-login-server-wrap');
    const plexServerSelect = document.querySelector<HTMLSelectElement>('#plex-login-server');
    const plexConnWrap = document.getElementById('plex-login-connection-wrap');
    const plexConnSelect = document.querySelector<HTMLSelectElement>('#plex-login-connection');
    const plexLoginStatus = document.getElementById('plex-login-status');
    let plexPollTimer: number | null = null;
    type PlexLoginConn = { uri: string; local: boolean; relay: boolean; reachable: boolean; label: string };
    let plexLoginServers: Array<{ name: string; machine_identifier: string; owned: boolean; url: string; token: string; connections: PlexLoginConn[] }> = [];

    const setPlexStatus = (msg: string) => {
      if (!plexLoginStatus) return;
      plexLoginStatus.textContent = msg;
      plexLoginStatus.classList.toggle('hidden', !msg);
    };

    const applyPlexConnection = () => {
      const server = plexLoginServers[plexServerSelect ? plexServerSelect.selectedIndex : 0];
      const conn = server?.connections[plexConnSelect ? plexConnSelect.selectedIndex : 0];
      const urlEl = document.querySelector<HTMLInputElement>('#new-conn-url');
      if (urlEl && conn) urlEl.value = conn.uri;
    };
    plexConnSelect?.addEventListener('change', applyPlexConnection);

    const applyPlexServer = () => {
      const server = plexLoginServers[plexServerSelect ? plexServerSelect.selectedIndex : 0];
      if (!server) return;
      const tokenEl = document.querySelector<HTMLInputElement>('#new-conn-token');
      const machineEl = document.querySelector<HTMLInputElement>('#new-plex-machine-id');
      if (tokenEl) tokenEl.value = server.token;
      if (machineEl) machineEl.value = server.machine_identifier;
      const nameEl = document.querySelector<HTMLInputElement>('#new-conn-name');
      if (nameEl && !nameEl.value.trim()) nameEl.value = server.name;
      if (plexConnSelect) {
        plexConnSelect.innerHTML = server.connections
          .map((c) => `<option>${esc(c.label)}${c.reachable ? ' (reachable)' : ''}</option>`)
          .join('');
        const recommendedIdx = Math.max(0, server.connections.findIndex((c) => c.uri === server.url));
        plexConnSelect.selectedIndex = recommendedIdx;
      }
      plexConnWrap?.classList.toggle('hidden', server.connections.length <= 1);
      applyPlexConnection();
    };
    plexServerSelect?.addEventListener('change', applyPlexServer);

    const resetPlexLogin = () => {
      if (plexPollTimer !== null) { window.clearTimeout(plexPollTimer); plexPollTimer = null; }
      plexLoginServers = [];
      plexServerWrap?.classList.add('hidden');
      plexConnWrap?.classList.add('hidden');
      if (plexServerSelect) plexServerSelect.innerHTML = '';
      if (plexConnSelect) plexConnSelect.innerHTML = '';
      setPlexStatus('');
      for (const id of ['new-plex-auth-token', 'new-plex-account-id', 'new-plex-machine-id']) {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el) el.value = '';
      }
      if (plexLoginBtn) { plexLoginBtn.disabled = false; plexLoginBtn.textContent = 'Login with Plex'; }
    };

    if (addBtn && addForm) {
      addBtn.addEventListener('click', () => {
        const open = !addForm.classList.contains('hidden') && !addForm.inert;
        if (open) void hideCollapsible(addForm);
        else showCollapsible(addForm);
        addBtn.setAttribute('aria-expanded', String(!open));
      });
    }
    if (cancelBtn && addForm) {
      cancelBtn.addEventListener('click', () => {
        void hideCollapsible(addForm);
        addBtn?.setAttribute('aria-expanded', 'false');
        if (stremioPollTimer !== null) {
          window.clearTimeout(stremioPollTimer);
          stremioPollTimer = null;
        }
        document.getElementById('stremio-link-details')?.classList.add('hidden');
        if (connectStremioBtn) {
          connectStremioBtn.disabled = false;
          connectStremioBtn.textContent = 'Connect Stremio';
        }
        resetPlexLogin?.();
      });
    }

    // Provider-specific fields for a new connection
    const typeSelect = document.querySelector<HTMLSelectElement>('#new-conn-type');
    const userIdRow = document.getElementById('new-conn-user-id-row');
    const usernameRow = document.getElementById('new-conn-username-row');
    const nuvioEmailRow = document.getElementById('new-nuvio-email-row');
    const nuvioProfileRow = document.getElementById('new-nuvio-profile-row');
    const stremioLinkRow = document.getElementById('new-stremio-link-row');
    const urlRow = document.getElementById('new-conn-url-row');
    const tokenRow = document.getElementById('new-conn-token-row');
    const urlInput = document.querySelector<HTMLInputElement>('#new-conn-url');
    const urlLabel = document.getElementById('new-conn-url-label');
    const tokenInput = document.querySelector<HTMLInputElement>('#new-conn-token');
    const tokenLabel = document.getElementById('new-conn-token-label');
    const nuvioProfileSelect = document.querySelector<HTMLSelectElement>('#new-nuvio-profile');
    let pendingNuvioRefreshToken = '';
    let previousType = typeSelect?.value ?? 'jellyfin';

    const updateTypeFields = () => {
      const type = typeSelect?.value ?? 'jellyfin';
      const isPlex = type === 'plex';
      const isNuvio = type === 'nuvio';
      const isArvio = type === 'arvio';
      const isStremio = type === 'stremio';
      const isCloud = isNuvio || isStremio || isArvio;
      userIdRow?.classList.toggle('hidden', isPlex || isCloud);
      usernameRow?.classList.toggle('hidden', !isPlex);
      nuvioEmailRow?.classList.toggle('hidden', !(isNuvio || isArvio));
      nuvioProfileRow?.classList.toggle('hidden', !(isNuvio || isArvio));
      stremioLinkRow?.classList.toggle('hidden', !isStremio);
      document.getElementById('new-plex-login-row')?.classList.toggle('hidden', !isPlex);
      urlRow?.classList.toggle('hidden', isStremio);
      tokenRow?.classList.toggle('hidden', isStremio);
      document.querySelector<HTMLButtonElement>('#create-connection-btn')?.classList.toggle('hidden', isStremio);
      document.querySelector<HTMLButtonElement>('#test-new-connection-btn')?.classList.toggle('hidden', isStremio);
      if (urlInput) {
        if (isNuvio) {
          urlInput.value = 'https://api.nuvio.tv';
          urlInput.disabled = false;
        } else if (isArvio) {
          urlInput.value = 'https://auth.arvio.tv/.netlify/functions';
          urlInput.disabled = true;
        } else if (isStremio) {
          urlInput.value = 'https://api.strem.io';
          urlInput.disabled = true;
        } else {
          if (previousType === 'nuvio' || previousType === 'arvio' || previousType === 'stremio') urlInput.value = '';
          urlInput.disabled = false;
        }
      }
      const nuvioEmailLabel = nuvioEmailRow?.querySelector('label');
      if (nuvioEmailLabel) nuvioEmailLabel.textContent = isArvio ? 'ARVIO Email' : 'Nuvio Email';
      const nuvioProfileLabel = nuvioProfileRow?.querySelector('label');
      if (nuvioProfileLabel) nuvioProfileLabel.textContent = isArvio ? 'ARVIO Profile' : 'Nuvio Profile';

      if (urlLabel) urlLabel.textContent = (isNuvio || isArvio) ? 'Cloud API URL' : 'Server URL';
      if (tokenLabel) tokenLabel.textContent = isArvio ? 'ARVIO Password' : isNuvio ? 'Nuvio Password' : 'Token';
      if (tokenInput) tokenInput.autocomplete = (isNuvio || isArvio) ? 'current-password' : 'off';
      const syncRatings = document.getElementById('new-sync-ratings') as HTMLInputElement | null;
      const pushRatings = document.getElementById('new-push-ratings') as HTMLInputElement | null;
      const pushPlayback = document.querySelector<HTMLInputElement>('#new-push-playback');
      pushPlayback?.closest('label')?.classList.toggle('hidden', !isCloud);
      if (pushPlayback) pushPlayback.disabled = !isCloud;
      const pushCollection = document.querySelector<HTMLInputElement>('#new-push-collection');
      pushCollection?.closest('label')?.classList.toggle('hidden', !isCloud);
      if (pushCollection) pushCollection.disabled = !isCloud;
      for (const checkbox of [syncRatings, pushRatings]) {
        checkbox?.closest('label')?.classList.toggle('hidden', isCloud);
        if (checkbox) checkbox.disabled = isCloud;
      }
      const playbackLabel = document.getElementById('new-sync-playback-label');
      if (playbackLabel) playbackLabel.textContent = isCloud ? 'Playback progress' : 'Playback events';
      const pullHeading = document.getElementById('new-pull-heading');
      const pushHeading = document.getElementById('new-push-heading');
      const providerName = isArvio ? 'ARVIO' : isNuvio ? 'Nuvio' : isStremio ? 'Stremio' : 'Server';
      if (pullHeading) pullHeading.textContent = `${providerName} → AnyList`;
      if (pushHeading) pushHeading.textContent = `AnyList → ${providerName}`;
      if (type !== previousType) {
        pendingNuvioRefreshToken = '';
        if (stremioPollTimer !== null) {
          window.clearTimeout(stremioPollTimer);
          stremioPollTimer = null;
          document.getElementById('stremio-link-details')?.classList.add('hidden');
        }
        resetPlexLogin?.();
      }
      previousType = type;
    };
    typeSelect?.addEventListener('change', updateTypeFields);
    updateTypeFields();

    const authenticateNuvio = async () => {
      const type = typeSelect?.value ?? 'nuvio';
      const isArvio = type === 'arvio';
      const email = (document.querySelector<HTMLInputElement>('#new-nuvio-email'))?.value.trim() || '';
      const password = tokenInput?.value || '';
      const url = urlInput?.value || (isArvio ? 'https://auth.arvio.tv/.netlify/functions' : 'https://api.nuvio.tv');
      if (!password) throw new Error(`${isArvio ? 'ARVIO' : 'Nuvio'} password or refresh token is required.`);
      const selectedProfile = nuvioProfileSelect?.value || '';
      let response: Response | null = null;
      let data: any = null;

      if (email) {
        const endpoint = isArvio ? '/api/proxy/auth/arvio-login' : '/api/proxy/auth/nuvio-login';
        response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, url }),
        });
        data = await response.json();
      }

      if (!email || (response && !response.ok)) {
        const testEndpoint = isArvio ? '/api/proxy/auth/test-arvio' : '/api/proxy/auth/test-nuvio';
        const testRes = await fetch(testEndpoint, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, token: password, profile_id: selectedProfile || '0' }),
        });
        const testData = await testRes.json();
        if (testRes.ok) {
          response = testRes;
          data = testData;
        } else if (response && !response.ok) {
          throw new Error(data?.detail || testData?.detail || `${isArvio ? 'ARVIO' : 'Nuvio'} sign-in failed`);
        } else {
          throw new Error(testData?.detail || `${isArvio ? 'ARVIO' : 'Nuvio'} authentication failed`);
        }
      }

      if (!response || !response.ok) throw new Error(data?.detail || `${isArvio ? 'ARVIO' : 'Nuvio'} sign-in failed`);
      pendingNuvioRefreshToken = data.refresh_token || password;
      if (nuvioProfileSelect) {
        nuvioProfileSelect.innerHTML = (data.profiles || []).map((profile: any) => {
          const pid = String(profile.profile_index !== undefined && profile.profile_index !== null ? profile.profile_index : profile.id);
          const pname = profile.name || `Profile ${pid}`;
          return `<option value="${esc(pid)}">${esc(pname)}</option>`;
        }).join('');
        if (selectedProfile && [...nuvioProfileSelect.options].some(option => option.value === selectedProfile)) {
          nuvioProfileSelect.value = selectedProfile;
        }
      }
      if (!nuvioProfileSelect?.value) throw new Error(`No ${isArvio ? 'ARVIO' : 'Nuvio'} profile is available for this account.`);
      return data;
    };

    connectStremioBtn?.addEventListener('click', async () => {
      const name = (document.querySelector<HTMLInputElement>('#new-conn-name'))?.value.trim() || '';
      if (!name) {
        showMessage('Choose a name for the Stremio connection.', 'error');
        return;
      }
      if (stremioPollTimer !== null) {
        window.clearTimeout(stremioPollTimer);
        stremioPollTimer = null;
      }
      connectStremioBtn.disabled = true;
      const originalLabel = connectStremioBtn.textContent;
      connectStremioBtn.textContent = 'Creating link…';
      try {
        const response = await fetch('/api/proxy/auth/stremio/link/start', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        const link = await response.json();
        if (!response.ok) throw new Error(link.detail || 'Could not create the Stremio link.');
        const details = document.getElementById('stremio-link-details');
        const linkUrl = document.getElementById('stremio-link-url') as HTMLAnchorElement | null;
        const code = document.getElementById('stremio-link-code');
        const qr = document.getElementById('stremio-link-qr') as HTMLImageElement | null;
        const status = document.getElementById('stremio-link-status');
        details?.classList.remove('hidden');
        if (linkUrl) linkUrl.href = link.link;
        if (code) code.textContent = link.code;
        if (qr) qr.src = link.qrcode;
        if (status) status.textContent = 'Waiting for authorization…';
        window.open(link.link, '_blank', 'noopener,noreferrer');
        const linkExpiresAt = Date.now() + 10 * 60 * 1000;

        const poll = async () => {
          try {
            if (Date.now() >= linkExpiresAt) {
              throw new Error('Stremio authorization expired. Create a new link and try again.');
            }
            const pollResponse = await fetch('/api/proxy/auth/stremio/link/poll', {
              method: 'POST',
              headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
              body: JSON.stringify({
                code: link.code,
                name,
                sync_collection: (document.getElementById('new-sync-collection') as HTMLInputElement)?.checked ?? true,
                sync_watched: (document.getElementById('new-sync-watched') as HTMLInputElement)?.checked ?? true,
                sync_playback: (document.getElementById('new-sync-playback') as HTMLInputElement)?.checked ?? true,
                push_collection: (document.querySelector<HTMLInputElement>('#new-push-collection'))?.checked ?? false,
                push_watched: (document.getElementById('new-push-watched') as HTMLInputElement)?.checked ?? false,
                push_playback: (document.querySelector<HTMLInputElement>('#new-push-playback'))?.checked ?? false,
                auto_sync_interval: (() => {
                  const value = (document.querySelector<HTMLSelectElement>('#new-auto-sync'))?.value;
                  return value ? parseFloat(value) : null;
                })(),
              }),
            });
            const result = await pollResponse.json();
            if (!pollResponse.ok) throw new Error(result.detail || 'Stremio authorization failed.');
            if (result.status === 'connected') {
              stremioPollTimer = null;
              if (status) status.textContent = 'Connected. Reloading…';
              showMessage('Stremio connected.');
              window.location.reload();
              return;
            }
            stremioPollTimer = window.setTimeout(poll, 2000);
          } catch (error: any) {
            stremioPollTimer = null;
            if (status) status.textContent = error.message;
            showMessage(error.message, 'error');
            connectStremioBtn.disabled = false;
            connectStremioBtn.textContent = originalLabel;
          }
        };
        stremioPollTimer = window.setTimeout(poll, 1500);
        connectStremioBtn.textContent = 'Waiting…';
      } catch (error: any) {
        stremioPollTimer = null;
        showMessage(error.message, 'error');
        connectStremioBtn.disabled = false;
        connectStremioBtn.textContent = originalLabel;
      }
    });

    // Login with Plex - helpers declared with the Add Connection toggle above
    plexLoginBtn?.addEventListener('click', async () => {
      resetPlexLogin();
      plexLoginBtn.disabled = true;
      plexLoginBtn.textContent = 'Starting…';
      try {
        const startRes = await fetch('/api/proxy/auth/plex/pin/start', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        const start = await startRes.json();
        if (!startRes.ok) throw new Error(start.detail || 'Could not start the Plex login.');
        window.open(start.auth_url, '_blank', 'noopener,noreferrer');
        setPlexStatus('Waiting for you to authorize in Plex…');
        plexLoginBtn.textContent = 'Waiting…';
        const expiresAt = Date.now() + 14 * 60 * 1000;
        const intervalMs = Math.max(1, Number(start.interval) || 2) * 1000;

        const poll = async () => {
          try {
            if (Date.now() >= expiresAt) throw new Error('Plex login expired. Try again.');
            const pollRes = await fetch('/api/proxy/auth/plex/pin/poll', {
              method: 'POST',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            const result = await pollRes.json();
            if (!pollRes.ok) throw new Error(result.detail || 'Plex login failed.');
            if (result.status === 'pending') {
              plexPollTimer = window.setTimeout(poll, intervalMs);
              return;
            }
            plexPollTimer = null;
            plexLoginServers = result.servers || [];
            const username: string = result.account?.username || '';
            const usernameEl = document.querySelector<HTMLInputElement>('#new-conn-username');
            if (usernameEl && username) usernameEl.value = username;
            const authTokenEl = document.querySelector<HTMLInputElement>('#new-plex-auth-token');
            if (authTokenEl) authTokenEl.value = result.auth_token || '';
            const accountIdEl = document.querySelector<HTMLInputElement>('#new-plex-account-id');
            if (accountIdEl) accountIdEl.value = result.account?.id || '';

            if (!plexLoginServers.length) {
              setPlexStatus(`Signed in as ${username || 'your Plex account'}, but no reachable servers were found. Enter the server URL and token manually.`);
              plexLoginBtn.disabled = false;
              plexLoginBtn.textContent = 'Login with Plex';
              return;
            }
            if (plexServerSelect) {
              plexServerSelect.innerHTML = plexLoginServers
                .map((s, i) => `<option value="${i}">${esc(s.name)}${s.owned ? '' : ' (shared)'}</option>`)
                .join('');
            }
            plexServerWrap?.classList.remove('hidden');
            applyPlexServer();
            setPlexStatus(`Signed in as ${username || 'your Plex account'}. Pick a server, then press Add.`);
            plexLoginBtn.disabled = false;
            plexLoginBtn.textContent = 'Use a different account';
          } catch (error: any) {
            plexPollTimer = null;
            setPlexStatus(error.message);
            showMessage(error.message, 'error');
            plexLoginBtn.disabled = false;
            plexLoginBtn.textContent = 'Login with Plex';
          }
        };
        plexPollTimer = window.setTimeout(poll, intervalMs);
      } catch (error: any) {
        plexPollTimer = null;
        setPlexStatus(error.message);
        showMessage(error.message, 'error');
        plexLoginBtn.disabled = false;
        plexLoginBtn.textContent = 'Login with Plex';
      }
    });

    // Test new connection button
    const testNewBtn = document.querySelector<HTMLButtonElement>('#test-new-connection-btn');
    if (testNewBtn) {
      testNewBtn.addEventListener('click', async () => {
        const type = typeSelect?.value ?? 'jellyfin';
        const u = (document.querySelector<HTMLInputElement>('#new-conn-url'))?.value || '';
        const t = (document.querySelector<HTMLInputElement>('#new-conn-token'))?.value || '';
        const ui = (document.querySelector<HTMLInputElement>('#new-conn-user-id'))?.value || '';
        testNewBtn.disabled = true;
        const orig = testNewBtn.textContent;
        testNewBtn.textContent = '...';
        try {
          if (type === 'nuvio' || type === 'arvio') {
            await authenticateNuvio();
            showMessage(`${type === 'arvio' ? 'ARVIO' : 'Nuvio'} connection successful. Select the profile to sync.`);
          } else {
            const endpoint = `/api/proxy/auth/test-${type === 'plex' ? 'plex' : type === 'emby' ? 'emby' : 'jellyfin'}`;
            const credentials: Record<string, string> = type === 'plex'
              ? { url: u, token: t }
              : { url: u, token: t, user_id: ui };
            const res = await postIntegrationCredentials(endpoint, credentials);
            const data = await res.json();
            if (res.ok) showMessage(data.message || 'Connection successful!');
            else throw new Error(data.detail || 'Connection test failed');
          }
        } catch (e: any) {
          showMessage(errorMessage(e), 'error');
        } finally {
          testNewBtn.disabled = false;
          testNewBtn.textContent = orig;
        }
      });
    }

    // Create connection button
    const createBtn = document.querySelector<HTMLButtonElement>('#create-connection-btn');
    if (createBtn) {
      createBtn.addEventListener('click', async () => {
        const name = (document.querySelector<HTMLInputElement>('#new-conn-name'))?.value.trim();
        const type = typeSelect?.value ?? 'jellyfin';
        const u = (document.querySelector<HTMLInputElement>('#new-conn-url'))?.value.trim();
        let connectionToken = (document.querySelector<HTMLInputElement>('#new-conn-token'))?.value.trim();
        let userId = (document.querySelector<HTMLInputElement>('#new-conn-user-id'))?.value.trim() || null;
        const username = (document.querySelector<HTMLInputElement>('#new-conn-username'))?.value.trim() || null;
        if (!name || !u || !connectionToken) {
          showMessage(type === 'nuvio' || type === 'arvio' ? `Name, ${type === 'arvio' ? 'ARVIO' : 'Nuvio'} email and password are required.` : 'Name, URL and Token are required.', 'error');
          return;
        }

        createBtn.disabled = true;
        const orig = createBtn.textContent;
        createBtn.textContent = 'Adding…';

        try {
          if (type === 'nuvio' || type === 'arvio') {
            await authenticateNuvio();
            connectionToken = pendingNuvioRefreshToken;
            userId = nuvioProfileSelect?.value || null;
          }
          const body: Record<string, any> = {
            name, type, url: u, token: connectionToken,
            sync_collection: (document.getElementById('new-sync-collection') as HTMLInputElement)?.checked ?? true,
            sync_watched: (document.getElementById('new-sync-watched') as HTMLInputElement)?.checked ?? true,
            sync_ratings: type === 'nuvio' ? false : ((document.getElementById('new-sync-ratings') as HTMLInputElement)?.checked ?? true),
            sync_playback: (document.getElementById('new-sync-playback') as HTMLInputElement)?.checked ?? true,
            push_watched: (document.getElementById('new-push-watched') as HTMLInputElement)?.checked ?? false,
            push_collection: type === 'nuvio' && ((document.querySelector<HTMLInputElement>('#new-push-collection'))?.checked ?? false),
            push_playback: type === 'nuvio' && ((document.querySelector<HTMLInputElement>('#new-push-playback'))?.checked ?? false),
            push_ratings: type === 'nuvio' ? false : ((document.getElementById('new-push-ratings') as HTMLInputElement)?.checked ?? false),
            auto_sync_interval: (() => {
              const value = (document.querySelector<HTMLSelectElement>('#new-auto-sync'))?.value;
              return value ? parseFloat(value) : null;
            })(),
          };
          if (type === 'plex') {
            body.server_username = username;
            const authTok = (document.querySelector<HTMLInputElement>('#new-plex-auth-token'))?.value.trim();
            const acctId = (document.querySelector<HTMLInputElement>('#new-plex-account-id'))?.value.trim();
            const machineId = (document.querySelector<HTMLInputElement>('#new-plex-machine-id'))?.value.trim();
            if (authTok) body.plex_auth_token = authTok;
            if (acctId) body.plex_account_id = acctId;
            if (machineId) body.plex_machine_identifier = machineId;
          } else {
            body.server_user_id = userId;
          }

          const res = await fetch('/api/proxy/auth/connections', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.detail || 'Failed to create connection');
          }
          showMessage('Connection added! Reloading…');
          setTimeout(() => window.location.reload(), 1000);
        } catch (e: any) {
          showMessage(errorMessage(e), 'error');
          createBtn.disabled = false;
          createBtn.textContent = orig;
        }
      });
    }
  }

  function setupScrobbleConnections() {
    const apiKey = (document.querySelector<HTMLInputElement>('#scrob_api_key'))?.value ?? '';

    // Set webhook URLs and wire copy buttons for scrobble connection cards
    document.querySelectorAll('[data-scrobble-conn-id]').forEach(card => {
      const connId = card.getAttribute('data-scrobble-conn-id');
      const webhookInput = card.querySelector('.scrobble-webhook-url') as HTMLInputElement | null;
      const connType = webhookInput?.getAttribute('data-conn-type') ?? '';
      if (webhookInput && connId && connType) {
        webhookInput.value = `${window.location.origin}/api/proxy/webhooks/${connType}/scrobble/${connId}?api_key=${encodeURIComponent(apiKey)}`;
      }
      const copyBtn = card.querySelector('.scrobble-copy-webhook');
      if (copyBtn && webhookInput) {
        copyBtn.addEventListener('click', async () => {
          try {
            await copyToClipboard(webhookInput.value);
            flashCopied(copyBtn as HTMLElement);
          } catch {
            showMessage('Could not copy to clipboard', 'error');
          }
        });
      }
    });

    // Show/hide user_id vs username based on new scrobble connection type
    const scrobbleTypeSelect = document.querySelector<HTMLSelectElement>('#new-scrobble-type');
    const scrobbleUserIdRow = document.getElementById('new-scrobble-user-id-row');
    const scrobbleUsernameRow = document.getElementById('new-scrobble-username-row');
    const updateScrobbleTypeFields = () => {
      const isPlex = scrobbleTypeSelect?.value === 'plex';
      scrobbleUserIdRow?.classList.toggle('hidden', isPlex);
      scrobbleUsernameRow?.classList.toggle('hidden', !isPlex);
    };
    scrobbleTypeSelect?.addEventListener('change', updateScrobbleTypeFields);
    updateScrobbleTypeFields();

    // Create scrobble connection button
    const createScrobbleBtn = document.querySelector<HTMLButtonElement>('#create-scrobble-conn-btn');
    if (createScrobbleBtn) {
      createScrobbleBtn.addEventListener('click', async () => {
        const name = (document.querySelector<HTMLInputElement>('#new-scrobble-name'))?.value.trim();
        const type = scrobbleTypeSelect?.value ?? 'jellyfin';
        const ui = (document.querySelector<HTMLInputElement>('#new-scrobble-user-id'))?.value.trim() || null;
        const un = (document.querySelector<HTMLInputElement>('#new-scrobble-username'))?.value.trim() || null;
        if (!name) { showMessage('Name is required.', 'error'); return; }

        createScrobbleBtn.setAttribute('disabled', 'true');
        const orig = createScrobbleBtn.textContent;
        createScrobbleBtn.textContent = 'Adding…';

        const body: Record<string, any> = { name, type };
        if (type === 'plex') body.server_username = un;
        else body.server_user_id = ui;

        try {
          const res = await fetch('/api/proxy/auth/scrobble-connections', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.detail || 'Failed to create scrobble connection');
          }
          showMessage('Scrobble connection added! Reloading…');
          setTimeout(() => window.location.reload(), 1000);
        } catch (e: any) {
          showMessage(errorMessage(e), 'error');
          createScrobbleBtn.removeAttribute('disabled');
          createScrobbleBtn.textContent = orig;
        }
      });
    }
  }
  function setupSettingsForm() {
    const form = document.querySelector<HTMLFormElement>('#connections-form');
    if (!form) return;

    // Plex "Also monitor users" — toggle picker visibility and lazy-load friends
    async function loadPlexFriends(picker: HTMLElement, token: string) {
      const connId = picker.getAttribute('data-conn-id');
      const monitored: string[] = JSON.parse(picker.getAttribute('data-monitored') || '[]');
      const list = picker.querySelector('.plex-user-list') as HTMLElement;
      if (!list || list.querySelector('.plex-user-checkbox')) return; // already loaded
      list.innerHTML = '<p class="text-xs text-zinc-500 italic">Loading users…</p>';
      try {
        const res = await fetch(`/api/proxy/sync/connection/${connId}/plex-friends`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) throw new Error('Failed to load users');
        const data = await res.json();
        if (!data.friends?.length) {
          list.innerHTML = '<p class="text-xs text-zinc-500 italic">No friends found.</p>';
          return;
        }
        list.innerHTML = data.friends.map((f: any) => `
          <label class="flex items-center gap-3 cursor-pointer group">
            <input type="checkbox" class="plex-user-checkbox w-4 h-4 rounded cursor-pointer"
              data-user-id="${f.watchlist_id}"
              ${monitored.includes(f.watchlist_id) ? 'checked' : ''}
            />
            <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">
              ${f.display_name || f.username}
            </span>
          </label>
        `).join('');
      } catch {
        list.innerHTML = '<p class="text-xs text-red-400 italic">Could not load users.</p>';
      }
    }

    document.querySelectorAll('.plex-user-picker-toggle').forEach((btn) => {
      const connId = btn.getAttribute('data-conn-id');
      const picker = document.querySelector(`.plex-user-picker[data-conn-id="${connId}"]`) as HTMLElement | null;
      const chevron = btn.querySelector('.plex-user-picker-chevron') as HTMLElement | null;
      if (!picker) return;

      btn.addEventListener('click', () => {
        const open = !picker.classList.contains('hidden') && !picker.inert;
        if (open) void hideCollapsible(picker);
        else { showCollapsible(picker); loadPlexFriends(picker, token); }
        btn.setAttribute('aria-expanded', String(!open));
        if (chevron) chevron.style.transform = open ? '' : 'rotate(180deg)';
      });
    });

    // Show/hide the watchlist split sub-option based on the Lists checkbox
    const syncListsCb = document.querySelector<HTMLInputElement>('#trakt_sync_lists');
    const splitRow = document.getElementById('trakt-watchlist-split-row');
    if (syncListsCb && splitRow) {
      syncListsCb.addEventListener('change', () => {
        splitRow.classList.toggle('hidden', !syncListsCb.checked);
      });
    }
  }
  async function copyToClipboard(text: string): Promise<void> {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    // Fallback for HTTP (non-secure context) — works in all browsers
    const el = document.createElement('textarea');
    el.value = text;
    el.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0';
    document.body.appendChild(el);
    el.focus();
    el.select();
    const ok = document.execCommand('copy');
    document.body.removeChild(el);
    if (!ok) throw new Error('execCommand copy failed');
  }

  function flashCopied(btn: HTMLElement): void {
    const originalHTML = btn.innerHTML;
    btn.textContent = '✓';
    btn.classList.add('bg-green-900', 'border-green-700', 'text-green-400');
    btn.classList.remove('bg-zinc-800', 'hover:bg-zinc-700', 'border-zinc-700', 'text-zinc-300');
    setTimeout(() => {
      btn.innerHTML = originalHTML;
      btn.classList.remove('bg-green-900', 'border-green-700', 'text-green-400');
      btn.classList.add('bg-zinc-800', 'hover:bg-zinc-700', 'border-zinc-700', 'text-zinc-300');
    }, 2000);
  }

  function setupApiKey() {
    const copyBtn = document.querySelector<HTMLButtonElement>('#copy-api-key-btn');
    const regenBtn = document.querySelector<HTMLButtonElement>('#regenerate-api-key-btn');
    const keyInput = document.querySelector<HTMLInputElement>('#scrob_api_key');

    if (copyBtn && keyInput) {
      copyBtn.addEventListener('click', async () => {
        try {
          await copyToClipboard((keyInput as HTMLInputElement).value);
          flashCopied(copyBtn as HTMLElement);
        } catch {
          showMessage('Could not copy to clipboard', 'error');
        }
      });
    }

    if (regenBtn && keyInput) {
      regenBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to regenerate your API key? The old key will stop working immediately.')) return;

        regenBtn.disabled = true;
        const originalText = regenBtn.textContent;
        regenBtn.textContent = 'Regenerating...';

        try {
          const res = await fetch(`/api/proxy/auth/api-key/regenerate`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` },
          });
          if (!res.ok) {
            const data = await res.json();
            throw new Error(data.detail || 'Failed to regenerate key');
          }
          const data = await res.json();
          keyInput.value = data.api_key;
          showMessage('API key regenerated successfully!');
        } catch (e) {
          showMessage(errorMessage(e), 'error');
        } finally {
          regenBtn.disabled = false;
          regenBtn.textContent = originalText;
        }
      });
    }
  }

  function setupConnectedApps() {
    document.querySelectorAll<HTMLButtonElement>('.revoke-grant-btn').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const row = btn.closest('li');
        const id = row?.getAttribute('data-grant-id');
        if (!id || btn.disabled) return;
        btn.disabled = true;
        btn.textContent = 'Revoking…';
        try {
          const res = await fetch(`/api/proxy/auth/device/grants/${id}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` },
          });
          if (!res.ok) throw new Error();
          row?.remove();
          const list = document.getElementById('device-grants-list');
          if (list && list.querySelectorAll('li[data-grant-id]').length === 0) {
            list.innerHTML = '<li class="text-sm text-zinc-500 border border-zinc-800 rounded-lg px-4 py-3">No connected apps.</li>';
          }
          showMessage('Connected app revoked.');
        } catch {
          btn.disabled = false;
          btn.textContent = 'Revoke';
          showMessage('Failed to revoke connected app', 'error');
        }
      });
    });
  }

  function setupCollapsibleRows() {
    if (!document.body.classList.contains('connections-settings-page')) return;
    document.querySelectorAll('.collapsible-header').forEach(header => {
      if ((header as HTMLElement).dataset.connectionsCollapsibleInitialized) return;
      (header as HTMLElement).dataset.connectionsCollapsibleInitialized = 'true';
      const targetId = header.getAttribute('data-target');
      const initialBody = targetId ? document.getElementById(targetId) : null;
      header.setAttribute('role', 'button');
      header.setAttribute('tabindex', '0');
      if (targetId) header.setAttribute('aria-controls', targetId);
      header.setAttribute('aria-expanded', String(!!initialBody && !initialBody.classList.contains('hidden')));
      header.addEventListener('keydown', event => {
        const key = (event as KeyboardEvent).key;
        if (key !== 'Enter' && key !== ' ') return;
        event.preventDefault();
        (header as HTMLElement).click();
      });
      header.addEventListener('click', () => {
        const body = targetId ? document.getElementById(targetId) : null;
        if (!body) return;
        const isOpen = !body.classList.contains('hidden') && !body.inert;
        if (isOpen) {
          void hideCollapsible(body);
          header.querySelector('.collapsible-chevron')?.classList.remove('rotate-180');
        } else {
          showCollapsible(body);
          header.querySelector('.collapsible-chevron')?.classList.add('rotate-180');
        }
        header.setAttribute('aria-expanded', String(!isOpen));
      });
    });
  }

  function openDeepLinkedConnection() {
    const targetId = window.location.hash.slice(1);
    if (!targetId) return;
    const body = document.getElementById(targetId);
    const header = document.querySelector<HTMLElement>(`.collapsible-header[data-target="${CSS.escape(targetId)}"]`);
    if (!body || !header) return;
    showCollapsible(body);
    header.setAttribute('aria-expanded', 'true');
    header.querySelector('.collapsible-chevron')?.classList.add('rotate-180');
    header.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }

  async function loadLastSynced() {
    const appData = document.getElementById('app-data') as HTMLElement | null;
    const token = appData?.dataset.token ?? '';
    if (!token) return;

    try {
      const res = await fetch('/api/proxy/sync/status', {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) return;
      const jobs: any[] = await res.json();

      function parseUTC(dateStr: string): Date {
        return new Date(dateStr.endsWith('Z') || dateStr.includes('+') ? dateStr : dateStr + 'Z');
      }
      function timeAgo(dateStr: string): string {
        const diff = Math.floor((Date.now() - parseUTC(dateStr).getTime()) / 1000);
        if (diff < 60) return 'just now';
        if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
        if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
        return `${Math.floor(diff / 86400)}d ago`;
      }

      for (const source of ['jellyfin', 'emby', 'plex', 'nuvio', 'stremio'] as const) {
        const el = document.getElementById(`${source}-last-sync`);
        if (!el) continue;
        const job = jobs.find(j => j.source === source && (j.status === 'completed' || j.status === 'failed'));
        if (!job) continue;
        const label = job.status === 'failed' ? `failed ${timeAgo(job.updated_at)}` : `synced ${timeAgo(job.updated_at)}`;
        el.textContent = label;
        el.classList.remove('hidden');
      }
    } catch {
      // non-fatal
    }
  }



  async function loadSyncWarnings() {
    const appData = document.getElementById('app-data') as HTMLElement | null;
    const token = appData?.dataset.token ?? '';
    if (!token) return;

    try {
      // Remember which warning detail panes are currently open so we can restore them after rebuild
      const expandedDetails = new Set<string>();
      document.querySelectorAll('[id^="conn-warnings-details-"], [id^="conn-warnings-lookup-"]').forEach(el => {
        if (!el.classList.contains('hidden')) expandedDetails.add(el.id);
      });

      const [statusRes, overridesRes, matchedRes] = await Promise.all([
        fetch('/api/proxy/sync/status', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/proxy/sync/season-overrides', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/proxy/sync/matched-shows', { headers: { 'Authorization': `Bearer ${token}` } }),
      ]);
      if (!statusRes.ok) return;
      const jobs: any[] = await statusRes.json();
      const overrides: any[] = overridesRes.ok ? await overridesRes.json() : [];
      const matchedShows: any[] = matchedRes.ok ? await matchedRes.json() : [];

      // Build a lookup: lowercase show_title → matched show info
      // Used to overlay matched state onto SyncJob warnings that lack matched:true stamps
      const matchedShowMap = new Map<string, any>();
      for (const m of matchedShows) {
        if (m.show_title) matchedShowMap.set(m.show_title.toLowerCase(), m);
      }

      const overrideMap = new Map<string, any>();
      for (const o of overrides) {
        overrideMap.set(`${o.source_show_tmdb_id}:${o.source_season_number}`, o);
      }

      const formatJobDate = (job: any) => {
        const raw = job.updated_at as string;
        const stamped = raw.endsWith('Z') || raw.includes('+') ? raw : raw + 'Z';
        return new Date(stamped).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' });
      };

      // Pull unmatched-TMDB / enrichment vs push lookup-failed must not share a
      // job: the latest completed job with warnings used to be the Push, which
      // hid real Pull unmatched rows and painted lookup misses as Match-to-TMDB (#304).
      const latestJobFor = (connId: string, push: boolean) =>
        jobs.find((j: any) =>
          String(j.connection_id) === connId
          && j.status === 'completed'
          && j.warnings?.length > 0
          && (push ? j.job_type === 'push' : j.job_type === 'pull')
        );

      // Find all connection warning containers on the page
      const containers = document.querySelectorAll<HTMLElement>('[id^="conn-warnings-"]:not([id*="details-"]):not([id*="lookup-"])');
      containers.forEach(container => {
        const connId = container.id.replace('conn-warnings-', '');
        const pullJob = latestJobFor(connId, false);
        const pushJob = latestJobFor(connId, true);
        const pullWarnings: any[] = pullJob?.warnings ?? [];
        const lookupWarnings: any[] = (pushJob?.warnings ?? []).filter((w: any) => w.type === 'watched_lookup_failed');
        if (!pullJob && lookupWarnings.length === 0) { container.classList.add('hidden'); container.innerHTML = ''; return; }

        const date = pullJob ? formatJobDate(pullJob) : '';
        const pushDate = pushJob ? formatJobDate(pushJob) : '';
        const detailsId = `conn-warnings-details-${connId}`;
        const lookupDetailsId = `conn-warnings-lookup-${connId}`;

        const enrichmentWarnings = pullWarnings.filter((w: any) => w.tmdb_id !== undefined && w.season !== undefined);
        const unmatchedWarnings = pullWarnings.filter((w: any) => w.title !== undefined && w.type !== 'watched_lookup_failed');

        const renderEnrichment = enrichmentWarnings.length > 0 ? `
          <div class="space-y-1">
            <p class="text-xs text-zinc-500 mb-2">These seasons weren't found on TMDB — the show may be split into separate series there. Use "Remap" to point each season to the correct TMDB show.</p>
            ${enrichmentWarnings.map((w: any) => {
              const key = `${w.tmdb_id}:${w.season}`;
              const existing = overrideMap.get(key);
              const remapAttr = `data-src-tmdb="${w.tmdb_id}" data-src-season="${w.season}" data-src-title="${esc(w.show)}"`;
              return `
              <div class="flex items-center gap-3 py-1.5 border-b border-zinc-800/60 last:border-0">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">${esc(w.show)}</span>
                  <span class="ml-2 text-xs text-zinc-500">Season ${w.season}</span>
                  ${existing ? `<span class="ml-2 text-xs text-green-500">→ remapped</span>` : ''}
                </div>
                <span class="text-xs text-zinc-600 shrink-0 mr-2">${w.affected_episodes} ep${w.affected_episodes !== 1 ? 's' : ''}</span>
                <button type="button" class="remap-season-btn text-xs px-2.5 py-1 rounded-lg border cursor-pointer transition-colors shrink-0 ${existing ? 'border-green-700/50 text-green-400 hover:bg-green-900/20' : 'bg-amber-500/15 border-amber-500/40 text-amber-500 hover:bg-amber-500/25 hover:border-amber-500/60'}" ${remapAttr}>
                  ${existing ? 'Edit remap' : 'Remap'}
                </button>
              </div>`;
            }).join('')}
          </div>
        ` : '';

        // Group episode warnings by series_name to avoid N identical rows for the same show.
        // Series-level warnings for the same show are merged in (to carry their GUIDs) rather
        // than rendered as a separate row. Matched state is read directly from warning entries,
        // with a fallback to matchedShowMap for warnings created before auto-stamping existed.
        type GroupEntry = {count: number, reason: string, plex_guids: string[], matched: boolean, matched_tvdb_id?: number, matched_show_id?: number, matched_show_title?: string};
        const groupedEpisodeWarnings: Map<string, GroupEntry> = new Map();
        const standaloneUnmatched: any[] = [];
        for (const w of unmatchedWarnings) {
          if (w.media_type === 'episode' && w.series_name) {
            // Always overlay DB state — it reflects the current show linkage regardless of stamp age
            const dbMatch = matchedShowMap.get((w.series_name ?? '').toLowerCase());
            const isMatched = !!w.matched || !!dbMatch;
            const existing = groupedEpisodeWarnings.get(w.series_name);
            if (existing) {
              existing.count++;
              if (isMatched) {
                existing.matched = true;
                // Prefer tvdb_id: DB > stamp (stamps from old `already_linked` runs may have null tvdb_id)
                existing.matched_tvdb_id = dbMatch?.tvdb_id ?? w.matched_tvdb_id ?? existing.matched_tvdb_id;
                existing.matched_show_id = dbMatch?.show_id ?? w.matched_show_id ?? existing.matched_show_id;
                existing.matched_show_title = dbMatch?.show_title_matched ?? w.matched_show_title ?? existing.matched_show_title;
              }
            } else {
              groupedEpisodeWarnings.set(w.series_name, {
                count: 1,
                reason: w.reason ?? 'unknown reason',
                plex_guids: w.plex_guids ?? [],
                matched: isMatched,
                matched_tvdb_id: dbMatch?.tvdb_id ?? w.matched_tvdb_id,
                matched_show_id: dbMatch?.show_id ?? w.matched_show_id,
                matched_show_title: dbMatch?.show_title_matched ?? w.matched_show_title,
              });
            }
          } else {
            standaloneUnmatched.push(w);
          }
        }

        // Merge series-level standalone warnings into grouped episode entries where the title
        // matches, absorbing their GUIDs. Suppress the standalone row to avoid duplication.
        // Also apply matchedShowMap overlay to standalone series-level warnings.
        const trueStandaloneUnmatched = standaloneUnmatched.filter((w: any) => {
          const grouped = groupedEpisodeWarnings.get(w.title);
          if (grouped) {
            if (w.plex_guids?.length && !grouped.plex_guids.length) {
              grouped.plex_guids = w.plex_guids;
            }
            return false; // suppress — already shown in grouped section
          }
          // Apply matchedShowMap overlay for series-type standalone warnings
          if (!w.matched && (w.media_type === 'series' || w.media_type === 'episode')) {
            const dbMatch = matchedShowMap.get((w.title ?? '').toLowerCase());
            if (dbMatch) {
              w.matched = true;
              w.matched_tvdb_id = dbMatch.tvdb_id;
              w.matched_show_id = dbMatch.show_id;
              w.matched_show_title = dbMatch.show_title_matched;
            }
          }
          return true;
        });

        const hasUnmatched = groupedEpisodeWarnings.size > 0 || trueStandaloneUnmatched.length > 0;
        const displayCount = enrichmentWarnings.length + groupedEpisodeWarnings.size + trueStandaloneUnmatched.length;
        const renderUnmatched = hasUnmatched ? `
          <div class="space-y-1 ${enrichmentWarnings.length > 0 ? 'mt-4 pt-4 border-t border-zinc-800/60' : ''}">
            <p class="text-xs text-zinc-500 mb-2">Items that couldn't be matched to TMDB:</p>
            ${[...groupedEpisodeWarnings.entries()].map(([seriesName, {count, reason, plex_guids, matched, matched_tvdb_id, matched_show_id, matched_show_title}]) => {
              const isMatched = matched;
              const matchedTitle = matched_show_title ?? '';
              const matchHref = matched_tvdb_id ? `/show/tvdb/${matched_tvdb_id}` : (matched_show_id ? `/show/${matched_show_id}` : '');
              return `
              <div class="flex items-center gap-3 py-1.5 border-b border-zinc-800/60 last:border-0">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">${esc(seriesName)}</span>
                  <span class="ml-2 text-xs text-zinc-600">${count} episode${count !== 1 ? 's' : ''}</span>
                  ${isMatched
                    ? `<span class="ml-2 text-xs text-green-500">→ matched${matchedTitle && matchedTitle.toLowerCase() !== seriesName.toLowerCase() ? ` as "${esc(matchedTitle)}"` : ''}</span>`
                    : `<p class="text-xs text-zinc-500 mt-0.5">${esc(reason)}</p>`
                  }
                  ${plex_guids.length ? `<p class="text-xs text-zinc-600 font-mono mt-0.5">${plex_guids.map((g: string) => esc(g)).join(' · ')}</p>` : ''}
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  ${isMatched && matchHref ? `<a href="${esc(matchHref)}" class="text-xs px-2.5 py-1 rounded-lg border border-green-700/40 text-green-400 hover:bg-green-900/20 transition-colors">View</a>` : ''}
                  ${isMatched
                    ? `<button type="button" class="unmatch-show-btn text-xs px-2.5 py-1 rounded-lg border border-zinc-700 text-zinc-400 hover:bg-zinc-800 cursor-pointer transition-colors"
                        data-series-name="${esc(seriesName)}">Unmatch</button>`
                    : `<button type="button" class="match-show-btn text-xs px-2.5 py-1 rounded-lg border bg-amber-500/15 border-amber-500/40 text-amber-500 hover:bg-amber-500/25 hover:border-amber-500/60 cursor-pointer transition-colors"
                        data-series-name="${esc(seriesName)}">Match</button>`
                  }
                </div>
              </div>`;
            }).join('')}
            ${trueStandaloneUnmatched.map((w: any) => {
              const wMatched = !!w.matched;
              const wMatchedTitle = w.matched_movie_title ?? w.matched_show_title ?? '';
              const wMatchHref = w.media_type === 'movie' && w.matched_tmdb_id
                ? `/movie/${w.matched_tmdb_id}`
                : (w.matched_tvdb_id ? `/show/tvdb/${w.matched_tvdb_id}` : (w.matched_show_id ? `/show/${w.matched_show_id}` : ''));
              return `
              <div class="flex items-center gap-3 py-1.5 border-b border-zinc-800/60 last:border-0">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">${esc(w.title)}</span>
                  ${w.media_type ? `<span class="ml-2 text-xs text-zinc-600">${esc(w.media_type)}</span>` : ''}
                  ${wMatched
                    ? `<span class="ml-2 text-xs text-green-500">→ matched${wMatchedTitle && wMatchedTitle.toLowerCase() !== (w.title ?? '').toLowerCase() ? ` as "${esc(wMatchedTitle)}"` : ''}</span>`
                    : `<p class="text-xs text-zinc-500 mt-0.5">${esc(w.reason ?? 'unknown reason')}</p>`
                  }
                  ${w.plex_guids?.length ? `<p class="text-xs text-zinc-600 font-mono mt-0.5">${w.plex_guids.map((g: string) => esc(g)).join(' · ')}</p>` : ''}
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  ${wMatched && wMatchHref ? `<a href="${esc(wMatchHref)}" class="text-xs px-2.5 py-1 rounded-lg border border-green-700/40 text-green-400 hover:bg-green-900/20 transition-colors">View</a>` : ''}
                  ${wMatched
                    ? `<button type="button" class="unmatch-show-btn text-xs px-2.5 py-1 rounded-lg border border-zinc-700 text-zinc-400 hover:bg-zinc-800 cursor-pointer transition-colors"
                        data-series-name="${esc(w.title)}" data-media-type="${esc(w.media_type ?? '')}">Unmatch</button>`
                    : `<button type="button" class="match-show-btn text-xs px-2.5 py-1 rounded-lg border bg-amber-500/15 border-amber-500/40 text-amber-500 hover:bg-amber-500/25 hover:border-amber-500/60 cursor-pointer transition-colors shrink-0"
                        data-series-name="${esc(w.title)}" data-media-type="${esc(w.media_type ?? '')}">Match</button>`
                  }
                </div>
              </div>`;
            }).join('')}
          </div>
        ` : '';

        const hasPullPanel = !!pullJob && (hasUnmatched || enrichmentWarnings.length > 0);
        const hasLookupPanel = lookupWarnings.length > 0;
        if (!hasPullPanel && !hasLookupPanel) { container.classList.add('hidden'); container.innerHTML = ''; return; }

        const warnIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400 shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`;
        const chevron = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="warn-chevron w-4 h-4 text-amber-500/60 transition-transform shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>`;

        const pullBanner = hasPullPanel ? `
          <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 overflow-hidden">
            <button
              type="button"
              class="w-full flex items-center justify-between px-4 py-3 text-left hover:bg-amber-500/10 transition-colors cursor-pointer"
              data-warning-toggle="${detailsId}" aria-controls="${detailsId}" aria-expanded="false"
            >
              <div class="flex items-center gap-2">
                ${warnIcon}
                <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">${displayCount} item${displayCount > 1 ? 's' : ''} couldn't be fully synced</span>
                <span class="text-xs text-zinc-500">· ${esc(date)}</span>
              </div>
              ${chevron}
            </button>
            <div id="${detailsId}" class="hidden border-t border-amber-500/15 px-4 py-3">
              ${renderEnrichment}
              ${renderUnmatched}
            </div>
          </div>
        ` : '';

        // Group episode lookup-failures by series_name (same reasoning as
        // groupedEpisodeWarnings above) - a large legacy watch history
        // against a partial library can produce thousands of these for a
        // handful of shows, and one row per episode makes the panel
        // unusable (#400).
        const groupedLookupWarnings: Map<string, {count: number, reason: string}> = new Map();
        const standaloneLookupWarnings: any[] = [];
        for (const w of lookupWarnings) {
          if (w.media_type === 'episode' && w.series_name) {
            const existing = groupedLookupWarnings.get(w.series_name);
            if (existing) existing.count++;
            else groupedLookupWarnings.set(w.series_name, {count: 1, reason: w.reason ?? 'Not found on this server'});
          } else {
            standaloneLookupWarnings.push(w);
          }
        }
        const lookupDisplayCount = groupedLookupWarnings.size + standaloneLookupWarnings.length;

        const renderLookup = hasLookupPanel ? `
          <div class="space-y-1">
            <p class="text-xs text-zinc-500 mb-2">Watch history that has no matching item in this library. Nothing was marked watched here - this is not an unmatched TMDB title.</p>
            ${[...groupedLookupWarnings.entries()].map(([seriesName, {count, reason}]) => `
              <div class="flex items-center gap-3 py-1.5 border-b border-zinc-800/60 last:border-0">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">${esc(seriesName)}</span>
                  <span class="ml-2 text-xs text-zinc-600">${count} episode${count !== 1 ? 's' : ''}</span>
                  <p class="text-xs text-zinc-500 mt-0.5">${esc(reason)}</p>
                </div>
              </div>`).join('')}
            ${standaloneLookupWarnings.map((w: any) => `
              <div class="flex items-center gap-3 py-1.5 border-b border-zinc-800/60 last:border-0">
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-zinc-200 font-medium">${esc(w.title ?? 'Untitled')}</span>
                  ${w.media_type ? `<span class="ml-2 text-xs text-zinc-600">${esc(w.media_type)}</span>` : ''}
                  <p class="text-xs text-zinc-500 mt-0.5">${esc(w.reason ?? 'Not found on this server')}</p>
                </div>
              </div>`).join('')}
          </div>
        ` : '';

        const lookupBanner = hasLookupPanel ? `
          <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 overflow-hidden">
            <button
              type="button"
              class="w-full flex items-center justify-between px-4 py-3 text-left hover:bg-amber-500/10 transition-colors cursor-pointer"
              data-warning-toggle="${lookupDetailsId}" aria-controls="${lookupDetailsId}" aria-expanded="false"
            >
              <div class="flex items-center gap-2">
                ${warnIcon}
                <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">${lookupDisplayCount} watched item${lookupDisplayCount !== 1 ? 's' : ''} not found on this server${lookupWarnings.length !== lookupDisplayCount ? ` (${lookupWarnings.length} episodes)` : ''}</span>
                <span class="text-xs text-zinc-500">· ${esc(pushDate)}</span>
              </div>
              ${chevron}
            </button>
            <div id="${lookupDetailsId}" class="hidden border-t border-amber-500/15 px-4 py-3">
              ${renderLookup}
            </div>
          </div>
        ` : '';

        container.classList.remove('hidden');
        container.innerHTML = `<div class="space-y-2">${pullBanner}${lookupBanner}</div>`;

        // Restore expanded state if this pane was open before the rebuild
        for (const id of [detailsId, lookupDetailsId]) {
          if (!expandedDetails.has(id)) continue;
          const pane = document.getElementById(id);
          pane?.classList.remove('hidden');
          pane?.previousElementSibling?.querySelector('.warn-chevron')?.classList.add('rotate-180');
          pane?.previousElementSibling?.setAttribute('aria-expanded', 'true');
        }

      });
    } catch (_) { /* non-critical */ }
  }

  // ── Season remap modal ────────────────────────────────────────────────────


  function setupSeasonRemap() {
    seasonRemap?.stop();
    seasonRemap = mountSeasonRemap(document.getElementById('app-data')?.dataset.token ?? '', loadSyncWarnings);
  }

  setupActions();
  setupConnections();
  setupScrobbleConnections();
  setupSettingsForm();
  setupApiKey();
  setupConnectedApps();
  setupCollapsibleRows();
  openDeepLinkedConnection();
  checkConnections();
  loadSyncWarnings();
  loadLastSynced();
  setupSeasonRemap();

  document.addEventListener('astro:after-swap', () => {
    setupJobMonitoring();
    setupActions();
    setupConnections();
    setupSettingsForm();
    setupApiKey();
    setupConnectedApps();
    setupCollapsibleRows();
    openDeepLinkedConnection();
    checkConnections();
    loadSyncWarnings();
    loadLastSynced();
    setupSeasonRemap();
  });
</script>

