---
import { api } from "../lib/api";
import Tracker from "../layouts/Tracker.astro";
import { formatDate, requestDateLocale } from '../lib/date-time';
import { STREAMING_REGION_COOKIE, streamingCountry, streamingRegionPreference } from '../lib/streaming-region';
import BrowseCard from "../components/BrowseCard.astro";
import BrowseSkeleton from "../components/BrowseSkeleton.astro";
import BrowseSelect from "../components/BrowseSelect.astro";
import Icon from "../components/Icon.astro";
import {timelineGroups} from '../lib/browse-timeline-data';
import { tracker } from "../lib/tracker";
import "../styles/browse.css";
import { releaseYearBounds, releaseYearLabel } from "../lib/browse-ranges";
import {
  isCategoryView,
  genreSelectionLabel,
  browseRequestParams,
  sectionHref,
  browseLayout,
} from "../lib/browse-view";
const params = new URLSearchParams(Astro.url.search);
params.delete("streaming");
params.delete("unfiltered");
params.delete("include_rereleases");
if (params.get('sort') === 'upcoming') params.set('status', 'upcoming');
const account = Astro.locals.token ? await api.profile.get(Astro.locals.token).catch(() => null) : null;
const preference = streamingRegionPreference(Astro.cookies.get(STREAMING_REGION_COOKIE)?.value);
const region = streamingCountry(params.get('region')) || (preference?.manual ? preference.country : undefined) || preference?.country || streamingCountry(account?.country) || 'US';
params.set('region', region);
const view = browseLayout(params);
params.set('view',view);
const type = params.get("type") === "series" ? "series" : "movie";
if(type==='series'||!['1','true'].includes(params.get('cinema')||''))params.delete('cinema');
params.delete("type");
params.set("media_type", type);
params.delete("page");
params.delete("source");
const categories = isCategoryView(params);
let sections: any[] = [];
let payload: any = { results: [], has_more: false, page: 1, source: "" },
  facets: any = { genres: [], providers: [] },
  error = "";
const responses = await Promise.allSettled([
  tracker(
    categories
      ? `browse/sections?${new URLSearchParams({ media_type: type, region: params.get("region") || "US", min_score: params.get("min_score") || "0" })}`
      : `browse?${browseRequestParams(params)}`,
    Astro.locals.token,
  ),
  tracker(
    `browse/facets?${new URLSearchParams({ media_type: type, region: params.get("region") || "US", genres: params.get("genres") || "" })}`,
    Astro.locals.token,
  ),
]);
if (responses[0].status === "fulfilled") {
  if (categories) {
    sections = responses[0].value.sections;
    payload.notice = responses[0].value.notice;
  } else payload = responses[0].value;
} else error = "Unable to load titles. Check your filters and try again.";
if (responses[1].status === "fulfilled") facets = responses[1].value;
const cinemaCountry = region;
const cinemaScope = cinemaCountry ? new Intl.DisplayNames(['en'],{type:'region'}).of(cinemaCountry) || cinemaCountry : 'Worldwide';
const cinemaLabel = `Theatrical · ${cinemaScope}`;
const selectedGenres = (params.get("genres") || "").split(",");
const statusOptions =
  type === "movie"
    ? [
        ["released", "Released"],
        ["upcoming", "Upcoming"],
      ]
    : [
        ["airing", "Airing"],
        ["returning", "Returning Series"],
        ["finished", "Finished"],
        ["cancelled", "Cancelled"],
        ["upcoming", "Upcoming"],
      ];
const regions = [
  ["US", "United States"],
  ["GB", "United Kingdom"],
  ["CA", "Canada"],
  ["AU", "Australia"],
  ["DE", "Germany"],
  ["FR", "France"],
  ["IT", "Italy"],
  ["ES", "Spain"],
  ["NL", "Netherlands"],
  ["BR", "Brazil"],
  ["MX", "Mexico"],
  ["JP", "Japan"],
  ["IN", "India"],
  ["KR", "South Korea"],
];
if (!regions.some(([id]) => id === region)) regions.push([region, new Intl.DisplayNames(['en'], {type:'region'}).of(region) || region]);
const signedIn = !!Astro.locals.user;
const firstYear = Math.min(1900, Number(params.get("start")?.slice(0, 4)) || 1900, Number(params.get("end")?.slice(0, 4)) || 1900);
const lastYear = Math.max(new Date().getFullYear() + 3, Number(params.get("start")?.slice(0, 4)) || 0, Number(params.get("end")?.slice(0, 4)) || 0);
const years = releaseYearBounds(params.get("start") || "", params.get("end") || "", firstYear, lastYear);
const minScore = Math.max(0, Math.min(10, Number(params.get("min_score") ?? 0) || 0));
const hasSort = !categories;
const resultsSort = hasSort ? browseRequestParams(params).get('sort') : 'all';
const sortOptions = [
  ['all', 'All categories'], ['trending', 'Trending'], ['popular', 'Popular'],
  ['score', 'Highest rated'], ['newest', 'Newest'], ['upcoming', 'Upcoming'], ['oldest', 'Oldest'], ['title', 'Title'],
];
const viewHref = (view: string) => {
  const values = new URLSearchParams(Astro.url.search);
  if (view === 'timeline') values.set('view', view);
  else values.delete('view');
  return `/browse${values.size ? '?' + values : ''}`;
};
const typeHref = (type: string) => {
  const values = new URLSearchParams(viewHref(view).split('?')[1] || '');
  values.delete('genres');
  values.delete('status');
  values.delete('cinema');
  if (type === 'series') values.set('type', type);
  else values.delete('type');
  return `/browse${values.size ? '?' + values : ''}`;
};
const scoreLimit = 10;
const initialChips: string[] = facets.genres
  .filter((genre: any) => selectedGenres.includes(String(genre.id)))
  .map((genre: any) => genre.name);
const dateLocale = requestDateLocale(Astro.request.headers.get('accept-language'), Astro.cookies.get('anylist_date_region')?.value);
if (params.get("start")) initialChips.push(`After ${formatDate(params.get("start"),{locale:dateLocale})}`);
if (params.get("end")) initialChips.push(`Before ${formatDate(params.get("end"),{locale:dateLocale})}`);
const statusLabel = statusOptions.find(([id]) => id === params.get("status"))?.[1];
if (statusLabel) initialChips.push(statusLabel);
const providerLabel = facets.providers.find((provider: any) => String(provider.id) === params.get("provider"))?.name;
if (providerLabel) initialChips.push(providerLabel);
if (minScore !== 0) initialChips.push(`${minScore.toLocaleString()}+ TMDB score`);
if (params.get("q")?.trim()) initialChips.push(`“${params.get("q")!.trim()}”`);
if(params.has('cinema'))initialChips.push(cinemaLabel);

---

<Tracker title="Browse">

  <div class="page-width browse-page" data-browse-page data-browse-view={view} data-browse-sorted={hasSort ? '' : undefined} data-browse-chips={initialChips.length ? '' : undefined}>
    <script is:inline data-astro-rerun>
      document.currentScript.parentElement.dataset.browseScripted = "";
    </script>
    <header class="browse-header">
      <h1>Browse</h1>
      <div class="browse-header-controls">
      <nav aria-label="Media type" class="browse-types">
        <a
          href={typeHref('movie')}
          data-browse-type="movie"
          aria-current={type === "movie" ? "page" : undefined}
        >
          Movies
        </a>
        <a
          href={typeHref('series')}
          data-browse-type="series"
          aria-current={type === "series" ? "page" : undefined}
        >
          Series
        </a>
      </nav>
      <nav class="browse-view-switch" aria-label="Browse layout">
        <a href={viewHref('grid')} data-browse-layout="grid" aria-current={view==='grid'?'page':undefined}><Icon name="grid"/><span>Grid</span></a>
        <a href={viewHref('timeline')} data-browse-layout="timeline" aria-current={view==='timeline'?'page':undefined}><Icon name="calendar"/><span>Timeline</span></a>
      </nav>
      </div>
    </header>
    <form
      id="browse-filters"
      class="browse-filters" data-motion-static
      role="search"
      data-browse-form
    >
      <input type="hidden" name="type" value={type} />
      <input type="hidden" name="view" value={view} />
      <div class="browse-search-row">
        <label class="browse-search">
          <span>Search</span>
          <div>
            <Icon name="search" />
            <input
              type="search"
              name="q"
              value={params.get("q") || ""}
              placeholder="Search titles…"
              autocomplete="off"
              aria-label="Search titles"
            />
            <button type="button" class="browse-search-clear" data-browse-search-clear aria-label="Clear search" hidden={!params.get("q")}>
              <Icon name="close" />
            </button>
          </div>
        </label>
      </div>
      <label class="browse-cinema-toggle" data-browse-cinema data-cinema-label={cinemaLabel} hidden={type!=='movie'} title={cinemaLabel}>
        <input type="checkbox" name="cinema" value="1" checked={params.has('cinema')} aria-label={`Has cinema release · ${cinemaScope}`}/>
        <Icon name="film"/>
      </label>
      <div class="browse-controls" id="browse-controls">
        <label class="browse-sort" data-browse-primary-sort hidden={hasSort}>
          <span>Sort</span>
          <BrowseSelect name="sort" form="browse-filters" data-browse-sort valueLabel={params.get('q')?.trim() ? 'Relevance' : sortOptions.find(([id]) => id === (params.get('sort') || 'all'))?.[1]}>
            {sortOptions.map(([id, label]) => (
              <option value={id} selected={(params.get('sort') || 'all') === id}>{label}</option>
            ))}
          </BrowseSelect>
        </label>
        <div class="browse-filter">
          <span id="browse-genres-label">Genres</span>
          <details class="browse-filter-menu" data-filter-menu>
            <summary aria-labelledby="browse-genres-label browse-genres-value">
              <span id="browse-genres-value">
                {genreSelectionLabel(params.get('genres') || '', facets.genres)}
              </span>
              <Icon name="chevron-down" />
            </summary>
            <div class="browse-options" data-genre-options>
              {facets.genres.map((genre: any) => (
                <label>
                  <input
                    type="checkbox"
                    name="genre"
                    value={genre.id}
                    checked={selectedGenres.includes(String(genre.id))}
                  />
                  <span>{genre.name}</span>
                </label>
              ))}
            </div>
          </details>
          <input
            type="hidden"
            name="genres"
            value={params.get("genres") || ""}
          />
        </div>

        <label class="browse-filter">
          <span>Airing status</span>
          <BrowseSelect name="status" valueLabel={statusOptions.find(([id]) => id === params.get('status'))?.[1] || 'Any'}>
            <option value="">Any</option>
            {statusOptions.map(([id, label]) => (
              <option value={id} selected={params.get("status") === id}>
                {label}
              </option>
            ))}
          </BrowseSelect>
        </label>
        <details class="browse-more" data-motion-details open={!!(params.get("start") || params.get("end") || params.get("provider") || minScore !== 0)}>
          <summary aria-label="More filters" aria-controls="browse-secondary-filters" title="More filters">
            <Icon name="sliders" />
          </summary>
          <div class="browse-secondary-filters" id="browse-secondary-filters" data-motion-fade>
            <label class="browse-filter browse-streaming">
              <span>Streaming on</span>
              <select name="provider">
                <option value="">Any service</option>
                {facets.providers.map((provider: any) => (
                  <option
                    value={provider.id}
                    selected={params.get("provider") === String(provider.id)}
                  >
                    {provider.name}
                  </option>
                ))}
              </select>
            </label>
            <label class="browse-filter">
              <span>Region</span>
              <select name="region">
                {regions.map(([id, label]) => (
                  <option value={id} selected={region === id}>
                    {label}
                  </option>
                ))}
              </select>
            </label>
            <div class="browse-range" data-year-range data-range-collapsed={years.lower === years.upper ? '' : undefined} style={`--range-start:${(years.lower - firstYear) / (lastYear - firstYear) * 100}%;--range-end:${(years.upper - firstYear) / (lastYear - firstYear) * 100}%`}>
              <div class="browse-range-heading"><span id="browse-year-label">Year range</span><output>{releaseYearLabel(params.get('start') || '',params.get('end') || '',firstYear,lastYear)}</output></div>
              <div class="browse-range-track">
                <input type="range" min={firstYear} max={lastYear} value={years.lower} data-range-lower aria-label="Earliest release year" />
                <input type="range" min={firstYear} max={lastYear} value={years.upper} data-range-upper aria-label="Latest release year" />
              </div>
              <div class="browse-year-dates">
                <label><span>Released after</span><input type="date" name="start" value={params.get("start") || ""} /></label>
                <label><span>Released before</span><input type="date" name="end" value={params.get("end") || ""} /></label>
              </div>
            </div>
            <div class="browse-range" data-score-range style={`--range-start:0%;--range-end:${minScore / scoreLimit * 100}%`}>
              <div class="browse-range-heading"><label for="browse-min-score">Minimum TMDB score</label><output for="browse-min-score">{minScore.toLocaleString()}</output></div>
              <div class="browse-range-track">
                <input id="browse-min-score" type="range" name="min_score" min="0" max={scoreLimit} step="0.1" value={minScore} />
              </div>
            </div>
          </div>
        </details>
      </div>
    </form>
    <div class="browse-results-area">
    <div class="browse-results-toolbar">
      <div class="browse-active-filters" data-active-filters>
        {initialChips.map((label) => (
          <button type="button" aria-label={`Remove ${label} filter`}>{label}<Icon name="close" /></button>
        ))}
        {!!initialChips.length && <button type="button" data-reset>Clear all</button>}
      </div>
      <button type="button" class="button-quiet" data-browse-curated hidden>Return to curated results</button>
      <label class="browse-results-sort" hidden={!hasSort||view==='timeline'}>
        <Icon name="sort" />
        <BrowseSelect aria-label="Sort results" data-browse-results-sort valueLabel={params.get('q')?.trim() ? 'Relevance' : sortOptions.find(([id]) => id === resultsSort)?.[1]}>
          {sortOptions.map(([id, label]) => (
            <option value={id} selected={resultsSort === id}>{label}</option>
          ))}
        </BrowseSelect>
      </label>
    </div>
    <p
      class="browse-notice"
      data-browse-notice
      role="status"
      aria-live="polite"
    >{payload.notice || ""}</p>
    <div class="browse-error" data-browse-error role="alert" hidden={!error}>
      <span>{error}</span>
      <button type="button" class="button-secondary" data-browse-retry>
        Try again
      </button>
    </div>
    <section aria-label="Browse results" data-browse-region aria-busy="false">
      <div class="browse-sections" data-browse-sections hidden={!categories}>
        {sections.map((section: any) => (
          <section class="browse-category" aria-label={section.title}>
            <header>
              <h2><a href={sectionHref(type, region, section.filters)} data-view-all>{section.title}</a></h2>
              <a
                href={sectionHref(type, region, section.filters)}
                data-view-all
              >
                View all
              </a>
            </header>
            <div class="browse-grid">
              {section.results.map((item: any) => (
                <BrowseCard item={item} signedIn={signedIn} />
              ))}
            </div>
            {!section.results.length && (
              <p class="browse-category-empty">No titles found.</p>
            )}
          </section>
        ))}
      </div>
      <div class={view==='timeline'?'browse-timeline':'browse-grid'} data-browse-results hidden={categories}>
        {view === 'timeline' ? timelineGroups<any>(payload.results, params.get('sort')==='upcoming'||params.get('status')==='upcoming').map(year => (
          <section class="browse-timeline-year" data-timeline-year={year.year}>
            <h2 class="browse-timeline-year-label">{year.year || 'Undated'}</h2>
            <div class="browse-timeline-months">
              {year.months.map(month => (
                <section class="browse-timeline-month" data-timeline-month={month.key}>
                  <h3 data-local-date-time={/^\d{4}-\d{2}$/.test(month.key)&&!month.key.endsWith("-00")?"month-name":undefined} data-date-value={`${month.key}-01`}>{month.label}</h3>
                  <div class="browse-grid">
                    {month.items.map(item => <BrowseCard item={item} signedIn={signedIn} />)}
                  </div>
                </section>
              ))}
            </div>
          </section>
        )) : payload.results.map((item: any) => (
          <BrowseCard item={item} signedIn={signedIn} />
        ))}
      </div>
      <div
        class="browse-loading-view"
        data-browse-skeleton
        hidden
        aria-hidden="true"
      >
        <div class="browse-grid browse-skeletons" data-skeleton-grid>
          {Array.from({ length: 12 }, () => <BrowseSkeleton />)}
        </div>
        <div class="browse-timeline" data-skeleton-timeline hidden>
          <section class="browse-timeline-year">
            <h2 class="browse-timeline-year-label"><span class="skeleton-block" style="width:2.4ch;height:1lh"></span></h2>
            <div class="browse-timeline-months">
              <section class="browse-timeline-month">
                <h3><span class="skeleton-block" style="width:8ch;height:1lh"></span></h3>
                <div class="browse-grid browse-skeletons">
                  {Array.from({ length: 12 }, () => <BrowseSkeleton />)}
                </div>
              </section>
            </div>
          </section>
        </div>
        <div class="browse-sections" data-skeleton-sections hidden>
          {["Trending now", "Newest", "All-time popular", "Highest rated"].map(title => (
            <section class="browse-category">
              <header><h2>{title}</h2><span class="browse-skeleton-view-all">View all</span></header>
              <div class="browse-grid browse-skeletons">
                {Array.from({ length: 6 }, () => <BrowseSkeleton />)}
              </div>
            </section>
          ))}
        </div>
      </div>
      <div
        class="empty-state"
        data-browse-empty
        hidden={categories || payload.results.length > 0 || !!error}
      >
        <h2>No matching titles</h2>
        <button type="button" class="button-secondary" data-browse-clear>
          Clear filters
        </button>
      </div>
      <div class="browse-load" data-browse-sentinel hidden={categories}>
        <button
          type="button"
          class="button-quiet"
          data-browse-more
          hidden={!payload.has_more || (!!params.get('q')?.trim() && payload.results.length < 24)}
        >
          Load more
        </button>
        <span
          data-browse-end
          hidden={payload.has_more || !payload.results.length}
        >
          {payload.partial ? 'End of curated results' : "You're all caught up"}
        </span>
        <button type="button" class="button-secondary" data-browse-show-all hidden={categories || payload.has_more || !!error}>Show all</button>
      </div>
    </section>
    </div>
    <template data-browse-template>
      <BrowseCard signedIn={signedIn} template />
    </template>
    <template data-browse-close-icon>
      <Icon name="close" />
    </template>
    <script
      id="browse-data"
      type="application/json"
      set:html={JSON.stringify({ payload, facets, sections }).replaceAll(
        "<",
        "\\u003c",
      )}
    />
  </div>
</Tracker>
<script>
  import { initializeBrowse } from "../lib/browse";
  let session: AbortController;
  document.addEventListener("astro:page-load", () => {
    session?.abort();
    session = new AbortController();
    const root = document.querySelector<HTMLElement>("[data-browse-page]");
    if (root) initializeBrowse(root, session.signal);
  });
  document.addEventListener("astro:before-swap", () => session?.abort());
</script>
