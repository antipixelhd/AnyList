---
import Tracker from '../layouts/Tracker.astro';
import {api} from '../lib/api';
import {tracker} from '../lib/tracker';
import {responsiveArtwork} from '../lib/responsive-artwork';

const type = Astro.url.searchParams.get('type')==='series'?'series':'movie';
const q = Astro.url.searchParams.get('q')?.trim()||'';
let results:any[]=[],error='',notice='',trending=!q;
const normalize = (item:any) => ({
  id:item.id??null,tmdb_id:item.tmdb_id??null,type:item.type?.value||item.type||type,
  title:item.title,poster:item.poster??item.poster_path??null,
  year:(item.year||item.release_date||'').slice(0,4),adult:item.adult===true,
});
const unique = (items:any[]) => {
  const seen=new Set<string>();
  return items.filter(item=>{
    const key=`${item.type}:${item.title.toLocaleLowerCase()}:${item.year}`;
    if(seen.has(key))return false;seen.add(key);return true;
  });
};
try{
  if(q){
    const response=await tracker(`catalog?${new URLSearchParams({media_type:type,q})}`,Astro.locals.token);
    results=unique(response.results.map(normalize));notice=response.notice||'';
  }else{
    try{
      const response=type==='movie'?await api.media.trendingMovies(1,Astro.locals.token):await api.media.trendingShows(1,Astro.locals.token);
      results=unique(response.results.map(normalize).filter((item:any)=>!item.adult));
    }catch{results=[];}
    if(!results.length){
      const fallback=await tracker(`catalog?${new URLSearchParams({media_type:type})}`,Astro.locals.token);
      results=unique(fallback.results.map(normalize));trending=false;
      notice='Trending is temporarily unavailable. Showing the local catalogue.';
    }
  }
}catch(e){error=(e as Error).message;}
const heading=q?'Search results':trending?`Trending ${type==='movie'?'movies':'series'}`:`Browse ${type==='movie'?'movies':'series'}`;
const intro=q?`Live results for “${q}”.`:'See what people are watching now.';
const browseImageOptions={size:'w342',sizes:'(max-width: 650px) calc((100vw - 57px) / 2), 190px',route:'direct' as const};
---
<Tracker title="Browse"><div class="page-width browse-page">
  <header class="browse-heading"><span class="eyebrow">Browse</span><h1 data-browse-heading>{heading}</h1><p data-browse-intro>{intro}</p></header>
  <form class="browse-form" role="search" data-browse-form>
    <label class="sr-only" for="browse-query">Search titles</label><input id="browse-query" type="search" name="q" placeholder="Search titles…" value={q} autocomplete="off"/>
    <label class="sr-only" for="browse-type">Media type</label><select id="browse-type" name="type"><option value="movie" selected={type==='movie'}>Movies</option><option value="series" selected={type==='series'}>Series</option></select>
    <button class="sr-only" type="submit">Search</button>
  </form>
  <p class="browse-status" role="status" aria-live="polite" data-browse-status>{notice}</p>
  <div data-browse-region aria-busy="false">
    {error?<p class="error-message" data-browse-error>{error}</p>:<p class="error-message" data-browse-error hidden></p>}
    <div class="card-grid" data-browse-results hidden={results.length===0}>{results.map(m=>{const image=responsiveArtwork(m.poster,browseImageOptions);return <a class="media-card" href={m.id?`/title/${m.id}`:`/discover-title?type=${m.type}&id=${m.tmdb_id}`}>{image?.src?<img src={image.src} srcset={image.srcset} sizes={image.sizes} alt="" loading="lazy"/>:<span class="media-card-placeholder" aria-hidden="true">{m.title.slice(0,1)}</span>}<h2>{m.title}</h2><small>{m.year}</small></a>})}</div>
    <div class="card-grid browse-skeleton-grid" data-browse-skeleton aria-hidden="true" hidden>{Array.from({length:10},(_,index)=><div class="browse-skeleton-card" data-skeleton-card={index}><span class="skeleton-block skeleton-poster"></span><span class="skeleton-block skeleton-title"></span><span class="skeleton-block skeleton-meta"></span></div>)}</div>
    <div class="empty-state" data-browse-empty hidden={results.length>0}><h2>No matching titles</h2><p>Try another title or media type.</p></div>
  </div>
</div></Tracker>
<script>
import {applyResponsiveArtwork} from '../lib/responsive-artwork';
document.addEventListener('astro:page-load', () => {
  if (!document.querySelector('[data-browse-form]')) return;
  const form=document.querySelector<HTMLFormElement>('[data-browse-form]');
  const query=form?.querySelector<HTMLInputElement>('[name=q]');
  const typeSelect=form?.querySelector<HTMLSelectElement>('[name=type]');
  const heading=document.querySelector<HTMLElement>('[data-browse-heading]');
  const intro=document.querySelector<HTMLElement>('[data-browse-intro]');
  const status=document.querySelector<HTMLElement>('[data-browse-status]');
  const error=document.querySelector<HTMLElement>('[data-browse-error]');
  const grid=document.querySelector<HTMLElement>('[data-browse-results]');
  const skeleton=document.querySelector<HTMLElement>('[data-browse-skeleton]');
  const empty=document.querySelector<HTMLElement>('[data-browse-empty]');
  const region=document.querySelector<HTMLElement>('[data-browse-region]');
  let searchTimer:number|undefined;
  let controller:AbortController|undefined;

  const imageOptions={size:'w342',sizes:'(max-width: 650px) calc((100vw - 57px) / 2), 190px',route:'direct' as const};
  const normalize=(item:any,type:string)=>({
    id:item.id??null,tmdb_id:item.tmdb_id??null,type:item.type?.value||item.type||type,
    title:item.title,poster:item.poster??item.poster_path??null,
    year:String(item.year||item.release_date||'').slice(0,4),adult:item.adult===true,
  });
  const unique=(items:any[])=>{
    const seen=new Set<string>();
    return items.filter(item=>{const key=`${item.type}:${item.title.toLocaleLowerCase()}:${item.year}`;if(seen.has(key))return false;seen.add(key);return true;});
  };
  const render=(items:any[])=>{
    if(!grid||!empty)return;
    grid.replaceChildren();
    for(const item of items){
      const card=document.createElement('a');card.className='media-card browse-result-card';
      card.style.setProperty('--reveal-delay',`${Math.min(grid.childElementCount*25,150)}ms`);
      card.href=item.id?`/title/${item.id}`:`/discover-title?type=${encodeURIComponent(item.type)}&id=${item.tmdb_id}`;
      if(item.poster){const img=document.createElement('img');applyResponsiveArtwork(img,item.poster,imageOptions);img.alt='';img.loading='lazy';card.append(img);}
      else{const placeholder=document.createElement('span');placeholder.className='media-card-placeholder';placeholder.ariaHidden='true';placeholder.textContent=item.title.slice(0,1);card.append(placeholder);}
      const title=document.createElement('h2');title.textContent=item.title;card.append(title);
      const year=document.createElement('small');year.textContent=item.year;card.append(year);grid.append(card);
    }
    grid.hidden=items.length===0;empty.hidden=items.length>0;
  };
  async function load(){
    if(!query||!typeSelect)return;
    controller?.abort();const request=new AbortController();controller=request;
    const term=query.value.trim();const type=typeSelect.value;
    let loadingTimer=window.setTimeout(()=>{
      if(controller!==request)return;
      if(grid)grid.hidden=true;if(empty)empty.hidden=true;if(skeleton)skeleton.hidden=false;
      if(heading)heading.textContent=term?'Search results':`Browse ${type==='movie'?'movies':'series'}`;
      if(intro)intro.textContent=term?`Live results for “${term}”.`:'See what people are watching now.';
    },150);
    if(status)status.textContent='';if(error)error.hidden=true;if(empty)empty.hidden=true;region?.setAttribute('aria-busy','true');
    const params=new URLSearchParams();if(term)params.set('q',term);if(type==='series')params.set('type','series');
    history.replaceState(null,'',`${location.pathname}${params.size?`?${params}`:''}`);
    try{
      let response:Response;let payload:any;let isTrending=!term;
      if(term){response=await fetch(`/api/proxy/tracking/catalog?${new URLSearchParams({media_type:type,q:term})}`,{signal:request.signal});payload=await response.json();if(!response.ok)throw new Error('Unable to load titles. Please try again.');}
      else{response=await fetch(`/api/proxy/media/trending/${type==='movie'?'movies':'shows'}?page=1`,{signal:request.signal});payload=response.ok?await response.json():{results:[]};}
      let items=unique((payload.results||[]).map((item:any)=>normalize(item,type)).filter((item:any)=>!item.adult));
      let message=payload.notice||'';
      if(!term&&!items.length){
        const fallback=await fetch(`/api/proxy/tracking/catalog?media_type=${type}`,{signal:request.signal});
        if(!fallback.ok)throw new Error('Unable to load titles. Please try again.');
        items=unique((await fallback.json()).results.map((item:any)=>normalize(item,type)));isTrending=false;
        message='Trending is temporarily unavailable. Showing the local catalogue.';
      }
      if(controller!==request||query.value.trim()!==term||typeSelect.value!==type)return;
      window.clearTimeout(loadingTimer);if(skeleton)skeleton.hidden=true;
      render(items);if(heading)heading.textContent=term?'Search results':`${isTrending?'Trending':'Browse'} ${type==='movie'?'movies':'series'}`;
      if(intro)intro.textContent=term?`Live results for “${term}”.`:'See what people are watching now.';
      if(status)status.textContent=message;
    }catch(reason){
      if((reason as Error).name==='AbortError'||controller!==request||query.value.trim()!==term||typeSelect.value!==type)return;
      window.clearTimeout(loadingTimer);if(skeleton)skeleton.hidden=true;if(status)status.textContent='';if(grid)grid.hidden=true;if(empty)empty.hidden=true;
      if(heading)heading.textContent=term?'Search unavailable':'Browse unavailable';
      if(intro)intro.textContent='Try again in a moment.';
      if(error){error.hidden=false;error.textContent=navigator.onLine?'Unable to load titles. Please try again.':'No internet access. Reconnect and try again.';}
    }finally{
      if(controller===request){window.clearTimeout(loadingTimer);if(skeleton)skeleton.hidden=true;region?.setAttribute('aria-busy','false');}
    }
  }
  form?.addEventListener('submit',event=>{event.preventDefault();void load();});
  query?.addEventListener('input',()=>{window.clearTimeout(searchTimer);searchTimer=window.setTimeout(()=>void load(),280);});
  typeSelect?.addEventListener('change',()=>void load());
});
</script>
