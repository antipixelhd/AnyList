---
import {api} from '../../../../../lib/api';
const id=Number(Astro.params.id);
if (!Number.isSafeInteger(id)||id<=0) return Astro.redirect('/browse?type=series',302);
const show=await api.shows.getTvdb(id,Astro.locals.token).catch(()=>null);
const tmdbId=Number(show?.tmdb_id_cross);
if (Astro.locals.user&&Number.isSafeInteger(tmdbId)&&tmdbId>0) return Astro.redirect(`/discover-title?type=series&id=${tmdbId}`,302);
const query=show?.title?`&q=${encodeURIComponent(show.title)}`:'';
return Astro.redirect(`/browse?type=series${query}`,302);
---