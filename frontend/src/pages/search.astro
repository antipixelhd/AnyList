---
const query = Astro.url.searchParams.get('q')?.trim() || '';
const requestedType = Astro.url.searchParams.get('type') || '';
if (requestedType === 'user' && Astro.locals.user) {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  return Astro.redirect('/user/' + encodeURIComponent(Astro.locals.user.username) + '/social' + (params.size ? '?' + params : ''), 302);
}
const params = new URLSearchParams({ type: ['series', 'show'].includes(requestedType) ? 'series' : 'movie' });
if (query) params.set('q', query);
return Astro.redirect('/browse?' + params.toString(), 302);
