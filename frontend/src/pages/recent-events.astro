---
import Tracker from '../layouts/Tracker.astro';
import TrackingEditor from '../components/TrackingEditor.astro';
import {tracker,statuses} from '../lib/tracker';
let events:any={results:[],pending:0},prefs:any={},error='';
try{[events,prefs]=await Promise.all([tracker('recent-events',Astro.locals.token),tracker('preferences',Astro.locals.token)]);}catch(e){error=(e as Error).message;}
---
<Tracker title="Recent events"><div class="page-width"><h1>Recent events <span style="color:var(--blue)">{events.pending||''}</span></h1><p>Review changes from your connections. This page is private.</p>
<label style="display:flex;gap:12px;align-items:center;margin:24px 0"><input type="checkbox" id="auto-confirm" checked={prefs.auto_confirm}/>Automatically confirm ordinary Paused / Dropped changes</label><p style="color:var(--muted);font-size:13px">Conflicts, uncertain removals, initial imports, and deletion still require review. Ratings are always your choice.</p>
<p id="event-error" class="error-message" role="alert" hidden={!error}>{error}</p>
{events.outbound?.length>0&&<section><h2>Pending connection updates</h2><p>Playback updates retry during synchronization after the connection is approved. Newer remote playback requires review.</p>{events.outbound.map((action:any)=><article class="activity-card" style="display:block"><strong>{action.title}</strong><p>{action.connection} · {action.state} · {action.attempts} attempts</p>{action.error&&<small>{action.error}</small>}</article>)}</section>}
{events.results.length?events.results.map((event:any)=><article class="activity-card" style="display:block"><strong>{event.media?.title||'Connection update'}</strong><p>{event.message}</p><small>{event.state}</small>{event.state==='pending'&&event.kind!=='outbound_pending'&&<div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:14px"><button class="button-primary" data-event={event.id} data-action="confirm">{event.kind==='deletion_conflict'?'Retry deletion':'Confirm'}</button>{event.media&&event.kind!=='deletion_conflict'&&<><select data-status-for={event.id} aria-label="Change status">{statuses.map(([value,label])=><option value={value} selected={value===event.proposed_status}>{label}</option>)}</select><button class="button-secondary" data-event={event.id} data-action="change">Change status</button><button class="button-secondary" data-event={event.id} data-action="keep">Keep previous status</button></>}{event.kind==='deletion_conflict'&&<button class="button-secondary" data-event={event.id} data-action="keep">Keep remote history</button>}</div>}{event.media&&!['deletion_conflict','outbound_pending'].includes(event.kind)&&<button class="button-secondary" style="margin-top:12px" data-edit-entry={event.media.id}>Rate / edit entry</button>}</article>):<div class="empty-state"><h2>You're all caught up</h2><p>Changes that need your attention will appear here.</p></div>}
<h2 style="margin-top:40px;font-size:18px">Existing watch history</h2><p>Import existing Scrob watch history and ratings into your new lists. Streaming-library membership and existing tracked entries stay unchanged.</p><button class="button-secondary" id="import-history">Import existing history</button><p id="import-result" role="status"></p>
</div><TrackingEditor/></Tracker>
<script>
const error=document.querySelector<HTMLElement>('#event-error')!;
async function request(path:string,body:any,method='POST') {const response=await fetch(`/api/proxy/tracking/${path}`,{method,headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(!response.ok){const data=await response.json();throw new Error(typeof data.detail==='string'?data.detail:'Could not save this change.');}return response.json();}
function fail(e:any){error.textContent=e.message;error.hidden=false;}
document.querySelectorAll<HTMLButtonElement>('[data-event]').forEach(button=>button.addEventListener('click',async()=>{button.disabled=true;try{await request(`recent-events/${button.dataset.event}`,{action:button.dataset.action,status:button.dataset.action==='change'?(document.querySelector(`[data-status-for="${button.dataset.event}"]`) as HTMLSelectElement).value:undefined});location.reload();}catch(e){fail(e);button.disabled=false;}}));
document.querySelector<HTMLInputElement>('#auto-confirm')!.addEventListener('change',async event=>{const input=event.target as HTMLInputElement;try{await request('preferences',{auto_confirm:input.checked},'PATCH');}catch(e){input.checked=!input.checked;fail(e);}});
document.querySelector<HTMLButtonElement>('#import-history')!.addEventListener('click',async event=>{const button=event.target as HTMLButtonElement;button.disabled=true;try{const result=await request('import-history',{});document.querySelector('#import-result')!.textContent=`${result.added} entries imported.`;}catch(e){fail(e);}finally{button.disabled=false;}});
</script>
