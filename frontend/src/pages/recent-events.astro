---
import Tracker from '../layouts/Tracker.astro';
import NoticeCard from '../components/NoticeCard.astro';
import Icon from '../components/Icon.astro';
import {tracker,statuses} from '../lib/tracker';
import {responsiveArtwork} from '../lib/responsive-artwork';
import {eventBadge,eventCanChooseStatus,eventCanKeepPrevious,eventHref,eventIcon,eventImage,eventKey,eventMessage,eventSource,eventTitle,eventVariant,historyChanges,historyLabel,historyValue,isNewSeasonRelease,notificationVersion,outboundKey,seasonArtworkFallback,seasonArtworkRetry,shouldAutoSee,statusLabel} from '../lib/notification-presentation';
let events:any={results:[],pending:0,outbound:[]},prefs:any={},ignores:any[]=[],error='';
try{const values=await Promise.all([tracker('recent-events',Astro.locals.token),tracker('preferences',Astro.locals.token),tracker('provider-ignores',Astro.locals.token)]);[events,prefs]=values;ignores=values[2].results;}catch(e){error=(e as Error).message;}
const quickRatePoster=(path:any)=>responsiveArtwork(path,{size:'w185',sizes:'42px',route:'direct'})?.src || '';
---
<Tracker title="Notifications"><div class="page-width review-dashboard">
  <header class="page-intro"><div><span class="eyebrow">Your updates</span><h1>Notifications <span id="notification-count" class="count-pill" hidden={events.pending===0}>{events.pending>99?'99+':events.pending}</span></h1><p>Connection activity, inferred changes, and decisions that need your attention.</p></div></header>
  <p id="event-error" class="error-message" role="alert" hidden={!error}>{error}</p>
  <div class="dashboard-columns"><section aria-label="Connection notifications">
    <details class="connection-queue" id="notification-queue" data-motion-details hidden={!events.outbound?.length}><summary><span><Icon name="arrows-rotate"/><strong>Pending connection updates</strong></span><span class="count-pill" id="notification-queue-count">{events.outbound?.length||0}</span><Icon name="chevron-down"/></summary><div class="notice-list compact" id="notification-queue-list">{events.outbound?.map((item:any)=><NoticeCard cardKey={outboundKey(item)} version={notificationVersion(item,'outbound')} kind="outbound" state={item.state} variant={item.state==='conflict'?'warning':'info'} icon="arrows-rotate" title={item.title} href={item.media_id?`/title/${item.media_id}`:undefined} source="Connected services" badge={item.state==='conflict'?'Needs review':'Pending'} image={item.poster||null} imageSizes="(max-width:460px) 46px, (max-width:760px) 54px, 58px"><Fragment slot="detail"><div data-notification-detail><ul class="delivery-list">{item.deliveries.map((delivery:any)=><li><strong>{delivery.connection}</strong><span>{delivery.state==='conflict'?'Review needed':delivery.error?'Retry needed':'Queued'}</span>{delivery.error&&<small>{delivery.error}{delivery.attempts>1&&<span> · {delivery.attempts} attempts</span>}</small>}</li>)}</ul></div></Fragment></NoticeCard>)}</div></details>
    <div class="notice-list" id="notification-list" hidden={!events.results.length}>{events.results.map((event:any)=><NoticeCard cardKey={eventKey(event)} version={notificationVersion(event,'event')} kind={event.kind} priority={event.priority} state={event.state} variant={eventVariant(event)} icon={eventIcon(event)} title={eventTitle(event)} href={eventHref(event)} source={eventSource(event)} badge={eventBadge(event)} message={eventMessage(event)} image={eventImage(event)} artworkFallback={seasonArtworkFallback(event)} artworkRetry={seasonArtworkRetry(event)} dismissibleId={shouldAutoSee(event)?event.id:undefined}>
      <Fragment slot="detail"><div data-notification-detail>{event.previous_status&&event.proposed_status&&event.previous_status!==event.proposed_status&&<div class="status-transition"><span>{statusLabel(event.previous_status)}</span><Icon name="arrow-right"/><strong>{statusLabel(event.proposed_status)}</strong></div>}{historyChanges(event).length>0&&<div class="history-changes">{historyChanges(event).map((change:any)=><div><small>{historyLabel(change.field)}</small><span>{historyValue(change.previous)}</span><Icon name="arrow-right"/><strong>{historyValue(change.proposed)}</strong></div>)}</div>}{event.kind==='rating_conflict'&&<div class="status-transition"><span>{Number(event.previous_score).toFixed(1)}</span><Icon name="arrow-right"/><strong>{Number(event.proposed_score).toFixed(1)}</strong>{event.season_number!=null&&<small>Season {event.season_number}</small>}</div>}</div></Fragment>
      <Fragment slot="actions"><a data-notification-action="resolve" class="button-primary" href={event.payload.resolve_url} hidden={event.kind!=='connection_failure'}><Icon name="gear"/>Resolve</a>{event.kind==='rating_needed'&&event.media&&<button data-notification-action="rate" class="button-primary button-rate" data-quick-rate-id={event.media.id} data-quick-rate-title={event.media.title} data-quick-rate-poster={quickRatePoster(event.media.poster)} data-quick-rate-score=""><Icon name="star"/>Rate now</button>}{event.state==='pending'&&event.kind==='unmatched_import'&&<div class="provider-match" data-notification-action="match" data-match-box={event.id} data-kind={event.payload?.media_kind==='movies'?'movie':'series'}><div><input id={`catalog-title-${event.id}`} name="catalog_title" type="search" value={event.payload?.title||''} aria-label="Catalogue title"/><button class="button-secondary" data-match-search={event.id}><Icon name="search"/>Search</button><button class="button-quiet" data-event={event.id} data-action="ignore">Ignore for {event.provider}</button></div><div class="match-results" data-match-results={event.id}></div></div>}{isNewSeasonRelease(event)&&event.state==='pending'&&<><button data-notification-action="season-watching" class="button-primary" data-event={event.id} data-action="add_watching">Add to Watching</button><button data-notification-action="season-planning" class="button-secondary" data-event={event.id} data-action="add_planning">Add to Planning</button></>}{event.state==='pending'&&!['unmatched_import','connection_failure','new_season_release_date','new_season_release'].includes(event.kind)&&<><button data-notification-action="confirm" class="button-primary" data-event={event.id} data-action="confirm" data-proposed-status={event.proposed_status} data-status-choice={eventCanChooseStatus(event)}>{event.kind==='deletion_conflict'?'Retry deletion':event.kind.startsWith('initial_')?'Approve import':event.kind==='rating_conflict'?'Use provider score':'Confirm'}</button>{eventCanChooseStatus(event)&&<><label data-notification-action="status" class="status-select"><span>Status</span><select id={`event-status-${event.id}`} name="status" data-status-for={event.id}>{statuses.map(([value,label])=><option value={value} selected={value===event.proposed_status}>{label}</option>)}</select></label></>}{eventCanKeepPrevious(event)&&<button data-notification-action="keep" class="button-quiet" data-event={event.id} data-action="keep">Keep previous</button>}{event.kind==='rating_conflict'&&<button data-notification-action="keep-rating" class="button-quiet" data-event={event.id} data-action="keep">Keep local score</button>}{event.kind==='deletion_conflict'&&<button data-notification-action="keep-deletion" class="button-quiet" data-event={event.id} data-action="keep">Keep remote history</button>}</>}{event.dismissible&&<button data-notification-action="dismiss" class="button-quiet" data-dismiss={event.id}>Dismiss</button>}</Fragment>
    </NoticeCard>)}</div>{!error&&<div class="empty-state" id="notification-empty" hidden={events.results.length>0||events.outbound?.length>0}><Icon name="check"/><h2>You're all caught up</h2><p>Provider changes and decisions will appear here.</p></div>}
  </section><aside class="dashboard-aside review-inbox-tools" aria-label="Inbox tools"><section class="shortcut-panel review-preferences"><h2>Inbox preferences</h2>
    <label><input id="auto-confirm" name="auto_confirm" type="checkbox" data-pref="auto_confirm" checked={prefs.auto_confirm}/><span>Auto-confirm ordinary Paused / Dropped changes</span></label><label><input id="low-priority-notifications" name="low_priority_notifications" type="checkbox" data-pref="low_priority_notifications" checked={prefs.low_priority_notifications}/><span>Show automatic updates</span></label><label><input id="show-new-ratings-popup" name="show_new_ratings_popup" type="checkbox" data-pref="show_new_ratings_popup" checked={prefs.show_new_ratings_popup !== false}/><span>Show new ratings popup</span></label><label><input id="new-season-release-dates" name="new_season_release_dates" type="checkbox" data-pref="new_season_release_dates" checked={prefs.new_season_release_dates !== false}/><span>New Season release dates</span></label><label><input id="new-season-releases" name="new_season_releases" type="checkbox" data-pref="new_season_releases" checked={prefs.new_season_releases !== false}/><span>New Season releases</span></label>
    <label class="retention-field" for="low-priority-retention-days"><span>Keep low-priority notifications</span><select class="inbox-days-select" id="low-priority-retention-days" name="low_priority_retention_days" data-pref="low_priority_retention_days"><option value="1" selected={prefs.low_priority_retention_days===1}>1 day</option><option value="7" selected={prefs.low_priority_retention_days===7}>7 days</option><option value="14" selected={prefs.low_priority_retention_days===14}>14 days</option><option value="30" selected={prefs.low_priority_retention_days===30}>30 days</option></select></label>
  </section><section class="shortcut-panel"><h2>Ignored imports</h2><p>Entries ignored during provider matching can be restored here.</p>{ignores.length?<div class="ignore-list">{ignores.map((item:any)=><div><span><strong>{item.title||item.external_key}</strong><small>{item.provider}</small></span><button class="button-secondary" data-unignore={item.id}>Restore</button></div>)}</div>:<p class="section-empty">No ignored provider entries.</p>}</section>
  </aside></div>
<!-- Client-created cards clone these SSR templates so icons, slots, and controls stay aligned with initial rendering. -->
<template id="notification-card-template"><NoticeCard cardKey="template" version="template" kind="event" variant="info" icon="info" title="Notification" source="Connection sync" badge="Needs review" message="Notification message"><Fragment slot="detail"><div data-notification-detail></div></Fragment><Fragment slot="actions"><a data-notification-action="resolve" class="button-primary" href="#"><Icon name="gear"/>Resolve</a><button data-notification-action="rate" class="button-primary button-rate" data-quick-rate-id="" data-quick-rate-title="" data-quick-rate-poster="" data-quick-rate-score=""><Icon name="star"/>Rate now</button><div class="provider-match" data-notification-action="match"><div><input name="catalog_title" type="search" aria-label="Catalogue title"/><button class="button-secondary" data-match-search=""><Icon name="search"/>Search</button><button class="button-quiet" data-event="" data-action="ignore">Ignore</button></div><div class="match-results" data-match-results=""></div></div><button data-notification-action="season-watching" class="button-primary" data-event="" data-action="add_watching" hidden>Add to Watching</button><button data-notification-action="season-planning" class="button-secondary" data-event="" data-action="add_planning" hidden>Add to Planning</button><button data-notification-action="confirm" class="button-primary" data-event="" data-action="confirm" data-proposed-status="" data-status-choice="false">Confirm</button><label data-notification-action="status" class="status-select"><span>Status</span><select name="status" data-status-for="">{statuses.map(([value,label])=><option value={value}>{label}</option>)}</select></label><button data-notification-action="keep" class="button-quiet" data-event="" data-action="keep">Keep previous</button><button data-notification-action="keep-rating" class="button-quiet" data-event="" data-action="keep">Keep local score</button><button data-notification-action="keep-deletion" class="button-quiet" data-event="" data-action="keep">Keep remote history</button><button data-notification-action="dismiss" class="button-quiet" data-dismiss="">Dismiss</button></Fragment></NoticeCard></template>
<template id="notification-outbound-template"><NoticeCard cardKey="template" version="template" kind="outbound" variant="info" icon="arrows-rotate" title="Pending connection update" source="Connected services" badge="Pending"><Fragment slot="detail"><div data-notification-detail></div></Fragment></NoticeCard></template>
<template id="notification-icon-info"><Icon name="info"/></template><template id="notification-icon-warning"><Icon name="warning"/></template><template id="notification-icon-star"><Icon name="star"/></template><template id="notification-icon-search"><Icon name="search"/></template><template id="notification-icon-arrows-rotate"><Icon name="arrows-rotate"/></template><template id="notification-icon-inbox"><Icon name="inbox"/></template><template id="notification-icon-check"><Icon name="check"/></template><template id="notification-icon-arrow-right"><Icon name="arrow-right"/></template><template id="notification-icon-calendar"><Icon name="calendar"/></template>

</div></Tracker>

<script src="../lib/notification-inbox.ts"></script>
