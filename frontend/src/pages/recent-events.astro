---
import Tracker from '../layouts/Tracker.astro';
import TrackingEditor from '../components/TrackingEditor.astro';
import ActivityCover from '../components/ActivityCover.astro';
import {tracker,statuses} from '../lib/tracker';
let events:any={results:[],pending:0},prefs:any={},error='';
try{[events,prefs]=await Promise.all([tracker('recent-events',Astro.locals.token),tracker('preferences',Astro.locals.token)]);}catch(e){error=(e as Error).message;}
const labels:Record<string,string>={initial_import:'First import',initial_cloud_import:'First import',playback_removed:'Playback changed',conflict:'Needs your decision',rating_conflict:'Rating needs review',deletion_conflict:'Deletion needs review',outbound_pending:'Waiting for connections'};
---
<Tracker title="Recent events"><div class="page-width dashboard review-dashboard">
<header class="page-intro"><div><span class="eyebrow">Private sync inbox</span><h1>Recent events {events.pending>0&&<span class="count-pill">{events.pending}</span>}</h1><p>Review your connection updates and make them your own.</p></div><a class="button-secondary" href="/home">Back to activity</a></header>
<p id="event-error" class="error-message" role="alert" hidden={!error}>{error}</p>
<div class="dashboard-columns"><section aria-label="Connection events">
{events.outbound?.length>0&&<details class="outbound-panel"><summary>Pending connection updates <span class="count-pill">{events.outbound.length}</span></summary><p>Updates retry during synchronization after approval.</p>{events.outbound.map((action:any)=><div class="outbound-row"><span class="sync-symbol" aria-hidden="true">↻</span><div><strong>{action.title}</strong><p>{action.connection} · {action.attempts} attempts</p>{action.error&&<small>{action.error}</small>}</div><span class="event-badge">{action.state}</span></div>)}</details>}
{events.results.length?events.results.map((event:any)=><article class="visual-event review-event">
<ActivityCover media={event.media}/><div class="event-body"><div class="event-meta"><span>{labels[event.kind]||'Connection update'}</span><span class:list={['event-badge',{'needs-review':event.state==='pending'}]}>{event.state==='pending'?'To review':event.state}</span></div>
<h2>{event.media?<a href={`/title/${event.media.id}`}>{event.media.title}</a>:'Review your imported library'}</h2><p class="review-message">{event.message}</p>
{event.previous_status&&event.proposed_status&&<div class="status-transition"><span>{statuses.find(([s])=>s===event.previous_status)?.[1]}</span><span aria-hidden="true">→</span><strong>{statuses.find(([s])=>s===event.proposed_status)?.[1]}</strong></div>}
{event.kind==='rating_conflict'&&<div class="status-transition"><span>{Number(event.previous_score).toFixed(1)}</span><span aria-hidden="true">→</span><strong>{Number(event.proposed_score).toFixed(1)}</strong>{event.season_number!==null&&event.season_number!==undefined&&<small>Season {event.season_number}</small>}</div>}
<div class="event-actions">{event.state==='pending'&&event.kind!=='outbound_pending'&&<><button class="button-primary" data-event={event.id} data-action="confirm">{event.kind==='deletion_conflict'?'Retry deletion':event.kind==='initial_import'||event.kind==='initial_cloud_import'?'Approve import':event.kind==='rating_conflict'?'Use provider score':'Confirm change'}</button>{event.media&&!['deletion_conflict','rating_conflict'].includes(event.kind)&&<><label class="status-select"><span>Choose status</span><select data-status-for={event.id} aria-label={`Status for ${event.media.title}`}>{statuses.map(([value,label])=><option value={value} selected={value===event.proposed_status}>{label}</option>)}</select></label><button class="button-secondary" data-event={event.id} data-action="change">Apply status</button><button class="button-secondary" data-event={event.id} data-action="keep">Keep previous</button></>}{event.kind==='rating_conflict'&&<button class="button-secondary" data-event={event.id} data-action="keep">Keep local score</button>}{event.kind==='deletion_conflict'&&<button class="button-secondary" data-event={event.id} data-action="keep">Keep remote history</button>}</>}{event.media&&!['deletion_conflict','outbound_pending'].includes(event.kind)&&<button class="button-secondary" data-edit-entry={event.media.id}>Rate / edit</button>}</div>
{['initial_import','initial_cloud_import'].includes(event.kind)&&<p class="review-note">Approval allows enabled outbound sync after conflicts are resolved. Review your lists first.</p>}
</div></article>):!error&&<div class="empty-state"><span class="empty-symbol" aria-hidden="true">✓</span><h2>You're all caught up</h2><p>Changes that need your attention will appear here.</p><a class="button-secondary" href="/browse">Explore titles</a></div>}
</section><aside class="dashboard-aside"><section class="shortcut-panel review-preferences"><h2>Review preferences</h2><label><input type="checkbox" id="auto-confirm" checked={prefs.auto_confirm} disabled={!!error}/><span>Automatically confirm ordinary Paused / Dropped changes</span></label><p>Conflicts, uncertain removals, initial imports and deletion still require review. Ratings are always your choice.</p></section>
<section class="shortcut-panel"><h2>Existing watch history</h2><p>Bring existing watch history and ratings into your lists. Library membership stays separate.</p><button class="button-secondary" id="import-history">Import existing history</button><p id="import-result" role="status"></p></section></aside></div>
</div><TrackingEditor/></Tracker>
<script>
const error=document.querySelector<HTMLElement>('#event-error')!;
async function request(path:string,body:any,method='POST') {const response=await fetch(`/api/proxy/tracking/${path}`,{method,headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(!response.ok){const data=await response.json();throw new Error(typeof data.detail==='string'?data.detail:'Could not save this change.');}return response.json();}
function fail(e:any){error.textContent=e.message;error.hidden=false;}
document.querySelectorAll<HTMLButtonElement>('[data-event]').forEach(button=>button.addEventListener('click',async()=>{button.disabled=true;try{await request(`recent-events/${button.dataset.event}`,{action:button.dataset.action,status:button.dataset.action==='change'?(document.querySelector(`[data-status-for="${button.dataset.event}"]`) as HTMLSelectElement).value:undefined});location.reload();}catch(e){fail(e);button.disabled=false;}}));
document.querySelector<HTMLInputElement>('#auto-confirm')!.addEventListener('change',async event=>{const input=event.target as HTMLInputElement;try{await request('preferences',{auto_confirm:input.checked},'PATCH');}catch(e){input.checked=!input.checked;fail(e);}});
document.querySelector<HTMLButtonElement>('#import-history')!.addEventListener('click',async event=>{const button=event.target as HTMLButtonElement;button.disabled=true;try{const result=await request('import-history',{});document.querySelector('#import-result')!.textContent=`${result.added} entries imported.`;}catch(e){fail(e);}finally{button.disabled=false;}});
</script>
