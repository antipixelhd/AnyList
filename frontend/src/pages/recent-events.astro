---
import TrackerSettings from '../layouts/TrackerSettings.astro';
import TrackingEditor from '../components/TrackingEditor.astro';
import {tracker,statuses} from '../lib/tracker';
let events:any={results:[],pending:0,outbound:[]},prefs:any={},ignores:any[]=[],error='';
try{const values=await Promise.all([tracker('recent-events',Astro.locals.token),tracker('preferences',Astro.locals.token),tracker('provider-ignores',Astro.locals.token)]);[events,prefs]=values;ignores=values[2].results;}catch(e){error=(e as Error).message;}
const labels:Record<string,string>={initial_import:'First import',initial_cloud_import:'First import',playback_removed:'Playback updated',conflict:'Needs a decision',cloud_conflict:'Needs a decision',rating_conflict:'Rating conflict',deletion_conflict:'Deletion conflict',outbound_pending:'Connection update',unmatched_import:'Unmatched import'};
---
<TrackerSettings title="Recent events"><div class="review-dashboard">
  <header class="page-intro"><div><span class="eyebrow">Private sync inbox</span><h1>Recent events {events.pending>0&&<span class="count-pill">{events.pending}</span>}</h1><p>Automatic provider changes appear as compact notifications. Items that need a decision stay pinned.</p></div></header>
  <p id="event-error" class="error-message" role="alert" hidden={!error}>{error}</p>
  <div class="dashboard-columns"><section aria-label="Connection notifications">
    {events.outbound?.length>0&&<details class="outbound-panel"><summary>Pending connection updates <span class="count-pill">{events.outbound.length}</span></summary>{events.outbound.map((action:any)=><div class="outbound-row"><span class="sync-symbol" aria-hidden="true">↻</span><div><strong>{action.title}</strong><p>{action.connection} · {action.attempts} attempts</p>{action.error&&<small>{action.error}</small>}</div><span class="event-badge">{action.state}</span></div>)}</details>}
    {events.results.length?<div class="notification-list">{events.results.map((event:any)=><article class:list={['notification-card',event.priority]} data-auto-seen={event.dismissible&&event.priority==='low'?event.id:undefined}>
      <div><div class="notification-meta"><span>{labels[event.kind]||'Provider update'}</span>{event.provider&&<span>{event.provider}</span>}<span>{event.priority}</span></div><h2>{event.media?<a href={`/title/${event.media.id}`}>{event.media.title}</a>:event.payload?.title||'Connection reconciliation'}</h2><p>{event.message}</p>
      {event.previous_status&&event.proposed_status&&<div class="status-transition"><span>{statuses.find(([value])=>value===event.previous_status)?.[1]}</span><span aria-hidden="true">→</span><strong>{statuses.find(([value])=>value===event.proposed_status)?.[1]}</strong></div>}
      {event.kind==='rating_conflict'&&<div class="status-transition"><span>{Number(event.previous_score).toFixed(1)}</span><span aria-hidden="true">→</span><strong>{Number(event.proposed_score).toFixed(1)}</strong>{event.season_number!=null&&<small>Season {event.season_number}</small>}</div>}</div>
      <span class:list={['event-badge',{'needs-review':event.state==='pending'}]}>{event.state==='pending'?'Review':event.state}</span>
      <div class="event-actions">{event.state==='pending'&&event.kind==='unmatched_import'&&<div class="provider-match" data-match-box={event.id} data-kind={event.payload?.media_kind==='movies'?'movie':'series'}><div><input type="search" value={event.payload?.title||''} aria-label="Catalogue title"/><button class="button-secondary" data-match-search={event.id}>Search catalogue</button><button class="button-secondary" data-event={event.id} data-action="ignore">Ignore for {event.provider}</button></div><div class="match-results" data-match-results={event.id}></div></div>}{event.state==='pending'&&!['outbound_pending','unmatched_import'].includes(event.kind)&&<><button class="button-primary" data-event={event.id} data-action="confirm">{event.kind==='deletion_conflict'?'Retry deletion':event.kind.startsWith('initial_')?'Approve import':event.kind==='rating_conflict'?'Use provider score':'Confirm'}</button>{event.media&&!['deletion_conflict','rating_conflict'].includes(event.kind)&&<><label class="status-select"><span>Choose status</span><select data-status-for={event.id}>{statuses.map(([value,label])=><option value={value} selected={value===event.proposed_status}>{label}</option>)}</select></label><button class="button-secondary" data-event={event.id} data-action="change">Apply status</button><button class="button-secondary" data-event={event.id} data-action="keep">Keep previous</button></>}{event.kind==='rating_conflict'&&<button class="button-secondary" data-event={event.id} data-action="keep">Keep local score</button>}{event.kind==='deletion_conflict'&&<button class="button-secondary" data-event={event.id} data-action="keep">Keep remote history</button>}</>}{event.media&&!['deletion_conflict','outbound_pending'].includes(event.kind)&&<button class="button-secondary" data-edit-entry={event.media.id}>Rate / edit</button>}{event.dismissible&&<button class="button-secondary" data-dismiss={event.id}>Dismiss</button>}</div>
    </article>)}</div>:!error&&<div class="empty-state"><span class="empty-symbol" aria-hidden="true">✓</span><h2>You're all caught up</h2><p>Automatic connection changes and decisions will appear here.</p></div>}
  </section><aside class="dashboard-aside"><section class="shortcut-panel review-preferences"><h2>Inbox & list preferences</h2>
    <label><input type="checkbox" data-pref="auto_confirm" checked={prefs.auto_confirm}/><span>Auto-confirm ordinary Paused / Dropped changes</span></label><label><input type="checkbox" data-pref="low_priority_notifications" checked={prefs.low_priority_notifications}/><span>Show low-priority automatic updates</span></label><label><input type="checkbox" data-pref="combine_lists" checked={prefs.combine_lists}/><span>Combine movie and series lists</span></label>
    <label class="retention-field"><span>Keep low-priority notifications</span><select data-pref="low_priority_retention_days"><option value="1" selected={prefs.low_priority_retention_days===1}>1 day</option><option value="7" selected={prefs.low_priority_retention_days===7}>7 days</option><option value="14" selected={prefs.low_priority_retention_days===14}>14 days</option><option value="30" selected={prefs.low_priority_retention_days===30}>30 days</option></select></label>
  </section><section class="shortcut-panel"><h2>Ignored imports</h2><p>Entries ignored during provider matching can be restored here.</p>{ignores.length?<div class="ignore-list">{ignores.map((item:any)=><div><span><strong>{item.title||item.external_key}</strong><small>{item.provider}</small></span><button class="button-secondary" data-unignore={item.id}>Restore</button></div>)}</div>:<p class="section-empty">No ignored provider entries.</p>}</section>
  <section class="shortcut-panel"><h2>Existing watch history</h2><p>Import existing history and ratings. Streaming-library membership stays separate.</p><button class="button-secondary" id="import-history">Import existing history</button><p id="import-result" role="status"></p></section></aside></div>
</div><TrackingEditor/></TrackerSettings>
<script>
const error=document.querySelector<HTMLElement>('#event-error')!;
async function request(path:string,body:any={},method='POST'){const response=await fetch(`/api/proxy/tracking/${path}`,{method,headers:{'Content-Type':'application/json'},body:method==='DELETE'?undefined:JSON.stringify(body)});if(!response.ok){const data=await response.json();throw new Error(typeof data.detail==='string'?data.detail:'Could not save this change.');}return response.json();}
function fail(exception:any){error.textContent=exception.message;error.hidden=false;}
document.querySelectorAll<HTMLButtonElement>('[data-event]').forEach(button=>button.addEventListener('click',async()=>{button.disabled=true;try{await request(`recent-events/${button.dataset.event}`,{action:button.dataset.action,status:button.dataset.action==='change'?(document.querySelector(`[data-status-for="${button.dataset.event}"]`) as HTMLSelectElement).value:undefined});location.reload();}catch(exception){fail(exception);button.disabled=false;}}));
document.querySelectorAll<HTMLButtonElement>('[data-match-search]').forEach(button=>button.addEventListener('click',async()=>{const id=button.dataset.matchSearch!;const box=document.querySelector<HTMLElement>(`[data-match-box="${id}"]`)!;const input=box.querySelector<HTMLInputElement>('input')!;const target=box.querySelector<HTMLElement>('[data-match-results]')!;button.disabled=true;target.textContent='Searching…';try{const response=await fetch(`/api/proxy/tracking/catalog?q=${encodeURIComponent(input.value)}&media_type=${box.dataset.kind}`);if(!response.ok)throw new Error('Catalogue search failed.');const data=await response.json();target.replaceChildren(...data.results.slice(0,8).map((item:any)=>{const result=document.createElement('button');result.className='match-result';result.type='button';result.textContent=`${item.title}${item.year?` (${item.year})`:''}`;result.addEventListener('click',async()=>{result.disabled=true;try{let mediaId=item.id;if(!mediaId){const imported=await request(`catalog/${box.dataset.kind}/${item.tmdb_id}`);mediaId=imported.id;}await request(`recent-events/${id}`,{action:'match',media_id:mediaId});location.reload();}catch(exception){fail(exception);result.disabled=false;}});return result;}));if(!data.results.length)target.textContent='No catalogue titles found.';}catch(exception){fail(exception);target.textContent='';}finally{button.disabled=false;}}));
document.querySelectorAll<HTMLButtonElement>('[data-dismiss]').forEach(button=>button.addEventListener('click',async()=>{try{await request(`recent-events/${button.dataset.dismiss}`,{},'DELETE');button.closest('article')?.remove();}catch(exception){fail(exception);}}));
document.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[data-pref]').forEach(input=>input.addEventListener('change',async()=>{const value=input instanceof HTMLInputElement?input.checked:Number(input.value);try{await request('preferences',{[input.dataset.pref!]:value},'PATCH');if(input.dataset.pref==='combine_lists')location.reload();}catch(exception){fail(exception);}}));
document.querySelectorAll<HTMLButtonElement>('[data-unignore]').forEach(button=>button.addEventListener('click',async()=>{try{await request(`provider-ignores/${button.dataset.unignore}`,{},'DELETE');button.closest('div')?.remove();}catch(exception){fail(exception);}}));
document.querySelector<HTMLButtonElement>('#import-history')?.addEventListener('click',async event=>{const button=event.currentTarget as HTMLButtonElement;button.disabled=true;try{const result=await request('import-history');document.querySelector('#import-result')!.textContent=`${result.added} entries imported.`;}catch(exception){fail(exception);}finally{button.disabled=false;}});
const dismissibleIds=Array.from(document.querySelectorAll<HTMLElement>('[data-auto-seen]')).map(element=>Number(element.dataset.autoSeen));
if(dismissibleIds.length)fetch('/api/proxy/tracking/recent-events/seen',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:dismissibleIds})}).catch(()=>{});
</script>
