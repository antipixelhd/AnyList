---
import Tracker from '../../layouts/Tracker.astro';
import DevNavigation from '../../components/dev/DevNavigation.astro';
import PreviewTrackingEditor from '../../components/dev/PreviewTrackingEditor.astro';
import Icon from '../../components/Icon.astro';
import {samples} from '../../components/dev/detail-fixtures';
import '../../styles/dev-season-editor.css';
const concepts = [{id:'rows',name:'Rows',number:'01'}, {id:'rows-2',name:'Rows 2',number:'02'}, {id:'drawers',name:'Drawers',number:'03'}, {id:'popover',name:'Popover',number:'04'}, {id:'expand',name:'Expand',number:'05'}];
const design = concepts.find(item => item.id === Astro.url.searchParams.get('design')) ?? concepts[0];
const context = Astro.url.searchParams.get('context') === 'details' ? 'details' : 'list';
const media = ['series','movie','game'].includes(Astro.url.searchParams.get('media') || '') ? Astro.url.searchParams.get('media')! : 'series';
const fixtures = [
  {id:'series',title:'Breaking Bad',kind:'TV series',year:'2008',status:'Watching',score:'8.5',progress:'32 / 62',poster:'https://image.tmdb.org/t/p/w185/3xnWaLQjelJDDF7LT1WBo6f4BRe.jpg',backdrop:'https://image.tmdb.org/t/p/w1280/tsRy63Mu5cu8etL1X7ZLyf7UP1M.jpg',summary:'A chemistry teacher turns to manufacturing methamphetamine to secure his family’s future.'},
  {id:'movie',title:samples.movie.title,kind:'Movie',year:samples.movie.year,status:'Completed',score:'8.5',progress:'1 / 1',poster:samples.movie.poster.replace('/w500/','/w185/'),backdrop:samples.movie.backdrop,summary:samples.movie.summary},
  {id:'game',title:samples.game.title,kind:'Game',year:samples.game.year,status:'Playing',score:'8.5',progress:'12.5 h',poster:samples.game.poster,backdrop:samples.game.backdrop,summary:samples.game.summary},
];
const current = fixtures.find(item=>item.id===media)!;
const href = (id=design.id, ctx:string=context, kind=media) => `/dev/editor?design=${id}&context=${ctx}&media=${kind}`;
---
<Tracker title={`List editor · ${design.name}`}>
  <DevNavigation slot="navigation" designItems={concepts.map(item => ({label:item.name,href:href(item.id),active:item.id===design.id}))}/>
  <div class="season-lab" data-season-lab data-design={design.id}>
    <header class="sp-lab-heading"><h1>List editor <span>Preview</span></h1><button class="sp-text" type="button" data-action="reset"><Icon name="undo"/>Reset</button></header>
    <div class="sp-lab-toolbar"><nav class="sp-concepts" aria-label="Editor designs">{concepts.map(item => <a href={href(item.id)} aria-current={item.id === design.id ? 'page' : undefined}><span>{item.number}</span>{item.name}</a>)}</nav><nav class="sp-context" aria-label="Editor context"><a href={href(design.id,'list')} aria-current={context==='list'?'page':undefined}>List</a><a href={href(design.id,'details')} aria-current={context==='details'?'page':undefined}>Details</a></nav></div>
    {context === 'list' ? <section class="sp-list" aria-label="My list">
      <div class="sp-list-head"><span>Title</span><span>Score</span><span>Progress</span><span></span></div>
      {fixtures.map(item=><article class="sp-list-row" data-work-row={item.id}>
        <a class="sp-list-title" href={href(design.id,'details',item.id)}><img src={item.poster} alt="" width="34" height="51"/><span><strong>{item.title}</strong><small data-work-status={item.id}>{item.status}</small></span></a>
        <span data-work-score={item.id}>{item.score}</span><span data-work-progress={item.id}>{item.progress}</span>
        <button class="sp-icon" type="button" data-open-work={item.id} aria-label={`Edit ${item.title}`}><Icon name="edit"/></button>
      </article>)}
    </section> : <>
      <nav class="sp-media" aria-label="Sample media">{fixtures.map(item=><a href={href(design.id,'details',item.id)} aria-current={media===item.id?'page':undefined}>{item.kind==='TV series'?'Series':item.kind==='Movie'?'Movies':'Games'}</a>)}</nav>
      <section class="sp-detail" data-work-row={current.id}>
        <div class="sp-detail-backdrop"><img src={current.backdrop} alt=""/><div></div></div>
        <div class="sp-detail-content"><img class="sp-detail-poster" src={current.poster} alt={`${current.title} poster`}/><div><span class="sp-detail-kind">{current.kind} · {current.year}</span><h2>{current.title}</h2><p>{current.summary}</p><button class="button-primary" type="button" data-open-work={current.id}><Icon name="edit"/>Edit entry</button></div></div>
      </section>
    </>}
    <p class="sp-lab-feedback" role="status" aria-live="polite"></p>
    <PreviewTrackingEditor design={design.id}/>
    <script id="sp-fixtures" type="application/json" set:html={JSON.stringify(fixtures).replaceAll('<','\\u003c')}/>
  </div>
</Tracker>
<script>
  import '../../components/dev/season-editor-preview';
</script>
