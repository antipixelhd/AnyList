---
import {statuses} from '../lib/tracker';
import {gameStatuses} from '../lib/game-editor-data';
const {mediaId,status,subject,gameClass}=Astro.props;
const game=subject?.kind==='game',child=game&&gameClass==='expansion';
const choices=game?gameStatuses:statuses;
const editorAction=game?{'data-edit-game':mediaId}:{'data-edit-entry':mediaId};
---
<div class="status-control" data-status-control data-media={mediaId} data-game={game?'true':undefined}>
  <div class="status-split"><button class="button-primary" data-status-label {...editorAction}>{choices.find(([s])=>s===status)?.[1]||'Add to list'}</button><button class="button-primary status-arrow" hidden={child} aria-label="Quick status actions" aria-haspopup="menu" aria-expanded="false" aria-controls={`quick-status-options-${mediaId}`}><span class="ui-icon" aria-hidden="true"><svg data-dropdown-arrow viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 9 7 7 7-7" /></svg></span></button></div>
  <div class="status-options tracker-dropdown-menu" id={`quick-status-options-${mediaId}`} role="menu" hidden>
    <button role="menuitem" data-quick-status="completed" aria-current={status === 'completed' ? 'true' : undefined}>Set as Completed</button>
    <button role="menuitem" data-quick-status={game?'playing':'watching'} aria-current={status === (game?'playing':'watching') ? 'true' : undefined}>Set as {game?'Playing':'Watching'}</button>
    <button role="menuitem" data-quick-status="planning" aria-current={status === 'planning' ? 'true' : undefined}>Set as {game?'Planned':'Planning'}</button>
    <button role="menuitem" {...editorAction}>Open List Editor</button>
  </div>
</div>
<script>
import { showMenu, hideMenu } from '../lib/ui-motion';
import {editorStore,seedEditorPage} from '../lib/editor-store';
import {statuses} from '../lib/tracker';
import {showToast} from '../lib/toasts';
import {gameStatuses,gameDatePatch} from '../lib/game-editor-data';
import {localToday} from '../lib/date-time';
let pageListeners: AbortController;
document.addEventListener('astro:page-load', () => {
pageListeners?.abort();
pageListeners = new AbortController();
seedEditorPage();
document.querySelectorAll<HTMLElement>('[data-status-control]').forEach(control=>{
  const game=control.dataset.game==='true';
  const arrow=control.querySelector<HTMLButtonElement>('.status-arrow')!;
  const options=control.querySelector<HTMLElement>('.status-options')!;
  const close=()=>{void hideMenu(options);arrow.setAttribute('aria-expanded','false');};
  arrow.addEventListener('click',()=>{if(arrow.getAttribute('aria-expanded')==='true')close();else{showMenu(options);arrow.setAttribute('aria-expanded','true');}});
  arrow.addEventListener('keydown',event=>{if(event.key==='ArrowDown'||event.key==='ArrowUp'){event.preventDefault();showMenu(options);arrow.setAttribute('aria-expanded','true');const items=options.querySelectorAll<HTMLButtonElement>('button');items[event.key==='ArrowUp'?items.length-1:0]?.focus();}});
  options.addEventListener('keydown',event=>{
    const items=[...options.querySelectorAll<HTMLButtonElement>('button:not(:disabled)')];
    const index=items.indexOf(document.activeElement as HTMLButtonElement);
    const next=event.key==='ArrowDown'?(index+1)%items.length:event.key==='ArrowUp'?(index-1+items.length)%items.length:event.key==='Home'?0:event.key==='End'?items.length-1:null;
    if(next!=null){event.preventDefault();items[next]?.focus();}
  });
  control.addEventListener('keydown',event=>{if(event.key==='Escape'){close();arrow.focus();}});
  control.addEventListener('focusout',event=>{if(!control.contains(event.relatedTarget as Node))close();});
  document.addEventListener('click',event=>{if(!control.contains(event.target as Node))close();},{signal:pageListeners.signal});
  options.querySelector('[data-edit-entry],[data-edit-game]')?.addEventListener('click',close);
  options.querySelectorAll<HTMLButtonElement>('[data-quick-status]').forEach(button=>button.addEventListener('click',async()=>{
    close();
    const status=button.dataset.quickStatus;
    const buttons=control.querySelectorAll<HTMLButtonElement>('.status-split button,.status-options button');
    buttons.forEach(b=>b.disabled=true);
    try{
      const id=Number(control.dataset.media);
      const title=game?await editorStore.loadSubject({kind:'game',catalogue_id:id}):editorStore.find(id)||await editorStore.load(id);
      const current=title.game_state||title.entry||{};
      const today=localToday();
      const patch:Record<string,any>={status};
      if(game){
        Object.assign(patch,gameDatePatch(current,status!,{start_date:current.start_date||'',finish_date:current.finish_date||''},new Set(),today));
        if(status==='completed'&&current.status!=='completed'&&current.completion_seconds==null&&current.total_seconds!=null&&(patch.finish_date===today||current.finish_date===today))patch.completion_seconds=current.total_seconds;
        else if(status==='completed'&&current.status!=='completed'&&current.completion_seconds==null)patch.completion_seconds=null;
      }
      await editorStore.write(title,patch);
      showToast('List status updated.','success');
    }catch(e){showToast((e as Error).message,'error');arrow.focus();}
    finally{buttons.forEach(b=>b.disabled=false);}
  }));
  document.addEventListener('anylist:editor-state',event=>{
    const title=(event as CustomEvent).detail;
    if((title.type==='game')!==game||title.id!==Number(control.dataset.media))return;
    control.querySelector('[data-status-label]')!.textContent=(game?gameStatuses:statuses).find(([s])=>s===title.entry?.status)?.[1]||'Add to list';
    options.querySelectorAll<HTMLElement>('[data-quick-status]').forEach(button=>button.setAttribute('aria-current',String(button.dataset.quickStatus===title.entry?.status)));
  },{signal:pageListeners.signal});
});
});
</script>
<style>
.status-control{position:relative;margin-top:18px}.status-split{display:flex}.status-split .button-primary{margin:0;width:auto;min-height:44px}.status-split>button:first-child{flex:1;border-radius:4px 0 0 4px;padding:10px 8px}.status-split .status-arrow{width:40px;flex:none;border-radius:0 4px 4px 0;border-left:1px solid #ffffff40;padding:8px}.status-options{position:absolute;top:calc(100% + 6px);left:0;z-index:20;min-width:210px;background:#151f2e;border:1px solid var(--border);border-radius:5px;box-shadow:0 8px 24px #0005;padding:6px}.status-options button{display:block;width:100%;text-align:left;border:0;background:none;color:var(--text);padding:10px;border-radius:3px;font-size:var(--type-label-size);font-weight:var(--type-label-weight);min-height:42px}.status-options button:hover,.status-options button:focus-visible{background:#2a3440;color:var(--bright)}.status-options button[aria-current=true]{color:var(--blue);background:transparent}.status-options button[aria-current=true]:is(:hover,:focus-visible){background:#2a3440}.status-options button:last-child{border-top:1px solid var(--border);margin-top:5px}.status-error{font-size:var(--type-label-size);color:#efb4c6}
</style>
