---
import {viewerMediaPreferences} from '../lib/viewer-media-preferences';
import {defaultGameCategories} from '../lib/list-categories.ts';
const presentation=(await viewerMediaPreferences(Astro.locals)).list_categories?.game || defaultGameCategories();
---
<script type="application/json" data-viewer-game-categories set:html={JSON.stringify(presentation).replaceAll('<','\\u003c')}/>
<script>
import {viewerGameCategories,refreshGameCategories} from '../lib/game-category-store.ts';
let listeners:AbortController;
document.addEventListener('astro:page-load',()=>{
  listeners?.abort();listeners=new AbortController();
  viewerGameCategories();
  document.addEventListener('anylist:editor-committed',event=>{
    if((event as CustomEvent).detail.title?.type==='game')void refreshGameCategories(listeners.signal).catch(()=>{});
  },{signal:listeners.signal});
});
</script>
<style is:global>
  .category-info {
    inset: auto;
    margin: 0;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(340px, calc(100vw - 32px));
    max-height: calc(100dvh - 40px);
    overflow: auto;
    padding: 20px;
    background: var(--panel, #151f2e);
    color: var(--text);
    border: 0;
    border-radius: 6px;
    box-shadow: 0 12px 40px #0008;
    font-size: var(--type-label-size);
  }
  .category-info:popover-open { animation: category-info-enter 160ms cubic-bezier(.2,.7,.2,1); }
  .category-info::backdrop { background: #0005; }
  .category-info h3 { margin: 0 0 16px; color: var(--bright); font-size: var(--type-body-size); }
  .category-info strong { display: block; color: var(--bright); }
  .category-info p { margin: 3px 0 14px; line-height: 1.4; }
  .category-info p:last-child { margin-bottom: 0; }
  @keyframes category-info-enter { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .category-info:popover-open { animation: none; }
  }
</style>
