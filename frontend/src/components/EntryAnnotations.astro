---
import Icon from './Icon.astro';
import {releaseAnnotation} from '../lib/release-annotation';
interface Props {
  rewatchCount?: number;
  replayCount?: number;
  notes?: string | null;
  newSeasons?: number;
  newEpisodes?: number;
}
const {rewatchCount:screenRewatches = 0, replayCount, notes, newSeasons = 0, newEpisodes = 0} = Astro.props;
const rewatchCount=replayCount??screenRewatches;
const rewatchLabel = `${rewatchCount} ${replayCount!=null?(rewatchCount===1?'replay':'replays'):(rewatchCount === 1 ? 'rewatch' : 'rewatches')}`;
const releaseLabel = releaseAnnotation(newSeasons, newEpisodes);
const hasNote = Boolean(notes?.trim());
---
{(releaseLabel || rewatchCount > 0 || hasNote) && <span class="entry-annotations">
  {releaseLabel && <small class="unwatched-indicator">{releaseLabel}</small>}
  {rewatchCount > 0 && <span class="entry-rewatch" role="img" tabindex="0" aria-label={rewatchLabel} data-rewatch-label={rewatchLabel}><Icon name="arrows-rotate"/></span>}
  {hasNote && <span class="entry-note" role="img" tabindex="0" aria-label={`Note: ${notes}`}>
    <Icon name="comment"/>
    <span class="entry-note-tooltip" aria-hidden="true">{notes}</span>
  </span>}
</span>}
<script>
  import {initializeEntryAnnotations} from '../lib/entry-annotations';
  initializeEntryAnnotations();
</script>
