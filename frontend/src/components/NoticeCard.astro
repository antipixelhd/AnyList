---
import Icon from './Icon.astro';
import {responsiveArtwork} from '../lib/responsive-artwork';

interface Props {
  variant?: 'default' | 'info' | 'warning' | 'danger' | 'success';
  icon?: string;
  title: string;
  href?: string;
  source?: string;
  badge?: string;
  message?: string;
  image?: string | null;
  imageSizes?: string;
  dismissibleId?: number;
  cardKey?: string;
  version?: string;
  kind?: string;
  priority?: string;
  state?: string;
  artworkFallback?: boolean;
  artworkRetry?: boolean;
}

const {
  variant = 'default',
  icon = variant === 'danger' ? 'error' : variant === 'warning' ? 'warning' : variant === 'success' ? 'check' : 'info',
  title,
  href,
  source,
  badge,
  message,
  image,
  imageSizes = '(max-width:460px) 46px, (max-width:760px) 54px, 72px',
  dismissibleId,
  cardKey,
  version,
  kind,
  priority,
  state,
  artworkFallback = false,
  artworkRetry = false,
} = Astro.props;
const imageSource = responsiveArtwork(image,{size:'w342',sizes:imageSizes,route:'direct'});
---
<article class:list={['notice-card', `notice-${variant}`]} data-auto-seen={dismissibleId} data-notification-key={cardKey} data-notification-version={version} data-notification-kind={kind} data-notification-priority={priority} data-notification-state={state} data-season-artwork-fallback={artworkFallback} data-season-artwork-retry={artworkRetry}>
  <div class:list={['notice-visual', { 'has-image': !!imageSource?.src }]}>
    {imageSource?.src ? <img src={imageSource.src} srcset={imageSource.srcset} sizes={imageSource.sizes} alt="" loading="lazy" /> : <Icon name={icon} />}
  </div>
  <div class="notice-content">
    {(source || badge) && <div class="notice-meta">{source && <span>{source}</span>}{badge && <strong>{badge}</strong>}</div>}
    <h2>{href ? <a href={href}>{title}</a> : title}</h2>
    {message && <p>{message}</p>}
    <slot name="detail" />
    <div class="notice-actions"><slot name="actions" /></div>
  </div>
</article>
