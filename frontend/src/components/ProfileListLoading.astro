---
import ProfileListFilters from './ProfileListFilters.astro';
import {statuses} from '../lib/tracking-statuses';
import {gameStatuses} from '../lib/game-editor-data';
import {viewerMediaPreferences} from '../lib/viewer-media-preferences';
const preferences=await viewerMediaPreferences(Astro.locals);
const domains=[['movies','Movie List'],['series','Series List'],['list','Movie & Series List'],['games','Games List']] as const;
---
{domains.map(([kind,label])=><template data-profile-list-loading={kind}>
  <div data-profile-list-preview aria-label={label}>
    <div class="list-shell profile-list-loading" aria-busy="true" style="min-height:60vh">
      <div class="profile-list-loading-filters" inert>
        <ProfileListFilters statuses={kind==='games'?gameStatuses:statuses} counts={{}} genres={[]} years={[]} sort={preferences.default_sort} defaultSort={preferences.default_sort} progressLabel={kind==='games'?'Hours':'Progress'}/>
      </div>
      <div class="list-content">
        <div class="list-toolbar"><span role="status">Loading {label.toLowerCase()}…</span></div>
        <div class="profile-list-load-progress" role="progressbar" aria-label={`Loading ${label.toLowerCase()}`}><span></span></div>
      </div>
    </div>
  </div>
</template>)}
<style is:global>
  .profile-list-loading [data-list-status-count] { visibility:hidden; }
  .profile-list-loading-filters { min-width:0; }
  .profile-list-load-progress { height:2px; overflow:hidden; background:color-mix(in srgb,var(--blue) 15%,transparent); }
  .profile-list-load-progress>span { display:block; width:35%; height:100%; background:var(--blue); transform:translateX(-100%); animation:profile-list-progress 1.2s ease-in-out infinite; }
  @keyframes profile-list-progress { to { transform:translateX(390%); } }
  @media(prefers-reduced-motion:reduce) { .profile-list-load-progress>span { animation:none; transform:none; } }
</style>
