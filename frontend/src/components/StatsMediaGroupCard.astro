---
import Icon from './Icon.astro';
import type { MediaGroup } from '../lib/stats-overview-data';
import { displayNumber } from '../lib/stats-overview-data';
import { genreTime } from '../lib/stats-genres-data';
import { responsiveArtwork } from '../lib/responsive-artwork';
interface Props { group: MediaGroup; rank: number; href: string; prefix: 'genre' | 'studio'; }
const { group: genre, rank, href, prefix } = Astro.props;
---
<article class="stats-genre-card" {...{[`data-${prefix}-key`]: genre.key, [`data-${prefix}-signature`]: JSON.stringify(genre)}} aria-label={genre.label}>
  <div class="stats-genre-summary">
    <header><h3><a {...{[`data-${prefix}-link`]: ""}} href={href}>{genre.label}</a></h3><span class="stats-genre-rank" {...{[`data-${prefix}-rank`]: ""}} aria-label={`Rank ${rank}`}>{rank}</span></header>
    <dl><div><dt>Count</dt><dd {...{[`data-${prefix}-count`]: ""}}>{displayNumber(genre.titles)}</dd></div><div><dt>Mean Score</dt><dd {...{[`data-${prefix}-score`]: ""}}>{displayNumber(genre.mean_score, 2)}</dd></div><div><dt>Time Watched</dt><dd {...{[`data-${prefix}-time`]: ""}}>{genreTime(genre)}</dd></div></dl>
  </div>
  <div class="stats-genre-posters">
    <div class="stats-genre-track" data-genre-track tabindex="0" role="group" aria-label={`Highest-rated ${genre.label} titles`}>
      {genre.top_titles.map(title => {
        const artwork = responsiveArtwork(title.poster, { size: 'w185', sizes: '(max-width:650px) 20vw, 90px', route: 'direct' });
        return <a class="stats-genre-poster" href={title.href} aria-label={title.title} draggable="false">
          {artwork ? <img {...artwork} alt="" loading="lazy" draggable="false" /> : <span class="stats-genre-placeholder" aria-hidden="true">{title.title.slice(0, 1)}</span>}
          <span class="stats-genre-tooltip" aria-hidden="true">{title.title}</span>
        </a>;
      })}
    </div>
    <p class="stats-genre-empty" {...{[`data-${prefix}-no-ratings`]: ""}} hidden={genre.top_titles.length > 0}>No rated titles.</p>
    <button class="stats-genre-arrow stats-genre-arrow-prev" type="button" {...{[`data-${prefix}-scroll`]: "-1"}} aria-label={`Previous ${genre.label} titles`} hidden><Icon name="chevron-left" /></button>
    <button class="stats-genre-arrow stats-genre-arrow-next" type="button" {...{[`data-${prefix}-scroll`]: "1"}} aria-label={`Next ${genre.label} titles`} hidden><Icon name="chevron-right" /></button>
  </div>
</article>
