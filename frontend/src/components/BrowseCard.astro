---
import Icon from "./Icon.astro";
import { responsiveArtwork } from "../lib/responsive-artwork";
import { formatDateTime, requestDateLocale } from '../lib/date-time';
import { contributorMediaLabel } from '../lib/contributor-page-data';
import {browseCardHref,browseCardKey,browseStatusLabel,browseActionLabel,expansionCard} from '../lib/browse-card-data';
const {
  item = { title: "", type: "movie" },
  signedIn = false,
  template = false,
  credits = false,
} = Astro.props;
const image = responsiveArtwork(item.poster, {
  size: "w342",
  sizes: "(max-width: 650px) 30vw, (max-width: 1000px) 22vw, 185px",
  route:'direct',
});
const state = item.list_status;
const game=item.type==='game';
const href=browseCardHref(item);
---

<article
  class="browse-card"
  data-browse-card
  data-key={browseCardKey(item)}
  data-state={state || undefined}
  data-work-key={item.key || undefined}
>
  <div class="browse-card-body">
  <div class="browse-cover">
    <a
      class="browse-poster-link"
      href={template ? "#" : href}
      aria-label={item.title}
    >
      <img
        data-poster
        src={image?.src}
        srcset={image?.srcset}
        sizes={image?.sizes}
        alt=""
        loading="lazy"
        hidden={!image}
      />
      <span class="browse-placeholder" aria-hidden="true" hidden={!!image}>
        {item.title.slice(0, 1)}
      </span>
    </a>
    <span
      class="browse-list-state"
      data-list-state
      title={browseStatusLabel(state,game)}
      aria-label={browseStatusLabel(state,game)}
      hidden={!state}
    >
      {["watching", "playing", "completed", "planning", "paused", "dropped"].map(
        (value) => (
          <span data-state-icon={value} hidden={state !== value}>
            <Icon
              name={
                value === "watching" || value === "playing"
                  ? "play"
                  : value === "completed"
                    ? "check"
                    : value === "planning"
                      ? "clock"
                      : value === "paused"
                        ? "ellipsis"
                        : "close"
              }
            />
          </span>
        ),
      )}
    </span>
    {signedIn && (template || item.id || item.tmdb_id || item.igdb_id) && (
      <div class="browse-actions" data-motion-static>
        <button
          type="button"
          data-browse-action="edit"
          class="browse-add"
          aria-label={`Open list editor for ${item.title}`}
        >
          <span data-editor-icon="add" hidden={!!state}><Icon name="plus" /></span>
          <span data-editor-icon="edit" hidden={!state}><Icon name="edit" /></span>
        </button>
        <div class="browse-extra-actions" hidden={expansionCard(item)}>
          <button type="button" data-browse-action="watch" hidden={state === (game?'playing':'watching')} aria-label={`${browseActionLabel('watch',game)} ${item.title}`} data-tooltip={browseActionLabel('watch',game)}><Icon name="play" /></button>
          <button
            type="button"
            data-browse-action="plan"
            hidden={!!state}
            aria-label={`${browseActionLabel('plan',game)} ${item.title}`}
            data-tooltip={browseActionLabel('plan',game)}
          >
            <Icon name="clock" />
          </button>
          <button
            type="button"
            data-browse-action="rate"
            hidden={item.score > 0}
            aria-label={`Rate and complete ${item.title}`}
            data-tooltip="Rate & complete"
          >
            <Icon name="star" />
          </button>
        </div>
      </div>
    )}
  </div>
  <div class="browse-card-caption">
  <a class="browse-card-title" href={template ? "#" : href}>
    <h2>{item.title}</h2>
  </a>
  <div class="browse-card-meta">
    <span data-year title={item.release_event ? item.release_country ? `Release date · ${item.release_country}` : 'Worldwide release date' : undefined}>{item.year}</span>
    <span
      data-user-score
      hidden={!(item.score > 0)}
      aria-label={`Your rating: ${Number(item.score || 0).toFixed(1)} out of 10`}
    >
      <Icon name="star" />
      <span data-score>{Number(item.score || 0).toFixed(1)}</span>
    </span>
  </div>
  {credits && <p class="browse-credit" data-work-credit title={[...(item.characters || []), ...(item.roles || []).filter((role: string) => role !== 'Actor' && role !== 'Production')].join(' / ')}>{[...(item.characters || []), ...(item.roles || []).filter((role: string) => role !== 'Actor' && role !== 'Production')].join(' / ')}</p>}
  {credits && <time class="browse-work-date" datetime={item.release_date} data-local-date-time="month-day" data-work-date hidden={!item.release_date}>{formatDateTime(item.release_date,'month-day',{locale:requestDateLocale(Astro.request.headers.get('accept-language'), Astro.cookies.get('anylist_date_region')?.value)})}</time>}
  {credits && <span class="browse-work-type" data-work-type>{contributorMediaLabel(item.type)}</span>}
  </div>
  </div>
</article>
