---
const current=Astro.url.pathname;
---
<nav class="admin-tabs" aria-label="Administration">
  <a href="/admin" aria-current={current==='/admin'?'page':undefined}>Settings</a>
  <a href="/admin/game-runner" aria-current={current==='/admin/game-runner'?'page':undefined}>Game mapper</a>
</nav>
<style>
  .admin-tabs{display:flex;gap:1.5rem;margin:0 0 2rem;font-weight:600}
  a{color:var(--text-muted,#9ca3af);transition:color .15s}
  a:hover,a:focus-visible,a[aria-current]{color:var(--blue,#60a5fa);outline:none}
</style>
