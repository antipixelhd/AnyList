---
import Tracker from '../layouts/Tracker.astro';
import Icon from './Icon.astro';
import BrowseCard from './BrowseCard.astro';
import { tracker, artwork, statuses } from '../lib/tracker';
import { metadataKey } from '../lib/catalogue-key';
import { personAge, personDate } from '../lib/person-page-data';
import { countryLabel } from '../lib/stats-overview-data';
import { biographyPreview, contributorParams, contributorYear, type ContributorPage } from '../lib/contributor-page-data';
import '../styles/browse.css';
import '../styles/contributor-details.css';
interface Props { kind: 'actor' | 'staff' | 'studio' }
const { kind } = Astro.props;
const key = metadataKey(Astro.params.id);
const signedIn = !!Astro.locals.user;
const params = contributorParams(Astro.url.searchParams, signedIn);
const view = Astro.url.searchParams.get('view') === 'grid' ? 'grid' : 'timeline';
const endpoint = `contributors/${kind}/${encodeURIComponent(key || '')}`;
Astro.response.headers.set('Cache-Control', 'private, no-store');
let data: ContributorPage | null = null, error = '';
try {
  if (!key) throw new Error('Not found.');
  data = await tracker(`${endpoint}?${params}`, Astro.locals.token);
} catch (cause) { error = cause instanceof Error ? cause.message : 'Unable to load this page.'; Astro.response.status = error === 'Not found.' ? 404 : 503; }
const age = data ? personAge(data.birthday, data.deathday) : null;
const biography = biographyPreview(data?.description);
const facts = data ? [
  ['Born', personDate(data.birthday)], ['Died', personDate(data.deathday)],
  [data.deathday ? 'Age at death' : 'Age', age === null ? null : String(age)],
  ['Place of birth', data.place_of_birth], ['Department', data.department],
  ['Country', data.countries.map(countryLabel).join(', ')], ['Headquarters', data.headquarters],
].filter(([,value]) => value) : [];
const years = [...new Set(data?.works.map(contributorYear) || [])];
const portrait = artwork(data?.image || null, 'w342');
const backdrop = artwork(data?.works.find(work => work.backdrop)?.backdrop || null, 'w1280');
const banner = kind === 'studio' ? data?.banner : null;
const next = new URL(Astro.url);
if (data) {
  next.searchParams.set('page', String(data.page + 1));
  next.searchParams.set('source', data.source);
  if (data.next_cursor) next.searchParams.set('cursor', data.next_cursor); else next.searchParams.delete('cursor');
}
---
<Tracker title={data?.name || (kind === 'studio' ? 'Studio' : 'Person')}>
  {data ? <article class="contributor-page" data-contributor-page data-view={view} data-endpoint={endpoint}>
    <div class:list={['contributor-banner', {'is-logo':!!banner}]} aria-hidden="true">{(banner || backdrop) && <img src={banner || backdrop} alt="" fetchpriority="high" data-contributor-banner data-banner-fallback={backdrop || undefined} />}</div>
    <div class="page-width contributor-layout">
      <aside class:list={['contributor-sidebar', {'is-studio':kind === 'studio'}]}>
        <div class="contributor-portrait">{portrait && <img src={portrait} alt={data.name} fetchpriority="high" />}<span data-contributor-portrait-fallback hidden={!!portrait}><Icon name={kind === 'studio' ? 'film' : 'user'} /></span></div>
        {facts.length > 0 && <section class="contributor-facts" aria-label="Information"><h2>Information</h2><dl>{facts.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}
        {data.links.length > 0 && <nav class="contributor-links" aria-label="External links">{data.links.map(link => <a href={link.href} target="_blank" rel="noreferrer">{link.label}<Icon name="external" /></a>)}</nav>}
      </aside>
      <div class="contributor-main">
        <header class="contributor-heading"><p class="contributor-kicker">{kind === 'studio' ? 'Production studio' : kind === 'actor' ? 'Actor' : 'Staff'}</p><h1>{data.name}</h1>
          {data.roles.length > 0 && <p class="contributor-roles">{data.roles.slice(0,4).join(' / ')}</p>}
          {signedIn && <a class="contributor-list-link" href={`${Astro.url.pathname}?list_scope=in&view=${view}`}><Icon name="list" /><span><strong data-contributor-list-count>{data.list_count || 0}</strong> in your list</span></a>}
        </header>
        {data.description && <section class="contributor-biography" aria-labelledby="contributor-about-heading"><h2 id="contributor-about-heading">{kind === 'studio' ? 'About' : 'Biography'}</h2>
          {kind === 'studio' ? <p>{data.description}</p> : <>
            <p id="contributor-biography-text" data-biography-text><span>{biography.lead}</span><span data-biography-rest hidden>{biography.rest}</span><span data-biography-ellipsis hidden={!biography.shortened}>…</span></p>
            {biography.expandable && <button type="button" class="contributor-biography-toggle" data-biography-toggle aria-expanded="false" aria-controls="contributor-biography-text">Read more</button>}
            <noscript><style>{`.contributor-page [data-biography-rest][hidden] { display:inline!important; } .contributor-biography-toggle, [data-biography-ellipsis] { display:none!important; }`}</style></noscript>
          </>}
        </section>}
        {data.aliases.length > 0 && <details class="contributor-aliases"><summary>Also known as</summary><p>{data.aliases.join(' · ')}</p></details>}
        <section class="contributor-works" aria-labelledby="contributor-works-heading">
          <header class="contributor-works-heading"><h2 id="contributor-works-heading">Works</h2>
            <div class="contributor-view-switch" role="group" aria-label="Works layout"><button type="button" data-contributor-view="timeline" aria-pressed={view === 'timeline'}><Icon name="list" /><span>Timeline</span></button><button type="button" data-contributor-view="grid" aria-pressed={view === 'grid'}><Icon name="grid" /><span>Compact</span></button></div>
          </header>
          <form method="get" class="contributor-filters" data-contributor-filters>
            <input type="hidden" name="view" value={view} />
            <label><span>Media</span><select name="media_type"><option value="all" selected={!params.has('media_type')}>All media</option><option value="movie" selected={params.get('media_type') === 'movie'}>Movies</option><option value="series" selected={params.get('media_type') === 'series'}>Series</option></select></label>
            {signedIn && <><label><span>List</span><select name="list_scope"><option value="all" selected={!params.has('list_scope')}>All titles</option><option value="in" selected={params.get('list_scope') === 'in'}>In my list</option><option value="out" selected={params.get('list_scope') === 'out'}>Not in my list</option></select></label><label><span>Status</span><select name="status"><option value="" selected={!params.has('status')}>Any status</option>{statuses.map(([id,label]) => <option value={id} selected={params.get('status') === id}>{label}</option>)}</select></label></>}
            <button type="submit" class="contributor-apply">Apply</button>
          </form>
          <p class="contributor-notice" data-contributor-notice role="status" hidden={!data.notice}>{data.notice}</p>
          <div class:list={['contributor-works-grid', {'browse-grid':view === 'grid'}]} data-contributor-works>
            {years.map(year => <section class="contributor-year" data-contributor-year={year} aria-label={year}><h3>{year}</h3><div class="contributor-year-works">{data!.works.filter(work => contributorYear(work) === year).map(work => <BrowseCard item={work} signedIn={signedIn} credits />)}</div></section>)}
          </div>
          <p class="contributor-empty" data-contributor-empty hidden={data.works.length > 0}>No works match these filters.</p>
          <div class="contributor-pagination"><a href={`${next.pathname}${next.search}`} data-contributor-next hidden={!data.has_more}>Next page <Icon name="arrow-right" /></a><button type="button" data-contributor-more hidden>Load more</button><p class="contributor-load-error" data-contributor-error role="alert" hidden></p></div>
          <template data-contributor-template><BrowseCard item={{title:'',type:'movie'}} signedIn={signedIn} template credits /></template>
        </section>
      </div>
    </div>
    <script type="application/json" data-contributor-data set:html={JSON.stringify(data).replaceAll('<','\u003c')} />
  </article> : <div class="page-width contributor-error"><h1>{kind === 'studio' ? 'Studio' : 'Person'}</h1><p role="alert">{error}</p><a href="/browse">Browse titles</a></div>}
</Tracker>
<script>
  import { initializeContributorPage } from '../lib/contributor-page';
  let controller: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    controller?.abort(); controller = new AbortController();
    const root = document.querySelector<HTMLElement>('[data-contributor-page]');
    if (root) initializeContributorPage(root, controller.signal);
  });
  document.addEventListener('astro:before-swap', () => controller?.abort());
</script>
