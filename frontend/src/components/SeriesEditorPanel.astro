---
import Icon from './Icon.astro';
---
<div class="series-editor-panel" data-series-editor hidden>
  <div class="editor-field-heading">
    <label id="series-progress-label" for="series-progress-trigger">Progress</label>
  </div>
  <p class="series-editor-message" data-series-loading role="status">Loading progress…</p>
  <button type="button" class="lab-text-button" data-series-retry hidden>Retry</button>
  <div class="series-progress-fields" data-series-content hidden>
    <button id="series-progress-trigger" type="button" class="series-progress-trigger" data-series-trigger aria-haspopup="dialog" aria-controls="series-progress-picker" aria-expanded="false" aria-labelledby="series-progress-label series-progress-position series-progress-completed">
      <strong id="series-progress-position" data-series-position></strong>
      <span class="series-progress-detail"><span id="series-progress-completed" data-series-completed></span><Icon name="chevron-down"/></span>
      <span class="series-progress-segments" data-series-segments aria-hidden="true"></span>
    </button>
    <span class="score-stepper series-episode-stepper" data-series-stepper hidden>
      <input id="series-episode-count" data-series-count type="number" min="0" step="1" inputmode="numeric" aria-describedby="series-episode-total" required disabled/>
      <span id="series-episode-total" data-series-total></span>
      <span class="series-episode-remaining" data-series-remaining aria-hidden="true"></span>
      <span class="score-stepper-controls">
        <button type="button" data-series-step="1" aria-label="Increase episode progress"><Icon name="chevron-down" rotate={180}/></button>
        <button type="button" data-series-step="-1" aria-label="Decrease episode progress"><Icon name="chevron-down"/></button>
      </span>
      <span class="series-episode-bar" data-series-bar aria-hidden="true"></span>
    </span>
    <dialog id="series-progress-picker" class="series-progress-picker" data-series-picker aria-labelledby="series-progress-heading">
      <header class="series-progress-header">
        <h3 id="series-progress-heading">Episodes watched</h3>
        <span data-series-watched></span>
        <button type="button" data-series-dismiss aria-label="Close episode progress" autofocus><Icon name="close"/></button>
      </header>
      <div class="series-progress-scroll" data-series-scroll>
        <ul class="series-progress-rows" data-series-rows></ul>
      </div>
    </dialog>
    <template data-series-row>
      <li class="series-progress-row">
        <span data-row-season></span>
        <input type="range" min="0" step="1" data-row-slider/>
        <button type="button" class="series-progress-counter" data-row-counter></button>
        <button type="button" class="series-progress-step" data-row-step="-1">−</button>
        <button type="button" class="series-progress-step" data-row-step="1">+</button>
      </li>
    </template>
  </div>
</div>
<style is:global>
  .editor[data-editor-type=series] .editor-heading { right:350px; }
  .editor-scope { width:158px; min-width:0; }
  .editor-scope[hidden], .series-editor-panel[hidden], .series-editor-panel [hidden] { display:none!important; }
  .editor-scope .editor-status-trigger {
    --editor-input-focus-background:var(--panel);
    margin:0;
    background:var(--panel);
    font-weight:600;
  }
  .editor-scope [data-editor-select-value] {
    min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  .editor[data-editor-domain=movies-series] .editor-fields { gap:16px 24px; }
  .editor[data-editor-domain=movies-series] .editor-fields > .editor-notes { grid-column:1 / 3; grid-row:3; max-width:none; }
  .editor[data-editor-domain=movies-series] .editor-fields > .editor-rewatches { grid-column:3; grid-row:3; }
  .editor[data-editor-domain=movies-series] .editor-notes textarea { min-height:46px; height:46px; }
  .editor .editor-fields > .series-editor-panel { grid-column:3; grid-row:1; min-width:0; }
  .series-progress-fields { margin-top:6px; }
  .series-episode-stepper {
    display:flex; align-items:center; justify-content:flex-start; gap:4px;
    padding-inline:10px 28px; min-height:42px; min-width:0; border-radius:4px; background:var(--field); overflow:hidden;
    color:var(--muted); cursor:text; font-variant-numeric:tabular-nums;
    --editor-input-focus-background:transparent;
  }
  .editor .series-episode-stepper input {
    field-sizing:content; width:3ch; min-width:1.25ch; max-width:100%;
    margin:0; padding:0; border:0; background:transparent; outline:none;
    color:var(--bright); font-size:var(--type-control-size); font-weight:600;
  }
  @supports (field-sizing:content) { .editor .series-episode-stepper input { width:auto; } }
  .editor .series-episode-stepper input:focus-visible { color:var(--blue); }
  .series-episode-stepper [data-series-total] { white-space:nowrap; font-size:var(--type-caption-size); }
  .series-progress-trigger {
    position:relative; display:flex; align-items:center; justify-content:space-between; gap:8px;
    width:100%; min-height:42px; padding:0 12px 7px; border-radius:4px; text-align:start;
    border:0; background:var(--field); color:var(--white); font:inherit; font-variant-numeric:tabular-nums;
    cursor:pointer;
  }
  .series-progress-trigger:is(:focus-visible,[aria-expanded=true]) { outline:none; color:var(--blue); }
  .series-progress-trigger:disabled { cursor:default; }
  .series-progress-detail { display:flex; align-items:center; gap:6px; color:var(--muted); font-size:var(--type-caption-size); }
  .series-progress-detail svg { width:10px; height:10px; }
  .series-progress-trigger[aria-expanded=true] svg { rotate:180deg; }
  .series-progress-segments { position:absolute; inset:auto 12px 6px; display:flex; gap:2px; }
  .series-progress-segments span, .series-episode-bar {
    height:3px; border-radius:999px;
    background:linear-gradient(to right,var(--blue) var(--progress,0%),var(--border) var(--progress,0%));
  }
  .series-progress-segments span { flex:1; min-width:0; }
  .series-episode-bar { position:absolute; inset:auto 0 0; height:2px; pointer-events:none; }
  .series-episode-remaining { margin-inline-start:auto; white-space:nowrap; font-size:var(--type-caption-size); }
  .series-progress-picker {
    box-sizing:border-box; inset:0; width:min(400px,calc(100% - 16px)); max-width:none; max-height:290px;
    padding:0; border:0; border-radius:8px; overflow:hidden; color:var(--white);
    background:color-mix(in srgb,var(--panel) 94%,var(--white)); box-shadow:0 12px 32px #0006;
  }
  .series-progress-picker:is([open],:popover-open) { display:flex; flex-direction:column; }
  .series-progress-picker[open] { display:flex; flex-direction:column; overscroll-behavior:contain; }
  .series-progress-picker:modal::backdrop { overflow:hidden; overscroll-behavior:contain; background:#0006; }
  .tracker .series-progress-picker.tracker-floating-dropdown { padding:0; margin:0; overflow:hidden; }
  .series-progress-header {
    display:flex; align-items:center; gap:8px; flex:none; margin-inline:12px;
    min-height:40px; border-bottom:1px solid var(--border); padding-inline:4px;
  }
  .series-progress-header h3 { flex:1; margin:0; font-size:var(--type-label-size); }
  .series-progress-header span { font-size:var(--type-caption-size); color:var(--muted); white-space:nowrap; }
  .series-progress-header button {
    display:grid; place-items:center; inline-size:30px; block-size:36px; color:var(--muted);
  }
  .series-progress-header svg { inline-size:12px; block-size:12px; }
  .series-progress-picker button {
    border:0; background:transparent; color:inherit; padding:0; font:inherit; cursor:pointer;
  }
  .series-progress-picker [data-series-dismiss] { color:var(--muted); }
  .series-progress-scroll {
    --fade-top:0px; --fade-bottom:0px;
    overflow:auto; overscroll-behavior:contain; min-height:0; scrollbar-width:thin;
    scroll-padding-block:16px;
    mask-image:linear-gradient(to bottom,transparent,black var(--fade-top),black calc(100% - var(--fade-bottom)),transparent);
  }
  .series-progress-scroll[data-fade-top] { --fade-top:16px; }
  .series-progress-scroll[data-fade-bottom] { --fade-bottom:16px; }
  .series-progress-rows { list-style:none; margin:0; padding:5px 16px; }
  .series-progress-row {
    display:grid; grid-template-columns:minmax(66px,1fr) minmax(36px,1.8fr) minmax(56px,.85fr) 30px 30px;
    align-items:center; gap:4px; min-height:42px; font-size:var(--type-label-size);
  }
  .series-progress-row [data-row-season] { overflow-wrap:anywhere; line-height:1.2; font-weight:600; padding-block:6px; }
  .series-progress-row[data-empty] [data-row-season] { color:var(--muted); }
  .series-progress-picker button:is(:hover,:focus-visible):not(:disabled) { outline:none; color:var(--blue); }
  .series-progress-picker button:focus-visible { text-decoration:underline; }
  .series-progress-picker .series-progress-counter { justify-self:end; min-height:36px; padding-inline:2px; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .series-progress-picker .series-progress-counter[data-complete] { color:#72d74f; }
  .series-progress-counter:disabled { opacity:1; cursor:default; }
  .series-progress-picker .series-progress-step {
    justify-self:center; border-radius:4px; inline-size:26px; block-size:26px;
    background:var(--field); font-weight:600;
  }
  .series-progress-step:disabled { opacity:.45; cursor:default; }
  .editor .series-progress-row input {
    --track-color:color-mix(in srgb,var(--muted) 85%,var(--field));
    --fill-color:var(--blue); --editor-input-focus-background:transparent;
    appearance:none; inline-size:100%; block-size:38px; min-width:0; margin:0; padding:0;
    border:0; outline:none; background:transparent; cursor:pointer; touch-action:pan-y;
  }
  .editor .series-progress-row input:disabled { cursor:default; }
  .editor .series-progress-row input:focus-visible { --thumb-size:12px; --track-color:var(--muted); }
  .series-progress-row input::-webkit-slider-runnable-track {
    height:4px; border-radius:999px;
    background:linear-gradient(to right,var(--fill-color) var(--progress),var(--track-color) var(--progress));
  }
  .series-progress-row input::-moz-range-track {
    height:4px; border-radius:999px;
    background:linear-gradient(to right,var(--fill-color) var(--progress),var(--track-color) var(--progress));
  }
  .series-progress-row input::-webkit-slider-thumb {
    appearance:none; width:var(--thumb-size,4px); height:var(--thumb-size,4px);
    margin-top:calc((4px - var(--thumb-size,4px)) / 2); border:0; border-radius:50%;
    background:var(--thumb-color,var(--blue));
  }
  .series-progress-row input::-moz-range-thumb {
    width:var(--thumb-size,4px); height:var(--thumb-size,4px); border:0; border-radius:50%;
    background:var(--thumb-color,var(--blue));
  }
  .editor .series-progress-row[data-empty] input:not(:focus-visible) { --thumb-color:var(--track-color); }
  .series-editor-message { margin:8px 0 0; color:var(--muted); }
  .series-scope-message { color:var(--muted); margin:12px 0 0; font-size:var(--type-label-size); }
  @media(max-width:760px) {
    .editor[data-editor-type=series] .editor-heading { right:296px; }
    .editor-scope { width:132px; }
    .editor[data-editor-type=series] .editor-fields { grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
    .editor .editor-fields > .series-editor-panel {
      display:grid;
      grid-column:1 / -1;
      grid-row:2;
      grid-template-columns:repeat(2,minmax(0,1fr));
      grid-template-columns:subgrid;
      column-gap:inherit;
    }
    .series-editor-panel > * { grid-column:1 / -1; }
    .series-editor-panel > [data-series-retry] { justify-self:start; }
    .series-progress-picker[open] {
      width:100%; height:100%; height:100dvh; max-width:100%; max-height:100%; margin:0;
      border-radius:0; padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
    }
    .series-progress-header { min-height:58px; }
    .series-progress-header button { inline-size:44px; block-size:44px; }
    .series-progress-row { min-height:50px; grid-template-columns:minmax(64px,1fr) minmax(28px,2fr) minmax(48px,.8fr) 44px 44px; }
    .series-progress-picker .series-progress-step { inline-size:44px; block-size:44px; border-radius:50%; background:none; }
    .series-progress-row input { min-height:44px; }
    .editor[data-editor-type=series] .editor-fields > .editor-start-date { grid-column:1; grid-row:3; }
    .editor[data-editor-type=series] .editor-fields > .editor-finish-date { grid-column:2; grid-row:3; }
    .editor[data-editor-domain=movies-series] .editor-fields > .editor-notes { grid-column:1; }
    .editor[data-editor-domain=movies-series] .editor-fields > .editor-rewatches { grid-column:2; }
    .editor[data-editor-type=series] .editor-fields > :is(.editor-notes,.editor-rewatches) { grid-row:4; }
  }
  @media(prefers-reduced-motion:no-preference) { .series-progress-detail svg { transition:rotate .15s ease; } }
  @media(max-width:460px) {
    .editor[data-editor-type=series] .editor-heading { right:auto; }
    .editor[data-editor-domain=movies-series] .editor-fields { grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
    .editor[data-editor-domain=movies-series] .editor-fields > .editor-notes { grid-column:1!important; }
    .editor[data-editor-domain=movies-series] .editor-fields > .editor-rewatches { grid-column:2!important; }
    .editor .editor-fields > .series-editor-panel { grid-column:1 / -1!important; }
    .editor[data-editor-type=series] .editor-fields > .editor-start-date { grid-column:1!important; }
    .editor[data-editor-type=series] .editor-fields > .editor-finish-date { grid-column:2!important; }
    .editor-scope { width:auto; flex:1; }
    .editor[data-editor-type=series] .editor-hero-actions .editor-save { min-width:72px; }
  }
</style>
