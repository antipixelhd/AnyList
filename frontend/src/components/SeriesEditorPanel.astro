---
import CalendarDateInput from './CalendarDateInput.astro';
import NumberStepper from './NumberStepper.astro';
import EditorSelect from './EditorSelect.astro';
import Icon from './Icon.astro';
---
<section class="wide series-editor-panel" data-series-editor hidden aria-label="Series progress">
  <p class="series-editor-message" data-series-loading role="status">Loading progress…</p>
  <button type="button" class="series-editor-text" data-series-retry hidden>Retry</button>
  <div data-series-content hidden>
    <div data-series-selection class="series-editor-selection" hidden>
      <div class="series-editor-season-picker">
        <label id="series-season-label" class="sr-only">Choose season</label>
        <div class="series-editor-season-navigation">
          <EditorSelect id="series-season" name="series_season" label="Season" labelledBy="series-season-label"/>
        </div>
      </div>
      <div class="series-editor-count">
        <label for="series-episode-count">Episodes <span data-series-total></span></label>
        <span class="score-stepper">
          <input id="series-episode-count" data-series-count type="number" min="0" step="1" inputmode="numeric" aria-label="Episodes watched" required disabled/>
          <span class="score-stepper-controls">
            <button type="button" data-series-step="1" aria-label="Increase episode progress"><Icon name="chevron-down" rotate={180}/></button>
            <button type="button" data-series-step="-1" aria-label="Decrease episode progress"><Icon name="chevron-down"/></button>
          </span>
        </span>
      </div>
    </div>
    <div class="series-editor-toolbar" data-series-toolbar><button type="button" class="series-editor-text series-editor-expand" data-series-expand aria-expanded="false" aria-controls="editor-season-list"><span data-series-expand-label>All seasons</span><Icon name="chevron-down"/></button></div>
    <ul id="editor-season-list" class="series-editor-list" data-series-rows aria-label="Season dates and scores"></ul>
  </div>
  <template data-series-row-template>
    <li class="series-editor-row">
      <div class="series-editor-row-heading" data-season-heading><div class="series-editor-poster" data-season-poster aria-hidden="true"></div><div class="series-editor-season-identity"><strong data-season-label></strong><small data-season-progress></small></div></div>
      <div class="series-editor-fields">
        <div class="series-editor-score"><label data-season-score-label>Score</label><NumberStepper id="season-score" name="series_score" label="Season score" min={0} max={10} step={0.1} score/></div>
        <div class="series-editor-dates">
        <div class="series-editor-start"><label data-season-date-label="start">Start date</label><CalendarDateInput id="season-start" name="series_start" label="Start date"/></div>
        <div class="series-editor-finish"><label data-season-date-label="finish">Finish date</label><CalendarDateInput id="season-finish" name="series_finish" label="Finish date"/></div>
        </div>

      </div>
    </li>
  </template>
</section>
<style is:global>
  .editor .editor-fields[data-series-tracked] { grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px 24px; }
  .editor:has([data-series-tracked]) { width:min(980px,calc(100vw - 32px)); }
  .editor-fields > .series-editor-panel { grid-column:1 / -1; }
  .editor-fields[data-series-tracked] > .editor-notes { grid-column:1 / 3; grid-row:3; max-width:none; }
  .editor-fields[data-series-tracked] > .editor-rewatches { grid-column:3; grid-row:3; }
  .editor-fields[data-series-tracked] > .editor-notes textarea { min-height:46px; height:46px; }
  .series-editor-panel { min-width:0; }
  .series-editor-toolbar { display:flex; align-items:center; justify-content:flex-end; gap:12px; margin-bottom:0; }
  .series-editor-toolbar:empty { display:none; }
  .series-editor-text { border:0; background:none; color:var(--text); cursor:pointer; padding:0; }
  .series-editor-expand { white-space:nowrap; display:flex; align-items:center; gap:7px; min-height:36px; font-size:var(--type-label-size); }
  .series-editor-expand svg { width:10px; transition:transform .18s ease; }
  .series-editor-expand[aria-expanded=true] svg { transform:rotate(180deg); }
  .series-editor-list { list-style:none; margin:0; padding:0; display:grid; gap:8px; }
  .series-editor-row { display:grid; grid-template-columns:minmax(150px,1fr) 76px 80px 128px 128px; gap:12px; align-items:center; padding:12px 0; }
  .series-editor-row:not([hidden]) ~ .series-editor-row:not([hidden]) { border-top:1px solid var(--field); }
  .series-editor-fields,.series-editor-selection,.series-editor-dates { display:contents; }
  .series-editor-row-heading { display:none; }
  .series-editor-row-heading .series-editor-poster { grid-column:1; grid-row:1; }
  .series-editor-poster { width:44px; height:66px; border-radius:4px; overflow:hidden; background:var(--field); color:var(--muted); display:grid; place-items:center; font-size:18px; }
  .series-editor-poster img { width:100%; height:100%; object-fit:cover; }
  .series-editor-season-identity { display:none; }
  .series-editor-season-picker { grid-column:1; grid-row:1; min-width:0; align-self:end; }
  .series-editor-season-navigation { display:flex; align-items:flex-end; margin-top:0; }
  .series-editor-season-navigation .editor-status-dropdown { flex:1; min-width:0; }
  .series-editor-season-navigation .editor-status-trigger { margin-top:0; min-height:40px; height:40px; }
  .series-editor-count { grid-column:2; grid-row:1; min-width:0; }
  .series-editor-count label { white-space:nowrap; }
  .series-editor-count label span { color:var(--muted); }
  .series-editor-score { grid-column:3; grid-row:1; }
  .series-editor-start { grid-column:4; grid-row:1; }
  .series-editor-finish { grid-column:5; grid-row:1; }
  .series-editor-fields > div { min-width:0; }
  .series-editor-fields label { white-space:nowrap; }
  .series-editor-panel .score-stepper { display:flex; width:100%; margin-top:6px; min-width:0; }
  .series-editor-panel .score-stepper input { width:100%; min-width:0; height:40px; min-height:40px; }
  .series-editor-panel [data-date-display] { min-height:40px; height:40px; padding:8px 29px 8px 9px; font-size:13px; }
  .series-editor-panel [data-date-picker] { right:1px; width:26px; }
  .series-editor-panel :is(button,input):focus-visible { outline:none; color:var(--bright); }
  .series-editor-panel input:focus-visible { background:var(--surface-hover,#21394a); }
  .series-editor-panel button:hover:not(:disabled) { color:var(--bright); }

  .series-editor-panel[data-all-seasons] .series-editor-row-heading { grid-column:1 / 3; grid-row:1; display:flex; align-items:center; gap:12px; }
  .series-editor-panel[data-all-seasons] .series-editor-season-identity { display:grid; gap:4px; }
  .series-editor-season-identity strong { font-size:14px; color:var(--bright); }
  .series-editor-season-identity small { color:var(--text); font-size:12px; font-variant-numeric:tabular-nums; }
  .series-editor-panel[data-all-seasons] .series-editor-score { grid-column:3; }
  .series-editor-panel[data-all-seasons] .series-editor-start { grid-column:4; }
  .series-editor-panel[data-all-seasons] .series-editor-finish { grid-column:5; }
  .series-editor-message { padding:12px 0; color:var(--muted); }
  .series-editor-panel [hidden],.series-editor-panel[hidden] { display:none!important; }
  .series-airing-dialog .editor-confirmation-actions { flex-wrap:wrap; }
  @media (min-width:651px) and (max-width:900px) {
    .series-editor-panel .series-editor-row { grid-template-columns:minmax(160px,1fr) 76px 80px; }
    .series-editor-panel .series-editor-dates { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; grid-column:1 / -1; grid-row:2; }
    .series-editor-panel :is(.series-editor-start,.series-editor-finish),.series-editor-panel[data-all-seasons] :is(.series-editor-start,.series-editor-finish) { grid-column:auto; grid-row:auto; }
  }
  @media (max-width:650px) {
    .editor .editor-fields[data-series-tracked] { grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
    .editor-fields[data-series-tracked] > .editor-notes { grid-column:1 / -1; grid-row:auto; }
    .editor-fields[data-series-tracked] > .editor-rewatches { grid-column:1; grid-row:auto; }
    .series-editor-row { grid-template-columns:minmax(0,1fr) 76px 76px; gap:12px 8px; padding:12px 0; }
    .series-editor-panel[data-all-seasons] .series-editor-row-heading { grid-column:1 / 3; }
    .series-editor-poster { width:32px; height:48px; }
    .series-editor-season-picker { grid-column:1; }
    .series-editor-season-navigation .editor-status-trigger { padding:8px; gap:5px; }
    .series-editor-count { grid-column:2; grid-row:1; }
    .series-editor-score,.series-editor-panel[data-all-seasons] .series-editor-score { grid-column:3; grid-row:1; }
    .series-editor-panel .series-editor-dates { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; grid-column:1 / -1; grid-row:2; }
    .series-editor-panel :is(.series-editor-start,.series-editor-finish),.series-editor-panel[data-all-seasons] :is(.series-editor-start,.series-editor-finish) { grid-column:auto; grid-row:auto; }
    .series-editor-panel [data-date-display] { font-size:12px; padding-left:6px; padding-right:24px; }
  }
  @media (max-width:460px) {
    .editor:has([data-series-tracked]) { width:calc(100vw - 18px); }

  }
  @media (prefers-reduced-motion:reduce) { .series-editor-expand svg { transition:none; } }
  @media (max-width:360px) {
    .series-editor-row { grid-template-columns:minmax(0,1fr) 68px 68px; }
    .series-editor-season-navigation .editor-status-trigger { padding-inline:6px; font-size:12px; }
  }
</style>
