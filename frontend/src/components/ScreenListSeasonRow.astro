---
import Icon from './Icon.astro';
import EntryAvailability from './EntryAvailability.astro';
const {owner,isCombined}=Astro.props;
---
<div class:list={['entry-row','list-season-row',{'combined-row':isCombined}]}>
  <div class="entry-thumbnail"><EntryAvailability/><img class="entry-cover" alt="" loading="lazy" />{owner&&<button class="row-menu" type="button" data-motion-static data-edit-entry><Icon name="ellipsis"/></button>}</div>
  <div class="entry-title"><span data-season-name></span><small data-season-year hidden></small></div>
  <span class="entry-score" role="group" aria-label="Score">
    {owner?<button type="button" class="entry-score-button" data-quick-rate-id data-quick-rate-season><span data-score-label></span></button>:<span data-score-label></span>}
  </span>
  <span class="entry-progress" role="group" aria-label="Progress" data-season-progress></span>
  {isCombined&&<span class="entry-type" data-season-status></span>}
</div>
