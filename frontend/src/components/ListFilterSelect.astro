---
import Icon from './Icon.astro';
import {listFilterLabel} from '../lib/list-filter-label.ts';

interface Props {
  id: string;
  label: string;
  options: ReadonlyArray<readonly [string, string]>;
  value?: string;
  name?: string;
  defaultValue?: string;
  showDefaultValue?: boolean;
}

const { id, label, options, value = '', name, defaultValue = '', showDefaultValue = false } = Astro.props;
const selectedLabel = listFilterLabel(value, defaultValue, label, options.find(([optionValue]) => optionValue === value)?.[1], showDefaultValue);
---
<div class="filter-control filter-dropdown-field">
  <span id={`${id}-label`} class="sr-only">{label}</span>
  <select id={id} name={name} class="filter-select-native" tabindex="-1" aria-hidden="true" data-filter-label={label} data-filter-default={defaultValue} data-filter-show-default={showDefaultValue?'true':undefined}>
    {options.map(([optionValue, optionLabel]) => <option value={optionValue} selected={optionValue === value}>{optionLabel}</option>)}
  </select>
  <div class="filter-dropdown" data-filter-dropdown data-motion-static>
    <button type="button" class="filter-dropdown-trigger tracker-dropdown-trigger" id={`${id}-trigger`} aria-label={selectedLabel === label ? label : `${label}: ${selectedLabel}`} aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-options`}>
      <span id={`${id}-value`}>{selectedLabel}</span><Icon name="chevron-down" />
    </button>
    <div class="filter-dropdown-options tracker-dropdown-menu" id={`${id}-options`} role="listbox" aria-labelledby={`${id}-label`} hidden>
      {options.map(([optionValue, optionLabel]) => <button type="button" role="option" data-filter-value={optionValue} aria-selected={optionValue === value}>{optionLabel}</button>)}
    </div>
  </div>
</div>
