---
import Icon from './Icon.astro';

interface Props {
  id: string;
  label: string;
  options: ReadonlyArray<readonly [string, string]>;
  value?: string;
}

const { id, label, options, value = '' } = Astro.props;
const selectedLabel = options.find(([optionValue]) => optionValue === value)?.[1] ?? options[0]?.[1] ?? '';
---
<div class="filter-control filter-dropdown-field">
  <span id={`${id}-label`}>{label}</span>
  <select id={id} class="filter-select-native" tabindex="-1" aria-hidden="true">
    {options.map(([optionValue, optionLabel]) => <option value={optionValue} selected={optionValue === value}>{optionLabel}</option>)}
  </select>
  <div class="filter-dropdown" data-filter-dropdown data-motion-static>
    <button type="button" class="filter-dropdown-trigger tracker-dropdown-trigger" id={`${id}-trigger`} aria-labelledby={`${id}-label ${id}-value`} aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-options`}>
      <span id={`${id}-value`}>{selectedLabel}</span><Icon name="chevron-down" />
    </button>
    <div class="filter-dropdown-options tracker-dropdown-menu" id={`${id}-options`} role="listbox" aria-labelledby={`${id}-label`} hidden>
      {options.map(([optionValue, optionLabel]) => <button type="button" role="option" data-filter-value={optionValue} aria-selected={optionValue === value}>{optionLabel}</button>)}
    </div>
  </div>
</div>
