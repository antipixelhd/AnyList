---
import Icon from './Icon.astro';
const {query='',label='Search',placeholder='Search titles…',ariaLabel='Search titles'}=Astro.props;
---
      <div class="browse-search-row">
        <label class="browse-search">
          <span>{label}</span>
          <div>
            <Icon name="search" />
            <input
              type="search"
              name="q"
              value={query}
              placeholder={placeholder}
              autocomplete="off"
              aria-label={ariaLabel}
            />
            <button type="button" class="browse-search-clear" data-browse-search-clear aria-label="Clear search" hidden={!query}>
              <Icon name="close" />
            </button>
          </div>
        </label>
      </div>
