---
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';

const features = [
  { icon: 'list', title: 'One clear watch journal', copy: 'Movies and series grouped by Watching, Completed, Paused, Dropped, and Planning.' },
  { icon: 'star', title: 'Ratings with room for nuance', copy: 'Score titles in half-points, keep season ratings, and see what the people you follow thought.' },
  { icon: 'arrows-rotate', title: 'Optional background sync', copy: 'Reconcile connected streaming and tracking accounts without replacing your local choices.' },
];
---

<div class="auth-hero">
  <a class="auth-brand" href="/login" aria-label="AnyList sign in">
    <BrandMark size={46}/>
    <span>AnyList</span>
  </a>
  <p class="auth-kicker">Your private media journal</p>
  <h1>Keep every story<br/><span>in one place.</span></h1>
  <p class="auth-lead">A clean, self-hosted home for the movies and series you watch, rate, and share with friends.</p>

  <ul class="auth-features">
    {features.map((feature) => <li>
      <span class="auth-feature-icon"><Icon name={feature.icon}/></span>
      <span><strong>{feature.title}</strong><small>{feature.copy}</small></span>
    </li>)}
  </ul>
</div>

<style>
  .auth-hero{max-width:570px;color:#f1f7fb;text-shadow:0 1px 12px #06111dcc}
  .auth-brand{display:inline-flex;align-items:center;gap:12px;color:#f3f8fc;text-decoration:none;font-size:21px;font-weight:700;letter-spacing:-.02em;margin-bottom:42px}
  .auth-kicker{margin:0 0 13px;color:#8fcbea;font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
  h1{margin:0;color:#f7fbff;font-size:clamp(38px,5vw,64px);font-weight:700;line-height:1.04;letter-spacing:-.045em}h1 span{color:#3db4f2}
  .auth-lead{max-width:520px;margin:22px 0 34px;color:#b5c5d3;font-size:16px;line-height:1.7}
  .auth-features{display:grid;gap:18px;margin:0;padding:0;list-style:none}.auth-features li{display:grid;grid-template-columns:38px 1fr;gap:14px;align-items:start}.auth-feature-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:7px;background:#172638cc;color:#55bff5;border:1px solid #294158}.auth-features strong,.auth-features small{display:block}.auth-features strong{font-size:14px;color:#e9f1f7;margin:1px 0 3px}.auth-features small{max-width:460px;color:#8ea2b4;font-size:12px;line-height:1.5}
  .auth-feature-icon :global(.ui-icon){display:inline-grid;place-items:center;line-height:1}.auth-feature-icon :global(.ui-icon-svg){width:15px;height:15px;fill:currentColor}
  @media(max-width:767px){.auth-hero{text-align:center;margin-inline:auto}.auth-brand{margin-bottom:24px}.auth-kicker,.auth-features{display:none}.auth-lead{margin:15px auto 0;font-size:14px}h1{font-size:36px}}
</style>
