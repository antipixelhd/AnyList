---
import Icon from './Icon.astro';
import {responsiveArtwork} from '../lib/responsive-artwork';
import {detailDate,durationLabel,type DetailMedia} from '../lib/media-detail-data';
import {currentDetailSeason,type DetailSeason} from '../lib/season-detail-data';
import {scoreLabel} from '../lib/tracker';
const {title,signedIn}=Astro.props as {title:DetailMedia;signedIn:boolean};
const seasons=[...title.seasons].sort((a,b)=>a.season_number-b.season_number) as DetailSeason[];
const current=currentDetailSeason(seasons,title.entry?.status==='watching');
---
<section class="seasons-section lab-season-panel" id="seasons" data-season-details>
  <div class="lab-section-title"><h2>Seasons</h2><div class="media-season-actions"><button class="lab-text-button" type="button" data-episode-spoilers aria-pressed="false"><Icon name="eye-slash"/><span>Titles hidden</span></button>{signedIn&&<button class="lab-text-button" id="refresh-episodes" type="button" aria-label="Refresh episode metadata" title="Refresh episode metadata"><Icon name="arrows-rotate"/></button>}</div></div>
  {signedIn&&<div class="lab-season-rating-rule"><label><input type="checkbox" data-season-average checked={title.entry?.rating_mode==='average'}/> Use season average for your show score</label><span data-season-show-score>{scoreLabel(title.entry?.score??null)} / 10</span></div>}
  <div class="lab-season-cards">{seasons.map(season=>{
    const number=season.season_number;
    const complete=!!season.released_count&&season.watched_count>=season.released_count;
    return <article class="lab-season-card" data-season-card={number}>
      <div class="lab-season-head"><div class="lab-season-identity"><span class="lab-season-number">{String(number).padStart(2,'0')}</span><div><h3>{season.name||`Season ${number}`}</h3><p>{[season.air_date?.slice(0,4),`${season.episode_count} episodes`].filter(Boolean).join(' · ')}</p></div></div>{signedIn&&<button class="lab-season-rate" type="button" data-open-season-score={number} aria-label={`Rate season ${number}`} aria-haspopup="dialog"><span>Your season score</span><strong><Icon name="star"/><span data-season-score={number}>{scoreLabel(title.entry?.season_scores?.[String(number)]??null)}</span></strong></button>}</div>
      <details class="media-season-disclosure" data-season-disclosure open={number===current}>
        <summary class="lab-season-toolbar"><span data-season-count={number}>{season.released_count==null?'Episode metadata not loaded':`${season.watched_count} / ${season.released_count} watched`}</span>{signedIn&&number>0&&<button class="lab-text-button" type="button" data-season-progress={number} data-watched={!complete?'true':'false'} disabled={!season.released_count}>{complete?'Mark season unwatched':'Mark season watched'} <Icon name="check"/></button>}<span class="lab-season-expand">Episodes <Icon name="chevron-down"/></span></summary>
        <div class="lab-episode-list">{season.episodes?.length?season.episodes.map(episode=>{
          const image=responsiveArtwork(episode.image,{size:'w300',sizes:'(max-width:650px) 55px, 125px',route:'direct'});
          return <article class="lab-episode" data-episode-row={episode.id} data-watched={String(episode.watched)}><span class="lab-episode-number">{String(episode.episode_number).padStart(2,'0')}</span>{image?<div class="lab-episode-image"><img src={image.src} srcset={image.srcset} sizes={image.sizes} alt="" loading="lazy"/></div>:<div class="lab-episode-image lab-episode-placeholder" aria-hidden="true"><Icon name="play"/></div>}<div class="lab-episode-copy"><h3 data-episode-title={episode.title} data-episode-number={episode.episode_number}>{episode.watched?episode.title:`Episode ${episode.episode_number}`}</h3><p>{[durationLabel(episode.runtime),detailDate(episode.air_date)].filter(Boolean).join(' · ')}</p></div>{signedIn&&<button class="lab-episode-check" type="button" data-watch-episode={episode.id} aria-pressed={episode.watched} aria-label={`Mark season ${number} episode ${episode.episode_number} ${episode.watched?'unwatched':'watched'}`} disabled={!episode.released||season.released_count==null} title={!episode.released?'Not released yet':season.released_count==null?'Refresh episode metadata':undefined}><Icon name="check"/></button>}</article>;
        }):<p class="section-empty">Episode metadata has not been loaded yet.</p>}</div>
      </details>
      {signedIn&&<dialog class="editor media-season-rating" id={`season-rating-${number}`} aria-labelledby={`season-rating-heading-${number}`}><div class="editor-header"><h2 id={`season-rating-heading-${number}`}>Season {number} score</h2><button class="icon-button" type="button" data-close-season-score aria-label="Close season rating"><Icon name="close"/></button></div><div class="media-season-rating-body"><label for={`season-score-${number}`}>Your score</label><div class="score-stepper" data-score-stepper><input id={`season-score-${number}`} type="number" step="0.1" min="0" max="10" placeholder="—" value={title.entry?.season_scores?.[String(number)]??''} data-season={number} aria-label={`Season ${number} score`}/><span class="score-stepper-controls"><button type="button" data-score-step="up" aria-label={`Increase season ${number} score`}><Icon name="chevron-down" rotate={180}/></button><button type="button" data-score-step="down" aria-label={`Decrease season ${number} score`}><Icon name="chevron-down"/></button></span></div><button class="button-primary" type="button" data-save-season={number} data-has-seasons={Object.values(title.entry?.season_scores||{}).some(Boolean)?'yes':'no'}>Save</button></div></dialog>}
    </article>;
  })}</div>
  {!seasons.length&&<p class="section-empty">Season metadata has not been loaded yet.</p>}
</section>
<dialog class="editor" id="season-mode"><div class="editor-header"><h2>How should your show score work?</h2></div><form method="dialog" class="season-mode-form"><p>Season scores stay independent. Other seasons won't be rated automatically.</p><div class="season-mode-actions"><button class="button-primary" value="average">Average my rated seasons</button><button class="button-secondary" value="manual">Keep a separate show rating</button><button class="button-secondary" value="cancel">Cancel</button></div></form></dialog>
