---
import Icon from './Icon.astro';
import type { ActorGroup, StaffGroup } from '../lib/stats-overview-data';
import { displayNumber } from '../lib/stats-overview-data';
import { genreTime } from '../lib/stats-genres-data';
import { actorTitleImage, type ActorArtwork } from '../lib/stats-actors-data';
import { personTitleLabel } from '../lib/stats-staff-data';
import { responsiveArtwork } from '../lib/responsive-artwork';
interface Props { person: ActorGroup | StaffGroup; rank: number; mode: ActorArtwork; prefix: 'actor' | 'staff'; }
const { person: actor, rank, mode, prefix } = Astro.props;
const portrait = responsiveArtwork(actor.image, { size: 'w185', sizes: '(max-width:650px) 80px, 110px', route: 'direct' });
---
<article class="stats-genre-card stats-actor-card" {...{[`data-${prefix}-key`]: actor.key, [`data-${prefix}-signature`]: JSON.stringify(actor)}} aria-label={actor.label}>
  <div class="stats-genre-summary">
    <header><h3><a {...{[`data-${prefix}-link`]: ""}} href={actor.href} title={actor.label}>{actor.label}</a></h3><span class="stats-genre-rank" {...{[`data-${prefix}-rank`]: ""}} aria-label={`Rank ${rank}`}>{rank}</span></header>
    <dl><div><dt>Count</dt><dd {...{[`data-${prefix}-count`]: ""}}>{displayNumber(actor.titles)}</dd></div><div><dt>Mean Score</dt><dd {...{[`data-${prefix}-score`]: ""}}>{displayNumber(actor.mean_score, 2)}</dd></div><div><dt>Time Watched</dt><dd {...{[`data-${prefix}-time`]: ""}}>{genreTime(actor)}</dd></div></dl>
  </div>
  <a class="stats-actor-portrait" {...{[`data-${prefix}-portrait`]: ""}} href={actor.href} aria-label={actor.label}>
    {portrait ? <img {...portrait} alt="" loading="lazy" /> : <span class="stats-actor-placeholder" aria-hidden="true">{actor.label.slice(0, 1)}</span>}
  </a>
  <div class="stats-genre-posters">
    <div class="stats-genre-track" data-genre-track tabindex="0" role="group" aria-label={`Highest-rated ${actor.label} titles`}>
      {actor.top_titles.map(title => {
        const artwork = responsiveArtwork('roles' in title ? title.poster : actorTitleImage(title, mode), { size: 'w185', sizes: '(max-width:650px) 15vw, 70px', route: 'direct' });
        return <a class="stats-genre-poster" href={title.href} aria-label={personTitleLabel(title)} draggable="false" {...{[`data-${prefix}-title-key`]: title.key}}>
          {artwork ? <img {...artwork} alt="" loading="lazy" draggable="false" /> : <span class="stats-genre-placeholder" aria-hidden="true">{title.title.slice(0, 1)}</span>}
          <span class="stats-genre-tooltip" aria-hidden="true">{personTitleLabel(title)}</span>
        </a>;
      })}
    </div>
    <button class="stats-genre-arrow stats-genre-arrow-prev" type="button" {...{[`data-${prefix}-scroll`]: "-1"}} aria-label={`Previous ${actor.label} titles`} hidden><Icon name="chevron-left" /></button>
    <button class="stats-genre-arrow stats-genre-arrow-next" type="button" {...{[`data-${prefix}-scroll`]: "1"}} aria-label={`Next ${actor.label} titles`} hidden><Icon name="chevron-right" /></button>
  </div>
</article>
