---
import ActivityCover from './ActivityCover.astro';
import Icon from './Icon.astro';
import {activityAction,activityCompletionSuffix,activityRating,activityTime,scoreLabel,trackedWorkHref} from '../lib/tracker';
import '../styles/activity-card-rating.css';
const {activity,showUser=false}=Astro.props;
const time=activityTime(activity.created_at);
const profileHref=showUser?`/user/${encodeURIComponent(activity.username)}`:'';
const initial=(activity.display_name||activity.username||'?').trim().charAt(0).toUpperCase();
const rating=activityRating(activity);
const game=activity.media.type==='game';
const own=activity.user_id===Astro.locals.user?.id;
const completion=game&&activity.status==='completed'&&activity.payload?.status_changed;
---
<article class:list={['visual-event', {'following-event': showUser}]} data-activity-card data-activity-key={activity.key} data-created-at={activity.created_at} data-game-activity-id={game?activity.media.id:undefined} data-game-completion={completion?'true':undefined} data-activity-own={own?'true':undefined}>
  <ActivityCover media={activity.media}/>
  <div class="event-body">
    <div class="event-meta">
      <time datetime={time.datetime} title={time.exact} data-relative-time>{time.label}</time>
      {game&&own&&!['expansion','dlc'].includes(activity.media.game_class)&&<button type="button" class="lab-text-button" data-activity-playtime={activity.media.id}>Playtime</button>}
    </div>
    {showUser ? <div class="event-content">
        <a class="event-user" href={profileHref}>{activity.display_name}</a>
        <p class="event-action"><span>{activityAction(activity)}</span> <a href={trackedWorkHref(activity.media)}>{activity.media.title}</a><span data-activity-completion>{activityCompletionSuffix(activity)}</span></p>
        <a class="event-avatar" href={profileHref} aria-label={`View ${activity.display_name}'s profile`}>
          {activity.has_avatar?<img src={`/api/proxy/profile/avatar/${activity.user_id}`} alt="" loading="lazy"/>:<span aria-hidden="true">{initial}</span>}
        </a>
      </div> : <p class="event-action"><span>{activityAction(activity)}</span> <a href={trackedWorkHref(activity.media)}>{activity.media.title}</a><span data-activity-completion>{activityCompletionSuffix(activity)}</span></p>}
    {rating&&<div class="event-footer"><span class="score-pill" aria-label={rating.label}><Icon name="star"/> {rating.previous!=null&&<>{scoreLabel(rating.previous)}<span class="score-transition" aria-hidden="true">→</span></>}{scoreLabel(rating.current)}<small>/10</small></span></div>}
  </div>
</article>
