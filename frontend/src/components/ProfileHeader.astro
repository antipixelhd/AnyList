---
const {profile,active='overview'}=Astro.props;
const base=`/user/${encodeURIComponent(profile.username)}`;
import {hasStreamingLibraryConnection} from '../lib/streaming-library-availability';
const showLibrary=profile.owner&&await hasStreamingLibraryConnection(Astro.locals.token);
---
<section class="profile-hero"><div class="profile-identity">
{profile.has_avatar?<img class="profile-avatar" src={`/api/proxy/profile/avatar/${profile.id}`} alt=""/>:<div class="profile-avatar" aria-hidden="true">{profile.display_name.slice(0,1).toUpperCase()}</div>}
<div class="profile-heading"><h1>{profile.display_name}</h1>{profile.follows_you&&<span class="follows-you-tag">Follows You</span>}</div>
{!profile.owner&&Astro.locals.user&&<div class="profile-follow-action"><button type="button" class="button-primary profile-follow-button" id="follow-profile" data-username={profile.username} data-display-name={profile.display_name} data-following={profile.following?'yes':'no'} aria-label={`${profile.following?'Unfollow':'Follow'} ${profile.display_name}`}><span class="follow-label">Follow</span><span class="following-label">Following</span><span class="unfollow-label">Unfollow</span></button><span class="profile-follow-error" id="profile-follow-error" role="status" aria-live="polite"></span></div>}
</div></section>
<nav class="profile-tabs" aria-label="Profile" data-profile-owner={profile.owner?'yes':'no'} data-profile-base={base}><a href={base} class:list={{active:active==='overview'}} aria-current={active==='overview'?'page':undefined}>Overview</a>{profile.combine_lists!==false?<a href={`${base}/list`} class:list={{active:active==='list'}} aria-current={active==='list'?'page':undefined}>Movie/Series List</a>:<><a href={`${base}/movies`} class:list={{active:active==='movies'}} aria-current={active==='movies'?'page':undefined}>Movie List</a><a href={`${base}/series`} class:list={{active:active==='series'}} aria-current={active==='series'?'page':undefined}>Series List</a></>}<a href={`${base}/favorites`} class:list={{active:active==='favorites'}} aria-current={active==='favorites'?'page':undefined}>Favorites</a>{showLibrary&&<a href={`${base}/library`} class:list={{active:active==='library'}} aria-current={active==='library'?'page':undefined}>Library</a>}<a href={`${base}/stats`} class:list={{active:active==='stats'}} aria-current={active==='stats'?'page':undefined}>Stats</a><a href={`${base}/social`} class:list={{active:active==='social'}} aria-current={active==='social'?'page':undefined}>Social</a></nav>
<script>
document.addEventListener('astro:page-load', () => {
const tabs = document.querySelector<HTMLElement>('.profile-tabs');
const controller = new AbortController();
document.addEventListener('astro:before-swap', () => controller.abort(), { signal: controller.signal, once: true });
document.addEventListener('anylist:combine-lists-changed', rawEvent => {
 if (!tabs) return;
 const combined = (rawEvent as CustomEvent<{combineLists:boolean}>).detail.combineLists;
 const base = tabs.dataset.profileBase!;
 tabs.querySelectorAll(`a[href="${base}/list"], a[href="${base}/movies"], a[href="${base}/series"]`).forEach(link => link.remove());
 const favorites = tabs.querySelector(`a[href="${base}/favorites"]`);
 for (const [path,label] of (combined ? [['list','Movie/Series List']] : [['movies','Movie List'],['series','Series List']])) {
   const link = document.createElement('a'); link.href = `${base}/${path}`; link.textContent = label;
   if (location.pathname === link.pathname) { link.classList.add('active'); link.setAttribute('aria-current','page'); }
   favorites?.before(link);
 }
}, { signal: controller.signal });
const button = document.querySelector<HTMLButtonElement>('#follow-profile');
if (button) {
 const error = document.querySelector<HTMLElement>('#profile-follow-error');
 let confirmed = button.dataset.following === 'yes';
 let desired = confirmed;
 let syncing = false;
 const render = () => {
  button.dataset.following = desired ? 'yes' : 'no';
  button.setAttribute('aria-label', `${desired ? 'Unfollow' : 'Follow'} ${button.dataset.displayName || ''}`.trim());
 };
 const sync = async () => {
  if (syncing) return;
  syncing = true;
  while (desired !== confirmed) {
   const next = desired;
   try {
    const response = await fetch(`/api/proxy/tracking/people/${encodeURIComponent(button.dataset.username!)}/follow`, { method: next ? 'POST' : 'DELETE' });
    if (!response.ok) throw new Error('Could not update following. Please try again.');
    confirmed = next;
   } catch {
    desired = confirmed;
    render();
    if (error) error.textContent = 'Could not update following. Please try again.';
    break;
   }
  }
  syncing = false;
 };
 button.addEventListener('click', () => {
  desired = !desired;
  if (desired) button.dataset.recentFollow = 'yes';
  else delete button.dataset.recentFollow;
  if (error) error.textContent = '';
  render();
  void sync();
 }, { signal: controller.signal });
 button.addEventListener('pointerleave', () => { delete button.dataset.recentFollow; }, { signal: controller.signal });
 button.addEventListener('blur', () => { delete button.dataset.recentFollow; }, { signal: controller.signal });
}
});
</script>
<style>
.profile-heading{display:flex;align-items:center;gap:12px;flex-wrap:wrap;transform:translateY(-15px)}
.profile-heading h1{margin:0}
.follows-you-tag{display:inline-flex;align-items:center;padding:3px 8px;border:1px solid #48708c;border-radius:4px;background:#203c52;color:#acd9f3;font-size:var(--type-badge-size);font-weight:var(--type-badge-weight);white-space:nowrap}
.profile-follow-action{position:relative;align-self:end;margin:0 0 19px auto;flex:none}
.profile-follow-button{min-width:110px}
.profile-follow-button .following-label,.profile-follow-button .unfollow-label,.profile-follow-button[data-following="yes"] .follow-label{display:none}
.profile-follow-button[data-following="yes"] .following-label{display:inline}
.profile-follow-button[data-following="yes"]{background:var(--blue);color:#fff}
.profile-follow-button[data-following="yes"]:not([data-recent-follow]):is(:hover,:focus-visible){background:#613341;color:#ffe5eb}
.profile-follow-button[data-following="yes"]:not([data-recent-follow]):is(:hover,:focus-visible) .following-label{display:none}
.profile-follow-button[data-following="yes"]:not([data-recent-follow]):is(:hover,:focus-visible) .unfollow-label{display:inline}
.profile-follow-error{position:absolute;top:100%;left:0;width:220px;margin-top:6px;color:#ffbeca;font-size:var(--type-caption-size);line-height:1.3}
@media(max-width:650px){.profile-heading{gap:6px;align-content:center;min-width:0}.profile-follow-action{margin-bottom:10px}.follows-you-tag{font-size:var(--type-caption-size)}.profile-follow-button{min-width:92px;padding:8px 12px;font-size:var(--type-meta-size)}.profile-follow-error{width:160px;right:0;left:auto}}
</style>
