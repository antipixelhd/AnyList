---
import Icon from './Icon.astro';
import QuickSearch from './QuickSearch.astro';
import TrackingEditor from './TrackingEditor.astro';
import BrandMark from './BrandMark.astro';
import {tracker} from '../lib/tracker';
import {api} from '../lib/api';
import '../styles/app-bar.css';

const {user, token} = Astro.locals;
const {initiallyHidden = false} = Astro.props;
const pathname = Astro.url.pathname;
const fadesAtTop = pathname.startsWith('/user/') || pathname.startsWith('/title/') || pathname.startsWith('/media/');
const profile = user ? `/user/${encodeURIComponent(user.username)}` : '/login';
let combineLists = true;
let quietNotifications = 0;
let attentionNotifications = 0;
let avatarUrl: string | null = null;

if (user) {
  const [preferenceResult, notificationResult, profileResult] = await Promise.allSettled([
    tracker('preferences', token),
    tracker('recent-events', token),
    api.profile.get(token!),
  ]);
  if (preferenceResult.status === 'fulfilled') combineLists = preferenceResult.value.combine_lists !== false;
  if (notificationResult.status === 'fulfilled') {
    const notifications = notificationResult.value;
    attentionNotifications = (notifications.results ?? []).filter((event: any) => event.state === 'pending' && event.priority === 'high').length;
    // Operational delivery jobs stay visible in the collapsed connection queue,
    // but they are not user notifications and must not light up the app bar.
    quietNotifications = Math.max(0, (notifications.results?.length ?? 0) - attentionNotifications);
  }
  if (profileResult.status === 'fulfilled' && profileResult.value.avatar_url) avatarUrl = `/api/proxy${profileResult.value.avatar_url}`;
}

const notificationTotal = quietNotifications + attentionNotifications;
const notificationLabel = notificationTotal
  ? `Notifications: ${attentionNotifications} need attention, ${quietNotifications} other`
  : 'Notifications: none unread';
const active = (prefix: string) => pathname === prefix || pathname.startsWith(`${prefix}/`);
const listItems = combineLists
  ? [{href: `${profile}/list`, label: 'Movie/Series List', icon: 'list', active: pathname.includes('/list')}]
  : [
      {href: `${profile}/movies`, label: 'Movie List', icon: 'list', active: pathname.includes('/movies')},
      {href: `${profile}/series`, label: 'Series List', icon: 'list', active: pathname.includes('/series')},
    ];
const primaryItems = [
  {href: '/home', label: 'Home', icon: 'home', active: active('/home')},
  ...listItems,
  {href: '/browse', label: 'Browse', icon: 'browse', active: active('/browse')},
];
const settingsRoute = ['/settings', '/user-settings', '/connections', '/admin'].includes(pathname);
const mobileSection = primaryItems.find(item => item.active)?.label
  || (pathname.startsWith('/user/') ? 'Profile' : pathname === '/recent-events' ? 'Notifications' : settingsRoute ? 'Settings' : 'Browse');
---
<header class:list={['topbar', {'appbar-hidden': initiallyHidden, 'appbar-fade-capable': fadesAtTop}]} data-appbar transition:animate="none">
  <div class="appbar-inner">
    <a class="brand" href="/home" aria-label="AnyList home">
      <BrandMark size={34}/>
    </a>
    <nav class="appbar-nav" aria-label="Main navigation" data-desktop-main-nav data-profile-base={profile} transition:persist="desktop-main-nav">
      {primaryItems.map(item => <a href={item.href} aria-current={item.active?'page':undefined}>{item.label}</a>)}
    </nav>
    <details class="mobile-appbar-menu" data-mobile-appbar-menu>
      <summary aria-label={`${mobileSection}. Open main navigation`}><span>{mobileSection}</span><Icon name="chevron-down" /></summary>
      <nav aria-label="Mobile main navigation" data-mobile-main-nav data-profile-base={profile}>
        {primaryItems.map(item => <a href={item.href} class:list={{active:item.active}} aria-current={item.active?'page':undefined}><Icon name={item.icon} />{item.label}</a>)}
      </nav>
    </details>
    <div class="account-nav">
      {user ? <>
        <QuickSearch combineLists={combineLists} />
        <a class:list={{'profile-action': true, active: pathname.startsWith('/user/')}} href={profile} aria-label={`Open ${user.display_name || user.username}'s profile`} data-appbar-avatar>
          {avatarUrl
            ? <img src={avatarUrl} alt="" />
            : <span aria-hidden="true">{(user.display_name || user.username).slice(0,1).toUpperCase()}</span>}
        </a>
        <a class:list={{'appbar-icon-link': true, active: pathname === '/recent-events'}} href="/recent-events" aria-label={notificationLabel} aria-current={pathname === '/recent-events' ? 'page' : undefined} data-notification-link>
          <Icon name="bell" />
          <span class="notification-badge notification-badge-quiet" aria-hidden="true" data-notification-quiet hidden={quietNotifications===0}>{quietNotifications > 99 ? '99+' : quietNotifications}</span>
          <span class="notification-badge notification-badge-attention" aria-hidden="true" data-notification-attention hidden={attentionNotifications===0}>{attentionNotifications > 99 ? '99+' : attentionNotifications}</span>
        </a>
        <a class:list={{'appbar-icon-link': true, active: settingsRoute}} href="/user-settings" aria-label="Settings" aria-current={settingsRoute ? 'page' : undefined}><Icon name="gear" /></a>
        <form method="POST" action="/logout" class="appbar-signout"><button class="appbar-icon-link" type="submit" aria-label="Sign out"><Icon name="sign-out" /></button></form>
      </> : <a href="/login">Sign in</a>}
    </div>
  </div>
</header>
{user && <TrackingEditor />}
{user && <script>
  import {subscribeNotifications, type NotificationSnapshot} from '../lib/notification-store';

  let notificationPageListeners: AbortController;
  document.addEventListener('astro:page-load', () => {
  notificationPageListeners?.abort();
  notificationPageListeners = new AbortController();
  const link = document.querySelector<HTMLElement>('[data-notification-link]');
  const quietBadge = document.querySelector<HTMLElement>('[data-notification-quiet]');
  const attentionBadge = document.querySelector<HTMLElement>('[data-notification-attention]');
  const renderBadge = (badge: HTMLElement | null, count: number) => {
    if (!badge) return;
    badge.hidden = count === 0;
    badge.textContent = count > 99 ? '99+' : String(count);
  };
  const renderNotificationBadges = (notifications: NotificationSnapshot) => {
    const attention = notifications.results.filter((event: any) => event.state === 'pending' && event.priority === 'high').length;
    // The operational outbound queue is intentionally excluded from the app-bar badges.
    const quiet = Math.max(0, notifications.results.length - attention);
    renderBadge(quietBadge, quiet);
    renderBadge(attentionBadge, attention);
    if (link) link.setAttribute('aria-label', attention + quiet ? `Notifications: ${attention} need attention, ${quiet} other` : 'Notifications: none unread');
  };
  subscribeNotifications(renderNotificationBadges, {signal: notificationPageListeners.signal});
  });
</script>}
<script>
  let appbarListeners: AbortController;
  let cursorTransitionId = 0;
  let cursorTransitionActive = false;
  document.addEventListener('astro:page-load', () => {
  appbarListeners?.abort();
  appbarListeners = new AbortController();
  const appbar = document.querySelector<HTMLElement>('[data-appbar]');
  if (appbar) {
    let previousY = Math.max(0, window.scrollY);
    let scheduled = false;
    let keyboardFocus = false;
    let wheelDown = false;
    const mobile = () => matchMedia('(max-width:650px)').matches;
    const topThreshold = () => mobile() ? 16 : 0;
    const syncTopFade = (y: number) => appbar.classList.toggle('appbar-at-top', !mobile() && y <= 0);
    const clearPointerState = () => {
      appbar.classList.remove('appbar-pointer-active');
    };
    const clearHoveredLink = () => {
      appbar.querySelectorAll('.appbar-nav a.appbar-pointer-hover').forEach(link => link.classList.remove('appbar-pointer-hover'));
    };
    const syncPointerState = (event: PointerEvent) => {
      if (event.pointerType === 'touch') return;
      appbar.classList.add('appbar-pointer-active');
      const hoveredLink = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('.appbar-nav a') : null;
      if (!hoveredLink || !appbar.contains(hoveredLink)) return;
      for (const link of appbar.querySelectorAll<HTMLAnchorElement>('.appbar-nav a')) {
        link.classList.toggle('appbar-pointer-hover', link === hoveredLink);
      }
    };
    const syncDesktopCurrentPage = () => {
      for (const link of appbar.querySelectorAll<HTMLAnchorElement>('.appbar-nav a')) {
        const current = location.pathname === link.pathname || location.pathname.startsWith(`${link.pathname}/`);
        if (current) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      }
    };
    const releaseTransitionCursor = (id: number) => {
      if (id !== cursorTransitionId) return;
      cursorTransitionActive = false;
      document.documentElement.classList.remove('appbar-nav-transition-cursor');
    };
    document.addEventListener('astro:before-preparation', rawEvent => {
      const event = rawEvent as Event & { sourceElement?: Element; signal?: AbortSignal };
      const sourceLink = event.sourceElement?.closest('.appbar-nav a');
      const id = ++cursorTransitionId;
      cursorTransitionActive = !!sourceLink?.classList.contains('appbar-pointer-hover');
      document.documentElement.classList.toggle('appbar-nav-transition-cursor', cursorTransitionActive);
      event.signal?.addEventListener('abort', () => releaseTransitionCursor(id), { once: true });
    }, { signal: appbarListeners.signal });
    const prepareIncomingAppbar = (rawEvent: Event) => {
      const event = rawEvent as Event & { newDocument?: Document; viewTransition?: ViewTransition };
      if (cursorTransitionActive) {
        const id = cursorTransitionId;
        void event.viewTransition?.finished.then(
          () => releaseTransitionCursor(id),
          () => releaseTransitionCursor(id),
        );
      }
      const incomingAppbar = event.newDocument?.querySelector<HTMLElement>('[data-appbar]');
      if (!incomingAppbar) return;
      const pointerActive = appbar.classList.contains('appbar-pointer-active') || appbar.matches(':hover');
      incomingAppbar.classList.toggle('appbar-pointer-active', pointerActive);
      const listLanding = event.newDocument?.body.hasAttribute('data-list-landing') ?? false;
      const startsTransparent = !listLanding && !mobile() && incomingAppbar.classList.contains('appbar-fade-capable');
      incomingAppbar.classList.toggle('appbar-at-top', startsTransparent);
      if (listLanding) incomingAppbar.classList.add('appbar-hidden');
      else if (startsTransparent) incomingAppbar.classList.remove('appbar-hidden');
    };
    document.addEventListener('astro:before-swap', prepareIncomingAppbar, { signal: appbarListeners.signal });
    document.addEventListener('astro:after-swap', () => {
      if (cursorTransitionActive) document.documentElement.classList.add('appbar-nav-transition-cursor');
    }, { signal: appbarListeners.signal });
    appbar.addEventListener('pointerover', syncPointerState, { signal: appbarListeners.signal });
    appbar.addEventListener('pointermove', syncPointerState, { signal: appbarListeners.signal });
    appbar.addEventListener('pointerdown', syncPointerState, { signal: appbarListeners.signal });
    appbar.addEventListener('click', event => {
      if (event.detail === 0) return;
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('.appbar-nav a') : null;
      link?.blur();
    }, { signal: appbarListeners.signal });
    appbar.addEventListener('pointerleave', clearPointerState, { signal: appbarListeners.signal });
    document.addEventListener('pointermove', event => {
      if (event.pointerType === 'touch') return;
      const hoveredLink = event.target instanceof Element ? event.target.closest('.appbar-nav a') : null;
      if (!hoveredLink || !appbar.contains(hoveredLink)) {
        if (!appbar.contains(event.target as Node)) clearPointerState();
        clearHoveredLink();
      }
    }, { signal: appbarListeners.signal });
    window.addEventListener('blur', () => {
      clearPointerState();
      clearHoveredLink();
    }, { signal: appbarListeners.signal });
    // The desktop nav survives swaps. Refresh only route semantics after navigation.
    syncDesktopCurrentPage();
    if (appbar.classList.contains('appbar-hidden')) {
      clearPointerState();
      clearHoveredLink();
    }
    document.addEventListener('keydown', () => { keyboardFocus = true; }, { capture: true, signal: appbarListeners.signal });
    document.addEventListener('pointerdown', () => { keyboardFocus = false; }, { capture: true, signal: appbarListeners.signal });
    window.addEventListener('wheel', event => {
      keyboardFocus = false;
      if (!mobile() && event.deltaY > 0) wheelDown = true;
      if (!mobile() && event.deltaY < 0) {
        wheelDown = false;
      }
    }, { passive: true, signal: appbarListeners.signal });
    window.addEventListener('touchstart', () => { keyboardFocus = false; }, { passive: true, signal: appbarListeners.signal });
    const reveal = () => {
      if (appbar.classList.contains('appbar-hidden') && appbar.classList.contains('appbar-at-top')) {
        // Resolve the transparent background while the bar is still off-screen.
        void appbar.offsetWidth;
      }
      appbar.classList.remove('appbar-hidden');
    };
    syncTopFade(previousY);
    if (previousY <= topThreshold()) reveal();
    const update = () => {
      const currentY = Math.max(0, window.scrollY);
      const delta = currentY - previousY;
      const ownsFocus = keyboardFocus && appbar.contains(document.activeElement);
      const isMobile = mobile();
      const hideAfter = isMobile ? appbar.offsetHeight : 0;
      syncTopFade(currentY);
      if (currentY <= topThreshold() || delta < -4 || ownsFocus) reveal();
      else if ((delta > 6 || (!isMobile && wheelDown && delta > 0)) && currentY > hideAfter) {
        appbar.classList.add('appbar-hidden');
        clearPointerState();
        clearHoveredLink();
      }
      previousY = currentY;
      if (currentY > hideAfter || delta < 0) wheelDown = false;
      scheduled = false;
    };
    window.addEventListener('scroll', () => {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(update);
      }
    }, { passive: true, signal: appbarListeners.signal });
    appbar.addEventListener('focusin', reveal);
    window.addEventListener('pageshow', () => {
      previousY = Math.max(0, window.scrollY);
      syncTopFade(previousY);
      if (previousY <= topThreshold() || !document.body.hasAttribute('data-list-landing')) reveal();
    }, { signal: appbarListeners.signal });
    window.addEventListener('resize', () => syncTopFade(Math.max(0, window.scrollY)), { passive: true, signal: appbarListeners.signal });
  }
  const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-appbar-menu]');
  const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>('summary');
  document.addEventListener('anylist:combine-lists-changed', rawEvent => {
    const combined = (rawEvent as CustomEvent<{combineLists: boolean}>).detail.combineLists;
    for (const nav of document.querySelectorAll<HTMLElement>('[data-desktop-main-nav], [data-mobile-main-nav]')) {
      const base = nav.dataset.profileBase;
      if (!base) continue;
      const listIcon = nav.querySelector<HTMLElement>(`a[href="${base}/list"] .ui-icon, a[href="${base}/movies"] .ui-icon, a[href="${base}/series"] .ui-icon`)?.cloneNode(true);
      nav.querySelectorAll<HTMLAnchorElement>(`a[href="${base}/list"], a[href="${base}/movies"], a[href="${base}/series"]`).forEach(link => link.remove());
      const browse = nav.querySelector<HTMLAnchorElement>('a[href="/browse"]');
      const items = combined ? [['list', 'Movie/Series List']] : [['movies', 'Movie List'], ['series', 'Series List']];
      for (const [path, label] of items) {
        const link = document.createElement('a');
        link.href = `${base}/${path}`;
        if (listIcon) link.append(listIcon.cloneNode(true));
        link.append(label);
        if (location.pathname === link.pathname) {
          link.setAttribute('aria-current', 'page');
          if (nav.matches('[data-mobile-main-nav]')) link.classList.add('active');
        }
        browse?.before(link);
      }
    }
    const quickSearch = document.querySelector<HTMLElement>('[data-quick-search]');
    if (quickSearch) {
      quickSearch.dataset.combined = combined ? 'yes' : 'no';
      quickSearch.querySelector('.quick-search-results')?.classList.toggle('combined', combined);
    }
    const summary = mobileMenuSummary?.querySelector('span');
    if (summary && /^(Movie\/Series|Movie|Series) List$/.test(summary.textContent || ''))
      summary.textContent = combined ? 'Movie/Series List' : location.pathname.endsWith('/series') ? 'Series List' : 'Movie List';
  }, { signal: appbarListeners.signal });
  let openMobileMenuFromKeyboard = false;
  mobileMenuSummary?.addEventListener('keydown', event => {
    if (event.key === 'Enter' || event.key === ' ') openMobileMenuFromKeyboard = true;
  });
  mobileMenu?.addEventListener('toggle', () => {
    if (mobileMenu.open && openMobileMenuFromKeyboard) {
      requestAnimationFrame(() => mobileMenu.querySelector<HTMLAnchorElement>('nav a')?.focus());
    }
    openMobileMenuFromKeyboard = false;
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && mobileMenu?.open) {
      mobileMenu.open = false;
      mobileMenuSummary?.focus();
    }
  }, { signal: appbarListeners.signal });
  document.addEventListener('pointerdown', event => {
    if (mobileMenu?.open && !mobileMenu.contains(event.target as Node)) mobileMenu.open = false;
  }, { signal: appbarListeners.signal });
  document.addEventListener('focusin', event => {
    if (mobileMenu?.open && !mobileMenu.contains(event.target as Node)) mobileMenu.open = false;
  }, { signal: appbarListeners.signal });
  });
</script>
