---
import Icon from './Icon.astro';
const { combineLists = true } = Astro.props;
---
<button class="appbar-icon-link quick-search-trigger" type="button" aria-label="Fast search" aria-haspopup="dialog" data-quick-search-open><Icon name="search" /></button>
<dialog class="quick-search-dialog" data-quick-search data-combined={combineLists ? 'yes' : 'no'} aria-labelledby="quick-search-heading">
  <h1 class="sr-only" id="quick-search-heading">Fast search</h1>
  <div class="quick-search-bar">
    <Icon name="search" />
    <label class="sr-only" for="quick-search-input">Search movies and series</label>
    <input id="quick-search-input" type="search" placeholder="Search movies and series…" autocomplete="off" spellcheck="false" />
    <button class="editor-icon-button" type="button" aria-label="Close search" data-quick-search-close><Icon name="close" /></button>
  </div>
  <div class="quick-search-progress" data-search-progress aria-hidden="true"></div>
  <p class="quick-search-state" data-search-state role="status" hidden></p>
  <p class="sr-only" data-search-announcement role="status"></p>
  <div class:list={['quick-search-results', {'combined': combineLists}]} aria-busy="false" hidden>
    <section class="quick-search-card" data-search-section="all" hidden><h2>Movies & Series</h2><div data-search-results="all"></div></section>
    <section class="quick-search-card" data-search-section="movie" hidden><h2>Movies</h2><div data-search-results="movie"></div></section>
    <section class="quick-search-card" data-search-section="series" hidden><h2>Series</h2><div data-search-results="series"></div></section>
  </div>
</dialog>

<script>
import { responsiveArtwork } from '../lib/responsive-artwork';

let pageListeners: AbortController;
document.addEventListener('astro:page-load', () => {
  pageListeners?.abort();
  pageListeners = new AbortController();
  type SearchResult = { id: number | null; tmdb_id?: number; type: 'movie' | 'series'; title: string; poster?: string | null; year?: string | null };
  const dialog = document.querySelector<HTMLDialogElement>('[data-quick-search]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-quick-search-open]');
  if (!dialog || !openButton) return;
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-quick-search-close]');
  const input = dialog?.querySelector<HTMLInputElement>('#quick-search-input');
  const resultShell = dialog?.querySelector<HTMLElement>('.quick-search-results');
  const state = dialog?.querySelector<HTMLElement>('[data-search-state]');
  const announcement = dialog?.querySelector<HTMLElement>('[data-search-announcement]');
  const progress = dialog?.querySelector<HTMLElement>('[data-search-progress]');
  let controller: AbortController | null = null;
  let timer = 0;
  let progressTimer = 0;
  let latest: Record<'movie'|'series', SearchResult[]> = { movie: [], series: [] };

  const resultUrl = (item: SearchResult) => item.id ? `/title/${item.id}` : `/discover-title?type=${item.type}&id=${item.tmdb_id}`;
  function interleave(first: SearchResult[], second: SearchResult[]) {
    const merged: SearchResult[] = [];
    for (let index = 0; index < Math.max(first.length, second.length); index++) {
      if (first[index]) merged.push(first[index]);
      if (second[index]) merged.push(second[index]);
    }
    return merged;
  }
  function unique(items: SearchResult[]) {
    const seen = new Set<string>();
    return items.filter(item => {
      const key = `${item.type}:${item.title.toLocaleLowerCase()}:${item.year || ''}`;
      if (seen.has(key)) return false;
      seen.add(key); return true;
    });
  }
  function resultNode(item: SearchResult) {
    const link = document.createElement('a');
    link.className = 'quick-search-result';
    link.href = resultUrl(item);
    const artwork = responsiveArtwork(item.poster, {
      size: 'w92',
      sizes: '(max-width: 650px) 52px, 48px',
      route: 'direct',
    });
    if (artwork?.src) {
      const poster = document.createElement('img');
      if (artwork.srcset) poster.srcset = artwork.srcset;
      if (artwork.sizes) poster.sizes = artwork.sizes;
      poster.src = artwork.src;
      poster.alt = ''; poster.loading = 'lazy';
      link.append(poster);
    } else {
      const fallback = document.createElement('span');
      fallback.className = 'quick-search-poster'; fallback.textContent = item.title.slice(0,1);
      link.append(fallback);
    }
    const copy = document.createElement('span');
    const name = document.createElement('strong'); name.textContent = item.title;
    const meta = document.createElement('small'); meta.textContent = [item.year, item.type === 'movie' ? 'Movie' : 'Series'].filter(Boolean).join(' · ');
    copy.append(name, meta); link.append(copy);
    return link;
  }
  function fill(kind: 'all'|'movie'|'series', items: SearchResult[]) {
    const target = dialog?.querySelector<HTMLElement>(`[data-search-results="${kind}"]`);
    if (!target) return;
    target.replaceChildren(...items.slice(0,8).map(resultNode));
  }
  function showState(message: string) {
    if (!state) return;
    state.textContent = message;
    state.hidden = !message;
  }
  function render() {
    fill('movie', latest.movie); fill('series', latest.series);
    fill('all', interleave(latest.movie, latest.series));
    const visible = dialog?.dataset.combined === 'yes'
      ? {all: latest.movie.length + latest.series.length > 0, movie: false, series: false}
      : {all: false, movie: latest.movie.length > 0, series: latest.series.length > 0};
    for (const kind of ['all','movie','series'] as const) {
      const section = dialog?.querySelector<HTMLElement>(`[data-search-section="${kind}"]`);
      if (section) section.hidden = !visible[kind];
    }
    if (resultShell) resultShell.hidden = !Object.values(visible).some(Boolean);
    showState(resultShell?.hidden ? 'No matching movies or series.' : '');
    if (announcement) announcement.textContent = resultShell?.hidden ? '' : `${latest.movie.length} movie and ${latest.series.length} series results.`;
  }
  async function search() {
    const query = input?.value.trim() || '';
    controller?.abort();
    if (resultShell) resultShell.hidden = true;
    if (announcement) announcement.textContent = '';
    if (query.length < 2) {
      latest = {movie:[],series:[]};
      showState(query ? 'Type one more character.' : '');
      fill('movie',[]); fill('series',[]); fill('all',[]);
      if (resultShell) resultShell.setAttribute('aria-busy','false');
      return;
    }
    const current = new AbortController();
    controller = current;
    if (resultShell) resultShell.setAttribute('aria-busy','true');
    showState('');
    clearTimeout(progressTimer);
    progressTimer=window.setTimeout(()=>{if(controller===current)progress?.classList.add('visible');},150);
    try {
      const request = (mediaType: 'movie'|'series') => fetch(`/api/proxy/tracking/catalog?${new URLSearchParams({media_type:mediaType,q:query})}`, {signal:current.signal}).then(response => {
        if (!response.ok) throw new Error(); return response.json();
      });
      const [movies, series] = await Promise.all([request('movie'), request('series')]);
      if (controller !== current) return;
      latest = { movie: unique(movies.results || []), series: unique(series.results || []) };
      render();
    } catch (cause) {
      if (controller === current && (cause as Error).name !== 'AbortError') showState('Search is unavailable. Try again.');
    } finally { if (controller === current) { clearTimeout(progressTimer);progress?.classList.remove('visible');resultShell?.setAttribute('aria-busy','false'); } }
  }
  function open() {
    if (matchMedia('(max-width:650px)').matches) return;
    clearTimeout(timer);
    clearTimeout(progressTimer);progress?.classList.remove('visible');
    controller?.abort();
    if (input) input.value = '';
    if (resultShell) resultShell.hidden = true;
    if (announcement) announcement.textContent = '';
    showState('');
    if (!dialog?.open) dialog?.showModal();
    requestAnimationFrame(() => input?.focus());
  }
  openButton?.addEventListener('click', open);
  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => { clearTimeout(timer);clearTimeout(progressTimer);progress?.classList.remove('visible');controller?.abort(); });
  input?.addEventListener('input', () => {
    clearTimeout(timer);clearTimeout(progressTimer);controller?.abort();controller=null;progress?.classList.remove('visible');
    if (resultShell) resultShell.hidden = true;
    if (announcement) announcement.textContent = '';
    showState('');
    timer = window.setTimeout(search, 180);
  });
  window.addEventListener('resize', () => { if (matchMedia('(max-width:650px)').matches && dialog?.open) dialog.close(); }, { signal: pageListeners.signal });
  document.addEventListener('keydown', event => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); open(); }
  }, { signal: pageListeners.signal });
});
</script>
