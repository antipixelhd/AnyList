---
import '../styles/stats-overview.css';
import '../styles/stats-genres.css';
import '../styles/stats-actors.css';
import Icon from './Icon.astro';
import ProfileSectionSelector from './ProfileSectionSelector.astro';
import ProfileStatsDomains from './ProfileStatsDomains.astro';
import StatsHeadlineLoading from './StatsHeadlineLoading.astro';
import {gameStatsSections} from '../lib/game-statistics-data';
const {username,owner=false}=Astro.props;
const screenSections=[['overview','Overview'],['genres','Genres'],['actors','Actors'],['studios','Studios'],['staff','Staff']];
---
{(['stats','stats/games'] as const).map(kind=><template data-profile-statistics-loading={kind}>
  <div data-profile-stats-preview>
    <section class="page-width stats-overview-page" style="min-height:60vh" aria-busy="true" aria-label="Loading statistics">
      <aside class="overview-sidebar" inert><button type="button" class="overview-menu-toggle" disabled aria-label="Statistics sections"><span>Statistics</span><Icon name="ellipsis"/></button><div id="statistics-sections"><ProfileSectionSelector heading="Statistics" ariaLabel="Statistics sections" options={(kind==='stats/games'?gameStatsSections:screenSections).map(([id,label])=>({id,label}))} active="overview" width="100%"/></div></aside>
      <div class="stats-overview-content">
        <ProfileStatsDomains {username} {owner} active={kind==='stats/games'?'game':'movies-series'}/>
        <header class="overview-heading"><h2>Overview</h2>{kind==='stats'&&<nav class="overview-media" aria-label="Statistics media type" inert>{['All','Movies','Series'].map((label,index)=><a aria-current={index===0?'page':undefined}>{label}</a>)}</nav>}</header>
        <StatsHeadlineLoading domain={kind==='stats/games'?'game':'screen'}/>
      </div>
    </section>
  </div>
</template>)}
