---
import Icon from '../Icon.astro';
import CalendarDateInput from '../CalendarDateInput.astro';
import NumberStepper from '../NumberStepper.astro';
import EditorSelect from '../EditorSelect.astro';
import PreviewSeasonDate from './PreviewSeasonDate.astro';
import {statuses} from '../../lib/tracking-statuses';
import {initialEntry} from './season-editor-state';
const {design} = Astro.props as {design:string};
const seasons = initialEntry().seasons;
---
<!-- Fixture version of TrackingEditor: the same shared controls, classes and field order. -->
<dialog class="editor season-preview-editor" id="season-preview-editor" aria-labelledby="sp-editor-title" data-motion-static data-design={design}>
  <div class="editor-hero">
    <img class="editor-backdrop" data-editor-backdrop alt=""/>
    <div class="editor-hero-shade"></div>
    <img class="editor-poster" data-editor-poster alt=""/>
    <div class="editor-heading"><span data-editor-kind>TV series</span><h2 id="sp-editor-title">Edit entry</h2></div>
    <div class="editor-hero-actions">
      <button type="button" class="editor-library editor-icon-button" data-action="library" aria-label="Add to library" aria-pressed="false"><Icon name="list"/></button>
      <label class="editor-favorite" title="Favorite"><input type="checkbox" name="favorite" form="sp-form" aria-label="Favorite"/><Icon name="heart"/></label>
      <button type="submit" form="sp-form" class="button-primary editor-save">Save</button>
    </div>
    <button type="button" class="editor-close editor-icon-button" data-action="close" aria-label="Close editor"><Icon name="close"/></button>
  </div>
  <form id="sp-form">
    <div class="editor-fields">
      <div class="editor-status-field"><label for="sp-status-trigger">Status</label><EditorSelect id="sp-status" name="status" label="Status" options={statuses} value="watching"/></div>
      <div class="editor-score-field"><label for="sp-score">Score</label><NumberStepper id="sp-score" name="score" label="Score" min={0} max={10} step={0.1} score/></div>
      <div class="editor-number-field sp-progress-field" data-series-only><label for="sp-progress">Episode progress</label><NumberStepper id="sp-progress" name="progress" label="Episode progress" max={62}/></div>
      <div class="editor-number-field sp-hours-field" data-game-only hidden><label for="sp-hours">Total time (hours)</label><NumberStepper id="sp-hours" name="hours" label="Total time in hours" step="any"/><div class="game-first-completion"><div class="game-field-heading"><label for="sp-first-hours">First completion</label><button type="button" class="game-value-button" data-action="first-hours">Add</button></div><div data-first-hours hidden><NumberStepper id="sp-first-hours" name="firstHours" label="First completion time in hours" step="any"/></div></div></div>
      <div class="editor-start-date"><label for="sp-start">Start date</label><CalendarDateInput id="sp-start" name="start" label="Start date"/></div>
      <div class="editor-finish-date"><label for="sp-finish">Finish date</label><CalendarDateInput id="sp-finish" name="finish" label="Finish date"/></div>
      <label class="editor-rewatches editor-number-field" for="sp-rewatches" data-watch-only>Total rewatches<NumberStepper id="sp-rewatches" name="rewatches" label="Total rewatches" max={10000}/></label>
      <div class="editor-number-field sp-replays-field" data-game-only hidden><label for="sp-replays">Replay count</label><NumberStepper id="sp-replays" name="replays" label="Replay count" max={2147483647}/></div>
      <section class="wide game-achievement-editor" data-game-only hidden><div class="game-field-heading"><span>Achievements</span><button type="button" class="game-value-button" data-action="achievements">Add</button></div><div class="sp-achievement-input" data-achievements hidden><NumberStepper id="sp-achievements" name="achievements" label="Achievement progress" max={67}/><span>/ 67</span></div></section>
      <label class="wide editor-notes">Notes<textarea name="notes" rows="2"></textarea></label>
      <details class="wide sp-seasons" data-series-only>
        <summary><span>Seasons</span><span class="sp-seasons-summary"><span data-season-count></span><Icon name="chevron-down"/></span></summary>
        <div class="sp-season-list">
          {seasons.map(season => design === 'drawers' ?
            <details class="sp-season-drawer" name="sp-season-drawer" data-season-row={season.number}>
              <summary><span class="sp-season-identity"><strong>Season {season.number}</strong><span data-season-progress={season.number}></span></span><span class="sp-drawer-date" data-date-label={season.number}></span><Icon name="chevron-down"/></summary>
              <div class="sp-drawer-body">
                <div class="editor-score-field"><label for={`sp-season-score-${season.number}`}>Score</label><NumberStepper id={`sp-season-score-${season.number}`} name={`season_score_${season.number}`} label={`Season ${season.number} score`} min={0} max={10} step={0.1} score/></div>
                <PreviewSeasonDate number={season.number}/>
                <button class="sp-season-complete sp-text" type="button" data-complete-season={season.number} aria-pressed="false"><Icon name="check"/><span>Complete season</span></button>
              </div>
            </details>
            : <div class:list={['sp-season-row',{'sp-inline-row':design==='rows-2'}]} data-season-row={season.number}>
                <button class="sp-icon sp-season-check" type="button" data-complete-season={season.number} aria-label={`Season ${season.number} completed`} aria-pressed="false"><Icon name="check"/></button>
                <div class="sp-season-identity"><strong>Season {season.number}</strong><span data-season-progress={season.number}></span></div>
                <div class="sp-season-score"><NumberStepper id={`sp-season-score-${season.number}`} name={`season_score_${season.number}`} label={`Season ${season.number} score`} min={0} max={10} step={0.1} score/></div>
                {design === 'rows-2' ? <PreviewSeasonDate number={season.number} inline/> : <>
                  <button class="sp-date-trigger" type="button" data-edit-season={season.number} aria-label={`Edit season ${season.number} finish date`} aria-expanded="false"><span data-date-label={season.number}></span><Icon name="calendar"/></button>
                  <div class="sp-expanded-date" data-expanded-date={season.number} hidden><PreviewSeasonDate number={season.number}/></div>
                </>}
              </div>
          )}
        </div>
        <div class="sp-season-footer"><button type="button" class="sp-text" data-action="complete-next"><Icon name="check"/><span data-next-label></span></button></div>
      </details>
    </div>
    <div class="editor-actions sp-editor-actions"><button type="button" class="editor-delete-button" data-action="delete"><Icon name="trash"/>Delete entry</button></div>
    <p class="sp-editor-feedback" role="status" aria-live="polite"></p>
  </form>
  <div class="sp-mobile-actions"><button class="sp-text" type="button" data-action="close">Cancel</button><button type="submit" form="sp-form" class="button-primary">Save</button></div>
</dialog>
