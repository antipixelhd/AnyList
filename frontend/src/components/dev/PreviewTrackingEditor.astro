---
import Icon from '../Icon.astro';
import CalendarDateInput from '../CalendarDateInput.astro';
import NumberStepper from '../NumberStepper.astro';
import EditorSelect from '../EditorSelect.astro';
import PreviewSeasonDate from './PreviewSeasonDate.astro';
import PreviewFinishDates from './PreviewFinishDates.astro';
import {statuses} from '../../lib/tracking-statuses';
import {initialEntry} from './season-editor-state';
const {design} = Astro.props as {design:string};
const seasons = initialEntry().seasons;
const integrated = design==='popover' || design==='expand';
---
<!-- Fixture version of TrackingEditor: the same shared controls, classes and field order. -->
<dialog class="editor season-preview-editor" id="season-preview-editor" aria-labelledby="sp-editor-title" data-motion-static data-design={design}>
  <div class="editor-hero">
    <div class="editor-artwork" aria-hidden="true">
      <img class="editor-backdrop" data-editor-backdrop alt=""/>
      <div class="editor-hero-shade"></div>
    </div>
    <img class="editor-poster" data-editor-poster alt=""/>
    <div class="editor-heading"><span data-editor-kind>TV series</span><h2 id="sp-editor-title">Edit entry</h2></div>
    <div class="editor-hero-actions">
      <button type="button" class="editor-library editor-icon-button" data-action="library" aria-label="Add to library" aria-pressed="false"><Icon name="list"/></button>
      <label class="editor-favorite" title="Favorite"><input type="checkbox" name="favorite" form="sp-form" aria-label="Favorite"/><Icon name="heart"/></label>
      <button type="submit" form="sp-form" class="button-primary editor-save">Save</button>
    </div>
    <button type="button" class="editor-close editor-icon-button" data-action="close" aria-label="Close editor"><Icon name="close"/></button>
  </div>
  <form id="sp-form">
    <div class="editor-fields">
      <div class="editor-status-field"><span class="editor-field-label" id="sp-status-label">Status</span><EditorSelect id="sp-status" name="status" label="Status" labelledBy="sp-status-label" options={statuses} value="watching"/></div>
      <div class="editor-score-field"><span class="editor-field-label" id="sp-score-label">Score</span><NumberStepper id="sp-score" name="score" label="Score" labelledBy="sp-score-label" min={0} max={10} step={0.1} score/></div>
      <div class="editor-number-field sp-progress-field" data-series-only><span class="editor-field-label" id="sp-progress-label">Episode progress</span><NumberStepper id="sp-progress" name="progress" label="Episode progress" labelledBy="sp-progress-label" max={62}/></div>
      <div class="editor-number-field sp-hours-field" data-game-only hidden><span class="editor-field-label" id="sp-hours-label">Total time (hours)</span><NumberStepper id="sp-hours" name="hours" label="Total time in hours" labelledBy="sp-hours-label" step="any"/><div class="game-first-completion"><div class="editor-field-heading"><span class="editor-field-label" id="sp-first-hours-label">First completion</span><button type="button" class="game-value-button" data-action="first-hours">Add</button></div><div data-first-hours hidden><NumberStepper id="sp-first-hours" name="firstHours" label="First completion time in hours" labelledBy="sp-first-hours-label" step="any"/></div></div></div>
      <div class="editor-start-date"><span class="editor-field-label" id="sp-start-label">Start date</span><CalendarDateInput id="sp-start" name="start" label="Start date" labelledBy="sp-start-label"/></div>
      <div class:list={['editor-finish-date',{'sp-integrated-finish':integrated}]} data-finish-field={integrated?design:undefined}>
        <div class="sp-finish-heading"><span class="editor-field-label" id="sp-finish-label">Finish date</span>{integrated && <button class="sp-finish-trigger" type="button" data-finish-trigger data-series-only aria-label="Season finish dates" aria-controls="sp-finish-seasons" aria-expanded="false"><span>Seasons</span><Icon name="chevron-down"/></button>}</div>
        <CalendarDateInput id="sp-finish" name="finish" label="Finish date" labelledBy="sp-finish-label"/>
        {integrated && <PreviewFinishDates design={design}/>}
      </div>
      <div class="editor-rewatches editor-number-field" data-watch-only><span class="editor-field-label" id="sp-rewatches-label">Total rewatches</span><NumberStepper id="sp-rewatches" name="rewatches" label="Total rewatches" labelledBy="sp-rewatches-label" max={10000}/></div>
      <div class="editor-number-field sp-replays-field" data-game-only hidden><span class="editor-field-label" id="sp-replays-label">Replay count</span><NumberStepper id="sp-replays" name="replays" label="Replay count" labelledBy="sp-replays-label" max={2147483647}/></div>
      <section class="wide game-achievement-editor" data-game-only hidden><div class="editor-field-heading"><span>Achievements</span><button type="button" class="game-value-button" data-action="achievements">Add</button></div><div class="sp-achievement-input" data-achievements hidden><NumberStepper id="sp-achievements" name="achievements" label="Achievement progress" max={67}/><span>/ 67</span></div></section>
      <div class="wide editor-notes"><span class="editor-field-label" id="sp-notes-label">Notes</span><textarea name="notes" rows="2" aria-labelledby="sp-notes-label"></textarea></div>
      <details class="wide sp-seasons" data-series-only>
        <summary><span>Seasons</span><span class="sp-seasons-summary"><span data-season-count></span><Icon name="chevron-down"/></span></summary>
        <div class="sp-season-list">
          {seasons.map(season => design === 'drawers' ?
            <details class="sp-season-drawer" name="sp-season-drawer" data-season-row={season.number}>
              <summary><span class="sp-season-identity"><strong>Season {season.number}</strong><span data-season-progress={season.number}></span></span><span class="sp-drawer-date" data-date-label={season.number}></span><Icon name="chevron-down"/></summary>
              <div class="sp-drawer-body">
                <div class="editor-score-field"><span class="editor-field-label">Score</span><NumberStepper id={`sp-season-score-${season.number}`} name={`season_score_${season.number}`} label={`Season ${season.number} score`} min={0} max={10} step={0.1} score/></div>
                <PreviewSeasonDate number={season.number}/>
                <button class="sp-season-complete sp-text" type="button" data-complete-season={season.number} aria-pressed="false"><Icon name="check"/><span>Complete season</span></button>
              </div>
            </details>
            : <div class:list={['sp-season-row',{'sp-inline-row':design==='rows-2','sp-rating-row':integrated}]} data-season-row={season.number}>
                <button class="sp-icon sp-season-check" type="button" data-complete-season={season.number} aria-label={`Season ${season.number} completed`} aria-pressed="false"><Icon name="check"/></button>
                <div class="sp-season-identity"><strong>Season {season.number}</strong><span data-season-progress={season.number}></span></div>
                <div class="sp-season-score"><NumberStepper id={`sp-season-score-${season.number}`} name={`season_score_${season.number}`} label={`Season ${season.number} score`} min={0} max={10} step={0.1} score/></div>
                {!integrated && (design === 'rows-2' ? <PreviewSeasonDate number={season.number} inline/> : <>
                  <button class="sp-date-trigger" type="button" data-edit-season={season.number} aria-label={`Edit season ${season.number} finish date`} aria-expanded="false"><span data-date-label={season.number}></span><Icon name="calendar"/></button>
                  <div class="sp-expanded-date" data-expanded-date={season.number} hidden><PreviewSeasonDate number={season.number}/></div>
                </>)}
              </div>
          )}
        </div>
        <div class="sp-season-footer"><button type="button" class="sp-text" data-action="complete-next"><Icon name="check"/><span data-next-label></span></button></div>
      </details>
    </div>
    <div class="editor-actions sp-editor-actions"><button type="button" class="editor-delete-button" data-action="delete"><Icon name="trash"/>Delete entry</button></div>
    <p class="sp-editor-feedback" role="status" aria-live="polite"></p>
  </form>
  <div class="sp-mobile-actions"><button class="sp-text" type="button" data-action="close">Cancel</button><button type="submit" form="sp-form" class="button-primary">Save</button></div>
</dialog>
