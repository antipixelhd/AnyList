---
import {requirementRows,type GameInfo} from '../lib/game-info-data';
interface Props {info?:GameInfo|null}
const {info}=Astro.props;
const groups=[['minimum','Minimum'],['recommended','Recommended']] as const;
---
<section class="lab-module game-requirements" data-game-requirements hidden={!groups.some(([part])=>requirementRows(info,part).length)} aria-labelledby="game-requirements-heading">
  <div class="lab-section-title"><h2 id="game-requirements-heading">PC requirements</h2><a class="lab-text-button" href={info?.steam_app_id?`https://store.steampowered.com/app/${info.steam_app_id}/#app_system_requirements`:undefined} hidden={!info?.steam_app_id} target="_blank" rel="noreferrer" data-game-requirements-source>Steam</a></div>
  <div class="game-requirements-grid">{groups.map(([part,name])=><div data-requirements-part={part} hidden={!requirementRows(info,part).length}><h3>{name}</h3><dl>{requirementRows(info,part).map(row=><div>{row.label&&<dt>{row.label}</dt>}<dd>{row.value}</dd></div>)}</dl></div>)}</div>
</section>
<style is:global>
  .game-requirements{grid-column:1/-1}
  .game-requirements-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}
  .game-requirements h3{font-size:1.2rem;font-weight:600;color:var(--lab-text);margin:0 0 12px}
  .game-requirements dl{display:grid;gap:12px;margin:0}
  .game-requirements dt{font-weight:600;color:var(--lab-text)}
  .game-requirements dd{margin:3px 0 0;color:var(--lab-muted);overflow-wrap:anywhere}
  .game-requirements :is(dt,dd){font-size:1.2rem;line-height:1.6}
  @media(max-width:650px){.game-requirements-grid{grid-template-columns:minmax(0,1fr);gap:24px}}
</style>
