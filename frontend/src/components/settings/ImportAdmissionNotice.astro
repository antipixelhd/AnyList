---
import type { ActiveImport } from '../../lib/import-admission';
interface Props { active: ActiveImport | null }
const { active } = Astro.props;
const resumed = !!active?.import_id && Astro.url.searchParams.get('import') === active.import_id;
---
<div data-import-admission hidden={!active || resumed} class="rounded-2xl bg-zinc-900/60 p-5">
  <p class="text-sm leading-relaxed text-zinc-300">Finish your <span data-import-admission-title class="font-semibold text-zinc-100">{active?.title}</span> before starting another.</p>
  <div class="mt-4 flex flex-wrap gap-3">
    <a data-import-admission-resume href={active?.resolve_url} class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-700">Resume import</a>
    <button data-import-admission-cancel type="button" class="cursor-pointer rounded-lg border border-zinc-700 bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-200 transition-colors hover:bg-zinc-700">Cancel import</button>
  </div>
</div>
