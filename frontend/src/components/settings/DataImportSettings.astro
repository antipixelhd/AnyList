---
import StreamingImport from "./StreamingImport.astro";
interface Props { hasTmdbKey: boolean }
const { hasTmdbKey } = Astro.props;
---

<section class="mb-10">
<h2 class="section-headline mb-5">Import from Streaming Service</h2>
<div class="space-y-3">{(["netflix", "amazon"] as const).map(service => <details class="streaming-service rounded-2xl bg-zinc-900/60" data-service={service}>
<summary class="flex cursor-pointer list-none items-center gap-4 rounded-2xl px-5 py-5 text-lg font-semibold transition-colors hover:bg-zinc-800/50">
{service === "netflix" ? <svg class="h-9 w-9 text-red-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 2h4l8 20h-4L6 2Zm0 0h4v20H6V2Zm8 0h4v20h-4V2Z"/></svg> : <svg class="h-9 w-9 text-sky-400" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 4 11 6-11 6V4Z" fill="currentColor"/><path d="M3 18c5 4 12 4 18-1m-4 0h4v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
<span>{service === "netflix" ? "Netflix" : "Amazon Prime Video"}</span><span class="ml-auto text-zinc-500" aria-hidden="true">⌄</span></summary>
<div class="px-4 pb-5 sm:px-5"><StreamingImport hasTmdbKey={hasTmdbKey} service={service} /></div></details>)}</div>
</section>

<!-- Import -->
<section>
  <h2 class="section-headline mb-4 border-b border-zinc-800 pb-2">Import</h2>
  <div class="flex items-center gap-1 mb-4 bg-zinc-900 border border-zinc-800 rounded-xl p-1 w-fit">
    <button type="button" data-import-tab="scrob" class="import-tab-btn px-4 py-1.5 rounded-lg text-sm font-semibold bg-blue-600 text-white transition-colors cursor-pointer active:scale-95 active:opacity-70">AnyList</button>
    <button type="button" data-import-tab="trakt" class="import-tab-btn px-4 py-1.5 rounded-lg text-sm font-medium text-zinc-400 transition-colors cursor-pointer active:scale-95 active:opacity-70">Trakt</button>
    <button type="button" data-import-tab="yamtrack" class="import-tab-btn px-4 py-1.5 rounded-lg text-sm font-medium text-zinc-400 transition-colors cursor-pointer active:scale-95 active:opacity-70">Yamtrack</button>
  </div>

  <div data-import-panel="scrob">
    <input type="file" id="scrob_export_file" accept=".zip" class="hidden" disabled={!hasTmdbKey} />
    <div
      id="scrob-import-dropzone"
      class:list={[
        "flex flex-col items-center justify-center gap-2 text-center border-2 border-dashed rounded-2xl px-6 py-10 transition-colors",
        hasTmdbKey ? "border-zinc-700 hover:border-zinc-600 cursor-pointer bg-zinc-900/40" : "border-zinc-800 bg-zinc-900/20 opacity-50 cursor-not-allowed",
      ]}
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-zinc-500">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
      </svg>
      <p class="text-sm text-zinc-300 font-medium">
        {hasTmdbKey ? "Drop an AnyList data export .zip here, or click to browse" : "TMDB Read Access Token is required for import"}
      </p>
      <p class="text-xs text-zinc-500">From <span class="text-zinc-400">Account settings → Export Data</span> on this or another AnyList account. Restores watch history, ratings, collection, lists, and comments.</p>
    </div>
    <div id="scrob-import-progress" class="hidden border border-zinc-800 rounded-2xl px-6 py-8 bg-zinc-900/40">
      <div class="flex justify-between items-center mb-2">
        <span id="scrob-import-label" class="text-sm font-semibold text-zinc-200">Importing…</span>
        <span id="scrob-import-pct" class="text-sm font-bold text-zinc-400"></span>
      </div>
      <div class="w-full bg-zinc-800 rounded-full h-2 overflow-hidden">
        <div id="scrob-import-bar" class="h-2 rounded-full transition-all duration-500 bg-blue-500 animate-pulse" style="width: 100%"></div>
      </div>
      <div class="flex justify-between text-xs text-zinc-500 mt-2">
        <span id="scrob-import-items"></span>
        <span id="scrob-import-status"></span>
      </div>
    </div>
  </div>

  <div data-import-panel="trakt" class="hidden">
    <input type="file" id="trakt_export_file" accept=".zip" class="hidden" disabled={!hasTmdbKey} />
    <div
      id="trakt-import-dropzone"
      class:list={[
        "flex flex-col items-center justify-center gap-2 text-center border-2 border-dashed rounded-2xl px-6 py-10 transition-colors",
        hasTmdbKey ? "border-zinc-700 hover:border-zinc-600 cursor-pointer bg-zinc-900/40" : "border-zinc-800 bg-zinc-900/20 opacity-50 cursor-not-allowed",
      ]}
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-zinc-500">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
      </svg>
      <p class="text-sm text-zinc-300 font-medium">
        {hasTmdbKey ? "Drop your Trakt export .zip here, or click to browse" : "TMDB Read Access Token is required for import"}
      </p>
      <p class="text-xs text-zinc-500">Get it from <span class="text-zinc-400">trakt.tv → Settings → Data → Export now</span>. Imports watched history, ratings, and lists — no VIP or API app needed.</p>
    </div>
    <div id="trakt-import-progress" class="hidden border border-zinc-800 rounded-2xl px-6 py-8 bg-zinc-900/40">
      <div class="flex justify-between items-center mb-2">
        <span id="trakt-import-label" class="text-sm font-semibold text-zinc-200">Importing…</span>
        <span id="trakt-import-pct" class="text-sm font-bold text-zinc-400"></span>
      </div>
      <div class="w-full bg-zinc-800 rounded-full h-2 overflow-hidden">
        <div id="trakt-import-bar" class="h-2 rounded-full transition-all duration-500 bg-red-500 animate-pulse" style="width: 100%"></div>
      </div>
      <div class="flex justify-between text-xs text-zinc-500 mt-2">
        <span id="trakt-import-items"></span>
        <span id="trakt-import-status"></span>
      </div>
    </div>
  </div>

  <div data-import-panel="yamtrack" class="hidden">
    <input type="file" id="yamtrack_export_file" accept=".csv" class="hidden" disabled={!hasTmdbKey} />
    <div
      id="yamtrack-import-dropzone"
      class:list={[
        "flex flex-col items-center justify-center gap-2 text-center border-2 border-dashed rounded-2xl px-6 py-10 transition-colors",
        hasTmdbKey ? "border-zinc-700 hover:border-zinc-600 cursor-pointer bg-zinc-900/40" : "border-zinc-800 bg-zinc-900/20 opacity-50 cursor-not-allowed",
      ]}
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-zinc-500">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
      </svg>
      <p class="text-sm text-zinc-300 font-medium">
        {hasTmdbKey ? "Drop a Yamtrack or Floppy .csv export here, or click to browse" : "TMDB Read Access Token is required for import"}
      </p>
      <p class="text-xs text-zinc-500">From <span class="text-zinc-400">Yamtrack's or Floppy's Export</span> page. Imports watch history, ratings, and comments — Floppy exports also bring in lists and collection.</p>
    </div>
    <div id="yamtrack-import-progress" class="hidden border border-zinc-800 rounded-2xl px-6 py-8 bg-zinc-900/40">
      <div class="flex justify-between items-center mb-2">
        <span id="yamtrack-import-label" class="text-sm font-semibold text-zinc-200">Importing…</span>
        <span id="yamtrack-import-pct" class="text-sm font-bold text-zinc-400"></span>
      </div>
      <div class="w-full bg-zinc-800 rounded-full h-2 overflow-hidden">
        <div id="yamtrack-import-bar" class="h-2 rounded-full transition-all duration-500 bg-green-500 animate-pulse" style="width: 100%"></div>
      </div>
      <div class="flex justify-between text-xs text-zinc-500 mt-2">
        <span id="yamtrack-import-items"></span>
        <span id="yamtrack-import-status"></span>
      </div>
    </div>
  </div>

</section>
