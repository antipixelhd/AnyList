---
import CalendarDateInput from '../CalendarDateInput.astro';
import Icon from '../Icon.astro';
import '../../styles/steam-import.css';
---
<section data-steam-settings class="steam-settings space-y-4">
  <h2 class="section-headline border-b border-zinc-800 pb-2">Games</h2>
  <div class="steam-connection space-y-4">
    <h3 class="font-medium text-zinc-100">Steam</h3>
    <div data-steam-connections class="space-y-4"></div>
    <form data-steam-connect class="space-y-4">
      <label class="block text-sm text-zinc-300">Public Steam profile
        <input name="profile" required maxlength="300" autocomplete="off" placeholder="SteamID64 or profile URL" class="mt-2 w-full rounded-lg bg-zinc-800 px-3 py-2.5 text-zinc-100" />
      </label>
      <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-zinc-300">
        <label><input type="checkbox" name="achievements" checked /> Achievement sync</label>
        <label><input type="checkbox" name="playtime" checked /> Playtime sync</label>
        <label><input type="checkbox" name="auto-add" /> Automatically add new games</label>
        <label><input type="checkbox" name="wishlist" /> Wishlist sync</label>
      </div>
      <button type="submit" class="steam-primary">Connect Steam</button>
    </form>
    <p data-steam-message role="status" class="steam-message" hidden></p>
  </div>
  <button data-steam-resume type="button" class="steam-primary" hidden>Continue Steam import</button>
  <dialog data-steam-dialog class="steam-workflow" data-layout="list" aria-labelledby="steam-import-heading">
    <header class="steam-workflow-header">
      <div><p class="steam-eyebrow">Steam import</p><h2 id="steam-import-heading" tabindex="-1" autofocus>Choose your games</h2></div>
      <div class="steam-header-actions">

        <button data-steam-later type="button" class="steam-icon-button" aria-label="Close Steam import"><Icon name="close" /></button>
      </div>
    </header>
    <div data-steam-review class="steam-review" hidden>
      <p data-steam-review-message class="steam-message" role="status" hidden></p>
      <div data-steam-loading class="steam-loading" hidden>
        <p>Loading your Steam library…</p><progress max="1" aria-label="Loading Steam library"></progress>
        <p data-steam-loading-count></p>
      </div>
      <div data-steam-picker class="steam-picker" hidden>
        <div data-steam-controls class="steam-controls">
          <div class="steam-toolbar">
            <label class="steam-search"><Icon name="search" /><input data-steam-search type="search" aria-label="Search Steam library" placeholder="Search your library…" autocomplete="off" spellcheck="false" /></label>
          </div>
          <div class="steam-utility">
          <div class="steam-view-tabs" role="group" aria-label="Show Steam games">
            <button data-steam-view-all type="button" aria-pressed="true">All <span data-steam-total></span></button>
            <button data-steam-view-selected type="button" aria-pressed="false">Selected <span data-steam-selected-total></span></button>
          </div>
          <label class="steam-sort"><span class="sr-only">Sort Steam games</span><select data-steam-sort aria-label="Sort Steam games"><option value="playtime">Most played</option><option value="alphabetical">Name A–Z</option><option value="completion">Achievement completion</option></select></label>
          </div>
          <div data-steam-rule-row class="steam-rule-row"><details class="steam-selection-rules">
            <summary><Icon name="sliders" /><span>Auto-select games</span><Icon name="chevron-down" class="steam-disclosure-arrow" /></summary>
            <div class="steam-rule-content">
              <p>Match either minimum. Your individual choices take priority.</p>
              <div class="steam-filters">
                <label class="steam-threshold"><span><input type="checkbox" data-steam-playtime-enabled checked /> Playtime</span><span><input aria-label="Minimum playtime in minutes" data-steam-minutes type="number" min="0" max="10000000" value="30" /> min</span></label>
                <label class="steam-threshold"><span><input type="checkbox" data-steam-achievements-enabled checked /> Achievements</span><input aria-label="Minimum achievements" data-steam-achievements type="number" min="0" max="50000" value="1" /></label>
              </div>
              <button type="button" data-steam-reset class="steam-text-button">Reset choices</button>
            </div>
          </details>
          <div data-steam-progress-region class="steam-progress" role="status"><span class="steam-spinner" aria-hidden="true"></span><span>Updating achievements</span><span data-steam-progress-label></span><progress data-steam-progress max="1" value="0" aria-label="Loading achievement details"></progress></div>        <div data-steam-layout-toggle class="steam-layout-toggle" role="group" aria-label="Import layout">
          <button data-steam-layout-grid type="button" class="steam-icon-button" aria-label="Grid view" title="Grid view" aria-pressed="false"><Icon name="grid" /></button>
          <button data-steam-layout-list type="button" class="steam-icon-button" aria-label="List view" title="List view" aria-pressed="true"><Icon name="list" /></button>
        </div></div>
          <p data-steam-results class="sr-only" role="status" aria-live="polite"></p>
        </div>
        <div data-steam-layout-bar class="steam-layout-bar" hidden></div>
        <div data-steam-scroll class="steam-library">
          <div data-steam-wishlist hidden>
            <p class="steam-message">Selected wishlist games are added to Planning.</p>
            <div class="steam-toolbar"><label class="steam-search"><Icon name="search" /><input data-steam-wishlist-search type="search" aria-label="Search Steam wishlist" placeholder="Search your wishlist…" autocomplete="off" /></label></div>
            <div class="steam-utility"><button type="button" data-steam-wishlist-all class="steam-text-button">Select all</button><button type="button" data-steam-wishlist-none class="steam-text-button">Deselect all</button></div>
            <p data-steam-wishlist-error role="status" class="steam-message" hidden></p>
            <button data-steam-wishlist-retry type="button" class="steam-text-button" hidden>Retry wishlist</button>
            <div data-steam-wishlist-grid class="steam-grid"></div>
            <p data-steam-wishlist-empty class="steam-message" hidden>Your wishlist is empty.</p>
            <button data-steam-wishlist-more type="button" class="steam-more steam-text-button" hidden>Show more games</button>
          </div>
          <div data-steam-grid class="steam-grid"></div><div data-steam-details class="steam-details" hidden></div><button data-steam-details-more type="button" class="steam-more steam-text-button" hidden>Show more games</button>
          <div data-steam-empty class="steam-empty" hidden><Icon name="search" /><h3>No games found</h3><p>Try another name.</p><button type="button" data-steam-clear-search class="steam-text-button">Clear search</button></div>
          <button data-steam-more type="button" class="steam-more steam-text-button" hidden>Show more games</button>
        </div>
        <footer class="steam-import-bar"><div><strong data-steam-selected></strong></div><div class="steam-footer-actions"><button data-steam-back type="button" class="steam-secondary" hidden>Back</button><button data-steam-next type="button" class="steam-primary">Continue <Icon name="arrow-right" /></button><button type="button" data-steam-import class="steam-primary" hidden>Import selected <Icon name="arrow-right" /></button></div></footer>
      </div>
      <button type="button" data-steam-retry class="steam-primary" hidden>Retry loading</button>
    </div>
  </dialog>
  <dialog data-steam-exit-dialog class="steam-exit-dialog" aria-labelledby="steam-exit-heading"><h2 id="steam-exit-heading">Leave Steam import?</h2><p>Your choices can be saved for later.</p><p data-steam-exit-error role="alert" hidden></p><div class="steam-exit-actions"><button data-steam-abort type="button" class="steam-abort">Abort import</button><button data-steam-keep-editing type="button" autofocus class="steam-secondary">Keep editing</button><button data-steam-save-exit type="button" class="steam-primary">Save & close</button></div></dialog>
  <template data-steam-date-template><CalendarDateInput id="steam-review-date" name="review_date" label="Completion date" /></template>
</section>
<script src="../../scripts/steam-settings.ts"></script>
