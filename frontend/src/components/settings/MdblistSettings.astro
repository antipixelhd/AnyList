---
import { connectionIconHtml } from "../../lib/connectionIcons";
import type { UserSettings } from "../../lib/api";

interface Props {
  settings: UserSettings;
  hasTmdbKey: boolean;
  autoSyncOptions: readonly { value: number; label: string }[];
}
const { settings, hasTmdbKey, autoSyncOptions } = Astro.props;
---

<div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
  <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="mdblist-body">
    <div class="flex items-center gap-4 pointer-events-none">
      <Fragment set:html={connectionIconHtml("mdblist")} />
      <div class="flex flex-col gap-0.5">
        <span class="font-medium text-zinc-200">MDBList</span>
        <span id="mdblist-conn-status" class="hidden text-xs font-normal px-1.5 py-0.5 rounded self-start pointer-events-auto"></span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      {settings.mdblist_connected && (
        <div class="flex gap-2" onclick="event.stopPropagation()">
          <button type="button" id="mdblist-disconnect-btn" class="js-action-btn text-sm bg-zinc-800 hover:bg-red-900/30 text-red-400 border border-zinc-700 hover:border-red-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">Disconnect</button>
        </div>
      )}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
  <div id="mdblist-progress" class="hidden border-t border-zinc-800 px-6 py-3">
    <div class="flex justify-between items-center mb-1.5">
      <span id="mdblist-job-label" class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Working…</span>
      <div class="flex items-center gap-3">
        <span id="mdblist-job-pct" class="text-xs font-bold text-zinc-400"></span>
        <button type="button" id="mdblist-job-cancel" class="hidden cursor-pointer text-xs font-semibold text-zinc-400 hover:text-red-400 border border-zinc-700 hover:border-red-500/50 px-2 py-0.5 rounded-md transition-colors">Cancel</button>
      </div>
    </div>
    <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
      <div id="mdblist-job-bar" class="h-1.5 rounded-full transition-all duration-500 bg-violet-500 animate-pulse" style="width: 100%"></div>
    </div>
    <div class="flex justify-between text-xs text-zinc-500 mt-1">
      <span id="mdblist-job-items"></span>
      <span id="mdblist-job-status"></span>
    </div>
  </div>
  <div id="mdblist-body" class="border-t border-zinc-800 hidden">
    <div class="grid md:grid-cols-2 gap-8 px-6 py-6">
      <div class="space-y-4">
        <div class="space-y-2">
          <label for="mdblist_api_key" class="block text-sm font-medium text-zinc-400">API Key</label>
          <div class="relative group/field">
            <input
              type="password"
              name="mdblist_api_key"
              id="mdblist_api_key"
              value={settings.mdblist_api_key || ""}
              placeholder="Your MDBList API key"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-violet-500 transition-all"
            />
            <button type="button" class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors" aria-label="Toggle password visibility">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
            </button>
          </div>
          <p class="text-xs text-zinc-500">You can get your MDBList API key <a href="https://mdblist.com/preferences/" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">here</a>. Save Settings validates it before storage.</p>
        </div>
      </div>
      <div class="space-y-4">
        {settings.mdblist_connected && (
          <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">MDBList → AnyList</p>
            {[
              { key: "mdblist_sync_watched", label: "Watched history" },
              { key: "mdblist_sync_ratings", label: "Ratings" },
              { key: "mdblist_sync_watchlist", label: "Watchlist" },
            ].map(({ key, label }) => (
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" name={key} id={key} checked={settings[key as keyof typeof settings] !== false} class="sync-pref-checkbox w-4 h-4 rounded accent-violet-500 cursor-pointer" />
                <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
              </label>
            ))}
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" name="mdblist_sync_dropped" id="mdblist_sync_dropped" checked={settings.mdblist_sync_dropped !== false} class="sync-pref-checkbox w-4 h-4 rounded accent-violet-500 cursor-pointer" />
              <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">Dropped shows</span>
            </label>
            <button
              type="button"
              data-action="sync_mdblist"
              disabled={!settings.mdblist_connected || !hasTmdbKey}
              title={!hasTmdbKey ? "TMDB Read Access Token is required for sync" : "Pull watched history, ratings, and watchlist from MDBList"}
              class="js-action-btn text-sm bg-violet-500/10 hover:bg-violet-500/20 text-violet-400 border border-violet-500/30 px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
            >Pull</button>
          </div>
        )}
        {settings.mdblist_connected && (
          <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">AnyList → MDBList</p>
            {[
              { key: "mdblist_push_watched", label: "Watched status" },
              { key: "mdblist_push_ratings", label: "Ratings" },
              { key: "mdblist_push_watchlist", label: "Watchlist" },
              { key: "mdblist_push_collection", label: "Collection" },
              { key: "mdblist_push_dropped", label: "Dropped shows" },
            ].map(({ key, label }) => (
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" name={key} id={key} checked={!!settings[key as keyof typeof settings]} class="sync-pref-checkbox w-4 h-4 rounded accent-violet-500 cursor-pointer" />
                <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
              </label>
            ))}
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" name="mdblist_scrobble" id="mdblist_scrobble" checked={!!settings.mdblist_scrobble} class="sync-pref-checkbox w-4 h-4 rounded accent-violet-500 cursor-pointer" />
              <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">Now watching</span>
            </label>
            <button
              type="button"
              data-action="push_mdblist"
              disabled={!settings.mdblist_connected}
              class="js-action-btn text-sm bg-violet-500/10 hover:bg-violet-500/20 text-violet-400 border border-violet-500/30 px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
              title="Push watched states, ratings, and the managed watchlist to MDBList"
            >Push</button>
          </div>
        )}
        {settings.mdblist_connected && (
          <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Scheduled Pull</p>
            <div class="flex items-center justify-between gap-4">
              <label class="text-sm text-zinc-300">Pull interval</label>
              <select name="mdblist_auto_sync_interval" class="bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-violet-500 transition-all cursor-pointer">
                <option value="" selected={!settings.mdblist_auto_sync_interval}>Disabled</option>
                {autoSyncOptions.map(({ value, label }) => (
                  <option value={String(value)} selected={settings.mdblist_auto_sync_interval === value}>{label}</option>
                ))}
              </select>
            </div>
          </div>
        )}
      </div>
    </div>
    <div class="border-t border-zinc-800 px-6 py-4 flex gap-2">
      <button type="button" data-action="save_mdblist_settings" class="js-action-btn text-sm bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors cursor-pointer">Save changes</button>
    </div>
  </div>
</div>
