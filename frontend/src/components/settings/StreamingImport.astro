---
import Icon from "../Icon.astro";
interface Props { hasTmdbKey: boolean; service: "netflix" | "amazon" }
const { hasTmdbKey, service } = Astro.props;
const serviceName = service === "amazon" ? "Amazon Prime Video" : "Netflix";
const extension = service === "amazon" ? ".zip" : ".csv";
---
    <div data-streaming-import data-service={service} data-service-name={serviceName} data-extension={extension} data-has-tmdb-key={String(hasTmdbKey)}>
      <template data-role="streaming-disclosure-arrow"><Icon name="chevron-down" class="streaming-disclosure-arrow" /></template>
      <input type="file" id={`${service}-streaming-import-file`} data-role="streaming-import-file" accept={extension} class="hidden" disabled={!hasTmdbKey} />
      <div id={`${service}-streaming-import-upload-controls`} data-role="streaming-import-upload-controls">
      <div id={`${service}-streaming-import-upload`} data-role="streaming-import-upload" class:list={[
        "flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed px-5 py-9 text-center transition-colors sm:px-6 sm:py-10",
        hasTmdbKey ? "cursor-pointer border-zinc-700 bg-zinc-900/40 hover:border-zinc-500" : "cursor-not-allowed border-zinc-800 bg-zinc-900/20 opacity-50",
      ]} role="button" tabindex={hasTmdbKey ? 0 : -1} aria-controls={`${service}-streaming-import-file`} aria-label={`Choose ${serviceName} viewing history`}>
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8 text-zinc-500"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z"/></svg>
        <p class="text-sm font-medium text-zinc-200">{hasTmdbKey ? `Drop your ${serviceName} ${extension} here, or click to browse` : "A TMDB Read Access Token is required for import"}</p>
        <p class="text-xs text-zinc-500">{service === "amazon" ? <>Request your Prime Video data from <a href="https://www.amazon.de/hz/privacy-central/data-requests/preview.html" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300">Amazon</a>, then upload the ZIP. It may take a couple of days.</> : <>Download all your <a href="https://www.netflix.com/settings/viewing-history" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300">Netflix viewing activity</a>.</>}</p>
      </div>
      <label for={`${service}-streaming-import-language`} class="mt-3 flex flex-col gap-1 text-xs text-zinc-500 sm:flex-row sm:items-center sm:gap-3">Export language <select id={`${service}-streaming-import-language`} data-role="streaming-import-language" class="w-fit rounded-lg border border-zinc-800 bg-zinc-950 px-2.5 py-1.5 text-xs text-zinc-300"><option value="auto">Detect automatically</option><option value="en">English</option><option value="de">Deutsch</option></select><span>English and German exports are supported.</span></label>
      <label class="mt-3 flex items-start gap-2 text-xs text-zinc-300"><input id={`${service}-streaming-skip-anime`} data-role="streaming-skip-anime" type="checkbox" checked disabled class="mt-0.5 h-4 w-4 accent-blue-500" /><span>Skip anime automatically <span class="block text-zinc-500">Required until AniList import or connection is supported.</span></span></label>
      </div>
      <section id={`${service}-streaming-import-workflow`} data-role="streaming-import-workflow" class="mt-5 hidden" aria-live="polite"></section>
      <dialog id={`${service}-streaming-remap-dialog`} data-role="streaming-remap-dialog" aria-labelledby={`${service}-streaming-remap-title`} class="quick-search-dialog streaming-remap-dialog">
        <h2 id={`${service}-streaming-remap-title`} data-role="streaming-remap-title" class="sr-only">Select a movie or series</h2>
        <div class="quick-search-bar">
          <span class="ui-icon" aria-hidden="true">⌕</span>
          <label class="sr-only" for={`${service}-streaming-remap-input`}>Search movies and series</label>
          <input id={`${service}-streaming-remap-input`} data-role="streaming-remap-input" type="search" placeholder="Search movies and series…" autocomplete="off" spellcheck="false" />
          <button id={`${service}-streaming-remap-close`} data-role="streaming-remap-close" class="editor-icon-button" type="button" aria-label="Close remap search">×</button>
          <div id={`${service}-streaming-remap-progress`} data-role="streaming-remap-progress" class="quick-search-progress" aria-hidden="true"></div>
        </div>
        <p id={`${service}-streaming-remap-state`} data-role="streaming-remap-state" class="quick-search-state" role="status" hidden></p>
        <div id={`${service}-streaming-remap-results`} data-role="streaming-remap-results" class="quick-search-results combined" hidden>
          <section class="quick-search-card"><div id={`${service}-streaming-remap-list`} data-role="streaming-remap-list"></div></section>
        </div>
      </dialog>
    </div>
