---
import { connectionIconHtml } from "../../lib/connectionIcons";
import type { UserSettings } from "../../lib/api";

interface Props {
  settings: UserSettings;
  hasTmdbKey: boolean;
}
const { settings, hasTmdbKey } = Astro.props;
---

<div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
  <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="trakt-body">
    <div class="flex items-center gap-4 pointer-events-none">
      <Fragment set:html={connectionIconHtml("trakt")} />
      <div class="flex flex-col gap-0.5">
        <span class="font-medium text-zinc-200">Trakt</span>
        <span id="trakt-conn-status" class="hidden text-xs font-normal px-1.5 py-0.5 rounded self-start pointer-events-auto"></span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <div class="flex gap-2" onclick="event.stopPropagation()">
        {settings.trakt_connected ? (
          <button type="button" id="trakt-disconnect-btn" class="js-action-btn text-sm bg-zinc-800 hover:bg-red-900/30 text-red-400 border border-zinc-700 hover:border-red-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">Disconnect</button>
        ) : (
          <button type="button" id="trakt-connect-btn" class="text-sm bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">Connect Trakt</button>
        )}
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
  <div id="trakt-progress" class="hidden border-t border-zinc-800 px-6 py-3">
    <div class="flex justify-between items-center mb-1.5">
      <span id="trakt-job-label" class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Working…</span>
      <div class="flex items-center gap-3">
        <span id="trakt-job-pct" class="text-xs font-bold text-zinc-400"></span>
      </div>
    </div>
    <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
      <div id="trakt-job-bar" class="h-1.5 rounded-full transition-all duration-500 bg-red-500 animate-pulse" style="width: 100%"></div>
    </div>
    <div class="flex justify-between text-xs text-zinc-500 mt-1">
      <span id="trakt-job-items"></span>
      <span id="trakt-job-status"></span>
    </div>
  </div>
  <div id="trakt-body" class="border-t border-zinc-800 hidden">
    <div class="grid md:grid-cols-2 gap-8 px-6 py-6">
      <!-- Left: Auth / Info -->
      <div class="space-y-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-400">Requires Trakt VIP</p>
        <div class="space-y-2">
          <label for="trakt_client_id" class="block text-sm font-medium text-zinc-400">Client ID</label>
          <input
            type="text"
            name="trakt_client_id"
            id="trakt_client_id"
            value={settings.trakt_client_id || ""}
            placeholder="Your Trakt application Client ID"
            class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
          />
        </div>
        <div class="space-y-2">
          <label for="trakt_client_secret" class="block text-sm font-medium text-zinc-400">Client Secret</label>
          <div class="relative group/field">
            <input
              type="password"
              name="trakt_client_secret"
              id="trakt_client_secret"
              value={settings.trakt_client_secret || ""}
              placeholder="Your Trakt application Client Secret"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
            />
            <button type="button" class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors" aria-label="Toggle password visibility">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
            </button>
          </div>
          <p class="text-xs text-zinc-500">Create a Trakt application at <span class="text-zinc-400">trakt.tv/oauth/applications</span> to get these credentials.</p>
        </div>
        <div id="trakt-auth-panel" class="hidden space-y-3 bg-zinc-900/50 border border-zinc-700 rounded-xl p-4">
          <p class="text-sm text-zinc-400">Go to <strong id="trakt-verify-url" class="text-zinc-100"></strong> and enter this code:</p>
          <div class="font-mono text-2xl font-bold tracking-widest text-zinc-100 bg-zinc-950 border border-zinc-700 rounded-lg px-4 py-3 text-center select-all" id="trakt-user-code"></div>
          <p class="text-xs text-zinc-500" id="trakt-auth-status">Waiting for authorization…</p>
        </div>
        <p class="text-sm text-zinc-400">
          {settings.trakt_connected
            ? "Trakt is connected. Use Pull to import your watched history and ratings."
            : "Enter your Client ID and Secret, then click Connect Trakt."}
        </p>
      </div>
      <!-- Right: Sync Preferences (only if connected) -->
      <div class="space-y-4">
        {settings.trakt_connected && (
          <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Trakt → AnyList</p>
            {[
              { key: "trakt_sync_watched", label: "Watched history" },
              { key: "trakt_sync_ratings", label: "Ratings" },
            ].map(({ key, label }) => (
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" name={key} id={key} checked={settings[key as keyof typeof settings] !== false} class="sync-pref-checkbox w-4 h-4 rounded accent-red-500 cursor-pointer" />
                <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
              </label>
            ))}
            <div>
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" name="trakt_sync_lists" id="trakt_sync_lists" checked={settings.trakt_sync_lists !== false} class="sync-pref-checkbox w-4 h-4 rounded accent-red-500 cursor-pointer" />
                <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">Lists</span>
              </label>
              <div id="trakt-watchlist-split-row" class:list={["ml-7 mt-2", !settings.trakt_sync_lists && "hidden"]}>
                <label class="flex items-center gap-3 cursor-pointer group">
                  <input type="checkbox" name="trakt_watchlist_split" id="trakt_watchlist_split" checked={!!settings.trakt_watchlist_split} class="sync-pref-checkbox w-4 h-4 rounded accent-red-500 cursor-pointer" />
                  <span class="text-sm text-zinc-400 group-hover:text-zinc-200 transition-colors">Split Watchlist into Movies / Shows</span>
                </label>
              </div>
            </div>
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" name="trakt_sync_dropped" id="trakt_sync_dropped" checked={settings.trakt_sync_dropped !== false} class="sync-pref-checkbox w-4 h-4 rounded accent-red-500 cursor-pointer" />
              <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">Dropped shows</span>
            </label>
            <div class="flex flex-wrap gap-2">
              <button
                type="button"
                data-action="full_sync_trakt"
                disabled={!hasTmdbKey}
                title={!hasTmdbKey ? "TMDB Read Access Token is required for sync" : "Scan all Trakt watch history again"}
                class="js-action-btn text-sm px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50 bg-zinc-900 hover:bg-zinc-800 text-zinc-400 border border-zinc-700"
              >Full resync</button>
            </div>
          </div>
        )}
        {settings.trakt_connected && (
          <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">AnyList → Trakt</p>
            {[
              { key: "trakt_push_watched", label: "Watched status" },
              { key: "trakt_push_ratings", label: "Ratings" },
              { key: "trakt_push_collection", label: "Collection" },
              { key: "trakt_push_lists", label: "Lists" },
              { key: "trakt_push_dropped", label: "Dropped shows" },
            ].map(({ key, label }) => (
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" name={key} id={key} checked={!!settings[key as keyof typeof settings]} class="sync-pref-checkbox w-4 h-4 rounded accent-red-500 cursor-pointer" />
                <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
              </label>
            ))}
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" name="trakt_scrobble" id="trakt_scrobble" checked={!!settings.trakt_scrobble} class="sync-pref-checkbox w-4 h-4 rounded accent-red-500 cursor-pointer" />
              <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">Now watching</span>
            </label>
            <button
              type="button"
              data-action="push_trakt"
              class="js-action-btn text-sm bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
              title="Push all watched states and ratings from AnyList to Trakt"
            >Push</button>
          </div>
        )}

      </div>
    </div>
    <div class="border-t border-zinc-800 px-6 py-4 flex gap-2">
      <button type="button" data-action="save_trakt_settings" class="js-action-btn text-sm bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors cursor-pointer">Save changes</button>
    </div>
  </div>
</div>
