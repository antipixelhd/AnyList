---
import { connectionIconHtml } from "../../lib/connectionIcons";
import type { UserSettings } from "../../lib/api";

interface Props {
  settings: UserSettings;
  hasTmdbKey: boolean;
  autoSyncOptions: readonly { value: number; label: string }[];
}
const { settings, hasTmdbKey, autoSyncOptions } = Astro.props;
---

<div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
  <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="simkl-body">
    <div class="flex items-center gap-4 pointer-events-none">
      <Fragment set:html={connectionIconHtml("simkl")} />
      <div class="flex flex-col gap-0.5">
        <span class="font-medium text-zinc-200">Simkl</span>
        <span id="simkl-conn-status" class="hidden text-xs font-normal px-1.5 py-0.5 rounded self-start pointer-events-auto"></span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <div class="flex gap-2" onclick="event.stopPropagation()">
        {settings.simkl_connected ? (
          <button type="button" id="simkl-disconnect-btn" class="js-action-btn text-sm bg-zinc-800 hover:bg-red-900/30 text-red-400 border border-zinc-700 hover:border-red-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">Disconnect</button>
        ) : (
          <button type="button" id="simkl-connect-btn" class="text-sm bg-teal-500/10 hover:bg-teal-500/20 text-teal-400 border border-teal-500/30 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">Connect Simkl</button>
        )}
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
  <div id="simkl-progress" class="hidden border-t border-zinc-800 px-6 py-3">
    <div class="flex justify-between items-center mb-1.5">
      <span id="simkl-job-label" class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Working…</span>
      <div class="flex items-center gap-3">
        <span id="simkl-job-pct" class="text-xs font-bold text-zinc-400"></span>
        <button type="button" id="simkl-job-cancel" class="hidden cursor-pointer text-xs font-semibold text-zinc-400 hover:text-red-400 border border-zinc-700 hover:border-red-500/50 px-2 py-0.5 rounded-md transition-colors">Cancel</button>
      </div>
    </div>
    <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
      <div id="simkl-job-bar" class="h-1.5 rounded-full transition-all duration-500 bg-blue-600 animate-pulse" style="width: 100%"></div>
    </div>
    <div class="flex justify-between text-xs text-zinc-500 mt-1">
      <span id="simkl-job-items"></span>
      <span id="simkl-job-status"></span>
    </div>
  </div>
  <div id="simkl-body" class="border-t border-zinc-800 hidden">
    <div class="grid md:grid-cols-2 gap-8 px-6 py-6">
      <!-- Left: Auth / Info -->
      <div class="space-y-4">
        <div class="space-y-2">
          <label for="simkl_client_id" class="block text-sm font-medium text-zinc-400">Client ID</label>
          <input
            type="text"
            name="simkl_client_id"
            id="simkl_client_id"
            value={settings.simkl_client_id || ""}
            placeholder="Your Simkl application Client ID"
            class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-teal-500 transition-all"
          />
          <p class="text-xs text-zinc-500">Create a Simkl application at <span class="text-zinc-400">simkl.com/settings/developer</span> to get your Client ID.</p>
        </div>
        <div id="simkl-auth-panel" class="hidden space-y-3 bg-zinc-900/50 border border-zinc-700 rounded-xl p-4">
          <p class="text-sm text-zinc-400">Go to <strong id="simkl-verify-url" class="text-zinc-100"></strong> and enter this PIN:</p>
          <div class="font-mono text-2xl font-bold tracking-widest text-zinc-100 bg-zinc-950 border border-zinc-700 rounded-lg px-4 py-3 text-center select-all" id="simkl-user-code"></div>
          <p class="text-xs text-zinc-500" id="simkl-auth-status">Waiting for authorization…</p>
        </div>
        <p class="text-sm text-zinc-400">
          {settings.simkl_connected
            ? "Simkl is connected. Use Pull to import your watched history and ratings."
            : "Enter your Client ID, then click Connect Simkl."}
        </p>
      </div>
      <!-- Right: Sync Preferences (only if connected) -->
      {settings.simkl_connected && (
        <div class="space-y-4">
          <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Simkl → AnyList</p>
            {[
              { key: "simkl_sync_watched", label: "Watched history" },
              { key: "simkl_sync_ratings", label: "Ratings" },
              { key: "simkl_sync_lists",   label: "Lists / Watchlist" },
            ].map(({ key, label }) => (
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" name={key} id={key} checked={settings[key as keyof typeof settings] !== false} class="sync-pref-checkbox w-4 h-4 rounded accent-teal-500 cursor-pointer" />
                <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
              </label>
            ))}
            <button
              type="button"
              data-action="sync_simkl"
              disabled={!hasTmdbKey}
              title={!hasTmdbKey ? "TMDB Read Access Token is required for sync" : "Pull watched history and ratings from Simkl"}
              class={`js-action-btn text-sm px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50 ${hasTmdbKey ? "bg-teal-500/10 hover:bg-teal-500/20 text-teal-400 border border-teal-500/30" : "bg-zinc-800 text-zinc-400 border border-zinc-700 opacity-50"}`}
            >Pull</button>
          </div>
          <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">AnyList → Simkl</p>
            {[
              { key: "simkl_push_watched", label: "Watched status" },
              { key: "simkl_push_ratings", label: "Ratings" },
            ].map(({ key, label }) => (
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" name={key} id={key} checked={!!settings[key as keyof typeof settings]} class="sync-pref-checkbox w-4 h-4 rounded accent-teal-500 cursor-pointer" />
                <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
              </label>
            ))}
            <label class="flex items-center gap-3 cursor-pointer group">
              <input type="checkbox" name="simkl_scrobble" id="simkl_scrobble" checked={!!settings.simkl_scrobble} class="sync-pref-checkbox w-4 h-4 rounded accent-teal-500 cursor-pointer" />
              <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">
                Now watching <span class="text-zinc-500 text-xs">(live checkin on play/stop)</span>
              </span>
            </label>
            <button
              type="button"
              data-action="push_simkl"
              class="js-action-btn text-sm bg-teal-500/10 hover:bg-teal-500/20 text-teal-400 border border-teal-500/30 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
              title="Push all watched states and ratings from AnyList to Simkl"
            >Push</button>
          </div>
          <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Scheduled Pull</p>
            <div class="flex items-center justify-between gap-4">
              <label class="text-sm text-zinc-300">Pull interval</label>
              <select name="simkl_auto_sync_interval" class="bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-teal-500 transition-all cursor-pointer">
                <option value="" selected={!settings.simkl_auto_sync_interval}>Disabled</option>
                {autoSyncOptions.map(({ value, label }) => (
                  <option value={String(value)} selected={settings.simkl_auto_sync_interval === value}>{label}</option>
                ))}
              </select>
            </div>
          </div>
        </div>
      )}
    </div>
    <div class="border-t border-zinc-800 px-6 py-4 flex gap-2">
      <button type="button" data-action="save_simkl_settings" class="js-action-btn text-sm bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors cursor-pointer">Save changes</button>
    </div>
  </div>
</div>
