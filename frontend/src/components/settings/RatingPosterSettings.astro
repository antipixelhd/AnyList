---
import Icon from '../Icon.astro';
import type { UserSettings } from '../../lib/api';
interface Props { settings: UserSettings }
const { settings } = Astro.props;
---
      <!-- Rating posters -->
      <section>
        <div class="flex items-center justify-between mb-4 border-b border-zinc-800 pb-2">
          <h2 class="section-headline">Rating posters</h2>
        </div>
        <form id="settings-form" class="space-y-6">
          <div class="space-y-6 max-w-xl">
          <!-- RPDB API Key -->
          <div class="space-y-2">
            <label for="rpdb_api_key" class="block text-sm font-medium text-zinc-400">RPDB API Key</label>
            <p class="text-xs"><a href="https://ratingposterdb.com/login" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">Open your RPDB API key</a></p>
            <div class="flex gap-2">
              <div class="relative flex-1 group/field">
                <input
                  type="password"
                  name="rpdb_api_key"
                  id="rpdb_api_key"
                  value={settings.rpdb_api_key || ""}
                  maxlength="255"
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle password visibility"
                >
                  <Icon name="eye" class="w-5 h-5 eye-icon" />
                  <Icon name="eye-slash" class="w-5 h-5 eye-slash-icon hidden" />
                </button>
              </div>
              <button
                type="button"
                data-action="test_rpdb"
                title="Test RPDB key"
                aria-label="Test RPDB key"
                class="js-action-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
              >
                Test
              </button>
            </div>
            <div class="text-xs text-zinc-500 space-y-1">
              <p>Leave blank to use original artwork.</p>
              <p>Manage poster styles in the <a href="https://manager.ratingposterdb.com/" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">RPDB manager</a>.</p>
            </div>
          </div>
          </div>

          <div class="pt-6">
            <button
              id="save-settings-btn"
              type="submit"
              class="w-full sm:w-auto button-primary font-bold px-8 py-3 rounded-xl transition-colors cursor-pointer disabled:opacity-50"
            >
              Save key
            </button>
          </div>
        </form>
      </section>


<script>
  import { showMessage, errorMessage } from '../../lib/settings-feedback';
  function setup() {
    const form = document.querySelector<HTMLFormElement>('#settings-form');
    const input = document.querySelector<HTMLInputElement>('#rpdb_api_key');
    const save = document.querySelector<HTMLButtonElement>('#save-settings-btn');
    const test = document.querySelector<HTMLButtonElement>('[data-action="test_rpdb"]');
    if (!form || !input || !save || !test || form.dataset.initialized) return;
    form.dataset.initialized = 'true';
    let saved = input.value.trim();
    let saving = false;
    const update = () => { save.disabled = saving || input.value.trim() === saved; };
    input.addEventListener('input', update);
    update();
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (save.disabled) return;
      const value = input.value.trim();
      saving = true;
      update();
      save.textContent = 'Saving…';
      try {
        const response = await fetch('/api/proxy/auth/settings', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rpdb_api_key: value || null }) });
        const data = await response.json();
        if (!response.ok) throw new Error(typeof data.detail === 'string' ? data.detail : 'Could not save poster settings.');
        saved = value;
        showMessage('Poster settings saved.');
      } catch (error) { showMessage(errorMessage(error), 'error'); }
      finally { saving = false; save.textContent = 'Save key'; update(); }
    });
    test.addEventListener('click', async () => {
      test.disabled = true;
      test.textContent = 'Testing…';
      try {
        const response = await fetch('/api/proxy/auth/test-rpdb', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key: input.value.trim() }) });
        const data = await response.json();
        if (!response.ok || data.success !== true) throw new Error(typeof data.detail === 'string' ? data.detail : 'RPDB could not validate this key.');
        showMessage(data.message || 'RPDB key is valid.');
      } catch (error) { showMessage(errorMessage(error), 'error'); }
      finally { test.disabled = false; test.textContent = 'Test'; }
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
