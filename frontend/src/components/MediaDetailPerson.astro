---
import Icon from './Icon.astro';
import type {DetailPerson} from '../lib/media-detail-data';
const {person} = Astro.props as {person:DetailPerson};
const Tag = person.url ? 'a' : 'div';
---
<Tag class="lab-person" href={person.url || undefined}>
  {person.image ? <img src={person.image} alt="" loading="lazy"/> : <span class="lab-person-initials" aria-hidden="true"><Icon name={person.kind === 'studio' ? 'film' : 'user'}/></span>}
  <div><h3>{person.name}</h3><p>{person.characters.length ? person.characters.join(' / ') : person.roles.join(', ')}</p></div>
</Tag>
