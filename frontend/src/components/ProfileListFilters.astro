---
import Icon from './Icon.astro';
import ListFilterSelect from './ListFilterSelect.astro';
import type {CategoryPresentation} from '../lib/list-categories.ts';
interface Props {
  categoryPresentation?: CategoryPresentation;
  categoryOwner?: boolean;
  statuses: ReadonlyArray<readonly [string,string]>;
  counts?: Record<string,number>;
  genres: string[];
  years: string[];
  status?: string;
  sort?: string;
  defaultSort?: string;
  query?: string;
  genre?: string;
  year?: string;
  favorites?: boolean;
  progressLabel?: string;
  pending?: boolean;
}
const {statuses,counts={},genres,years,status='all',sort='title',defaultSort='title',query='',genre='',year='',favorites=false,progressLabel='Progress',pending=false}=Astro.props;
const {categoryPresentation,categoryOwner=false}=Astro.props;
const availableYears=[...years].sort();
const yearPosition=year?availableYears.indexOf(year)+1:0;
const id=(name:string)=>pending?`pending-${name}`:name;
---
<aside class="filters" id={id('list-filters')} aria-label="List filters" inert={pending}>
  <form method="GET" class="list-filter-form" data-list-filter-form>
    <input type="hidden" name="status" value={status==='all'?'':status}/>
    <input type="hidden" name="year" value={year} data-list-selected-year/>
    <div class="list-filter-search-row">
      <label class="filter-search"><Icon name="search"/><input id={id('list-search')} name="q" type="search" value={query} placeholder="Filter titles" aria-label="Search this list" maxlength="200"/></label>
      <button type="button" class="mobile-filter-toggle" aria-label="Filters and sorting" aria-expanded="false" aria-controls={id('list-filter-panel')}><Icon name="ellipsis"/></button>
    </div>
    <div class="list-filter-panel" id={id('list-filter-panel')}>
      <div class="category-heading"><h2>Lists</h2>{categoryPresentation&&<div data-category-controls>{categoryOwner&&<><button type="button" class="category-icon" data-category-mode="reorder" aria-label="Reorder categories" title="Reorder categories" aria-pressed="false"><Icon name="sort"/></button><button type="button" class="category-icon" data-category-mode="edit" aria-label="Edit categories" title="Edit categories" aria-pressed="false"><Icon name="edit"/></button></>}<button type="button" class="category-icon" data-category-mode="info" aria-label="Category meanings" title="Category meanings"><Icon name="info"/></button></div>}</div>
      {categoryPresentation&&<div data-category-editor hidden><template data-category-restore-icon><Icon name="undo"/></template><div data-category-edit-rows></div><div class="category-edit-actions"><button type="button" class="lab-text-button" data-category-save>Save</button><button type="button" class="lab-text-button" data-category-cancel>Cancel</button></div><p class="error-message" role="alert" hidden></p></div>}
      <div class="status-filters">{[['all','All'],...statuses].map(([value,label])=><button type="button" data-status={value} class:list={{selected:status===value}} aria-pressed={status===value} hidden={categoryPresentation?.categories.find(category=>category.id===value)?.hidden}><span data-category-filter-label>{label}</span>{pending?<span class="loading-surface pending-list-count" aria-hidden="true"></span>:<span data-list-status-count={value}>{value==='all'?Object.values(counts).reduce((sum,count)=>sum+count,0):counts[value]||0}</span>}</button>)}</div>
      <h2>Filters</h2>
      <ListFilterSelect id={id('genre-filter')} name="genre" label="Genre" value={genre} options={[["","All genres"],...genres.map((value):[string,string]=>[value,value])]}/>
      <label class="filter-year filter-control"><span class="filter-year-heading"><span>Year</span><output id={id('year-value')} for={id('year-filter')}>{year||'Any year'}</output></span><input id={id('year-filter')} type="range" min="0" max={availableYears.length} step="1" value={yearPosition} data-years={JSON.stringify(availableYears)} aria-label="Release year" aria-valuetext={year||'Any year'} disabled={!availableYears.length}/></label>
      <ListFilterSelect id={id('favorite-filter')} name="favorites" label="Favorites" value={favorites?'true':''} options={[["","All entries"],["true","Favorites only"]]}/>
      <h2>Sort</h2>
      <ListFilterSelect id={id('sort-filter')} name="sort" label="Order" value={sort} options={[["title","Title"],["score","Score"],["progress",progressLabel],["updated","Recently updated"]]}/>
      <button type="button" class="button-secondary" id={id('reset-filters')} data-default-sort={defaultSort} disabled={pending}>Reset filters</button>
    </div>
  </form>
</aside>
