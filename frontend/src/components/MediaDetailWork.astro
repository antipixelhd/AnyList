---
import Icon from './Icon.astro';
import {detailWorkCaption, relationLabel} from '../lib/media-detail-data';
import {detailWorkArtwork} from '../lib/detail-artwork';
const {work, similar = false} = Astro.props;
const artwork = detailWorkArtwork(work.poster, similar, Astro.locals.imageCacheEnabled ? 'proxy' : 'direct');
---
<a href={work.url} class={similar ? undefined : 'lab-related-card'}>
  {artwork ? <img {...artwork} alt="" loading="lazy" fetchpriority="low"/> : <span class="media-work-placeholder" aria-hidden="true"><Icon name="film"/></span>}
  <div>{!similar && <span class="lab-relation-type">{work.label || relationLabel(work.relation,work.reverse)}</span>}<h3>{work.title}</h3><p>{detailWorkCaption(work,similar)}</p></div>
  {similar && <Icon name="arrow-right"/>}
</a>
