<script>
    // ── PWA install prompt ─────────────────────────────────────────────────────
    const DISMISS_KEY = 'pwa-install-dismissed';
    const DISMISS_TTL = 7 * 24 * 60 * 60 * 1000; // 7 days

    const banner   = document.getElementById('pwa-banner')!;
    const msgEl    = document.getElementById('pwa-banner-msg')!;
    const installWrap = document.getElementById('pwa-install-wrap')!;
    const installBtn  = document.getElementById('pwa-install-btn')!;
    const dismissBtn  = document.getElementById('pwa-dismiss')!;

    // Don't show if already running as installed PWA
    const isInstalled = window.matchMedia('(display-mode: standalone)').matches
      || (navigator as any).standalone === true;

    const wasDismissed = (() => {
      const val = localStorage.getItem(DISMISS_KEY);
      return val ? Date.now() - Number(val) < DISMISS_TTL : false;
    })();

    function showBanner() {
      if (isInstalled || wasDismissed) return;
      banner.classList.remove('hidden');
    }

    function dismiss() {
      banner.classList.add('hidden');
      localStorage.setItem(DISMISS_KEY, String(Date.now()));
    }

    dismissBtn.addEventListener('click', dismiss);

    // ── Android / desktop Chrome: use beforeinstallprompt ─────────────────────
    let deferredPrompt: any = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      installWrap.classList.remove('hidden');
      setTimeout(showBanner, 2000);
    });

    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      deferredPrompt = null;
      if (outcome === 'accepted') {
        banner.classList.add('hidden');
      }
    });

    window.addEventListener('appinstalled', () => {
      banner.classList.add('hidden');
      deferredPrompt = null;
    });

    // ── iOS Safari: no beforeinstallprompt — show manual instructions ─────────
    // iPadOS 13+ spoofs a desktop Mac UA, so also check for Mac + touch support
    const isIos = /iphone|ipad|ipod/i.test(navigator.userAgent)
      || (navigator.userAgent.includes('Mac') && navigator.maxTouchPoints > 1);
    const isInStandaloneMode = (navigator as any).standalone === true;

    if (isIos && !isInStandaloneMode) {
      msgEl.textContent = 'Tap the Share button, then "Add to Home Screen".';
      setTimeout(showBanner, 2000);
    }
  </script>
