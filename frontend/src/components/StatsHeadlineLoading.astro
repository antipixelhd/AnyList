---
import Icon from './Icon.astro';
interface Props {domain?:'screen'|'game';media?:string;hidden?:boolean}
const {domain='screen',media='all',hidden=false}=Astro.props;
const labels=domain==='game'?['Total games','Completed games','Hours recorded','Mean score','Achievement progress','Achievements unlocked']:['Total titles',media==='movie'?'Movies watched':'Episodes watched','Days watched','Days planned','Mean score','Standard deviation'];
const icons=domain==='game'?['display','check','hourglass','star','percent','list']:['display','play','calendar','hourglass','percent','divide'];
---
<dl class="overview-totals" data-stats-headline-loading {hidden} aria-label="Loading statistics" aria-busy="true">
  {labels.map((label,index)=><div><dt><span class="overview-total-icon" aria-hidden="true"><Icon name={icons[index]}/></span><span>{label}</span></dt><dd><span class="stats-headline-placeholder" aria-hidden="true"></span></dd></div>)}
</dl>
<style is:global>
  .overview-totals[data-stats-headline-loading][hidden] { display:none; }
  .stats-headline-placeholder { display:inline-block; width:3ch; height:.85em; vertical-align:baseline; border-radius:4px; background:color-mix(in srgb,var(--stats-cyan) 18%,var(--panel)); }
</style>
