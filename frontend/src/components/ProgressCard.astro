---
const {entry} = Astro.props;
const season=entry.progress_season;
const name=season?`${entry.title} - ${season.name}`:entry.title;
const behind=(season?.released??entry.released_episodes)-(season?.watched??entry.progress);
---
<article class={entry.airing?'progress-card airing':'progress-card'} data-progress-card data-detail-kind="series" data-media-id={entry.id} data-progress={entry.progress} data-released={entry.released_episodes??''} data-season-position={entry.season_position||''} data-season-scoped={String(!!season)} data-next-watch={season?.next_watch_id} data-next-air={entry.next_release_date||''} data-next-air-at={entry.next_release_at||''}>
        <a class="progress-card-poster" href={`/title/${entry.id}`} aria-label={`View ${entry.title}`}>
          <img src={entry.artwork?.src} srcset={entry.artwork?.srcset} sizes={entry.artwork?.sizes} data-artwork-path={season?.poster||entry.poster||''} alt="" loading="lazy"/>
          {entry.airing&&<span class="progress-card-airing-label"><span data-countdown></span></span>}
          {entry.airing&&<span class="progress-card-catchup" data-catchup-bar data-caught-up={String(entry.caughtUp)} data-known={String(entry.released_episodes!==undefined)} aria-hidden="true"></span>}
        </a>
        <button class="progress-card-quick-action" type="button" data-progress-action={entry.id} data-next-progress={entry.progress+1} disabled={!entry.canIncrement} aria-label={entry.canIncrement?`Mark next episode of ${entry.title} watched`:entry.caughtUp?`${entry.title} is caught up`:`Progress unavailable for ${entry.title}`}>
          <span data-current-position>{season?.position||entry.season_position||'0'}</span>{entry.canIncrement&&<span class="progress-card-plus" aria-hidden="true">+</span>}
        </button>
        <div class="progress-card-details" aria-label={`${name} progress`}>
          <strong class="progress-card-behind" data-episodes-behind>{behind>0?`${behind} ${behind===1?'episode':'episodes'} behind`:entry.released_episodes!=null?'Caught up':'Progress unavailable'}</strong>
          <a class="progress-card-title" href={`/title/${entry.id}`}>{name}</a>
          <span class="progress-card-progress-label">Progress: <span data-progress-count>{season?.watched??entry.progress}</span>/<span data-released-count>{season?.released??entry.released_episodes??'?'}</span></span>
        </div>
      </article>
