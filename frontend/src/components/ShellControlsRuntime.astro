<script>
    import { showMenu, hideMenu } from '../lib/ui-motion';
    import { wirePasswordToggles } from '../lib/password-toggle';
    wirePasswordToggles();
    // ── Theme toggle ───────────────────────────────────────────────────────────
    const themeToggle = document.getElementById('theme-toggle');

    const themeColorMeta = document.getElementById('theme-color-meta') as HTMLMetaElement | null;
    const syncThemeColor = () => {
      const isLight = document.documentElement.classList.contains('light');
      if (themeColorMeta) themeColorMeta.content = isLight ? '#f9fafb' : '#09090b';
    };
    syncThemeColor();

    themeToggle?.addEventListener('click', () => {
      document.documentElement.classList.toggle('light');
      const isLight = document.documentElement.classList.contains('light');
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
      syncThemeColor();
    });

    // ── User dropdown (click-toggled) ──────────────────────────────────────────
    let cleanupUserMenu: (() => void) | undefined;
    function mountUserMenu() {
      const listeners = new AbortController();
      const userMenuBtn = document.getElementById('user-menu-btn');
      const userMenu = document.getElementById('user-menu');
      const closeUserMenu = () => {
        if (!userMenu || !userMenuBtn || userMenuBtn.getAttribute('aria-expanded') !== 'true') return;
        userMenuBtn.setAttribute('aria-expanded', 'false');
        void hideMenu(userMenu);
      };
      if (userMenu && userMenuBtn) {
        userMenu.classList.remove('hidden');
        userMenu.hidden = true;
        userMenuBtn.setAttribute('aria-expanded', 'false');
        userMenuBtn.setAttribute('aria-controls', userMenu.id);
        userMenuBtn.setAttribute('aria-haspopup', 'menu');
        userMenuBtn.addEventListener('click', event => {
          event.stopPropagation();
          if (userMenuBtn.getAttribute('aria-expanded') === 'true') closeUserMenu();
          else {
            showMenu(userMenu);
            userMenuBtn.setAttribute('aria-expanded', 'true');
          }
        }, { signal: listeners.signal });
        document.addEventListener('click', event => {
          if (!userMenu.contains(event.target as Node)) closeUserMenu();
        }, { signal: listeners.signal });
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && userMenuBtn.getAttribute('aria-expanded') === 'true') {
            closeUserMenu(); userMenuBtn.focus();
          }
        }, { signal: listeners.signal });
      }
      return () => {
        listeners.abort();
        if (userMenu) void hideMenu(userMenu, true);
      };
    }
    document.addEventListener('astro:page-load', () => { cleanupUserMenu?.(); cleanupUserMenu = mountUserMenu(); });
    document.addEventListener('astro:before-swap', () => { cleanupUserMenu?.(); cleanupUserMenu = undefined; });

    // Keep the desktop search caret at the end of an existing query.
    const desktopInput = document.getElementById('desktop-search-input') as HTMLInputElement | null;
    desktopInput?.addEventListener('focus', () => {
      const value = desktopInput.value;
      desktopInput.value = '';
      desktopInput.value = value;
    });
    document.addEventListener('keydown', event => {
      if (event.key !== '/' || ['INPUT','TEXTAREA'].includes((event.target as HTMLElement).tagName)) return;
      event.preventDefault();
      if (desktopInput?.checkVisibility()) desktopInput.focus();
      else if (document.querySelector('[data-mobile-navigation]')) location.href = '/search';
    });
</script>
