---
import { sharePath } from '../lib/share-preview';
const {title, description: suppliedDescription} = Astro.props;
const path = sharePath(Astro.url.pathname);
const description = suppliedDescription || (path?.startsWith('/user/') ? `${title}'s AnyList profile` : title);
const origin = process.env.SERVER_URL || Astro.url.origin;
const canonical = path ? new URL(path, origin).href : '';
const image = path ? new URL(`/api/proxy/sharing/image?${new URLSearchParams({path})}`, origin).href : '';
---
{path && title && Astro.response.status === 200 && <>
  <link rel="canonical" href={canonical}/>
  <meta property="og:site_name" content="AnyList"/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={image}/>
  <meta property="og:image:type" content="image/jpeg"/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:image:alt" content={`${title} · AnyList`}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={image}/>
</>}
