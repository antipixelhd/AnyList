---
import { loginSharePage, sharePagePath, sharePath } from '../lib/share-preview';
const {title: pageTitle, description: suppliedDescription} = Astro.props;
const loginPage = Astro.url.pathname === '/login' ? loginSharePage(Astro.url.searchParams.get('next')) : null;
const title = loginPage?.title || pageTitle;
const path = sharePath(Astro.url.pathname);
const description = suppliedDescription || (path?.startsWith('/user/') ? `${title} on AnyList` : 'Track movies and series with AnyList.');
const origin = process.env.SERVER_URL || Astro.url.origin;
const canonical = new URL(loginPage?.path || sharePagePath(Astro.url.pathname,Astro.url.search), origin).href;
const image = new URL(path ? `/api/proxy/sharing/image?${new URLSearchParams({path})}` : '/share-preview.png', origin).href;
const imageType = path ? 'image/jpeg' : 'image/png';
---
{title && Astro.response.status === 200 && <>
  <link rel="canonical" href={canonical}/>
  <meta property="og:site_name" content="AnyList"/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={image}/>
  <meta property="og:image:type" content={imageType}/>
  <meta property="og:image:width" content={path ? '1200' : '1280'}/>
  <meta property="og:image:height" content={path ? '630' : '640'}/>
  <meta property="og:image:alt" content={`${title} · AnyList`}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={image}/>
</>}
