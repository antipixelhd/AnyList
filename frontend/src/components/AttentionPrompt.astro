---
import Icon from "./Icon.astro";
---
<aside class="attention-prompt" data-attention-prompt hidden aria-live="polite" aria-label="Notification requiring attention">
  <button class="attention-prompt-mobile-close" type="button" data-attention-close aria-label="Dismiss notification"><Icon name="close" /></button>
  <img draggable="false" class="attention-prompt-poster" data-attention-poster alt="" hidden />
  <div class="attention-prompt-content">
    <div class="attention-prompt-copy">
      <span class="eyebrow" data-attention-kicker>Needs attention</span>
      <strong data-attention-title><a data-attention-title-link></a></strong>
      <small data-attention-metadata hidden></small>
      <p data-attention-message></p>
    </div>
    <div class="attention-prompt-actions">
      <a class="button-primary" href="/recent-events" data-attention-action>Review</a>
      <button class="button-primary button-rate" type="button" data-attention-rate hidden>Rate Now</button>
      <button class="button-secondary button-rate" type="button" data-attention-rate-series hidden>Rate series</button>
      <button class="button-secondary" type="button" data-attention-cancel-import hidden>Cancel import</button>
      <button class="button-quiet" type="button" data-attention-close aria-label="Dismiss this prompt">Dismiss</button>
    </div>
  </div>
</aside>

<script>
import {cancelImportNotification} from '../lib/import-cancel';
import {bindAttentionPromptMotion} from '../lib/attention-prompt-motion';
import {refreshNotifications, subscribeNotifications, type NotificationSnapshot} from '../lib/notification-store';
import {applyResponsiveArtwork, responsiveArtwork} from '../lib/responsive-artwork';
import {eventImage,isSeasonRating,ratingMetadata,ratingPopupEnabled,groupRatingNotifications,ratingActionLabel} from '../lib/notification-presentation';

let pageListeners: AbortController;
document.addEventListener('astro:page-load', () => {
  pageListeners?.abort();
  pageListeners = new AbortController();
  const prompt = document.querySelector<HTMLElement>('[data-attention-prompt]');
  if (!prompt) return;
  const titleLink = prompt.querySelector<HTMLAnchorElement>('[data-attention-title-link]')!;

  const account = document.body.dataset.cacheUser || 'anonymous';
  const hiddenKey = `anylist-acknowledged-attention:${encodeURIComponent(account)}`;
  const readAcknowledged = () => {
    try { return new Set<string>(JSON.parse(localStorage.getItem(hiddenKey) || '[]')); }
    catch { return new Set<string>(); }
  };
  const writeAcknowledged = (ids: string[]) => {
    if (!ids.length) return;
    try { localStorage.setItem(hiddenKey, JSON.stringify([...readAcknowledged(), ...ids])); } catch {}
  };
  // Event IDs are opaque acknowledgement tokens. Include creation time because
  // some synthetic connection failures reuse an ID for a later occurrence.
  const token = (item: any) => `${item.id}:${item.created_at || ''}`;
  const isNotificationsPage = () => location.pathname === '/recent-events';
  let visibleIds: string[] = [];
  let currentRatings: any[] = [];
  let currentImport: any = null;
  prompt.querySelector('[data-attention-cancel-import]')?.addEventListener('click', async event => {
    if (!currentImport) return;
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    try { await cancelImportNotification(currentImport.payload.import_id, currentImport.payload.connection_id != null, pageListeners.signal); }
    catch { button.textContent = 'Retry cancellation'; }
    finally { button.disabled = false; }
  }, {signal: pageListeners.signal});
  let showNewRatingsPopup = false;
  let showSeasonRatingPopup = false;
  let preferencesLoaded = false;
  const preferencesChangedLocally = new Set<string>();
  let lastSnapshot: NotificationSnapshot | null = null;
  const motion = bindAttentionPromptMotion(prompt, pageListeners.signal, () => writeAcknowledged(visibleIds));
  const hide = (acknowledge = true) => acknowledge ? motion.dismiss() : motion.hide();
  prompt.querySelectorAll('[data-attention-close]').forEach(button => button.addEventListener('click', () => hide(), {signal: pageListeners.signal}));
  document.addEventListener('astro:before-swap', () => pageListeners.abort(), {signal: pageListeners.signal, once: true});
  document.addEventListener('media-tracker:rating-changed', event => {
    const detail=(event as CustomEvent).detail;
    const mediaId = Number(detail?.id);
    if (!Number.isFinite(mediaId)) return;
    const ratedTokens = currentRatings.filter((item: any) => Number(item.media?.id) === mediaId &&
      (item.season_number??null)===(detail?.season_number??null) &&
      (!isSeasonRating(item) || (item.payload?.episode_order??'tmdb:aired')===(detail?.episode_order??'tmdb:aired'))).map(token);
    if (!ratedTokens.length) return;
    writeAcknowledged(ratedTokens);
    void refreshNotifications({force: true});
  }, { signal: pageListeners.signal });
  document.addEventListener('click', event => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-notification-link]');
    if (link || (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href="/recent-events"]')) hide();
  }, { signal: pageListeners.signal });
  prompt.querySelector<HTMLImageElement>('[data-attention-poster]')?.addEventListener('error', event => {
    (event.currentTarget as HTMLImageElement).hidden = true;
    (event.currentTarget as HTMLImageElement).removeAttribute('srcset');
    (event.currentTarget as HTMLImageElement).removeAttribute('sizes');
    const rate = prompt.querySelector<HTMLButtonElement>('[data-attention-rate]');
    if (rate) delete rate.dataset.quickRatePoster;
  }, { signal: pageListeners.signal });

  const renderPrompt = (data: NotificationSnapshot) => {
    lastSnapshot = data;
    if (!preferencesLoaded) { prompt.hidden = true; return; }
    const acknowledged = readAcknowledged();
    const conflicts = (data.results || []).filter((item: any) => item.state === 'pending' && item.priority === 'high' && item.kind !== 'import_ready');
    const allRatings = (data.results || []).filter((item: any) => item.kind === 'rating_needed' && item.media);
    const preferences={show_new_ratings_popup:showNewRatingsPopup,show_season_rating_popup:showSeasonRatingPopup};
    writeAcknowledged(allRatings.filter((item:any)=>!ratingPopupEnabled(item,preferences)).map(token));
    const ratings = allRatings.filter((item:any)=>ratingPopupEnabled(item,preferences));
    const imports = (data.results || []).filter((item: any) => item.kind === 'import_ready'
      && !document.querySelector('[data-import-session], [data-connection-import][data-import-active="true"]:not([hidden])'));
    const eligible = [...imports, ...conflicts, ...ratings];
    // Being on Notifications acknowledges items present in each live snapshot.
    // A later snapshot after leaving will still contain fresh, unacknowledged IDs.
    if (isNotificationsPage()) writeAcknowledged(eligible.map(token));
    const unresolvedConflicts = conflicts.filter((item: any) => !acknowledged.has(token(item)) && !isNotificationsPage());
    const unresolvedRatings = ratings.filter((item: any) => !acknowledged.has(token(item)) && !isNotificationsPage());
    const unresolvedImports = imports.filter((item: any) => !acknowledged.has(token(item)) && !isNotificationsPage());
    currentImport = unresolvedImports[0] || null;
    const groupedRatings=groupRatingNotifications(unresolvedRatings);
    const items = [...unresolvedImports, ...unresolvedConflicts, ...groupedRatings];
    visibleIds = [...unresolvedImports,...unresolvedConflicts,...unresolvedRatings].map(token);
    currentRatings = unresolvedRatings;

    const kicker = prompt.querySelector<HTMLElement>('[data-attention-kicker]')!;
    const title = prompt.querySelector<HTMLElement>('[data-attention-title]')!;
    const message = prompt.querySelector<HTMLElement>('[data-attention-message]')!;
    const action = prompt.querySelector<HTMLAnchorElement>('[data-attention-action]')!;
    const rate = prompt.querySelector<HTMLButtonElement>('[data-attention-rate]')!;
    const rateSeries=prompt.querySelector<HTMLButtonElement>('[data-attention-rate-series]')!;
    const poster = prompt.querySelector<HTMLImageElement>('[data-attention-poster]')!;
    const metadata=prompt.querySelector<HTMLElement>('[data-attention-metadata]')!;
    const resetSingleRating = () => {
      title.after(message);
      titleLink.hidden = true;
      titleLink.removeAttribute('href');
      poster.hidden = true;
      poster.removeAttribute('src');
      poster.removeAttribute('srcset');
      poster.removeAttribute('sizes');
      rate.hidden = true;
      rateSeries.hidden=true;
      for(const name of Object.keys(rateSeries.dataset))if(name.startsWith('quickRate'))delete rateSeries.dataset[name];
      rate.removeAttribute('data-quick-rate-id');
      rate.removeAttribute('data-quick-rate-title');
      rate.removeAttribute('data-quick-rate-poster');
      rate.removeAttribute('data-quick-rate-score');
      for(const name of ['season','order','metadata'])rate.removeAttribute(`data-quick-rate-${name}`);
      metadata.hidden=true;metadata.textContent='';
      action.hidden = false;
      prompt.querySelector<HTMLButtonElement>('[data-attention-cancel-import]')!.hidden = true;
      kicker.hidden = false;
      kicker.textContent = 'Needs attention';
    };

    if (!items.length) {
      motion.hide();
      return;
    }
    resetSingleRating();
    if (currentImport) {
      kicker.textContent = 'Import';
      title.textContent = currentImport.payload.title;
      message.textContent = currentImport.message;
      action.href = currentImport.payload.resolve_url;
      action.textContent = 'Resume import';
      prompt.querySelector<HTMLButtonElement>('[data-attention-cancel-import]')!.hidden = false;
    } else if (items.length > 1) {
      const summary = [];
      if (unresolvedRatings.length) summary.push(`${unresolvedRatings.length} ${unresolvedRatings.length === 1 ? 'rating' : 'ratings'} ready`);
      if (unresolvedConflicts.length) summary.push(`${unresolvedConflicts.length} ${unresolvedConflicts.length === 1 ? 'change' : 'changes'} need review`);
      title.textContent = summary.join(' · ');
      message.textContent = 'Open Notifications to work through the queue one item at a time.';
      action.href = '/recent-events';
      action.textContent = 'Open notifications';
    } else if (unresolvedConflicts.length) {
      title.textContent = 'A change needs your review';
      message.textContent = unresolvedConflicts[0].message || 'A connected service reported a change that conflicts with your list.';
      action.href = '/recent-events';
      action.textContent = 'Review change';
    } else {
      const item = groupedRatings[0];
      const media = item.media;
      kicker.hidden = true;
      message.textContent = isSeasonRating(item)?`You completed Season ${item.season_number}`:'You have completed';
      title.before(message);
      title.textContent = '';
      titleLink.textContent = media.title || 'Untitled';
      titleLink.href = `/title/${media.id}`;
      titleLink.hidden = false;
      title.append(titleLink);
      metadata.textContent=ratingMetadata(item);metadata.hidden=!metadata.textContent;
      const image=eventImage(item);
      const posterImage = responsiveArtwork(image,{size:'w185',sizes:'185px',route:'auto'});
      if (posterImage?.src) { applyResponsiveArtwork(poster,image,{size:'w185',sizes:'185px',route:'auto'}); poster.hidden = false; }
      action.hidden = true;
      rate.hidden = false;
      rate.textContent=ratingActionLabel(item);
      rate.dataset.quickRateId = String(media.id);
      rate.dataset.quickRateTitle = media.title || 'Rate title';
      rate.dataset.quickRateMetadata = metadata.textContent;
      if(isSeasonRating(item)) {
        rate.dataset.quickRateSeason=String(item.season_number);
        rate.dataset.quickRateOrder=item.payload?.episode_order||'tmdb:aired';
      }
      if (posterImage?.src) rate.dataset.quickRatePoster = posterImage.src;
      rate.dataset.quickRateScore = '';
      rate.dataset.quickRateMode=isSeasonRating(item)?'manual':item.payload?.rating_mode||'manual';
      if(item.series_rating_request) {
        const series=item.series_rating_request;
        rateSeries.hidden=false;
        rateSeries.dataset.quickRateId=String(series.media.id);
        rateSeries.dataset.quickRateTitle=series.media.title;
        rateSeries.dataset.quickRateMetadata=ratingMetadata(series);
        rateSeries.dataset.quickRateMode=series.payload?.rating_mode||'manual';
        rateSeries.dataset.quickRateScore='';
        rateSeries.dataset.quickRateUseVisiblePoster='false';
        rateSeries.dataset.quickRatePoster=responsiveArtwork(eventImage(series),{size:'w185',sizes:'185px',route:'auto'})?.src||'';
      }
    }
    motion.show();
  };
  document.addEventListener('streaming:activity-changed', () => { if (lastSnapshot) renderPrompt(lastSnapshot); }, {signal: pageListeners.signal});
  document.addEventListener('anylist:rating-popup-preference', event => {
    const detail=(event as CustomEvent).detail;
    const name=detail?.name||'show_new_ratings_popup';
    preferencesChangedLocally.add(name);
    if(name==='show_season_rating_popup')showSeasonRatingPopup=Boolean(detail?.enabled);
    else showNewRatingsPopup=Boolean(detail?.enabled);
    if (lastSnapshot) renderPrompt(lastSnapshot);
  }, { signal: pageListeners.signal });
  void fetch('/api/proxy/tracking/preferences', {cache: 'no-store', signal: pageListeners.signal})
    .then(response => response.ok ? response.json() : Promise.reject(new Error('Preferences unavailable')))
    .then(preferences => {
      if (pageListeners.signal.aborted) return;
      if (!preferencesChangedLocally.has('show_new_ratings_popup'))showNewRatingsPopup = preferences.show_new_ratings_popup !== false;
      if (!preferencesChangedLocally.has('show_season_rating_popup'))showSeasonRatingPopup = preferences.show_season_rating_popup !== false;
      preferencesLoaded = true;
      if (lastSnapshot) renderPrompt(lastSnapshot);
    })
    .catch(error => {
      if (pageListeners.signal.aborted) return;
      console.debug('Rating popup preference refresh deferred.', error);
      if (!preferencesChangedLocally.has('show_new_ratings_popup'))showNewRatingsPopup = true;
      if (!preferencesChangedLocally.has('show_season_rating_popup'))showSeasonRatingPopup = true;
      preferencesLoaded = true;
      if (lastSnapshot) renderPrompt(lastSnapshot);
    });
  subscribeNotifications(renderPrompt, {signal: pageListeners.signal});
});
</script>
