---
import {artwork} from '../lib/tracker';
import Icon from './Icon.astro';
const {media}=Astro.props;
const source=artwork(media?.poster);
---
{media?<a class="event-cover" href={`/title/${media.id}`} aria-label={`View ${media.title}`}>
  {source?<img src={source} alt="" loading="lazy"/>:<span class="cover-placeholder"><Icon name="play" /></span>}
</a>:<div class="event-cover connection-cover" aria-hidden="true"><Icon name="arrows-rotate" /></div>}
