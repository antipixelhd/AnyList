<div class="route-progress" data-route-progress aria-hidden="true"></div>

<script>
  import { wirePasswordToggles } from '../lib/password-toggle';
  import { mutationFetch } from '../lib/mutation-fetch';
  import { showToast as notify } from '../lib/toasts';
  import {createPrediction,bindPredictionIntent,predictionManifest,predictivePage,predictionAllowed,type PredictionArtwork} from '../lib/predictive-loading';
  import {approvedGamesPage,reusableGamesPage} from '../lib/game-public-routes';
  import {snapshotHasGames,authorizeGameSnapshot} from '../lib/navigation-games-access';
  import {editorStore,type EditorTitle} from '../lib/editor-store';
  import {isFailureHandled} from '../lib/handled-failures';
  import {responsiveArtwork} from '../lib/responsive-artwork';
  import {clearStoredBrowseCache} from '../lib/browse-cache';
  wirePasswordToggles();

  type CachedPage = { html: string; bytes: number; storedAt: number; predicted?:boolean; requiresGamesAccess?:boolean };
  type NavigationState = {
    user: string;
    pages: Map<string, CachedPage>;
    bytes: number;
    usedCached: Set<string>;
    generation?: number;
    timer?: number;
    initialized?: boolean;
    alignListLanding?: boolean;
    originalFetch?: typeof window.fetch;
    prediction?: ReturnType<typeof createPrediction<CachedPage>>;
    predictionNavigation?: {key:string;signal:AbortSignal;generation:number};
    predictionBudget?: number;
    previewPrediction?:ReturnType<typeof createPrediction<EditorTitle>>;
    artwork?: Map<string,HTMLImageElement>;
  };
  declare global {
    interface Window {
      __anyListNavigation?: NavigationState;
      anyListToast?: (message: string) => void;
    }
  }

  const currentUser = () => document.body.dataset.cacheUser || 'anonymous';
  const cacheable = (url: URL) => url.origin === location.origin && (!approvedGamesPage(url)||reusableGamesPage(url)) && (
    ['/home','/browse','/browse/games','/recent-events','/connections'].includes(url.pathname)
    || predictivePage(url,location.origin)
    || /^\/user\/[^/]+(?:\/(?:movies|series|list|games|library|social|stats(?:\/games)?))?$/.test(url.pathname)
  );
  const keyFor = (url: URL, user = currentUser()) => `${user}:${url.pathname}${url.search}`;
  const state: NavigationState = window.__anyListNavigation ||= {
    user: currentUser(), pages: new Map(), bytes: 0, usedCached: new Set(), generation: 0,
  };

  function clearPages() {
    state.prediction?.cancel();state.previewPrediction?.cancel();state.predictionNavigation=undefined;
    state.pages.clear();
    document.dispatchEvent(new Event('anylist:cache-invalidated'));
    state.usedCached.clear();
    state.bytes = 0;
    state.generation = (state.generation || 0) + 1;
  }

  function resetForIdentity() {
    const user = currentUser();
    if (state.user === user) return;
    state.user = user;
    clearPages();
  }

  function showToast(message: string) {
    notify({message, kind:'warning', key:'navigation'});
  }
  window.anyListToast = showToast;

  function redactedConnections(doc: Document, clone: HTMLElement) {
    const main = clone.querySelector<HTMLElement>('#settings-content');
    if (!main) return false;
    const panel = clone.ownerDocument.createElement('section');
    panel.className = 'space-y-6';
    const introduction = clone.ownerDocument.createElement('p');
    introduction.className = 'text-sm text-zinc-400';
    introduction.textContent = 'Last viewed connection summary. Connect to the internet to view settings and manage providers.';
    panel.append(introduction);
    const sections: Array<[string, string]> = [
      ['Media Players', '#connections-list [data-connection-id] .collapsible-header'],
      ['Scrobble connections', '#scrobble-connections-list [data-scrobble-conn-id] .collapsible-header'],
      ['Tracking services', '[data-target="trakt-body"], [data-target="simkl-body"], [data-target="mdblist-body"]'],
      ['Media Managers', '[data-target="radarr-body"], [data-target="sonarr-body"]'],
    ];
    for (const [heading, selector] of sections) {
      const sourceRows = [...doc.querySelectorAll<HTMLElement>(selector)];
      if (!sourceRows.length) continue;
      const section = clone.ownerDocument.createElement('section');
      section.className = 'space-y-3';
      const title = clone.ownerDocument.createElement('h2');
      title.className = 'section-headline border-b border-zinc-800 pb-2';
      title.textContent = heading;
      section.append(title);
      for (const source of sourceRows) {
        const label = source.querySelector<HTMLElement>('.font-medium')?.textContent?.trim();
        if (!label) continue;
        const card = clone.ownerDocument.createElement('div');
        card.className = 'bg-zinc-900 border border-zinc-800 rounded-2xl px-6 py-4';
        const name = clone.ownerDocument.createElement('strong');
        name.className = 'font-medium text-zinc-200';
        name.textContent = label;
        card.append(name);
        const status = source.querySelector<HTMLElement>('.conn-status-badge:not(.hidden), [id$="-conn-status"]:not(.hidden)');
        const statusText = status?.textContent?.trim() || '';
        if (/^(connected|disconnected|available|unavailable|healthy|degraded|saved)$/i.test(statusText)) {
          const detail = clone.ownerDocument.createElement('span');
          detail.className = 'block text-xs text-zinc-400 mt-1';
          detail.textContent = statusText;
          card.append(detail);
        }
        section.append(card);
      }
      panel.append(section);
    }
    main.replaceChildren(panel);
    clone.querySelectorAll('script').forEach(script => script.remove());
    return true;
  }

  function sanitizedHtml(doc: Document, url: URL) {
    const clone = doc.documentElement.cloneNode(true) as HTMLElement;
    if (url.pathname === '/connections' && !redactedConnections(doc, clone)) return null;
    clone.querySelectorAll('[data-token]').forEach(element => element.removeAttribute('data-token'));
    // An open attribute copied into cached HTML restores a non-modal dialog:
    // it has no top-layer backdrop or focus lock. Cache pages with dialogs shut.
    clone.querySelectorAll('dialog').forEach(dialog => dialog.removeAttribute('open'));
    clone.querySelectorAll<HTMLInputElement>('input[type="password"]').forEach(input => {
      input.value = '';
      input.removeAttribute('value');
    });
    clone.querySelectorAll('[data-route-progress]').forEach(element => element.classList.remove('visible','finishing'));
    clone.querySelectorAll('[data-toast-host]').forEach(element => element.replaceChildren());
    return '<!doctype html>' + clone.outerHTML;
  }

  function remember(url: URL, doc: Document) {
    resetForIdentity();
    if (!cacheable(url) || doc.body.dataset.cacheUser !== state.user) return;
    if(!reusableGamesPage(url)&&(doc.body.hasAttribute('data-games-access')||doc.querySelector('[data-contributor-page][data-media-type="game"]')))return;
    const html = sanitizedHtml(doc, url);
    if (!html) return;
    const bytes = new Blob([html]).size;
    if (bytes > 2_000_000) return;
    const key = keyFor(url);
    const previous = state.pages.get(key);
    if (previous) state.bytes -= previous.bytes;
    state.pages.delete(key);
    state.pages.set(key, { html, bytes, storedAt: Date.now(),requiresGamesAccess:reusableGamesPage(url)||snapshotHasGames(html) });
    state.bytes += bytes;
    while (state.pages.size > 18 || state.bytes > 10_000_000) {
      const oldest = state.pages.keys().next().value as string | undefined;
      if (!oldest) break;
      state.bytes -= state.pages.get(oldest)?.bytes || 0;
      state.pages.delete(oldest);
    }
  }

  function storePrediction(url:URL,page:CachedPage){
    const key=keyFor(url),previous=state.pages.get(key);
    if(previous)state.bytes-=previous.bytes;
    state.pages.delete(key);state.pages.set(key,page);state.bytes+=page.bytes;
    while(state.pages.size>18||state.bytes>10_000_000){
      const first=state.pages.keys().next().value!;
      state.bytes-=state.pages.get(first)!.bytes;state.pages.delete(first);
    }
  }
  function warmPrimary(sources:PredictionArtwork[]){
    if(!predictionAllowed())return;
    state.artwork ||= new Map();
    for(const source of sources){
      const key=JSON.stringify(source);if(state.artwork.has(key))continue;
      const image=new Image();image.fetchPriority='low';image.decoding='async';
      if(source.sizes)image.sizes=source.sizes;if(source.srcset)image.srcset=source.srcset;image.src=source.src;
      state.artwork.set(key,image);void image.decode().catch(()=>{});
      while(state.artwork.size>6)state.artwork.delete(state.artwork.keys().next().value!);
    }
  }

  async function validate(url: URL, key: string) {
    if (!navigator.onLine || !cacheable(url)) {
      state.usedCached.delete(key);
      return;
    }
    const generation = state.generation;
    try {
      const response = await (state.originalFetch || window.fetch)(url.href, {
        credentials: 'same-origin', headers: { Accept: 'text/html' },
      });
      if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) return;
      const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
      if (generation !== state.generation) return;
      if (!doc.querySelector('[name="astro-view-transitions-enabled"]')) return;
      if ((doc.body.dataset.cacheUser || 'anonymous') !== state.user) return;
      remember(url, doc);
    } catch { /* Retained content remains usable until a later navigation. */ }
    finally { state.usedCached.delete(key); }
  }

  function startProgress() {
    window.clearTimeout(state.timer);
    state.timer = window.setTimeout(() => {
      document.querySelector('[data-route-progress]')?.classList.add('visible');
    }, 150);
  }
  function finishProgress() {
    window.clearTimeout(state.timer);
    const bar = document.querySelector<HTMLElement>('[data-route-progress]');
    if (!bar) return;
    bar.classList.add('finishing');
    window.setTimeout(() => bar.classList.remove('visible','finishing'), 170);
  }

  if (!state.initialized) {
    state.initialized = true;
    document.addEventListener('anylist:cache-invalidated', () => {
      try { clearStoredBrowseCache(window.sessionStorage); } catch { /* Storage is optional. */ }
    });
    state.originalFetch = window.fetch.bind(window);
    const lifetime=new AbortController();
    state.prediction=createPrediction<CachedPage>(async(href,signal)=>{
      const url=new URL(href),generation=state.generation,user=state.user;
      const response=await state.originalFetch!(href,{signal:AbortSignal.any([signal,AbortSignal.timeout(6000)]),credentials:'same-origin',cache:'no-store',headers:{Accept:'text/html'}});
      if(!response.ok||response.redirected||!response.headers.get('content-type')?.includes('text/html'))throw new Error('Prediction unavailable');
      const html=await response.text(),sources=predictionManifest(html,user,reusableGamesPage(url));
      if(signal.aborted||generation!==state.generation||!sources)throw new Error('Prediction invalidated');
      const bytes=new Blob([html]).size;if(bytes>2_000_000)throw new Error('Prediction too large');
      const page={html,bytes,storedAt:Date.now(),predicted:true,requiresGamesAccess:reusableGamesPage(url)||snapshotHasGames(html)};storePrediction(url,page);warmPrimary(sources);return page;
    },lifetime.signal);
    state.previewPrediction=createPrediction<EditorTitle>(async(path,signal)=>{
      const generation=state.generation,user=state.user;
      const response=await state.originalFetch!(path,{signal:AbortSignal.any([signal,AbortSignal.timeout(6000)]),cache:'no-store'});
      if(!response.ok)throw new Error('Preview unavailable');
      const title=await response.json();
      if(signal.aborted||generation!==state.generation||user!==currentUser())throw new Error('Preview invalidated');
      editorStore.scope(user);editorStore.warmMetadata({...title,entry:null});
      warmPrimary([responsiveArtwork(title.poster,{size:'w500',sizes:'(max-width:650px) 108px, (max-width:900px) 170px, (max-width:1100px) 190px, 210px',route:'auto'}),
        responsiveArtwork(title.backdrop,{size:'w1280',sizes:'100vw',route:'auto'})].filter(Boolean) as PredictionArtwork[]);
      return title;
    },lifetime.signal);
    bindPredictionIntent(document,lifetime.signal,link=>{
      const url=new URL(link.href);
      if(url.origin!==location.origin||approvedGamesPage(url)&&!reusableGamesPage(url)||link.target||link.hasAttribute('download')||link.hasAttribute('data-astro-reload'))return;
      if(link.hasAttribute('data-browse-type')&&url.pathname==='/browse'&&location.pathname==='/browse')return;
      if(url.pathname==='/discover-title'){
        const type=url.searchParams.get('type'),id=url.searchParams.get('id');
        if(!['movie','series'].includes(type||'')||!id||!/^\d+$/.test(id))return;
        const path=`/api/proxy/tracking/catalog/${type}/${id}/preview`;
        if(state.previewPrediction!.has(path)||(state.predictionBudget||0)>=3)return;
        state.predictionBudget=(state.predictionBudget||0)+1;state.previewPrediction!.prefetch(path);return;
      }
      if(!predictivePage(url,location.origin))return;
      const cached=state.pages.get(keyFor(url));
      if(cached&&(!cached.predicted||Date.now()-cached.storedAt<30_000))return;
      if((state.predictionBudget||0)>=3)return;
      state.predictionBudget=(state.predictionBudget||0)+1;
      state.prediction!.prefetch(url.href);
    });
    const navigationFetch:typeof fetch=async(input,init)=>{
      const request=input instanceof Request?input:null;
      const url=new URL(request?.url||String(input),location.href);
      const target=state.predictionNavigation;
      if(String(init?.method||request?.method||'GET').toUpperCase()==='GET'&&target?.key===keyFor(url)){
        let page=state.pages.get(target.key);
        if(!page||!page.predicted||Date.now()-page.storedAt>=30_000)page=await state.prediction!.consume(url.href,target.signal);
        if(page?.requiresGamesAccess&&!await authorizeGameSnapshot(state.user,target.signal,state.originalFetch,url)){
          if(state.pages.get(target.key)===page){state.pages.delete(target.key);state.bytes-=page.bytes;}
          page=undefined;state.predictionNavigation=undefined;
        }
        if(page&&target===state.predictionNavigation&&!target.signal.aborted&&target.generation===state.generation){
          state.predictionNavigation=undefined;
          return new Response(page.html,{headers:{'Content-Type':'text/html'}});
        }
      }
      return state.originalFetch!(input,init);
    };
    window.fetch = mutationFetch(navigationFetch, location.href, () => {
      clearPages();
      document.dispatchEvent(new Event('anylist:data-changed'));
    }, error => {
      // Give the initiating control time to show its more useful, action-specific error.
      window.setTimeout(() => { if (!isFailureHandled(error)) showToast('Could not reach the server. This change was not queued.'); }, 250);
    });

    document.addEventListener('submit', event => {
      const form = event.target as HTMLFormElement;
      if (new URL(form.action, location.href).pathname === '/logout') {
        clearPages();
      }
    }, true);

    document.addEventListener('astro:before-preparation', rawEvent => {
      if(document.querySelector('[data-game-browse]')){
        document.dispatchEvent(new Event('anylist:before-snapshot'));
        if(document.querySelector<HTMLElement>('[data-game-browse]')?.dataset.navigationSnapshotReady==='true')remember(new URL(location.href),document);
      }
      closeNavigationDialogs();
      resetForIdentity();
      const event = rawEvent;
      state.alignListLanding = event.navigationType !== 'traverse';
      const key = keyFor(event.to);
      state.predictionNavigation=undefined;
      let predicted=state.pages.get(key);
      if(predicted?.predicted&&Date.now()-predicted.storedAt>=30_000){state.pages.delete(key);state.bytes-=predicted.bytes;predicted=undefined;}
      if(!event.formData&&(!approvedGamesPage(event.to)||reusableGamesPage(event.to))&&(predicted?.predicted||state.prediction?.has(event.to.href))){
        state.predictionNavigation={key,signal:event.signal,generation:state.generation||0};startProgress();return;
      }
      state.prediction?.cancel();
      const cached = cacheable(event.to) && (event.to.pathname !== '/connections' || !navigator.onLine)
        ? state.pages.get(key) : undefined;
      if (!cached) {
        startProgress();
        return;
      }
      const defaultLoader=event.loader,generation=state.generation,user=state.user;
      event.loader = async () => {
        const authorized=!cached.requiresGamesAccess||await authorizeGameSnapshot(user,event.signal,state.originalFetch,event.to);
        if(event.signal.aborted)return;
        if(!authorized||generation!==state.generation||user!==currentUser()){
          if(state.pages.get(key)===cached){state.pages.delete(key);state.bytes-=cached.bytes;}
          await defaultLoader();return;
        }
        state.usedCached.add(key);
        event.newDocument = new DOMParser().parseFromString(cached.html, 'text/html');
      };
    });
    document.addEventListener('astro:after-preparation', finishProgress);
    document.addEventListener('astro:after-swap', () => {
      if (!state.alignListLanding || !document.body.hasAttribute('data-list-landing')) return;
      const tabs = document.querySelector<HTMLElement>('.profile-tabs');
      if (tabs) window.scrollTo(0, window.scrollY + tabs.getBoundingClientRect().top);
    });
    document.addEventListener('astro:page-load', () => {
      finishProgress();
      state.predictionBudget=0;state.predictionNavigation=undefined;
      resetForIdentity();
      const url = new URL(location.href);
      const key = keyFor(url);
      if (state.usedCached.has(key)) void validate(url, key);
      else remember(url, document);
    });
    window.addEventListener('pagehide', closeNavigationDialogs);
    window.addEventListener('pageshow', event => {
      if (event.persisted) closeNavigationDialogs();
    });
  }

  function closeNavigationDialogs() {
    document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach(dialog => dialog.close());
  }

  remember(new URL(location.href), document);
</script>
