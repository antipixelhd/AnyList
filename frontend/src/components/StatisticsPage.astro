---
import Tracker from '../layouts/Tracker.astro';
import ProfileHeader from './ProfileHeader.astro';
import StatisticsSections from './StatisticsSections.astro';
import Icon from './Icon.astro';
import StatsMetricChart from './StatsMetricChart.astro';
import StatsDistribution from './StatsDistribution.astro';
import StatsGenreCard from './StatsGenreCard.astro';
import StatsActorCard from './StatsActorCard.astro';
import StatsStudioCard from './StatsStudioCard.astro';
import StatsStaffCard from './StatsStaffCard.astro';
import '../styles/stats-overview.css';
import '../styles/stats-genres.css';
import '../styles/stats-actors.css';
import { tracker,trackerFailure } from '../lib/tracker';
import {emptyStatistics,gameStatisticsView,statisticsSection,statisticsPanel,type UnifiedStatistics} from '../lib/unified-statistics-data';
import {gameHeadlines,gameStatsQuery,signedNumber,type GameStatsResponse,type GameOverview} from '../lib/game-statistics-data';
import type { OverviewResponse, Overview, MediaScope } from '../lib/stats-overview-data';
import { headlineValues } from '../lib/stats-overview-data';
import { genreSort, rankedGenres } from '../lib/stats-genres-data';
import { actorArtwork, hasCharacterImages, rankedActors } from '../lib/stats-actors-data';
import { rankedStaff } from '../lib/stats-staff-data';
import { rankedStudios } from '../lib/stats-studios-data';

interface Props {domain?:'screen'|'game'}
const {domain='screen'}=Astro.props;
const games=domain==='game';
const { username } = Astro.params;
const gameQuery=gameStatsQuery(Astro.url.searchParams);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const requested = Astro.url.searchParams.get('media') || 'all';
const media: MediaScope = requested === 'movie' || requested === 'series' ? requested : 'all';
const selectedSection = Astro.url.searchParams.get('section');
const section=statisticsSection(domain,selectedSection||'overview');
const visiblePanel=statisticsPanel(section);
const sort = genreSort(Astro.url.searchParams.get('sort'));
const actorSort = games?gameQuery.sort:genreSort(Astro.url.searchParams.get('actor_sort'));
const studioSort = games?gameQuery.sort:genreSort(Astro.url.searchParams.get('studio_sort'));
const staffSort = games?gameQuery.sort:genreSort(Astro.url.searchParams.get('staff_sort'));
const artwork = actorArtwork(Astro.url.searchParams.get('artwork'));
let data: UnifiedStatistics | null = null, error = '';
try { data = games?gameStatisticsView(await tracker(`games/users/${encodeURIComponent(username!)}/statistics?${new URLSearchParams({section,sort:gameQuery.sort,page:'1'})}`,Astro.locals.token),gameQuery.sort):await tracker(`profile/${encodeURIComponent(username!)}/stats/overview?media_type=${media}`, Astro.locals.token); }
catch (cause) { const failure=trackerFailure(cause);error=failure.message;Astro.response.status=failure.status; }
const ready = data?.status === 'ready' && data.overview !== null;
const overview:Overview=data?.overview||emptyStatistics(media);
const gameOverview=games&&data?.game?.status==='ready'&&section==='overview'?data.game.data as GameOverview:null;
const highlights=games?gameHeadlines(gameOverview):headlineValues(overview);
const headlineIcons = ['display', 'play', 'calendar', 'hourglass', 'percent', 'divide'];
const genreTemplate = { key: '', label: '', titles: 0, minutes: 0, mean_score: null, rated_titles: 0, runtime_missing_plays: 0, browse_filters: { movie: '', series: '' }, top_titles: [] };
const actorTemplate = { key: '', label: '', image: null, href: '#', titles: 0, minutes: 0, mean_score: null, rated_titles: 0, runtime_missing_plays: 0, top_titles: [] };
---
<Tracker title={`${username}'s Statistics`} ownerProfileColor={data?.profile?.profile_color} ownerIsViewer={data?.owner === true} preloadBodyFonts>
  {data ? <>
    <ProfileHeader profile={{ ...data.profile, owner: data.owner, following: data.following, follows_you: data.follows_you, combine_lists: data.combine_lists }} active="stats" />
    <section class="page-width stats-overview-page" id="statistics-overview" data-integrated-statistics data-domain={domain} data-page="1" data-game-sort={gameQuery.sort} data-username={username} data-initial={JSON.stringify(data)} data-media={media} data-section={section} data-genre-sort={sort} data-studio-sort={studioSort} data-staff-sort={staffSort} data-actor-sort={actorSort} data-actor-artwork={artwork} aria-label="Statistics">
      <aside class="overview-sidebar">
        <button type="button" class="overview-menu-toggle" data-stats-menu-toggle aria-label="Show statistics sections" aria-expanded="false" aria-controls="statistics-sections"><span>Statistics</span><Icon name="ellipsis" /></button>
        <div id="statistics-sections"><StatisticsSections owner={data.owner} {domain} {section}/></div>
      </aside>
      <div class="stats-overview-content">
      <header class="overview-heading"><h2 data-stats-heading>{section==='developers'?'Developers':section==='publishers'?'Publishers':section === 'staff' ? 'Staff' : section === 'studios' ? 'Studios' : section === 'actors' ? 'Actors' : section === 'genres' ? 'Genres' : 'Overview'}</h2><nav class="overview-media" aria-label="Statistics media type" data-screen-media hidden={games}>
        {[['all', 'All'], ['movie', 'Movies'], ['series', 'Series']].map(([value, label]) => <a href={`?${new URLSearchParams({media: value, section, sort, actor_sort: actorSort, studio_sort: studioSort, staff_sort: staffSort, artwork})}`} data-overview-media={value} aria-current={value === media ? 'page' : undefined}>{label}</a>)}
      </nav></header>
      <p class="overview-error error-message" role="alert" hidden></p>
      <div class="overview-pending" role="status" hidden={ready}><p data-overview-state>{data.status === 'error' ? 'Statistics are unavailable. A retry is scheduled.' : 'Preparing statistics…'}</p><button type="button" data-overview-retry>{data.owner ? 'Refresh statistics' : 'Check again'}</button></div>
      <span class="overview-sr-only" data-overview-announcement role="status" aria-live="polite"></span>

      <div class="overview-results" hidden={!ready}>
        <div data-stats-panel="overview" hidden={visiblePanel !== 'overview'}>
        <dl class="overview-totals" aria-label="Primary statistics">{highlights.map((metric, index) => <div title={metric.detail}><dt><span class="overview-total-icon" aria-hidden="true"><Icon name={headlineIcons[index]} /></span><span data-headline-label={index}>{metric.label}</span></dt><dd data-headline-value={index}>{metric.value}</dd></div>)}</dl>
        <div class="overview-chart-grid"><StatsMetricChart id="scores" title="Scores" rows={overview.scores} score /><StatsMetricChart id="episode_counts" title={games?'Recorded time':'Episode count'} rows={overview.episode_counts} hidden={!games&&media === 'movie'} /></div>
        <div class="overview-distribution-grid"><StatsDistribution id="statuses" title="List status" data={overview} /><StatsDistribution id="formats" title="Format" data={overview} hidden={games} /><StatsDistribution id="countries" title="Country" data={overview} hidden={games} /></div>
        <div class="overview-chart-grid overview-years"><StatsMetricChart id="release_years" title="Release year" rows={overview.release_years} /><StatsMetricChart id="watch_years" title={games?'Completion year':'Watch year'} rows={overview.watch_years} /></div>
        <section data-game-statistics-extra hidden={!games}>
          <div class="overview-distribution-grid">
            <section class="overview-distribution"><h3>Planned</h3><dl class="overview-totals game-stats-secondary"><div><dt>Games</dt><dd data-game-planned-count>{gameOverview?.planned.games??'—'}</dd></div><div><dt>Main + Sides hours</dt><dd data-game-planned-hours>{gameOverview?.planned.estimated_seconds==null?'—':`${gameOverview.planned.known_estimate_games<gameOverview.planned.games?'≥ ':''}${(gameOverview.planned.estimated_seconds/3600).toLocaleString(undefined,{maximumFractionDigits:1})}`}</dd></div></dl></section>
            <section class="overview-distribution"><h3>Replays</h3><p data-game-replays>{gameOverview?.totals.replay_games?gameOverview.totals.replays:'—'}</p></section>
          </div>
          <p data-game-undated hidden={!gameOverview?.coverage.undated_completions}>{gameOverview?.coverage.undated_completions||0} completions have no date.</p>
          <section class="overview-chart"><header class="overview-chart-heading"><h3>First completion vs estimate</h3></header><div class="overview-table-scroll"><table class="game-comparison-table"><thead><tr><th>Estimate</th><th>Games</th><th>Hours difference</th><th>Difference</th></tr></thead><tbody data-game-comparisons>{(gameOverview?.comparisons||[]).map(row=><tr><th scope="row">{row.label}</th><td>{row.games}</td><td>{signedNumber(row.mean_difference_seconds,3600)}</td><td>{row.mean_relative_percent==null?'—':`${signedNumber(row.mean_relative_percent)}%`}</td></tr>)}</tbody></table></div></section>
        </section>
        </div>
        <div data-stats-panel="genres" hidden={visiblePanel !== 'genres'}>
          <div class="stats-genres-toolbar"><div class="overview-metrics" role="group" aria-label="Sort genres">
            {[['count', 'Count'], ['mean_score', 'Mean Score'], ['time', 'Time Watched']].map(([value, label]) => <button type="button" data-genre-sort={value} aria-pressed={sort === value}>{label}</button>)}
          </div></div>
          <div class="stats-genres-grid" data-genres-grid>{(games?overview.genres||[]:rankedGenres(overview.genres||[],sort)).map((genre, index) => <StatsGenreCard genre={genre} rank={index+1} media={media} />)}</div>
          <p class="stats-genres-empty" data-genres-empty hidden={(overview.genres || []).length > 0}>No watched genres.</p>
        </div>
        <template data-genre-card-template><StatsGenreCard genre={genreTemplate} rank={0} media={media} /></template>
        <div data-stats-panel="actors" hidden={visiblePanel !== 'actors'}>
          <div class="stats-actors-toolbar">
            <div class="overview-metrics" role="group" aria-label="Actor artwork">
              {[['media', 'Media'], ['characters', 'Characters']].map(([value, label]) => <button type="button" data-actor-artwork={value} aria-pressed={artwork === value} disabled={value === 'characters' && !hasCharacterImages(overview.actors || [])}>{label}</button>)}
            </div>
            <div class="overview-metrics" role="group" aria-label="Sort actors">
              {[['count', 'Count'], ['mean_score', 'Mean Score'], ['time', 'Time Watched']].map(([value, label]) => <button type="button" data-actor-sort={value} aria-pressed={actorSort === value}>{label}</button>)}
            </div>
          </div>
          <div class="stats-actors-grid" data-actors-grid>{(games?overview.actors||[]:rankedActors(overview.actors||[],actorSort)).map((actor, index) => <StatsActorCard actor={actor} rank={index+1} mode={artwork} />)}</div>
          <p class="stats-actors-empty" data-actors-empty hidden={(overview.actors || []).length > 0}>No actors yet.</p>
        </div>
        <template data-actor-card-template><StatsActorCard actor={actorTemplate} rank={0} mode={artwork} /></template>
        <div data-stats-panel="studios" hidden={visiblePanel !== 'studios'}>
          <div class="stats-genres-toolbar"><div class="overview-metrics" role="group" aria-label="Sort studios">
            {[['count', 'Count'], ['mean_score', 'Mean Score'], ['time', 'Time Watched']].map(([value, label]) => <button type="button" data-studio-sort={value} aria-pressed={studioSort === value}>{label}</button>)}
          </div></div>
          <div class="stats-genres-grid" data-studios-grid>{(games?overview.studios||[]:rankedStudios(overview.studios||[],studioSort)).map((studio, index) => <StatsStudioCard studio={studio} rank={index+1} />)}</div>
          <p class="stats-genres-empty" data-studios-empty hidden={(overview.studios || []).length > 0}>No watched studios.</p>
        </div>
        <template data-studio-card-template><StatsStudioCard studio={{...actorTemplate, top_titles: []}} rank={0} /></template>
        <div data-stats-panel="staff" hidden={visiblePanel !== 'staff'}>
          <div class="stats-actors-toolbar"><div class="overview-metrics" role="group" aria-label="Sort staff">
            {[['count', 'Count'], ['mean_score', 'Mean Score'], ['time', 'Time Watched']].map(([value, label]) => <button type="button" data-staff-sort={value} aria-pressed={staffSort === value}>{label}</button>)}
          </div></div>
          <div class="stats-actors-grid" data-staff-grid>{(games?overview.staff||[]:rankedStaff(overview.staff||[],staffSort)).map((person, index) => <StatsStaffCard person={person} rank={index+1} />)}</div>
          <p class="stats-actors-empty" data-staff-empty hidden={(overview.staff || []).length > 0}>No staff yet.</p>
        </div>
        <template data-staff-card-template><StatsStaffCard person={{...actorTemplate, roles: [], prominence: 8}} rank={0} /></template>
        <template data-genre-poster-template><a class="stats-genre-poster" href="#" draggable="false"><img alt="" loading="lazy" draggable="false" /><span class="stats-genre-placeholder" aria-hidden="true"></span><span class="stats-genre-tooltip" aria-hidden="true"></span></a></template>
      </div>

      </div>
    </section>
  </> : <div class="page-width"><p class="error-message" role="alert">{error}</p></div>}
</Tracker>
<script>import '../lib/profile-shell';</script>
