---
import type {DetailMedia} from '../lib/media-detail-data';
interface Props {facts:{label:string;value:string}[];title:DetailMedia}
const {facts,title}=Astro.props;
---
<dl>
  {facts.map(fact=><div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
  {title.organizations.map(person=><div><dt>{person.roles.join(', ')}</dt><dd>{person.url?<a href={person.url}>{person.name}</a>:person.name}</dd></div>)}
  {!!title.creators?.length&&<div><dt>Created by</dt><dd>{title.creators.map(person=>person.name).join(', ')}</dd></div>}
  {!!title.networks?.length&&<div><dt>Networks</dt><dd>{title.networks.map(person=>person.name).join(', ')}</dd></div>}
</dl>
