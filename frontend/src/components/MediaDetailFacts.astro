---
import {detailOrganizationFacts,type DetailMedia} from '../lib/media-detail-data';
import LocalDateTime from './LocalDateTime.astro';
import {gameAgeRating} from '../lib/game-info-data';
interface Props {facts:{label:string;value:string}[];title:DetailMedia}
const {facts,title}=Astro.props;
const organizations=detailOrganizationFacts(title);
const lowerFacts=new Set(['Language','Country','Budget','Box office','Platforms']);
const finalGroups=new Set(['Studios','Publisher']);
const age=title.type==='game'?gameAgeRating(title.game_info,title.game_offer_context?.country||'US'):null;
---
<dl>
  {title.type==='game'&&<div data-game-age-rating hidden={!age} title={age?.detail}><dt>Age rating</dt><dd>{age?.label}</dd></div>}
  {facts.filter(fact=>!lowerFacts.has(fact.label)).map(fact=><div><dt>{fact.label}</dt><dd>{['Released','Releases','First published'].includes(fact.label)?<LocalDateTime value={title.release_date} fallback={fact.value}/>:fact.value}</dd></div>)}
  {organizations.filter(group=>!finalGroups.has(group.label)).map(group=><div><dt>{group.label}</dt><dd>{group.rows.map(person=><span class="media-fact-entry">{person.url?<a href={person.url}>{person.name}</a>:person.name}</span>)}</dd></div>)}
  {facts.filter(fact=>lowerFacts.has(fact.label)).map(fact=><div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
  {organizations.filter(group=>finalGroups.has(group.label)).map(group=><div><dt>{group.label}</dt><dd>{group.rows.map(person=><span class="media-fact-entry">{person.url?<a href={person.url}>{person.name}</a>:person.name}</span>)}</dd></div>)}
</dl>
