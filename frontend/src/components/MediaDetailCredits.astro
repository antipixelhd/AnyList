---
import MediaDetailPerson from './MediaDetailPerson.astro';
import MediaDetailCastToggle from './MediaDetailCastToggle.astro';
import type {DetailPerson} from '../lib/media-detail-data';
import type {GameCastData,GameCharacter} from '../lib/game-cast-data';
interface Props {label:string;rows:DetailPerson[];id:string;limit?:number;secondary?:boolean;loading?:boolean;gameCast?:GameCastData|null;gameCharacters?:GameCharacter[]}
const {label,rows,id,limit=8,secondary=false,loading=false,gameCast,gameCharacters=[]}=Astro.props;
const deferred=JSON.stringify(gameCast?{actors:gameCast.actors,source_characters:gameCharacters,
  availability:gameCast.availability,mode:gameCast.mode}:rows.slice(limit)).replaceAll('<','\\u003c');
---
<section class:list={['lab-module','media-credit-group',{'media-credit-secondary':secondary}]} data-credit-section={id} data-credit-limit={limit} hidden={!rows.length&&!loading}>
  <div class="lab-section-title"><h2 data-credit-heading>{label}</h2>{id==='cast'&&<MediaDetailCastToggle gameCast={gameCast}/>}</div>
  <div class="media-credit-content" id={`credits-${id}`} data-credit-content data-cast-content={id==='cast' ? '' : undefined}>
    <div class="lab-person-grid" data-credit-visible>{rows.slice(0,limit).map(person=><MediaDetailPerson person={person}/>)}{!rows.length&&loading&&Array.from({length:limit},()=> <div class="detail-person-skeleton" aria-hidden="true"><span></span><div></div></div>)}</div>
    <div class="lab-person-grid media-credit-more" data-credit-rest hidden></div>
    <script type="application/json" data-credit-deferred data-game-cast-data={gameCast?true:undefined} set:html={deferred}/>
  </div>
  <button class="lab-text-button media-credit-toggle" type="button" data-credit-toggle hidden={rows.length<=limit} aria-expanded="false" aria-controls={`credits-${id}`}>Show more</button>
</section>
