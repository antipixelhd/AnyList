---
import Icon from './Icon.astro';
const { settings } = Astro.props;
---
<section>
  <h2 class="section-headline border-b border-zinc-800 pb-2 mb-4">Metadata providers</h2>
  <form id="metadata-settings-form" class="space-y-6 max-w-xl">
          <!-- TMDB Read Access Token -->
          <div class="space-y-2">
            <label for="tmdb_api_key" class="block text-sm font-medium text-zinc-400">TMDB Read Access Token</label>
            
            <div class="flex gap-2">
              <div class="relative flex-1 group/field">
                <input
                  type="password"
                  name="tmdb_api_key"
                  id="tmdb_api_key"
                  value={settings.tmdb_api_key || ""}
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="metadata-password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle password visibility"
                >
                  <Icon name="eye" class="w-5 h-5 eye-icon" />
                  <Icon name="eye-slash" class="w-5 h-5 eye-slash-icon hidden" />
                </button>
              </div>
              <button
                type="button"
                data-action="test_tmdb"
                title="Test TMDB token"
                class="metadata-test-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
              >
                <Icon name="play" class="w-5 h-5" />
              </button>
            </div>
            {settings.has_global_tmdb_key && !settings.tmdb_api_key ? (
              <p class="text-xs text-blue-400">A server-wide TMDB token is configured by your admin. You can leave this blank to use it, or enter your own token to override it.</p>
            ) : settings.has_global_tmdb_key && settings.tmdb_api_key ? (
              <p class="text-xs text-blue-400">A server-wide TMDB token is configured, but you are using your own token. Clear this field to fall back to the server token.</p>
            ) : (
              <p class="text-xs text-zinc-500">Paste the API Read Access Token (v4) from TMDB Settings → API. Required for metadata and posters; validated before saving.</p>
            )}
            <p class="text-xs text-zinc-500">You can get your TMDB Read Access Token <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">here</a>.</p>
          </div>

          <!-- TVDB API Key -->
          <div class="space-y-2">
            <label for="tvdb_api_key" class="block text-sm font-medium text-zinc-400">TVDB API Key</label>
            
            <div class="flex gap-2">
              <div class="relative flex-1 group/field">
                <input
                  type="password"
                  name="tvdb_api_key"
                  id="tvdb_api_key"
                  value={settings.tvdb_api_key || ""}
                  placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="metadata-password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle password visibility"
                >
                  <Icon name="eye" class="w-5 h-5 eye-icon" />
                  <Icon name="eye-slash" class="w-5 h-5 eye-slash-icon hidden" />
                </button>
              </div>
              <button
                type="button"
                data-action="test_tvdb"
                title="Test TVDB key"
                class="metadata-test-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
              >
                <Icon name="play" class="w-5 h-5" />
              </button>
            </div>
            {settings.has_global_tvdb_key && !settings.tvdb_api_key ? (
              <p class="text-xs text-blue-400">A server-wide TVDB key is configured by your admin.</p>
            ) : settings.has_global_tvdb_key && settings.tvdb_api_key ? (
              <p class="text-xs text-blue-400">A server-wide TVDB key is configured, but you are using your own key.</p>
            ) : null}

            <label for="tvdb_subscriber_pin" class="block text-sm font-medium text-zinc-400 pt-2">TVDB Subscriber PIN <span class="text-zinc-600">(optional)</span></label>
            <div class="relative group/field">
              <input
                type="password"
                name="tvdb_subscriber_pin"
                id="tvdb_subscriber_pin"
                value={settings.tvdb_subscriber_pin || ""}
                placeholder="Only for a subscriber-supported key"
                class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
              />
              <button
                type="button"
                class="metadata-password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                aria-label="Toggle password visibility"
              >
                <Icon name="eye" class="w-5 h-5 eye-icon" />
                <Icon name="eye-slash" class="w-5 h-5 eye-slash-icon hidden" />
              </button>
            </div>

            <div class="text-xs text-zinc-500 space-y-1 pt-1">
              <p>Powers shows and episodes not on TMDB, TVDB-ordered (absolute / anime) episode mapping, and matching unmatched local episodes. Without a key those fall back to TMDB only.</p>
              <p>
                You can get a free <span class="text-zinc-400">project</span> key
                <a href="https://thetvdb.com/dashboard/account/apikey" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">here</a>
                (key only, no PIN; requires attribution, which AnyList shows on TVDB pages). A <span class="text-zinc-400">subscriber-supported</span> key also needs your account's subscriber PIN above.
              </p>
            </div>
          </div>
    <button type="submit" class="button-primary">Save metadata keys</button>
    <p data-metadata-feedback role="status" aria-live="polite"></p>
  </form>
</section>
<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('#metadata-settings-form');
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';
    const token = document.querySelector<HTMLElement>('#app-data')?.dataset.token ?? '';
    const fields = ['tmdb_api_key', 'tvdb_api_key', 'tvdb_subscriber_pin'];
    // Use server-rendered defaults so autofill cannot become the saved baseline.
    const saved = Object.fromEntries(fields.map(field => [field, (form.elements.namedItem(field) as HTMLInputElement).defaultValue.trim() || null]));
    const feedback = form.querySelector<HTMLElement>('[data-metadata-feedback]')!;
    const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' };
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
      button.disabled = true;
      feedback.textContent = 'Saving…';
      try {
        const data = new FormData(form);
        const changes: Record<string, string | null> = {};
        for (const field of fields) {
          const value = String(data.get(field) ?? '').trim() || null;
          if (value !== saved[field]) changes[field] = value;
        }
        const response = await fetch('/api/proxy/auth/settings', { method: 'PATCH', headers, body: JSON.stringify(changes) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.detail || 'Failed to save metadata keys');
        Object.assign(saved, changes);
        feedback.textContent = 'Metadata keys saved.';
      } catch (error) {
        feedback.textContent = error instanceof Error ? error.message : 'Failed to save metadata keys';
      } finally {
        button.disabled = false;
      }
    });
    form.querySelectorAll<HTMLButtonElement>('.metadata-test-btn').forEach(button => {
      button.addEventListener('click', async () => {
        const provider = button.dataset.action === 'test_tmdb' ? 'tmdb' : 'tvdb';
        button.disabled = true;
        try {
          const api_key = (form.elements.namedItem(`${provider}_api_key`) as HTMLInputElement).value.trim();
          const pin = (form.elements.namedItem('tvdb_subscriber_pin') as HTMLInputElement).value.trim();
          const response = await fetch(`/api/proxy/auth/test-${provider}`, { method: 'POST', headers, body: JSON.stringify({ key: api_key, ...(provider === 'tvdb' ? { pin } : {}) }) });
          const result = await response.json();
          if (!response.ok) throw new Error(result.detail || 'Connection test failed');
          feedback.textContent = result.message || 'Connection test successful.';
        } catch (error) {
          feedback.textContent = error instanceof Error ? error.message : 'Connection test failed';
        } finally {
          button.disabled = false;
        }
      });
    });
    form.querySelectorAll<HTMLButtonElement>('.metadata-password-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const input = button.parentElement!.querySelector('input')!;
        input.type = input.type === 'password' ? 'text' : 'password';
        button.querySelector('.eye-icon')?.classList.toggle('hidden');
        button.querySelector('.eye-slash-icon')?.classList.toggle('hidden');
      });
    });
  });
</script>
