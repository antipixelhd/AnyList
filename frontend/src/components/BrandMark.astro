---
interface Props { size?: number; class?: string }
const {size=34,class:className=''}=Astro.props;
---
<span class:list={['anylist-mark',className]} style={`--mark-size:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 48 48" focusable="false">
    <defs><linearGradient id="anylist-mark-gradient" x1="5" y1="3" x2="43" y2="45" gradientUnits="userSpaceOnUse"><stop stop-color="#38bdf8"/><stop offset="1" stop-color="#6366f1"/></linearGradient></defs>
    <rect width="48" height="48" rx="10" fill="#101b2a"/><rect x="3" y="3" width="42" height="42" rx="8" fill="url(#anylist-mark-gradient)"/>
    <path fill="#fff" d="M9 36 20.2 11h6.1L37 36h-6.8l-2.1-5.5h-10L15.8 36H9Zm11.3-11.4h5.6L23.2 17l-2.9 7.6Z"/>
    <path d="m27.5 31.5 3.2 3.1 7.6-8.4" fill="none" stroke="#dff4ff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</span>
<style>.anylist-mark{display:inline-grid;place-items:center;width:var(--mark-size);height:var(--mark-size);flex:none}.anylist-mark svg{display:block;width:100%;height:100%;filter:drop-shadow(0 8px 18px #06111d55)}</style>
