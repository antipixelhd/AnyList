---
interface Props { size?: number; class?: string }
const {size=34,class:className=''}=Astro.props;
---
<img class:list={['anylist-mark',className]} src="/brand-mark.png" width={size} height={size} alt="" aria-hidden="true" />
<style>.anylist-mark{display:block;flex:none;object-fit:contain;filter:drop-shadow(0 4px 9px #06111d44)}</style>
