---
import Icon from './Icon.astro';
import {activityRating,scoreLabel} from '../lib/tracker';
import '../styles/activity-card-rating.css';
const rating=activityRating(Astro.props.activity||{});
const hasBreakdown=Boolean(rating?.breakdown.length);
---
<div class="event-footer" hidden={!rating}>
  <div class="activity-rating" data-rating-breakdown={hasBreakdown||undefined}>
    <button type="button" class="score-pill" disabled={!hasBreakdown} tabindex={hasBreakdown?0:-1} aria-label={rating?.label} aria-expanded={hasBreakdown?'false':undefined} aria-controls={rating?.breakdownId} data-season-rating-toggle data-motion-static>
      <Icon name="star"/> <span data-rating-previous hidden={rating?.previous==null}><span data-rating-previous-value>{scoreLabel(rating?.previous??null)}</span><span class="score-transition" aria-hidden="true">→</span></span><span data-rating-current>{scoreLabel(rating?.current??null)}</span><small>/10</small>
    </button>
    <div class="season-score-breakdown season-score-rows" role="region" aria-label="Rating breakdown" tabindex="0" id={rating?.breakdownId} data-season-rating-scores>
      {rating?.breakdown.map(row=><div><span>{row.label}</span><strong>{scoreLabel(row.score)}<small>/10</small></strong></div>)}
    </div>
  </div>
</div>
