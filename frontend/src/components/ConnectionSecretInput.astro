---
import type { HTMLAttributes } from 'astro/types';
type Props = Omit<HTMLAttributes<'input'>, 'type' | 'autocomplete'>;
---
<!-- External credentials must not become login credentials for AnyList's origin. -->
<input {...Astro.props} type="text" data-connection-secret autocomplete="off" autocapitalize="off" spellcheck="false" />
<style>
  input { -webkit-text-security: disc; }
  input[data-secret-visible="true"] { -webkit-text-security: none; }
</style>
