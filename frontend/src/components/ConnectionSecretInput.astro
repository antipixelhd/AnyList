---
import type { HTMLAttributes } from 'astro/types';
type Props = Omit<HTMLAttributes<'input'>, 'type' | 'autocomplete'>;
---
<!-- Native masking remains in place even if styles fail to load. -->
<input {...Astro.props} type="password" data-connection-secret autocomplete="off" autocapitalize="off" spellcheck="false" />
