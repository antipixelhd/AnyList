---
import Icon from './Icon.astro';
import EntryAnnotations from './EntryAnnotations.astro';
import {scoreLabel,compactListProgress} from '../lib/tracker';
import {responsiveArtwork} from '../lib/responsive-artwork';
import {canIncrementScreenList} from '../lib/screen-list-row';
const {entries,owner,isCombined,template=false}=Astro.props;
const compactImageSizes='(max-width:650px) 32px, 42px';
const imageRoute='direct';
const quickRatePoster=(path:any)=>responsiveArtwork(path,{size:'w185',sizes:'42px',route:imageRoute})?.src || '';
const availabilityLabel=(reason:string|undefined)=>reason==='airing'?'Currently airing':'New season available';
---
{entries.map((entry:any,index:number)=><article data-list-entry={entry.id} style={`--list-row:${index}`} class:list={['entry-row',{'combined-row':isCombined}]} data-title={entry.title.toLowerCase()} data-score={entry.score ?? -1} data-progress={entry.progress} data-media-type={entry.type} data-year={entry.year} data-genres={JSON.stringify(entry.genres)} data-favorite={entry.favorite?'yes':'no'} data-updated={entry.updated_at}>
          <div class="entry-thumbnail" data-preview-src={entry.poster||undefined} data-artwork-path={entry.poster||undefined}><span class="entry-availability" role="img" aria-label={availabilityLabel(entry.availability_reason)} title={availabilityLabel(entry.availability_reason)} hidden={!entry.availability_dot}></span>{(() => {const image=responsiveArtwork(entry.poster,{size:'w342',sizes:compactImageSizes,route:imageRoute}); return image||template ? <img class="entry-cover" src={image?.src} srcset={image?.srcset} sizes={image?.sizes} alt="" loading="lazy"/> : <span class="entry-cover"/>})()}{owner&&<button class="row-menu" data-motion-static data-edit-entry={entry.id} aria-label={`Edit ${entry.title}`}><Icon name="ellipsis"/></button>}</div><div class="entry-title"><a class="entry-title-link" href={`/title/${entry.id}`}>{entry.title}<span class="row-favorite" data-list-favorite aria-label="Favorite" hidden={!entry.favorite}><Icon name="heart"/></span></a><EntryAnnotations rewatchCount={entry.rewatch_count} notes={entry.notes} newSeasons={entry.status==='completed'?entry.new_seasons:0} newEpisodes={entry.status==='completed'?entry.new_episodes:0}/></div>
          <span class="entry-score">{owner?<button class="entry-score-button" data-quick-rate-id={entry.id} data-quick-rate-title={entry.title} data-quick-rate-poster={quickRatePoster(entry.poster)} data-quick-rate-score={entry.score??''} data-quick-rate-mode={entry.rating_mode??'manual'} aria-label={`Rate ${entry.title}`}><span data-score-label>{scoreLabel(entry.score)}</span></button>:scoreLabel(entry.score)}</span>
          <span class="entry-progress">
            <span data-progress-label>{entry.type==='movie' ? entry.progress : entry.released_episodes===undefined?entry.progress:(entry.season_position||'—')}</span>
            <span class="entry-mobile-progress" data-mobile-progress-label>{compactListProgress(entry)}</span>
            {owner && <button type="button" class="progress-increment" data-progress-increment={entry.id} data-next-progress={entry.type==='movie'?1:entry.progress+1} aria-label={entry.type==='movie'?`Mark ${entry.title} watched`:`Mark the next episode of ${entry.title} watched`} title={entry.type==='movie'?'Mark movie watched':'Mark next episode watched'} hidden={!canIncrementScreenList(entry)} disabled={!canIncrementScreenList(entry)}>+</button>}
          </span>
          {isCombined&&<span class="entry-type">{entry.type==='movie'?'Movie':'Series'}</span>}
        </article>)}
