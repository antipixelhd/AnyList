---
import Icon from './Icon.astro';
import EntryAnnotations from './EntryAnnotations.astro';
import EntryAvailability from './EntryAvailability.astro';
import {scoreLabel} from '../lib/tracker';
import {responsiveArtwork} from '../lib/responsive-artwork';
import {canIncrementScreenList,screenListProgress} from '../lib/screen-list-row';
const {entries,owner,isCombined,template=false}=Astro.props;
const compactImageSizes='(max-width:650px) 32px, 42px';
const imageRoute='direct';
const quickRatePoster=(path:any)=>responsiveArtwork(path,{size:'w185',sizes:'42px',route:imageRoute})?.src || '';
---
{entries.map((entry:any,index:number)=>{const series=entry.type==='series', season=entry.list_season, expandable=series&&!season;return <div data-list-entry={entry.list_id??entry.id} data-completed-seasons-only={entry.completed_seasons_only||undefined} data-detached-season={entry.detached_season??undefined} style={`--list-row:${index}`}>
        <article class:list={['entry-row',{'combined-row':isCombined}]} data-title={entry.title.toLowerCase()} data-score={entry.score ?? -1} data-progress={entry.progress} data-media-type={entry.type} data-year={entry.year} data-genres={JSON.stringify(entry.genres)} data-favorite={entry.favorite?'yes':'no'} data-updated={entry.updated_at}>
          <div class="entry-thumbnail" data-preview-src={entry.poster||undefined} data-artwork-path={entry.poster||undefined}><EntryAvailability available={entry.availability_dot} reason={entry.availability_reason}/>{(() => {const image=responsiveArtwork(entry.poster,{size:'w342',sizes:compactImageSizes,route:imageRoute}); return image||template ? <img class="entry-cover" src={image?.src} srcset={image?.srcset} sizes={image?.sizes} alt="" loading="lazy"/> : <span class="entry-cover"/>})()}{owner&&<button class="row-menu" data-motion-static data-edit-entry={entry.id} data-editor-season={season?.number} aria-label={`Edit ${entry.title}`}><Icon name="ellipsis"/></button>}</div>
          <div class="entry-title">
            <div class="list-title-main">
              <a class="entry-title-link" href={`/title/${entry.id}`}><span data-list-title-label>{entry.title}</span><span class="row-favorite" data-list-favorite aria-label="Favorite" hidden={!entry.favorite}><Icon name="heart"/></span></a>
              {(series||template)&&<button type="button" class="list-season-toggle" data-season-toggle data-motion-static hidden={!expandable} aria-expanded="false" aria-label={`${entry.title} seasons`}><Icon name="chevron-down"/></button>}
            </div>
            <EntryAnnotations rewatchCount={entry.rewatch_count} notes={entry.notes} newSeasons={entry.status==='completed'?entry.new_seasons:0} newEpisodes={entry.status==='completed'?entry.new_episodes:0}/>
          </div>
          <span class="entry-score" role="group" aria-label="Score">{owner?<button class="entry-score-button" data-quick-rate-id={entry.id} data-quick-rate-title={entry.series_title??entry.title} data-quick-rate-season={season?.number} data-quick-rate-order={season?.order} data-quick-rate-poster={quickRatePoster(entry.poster)} data-quick-rate-score={entry.score??''} data-quick-rate-mode={entry.rating_mode??'manual'} aria-label={`Rate ${entry.title}`}><span data-score-label>{scoreLabel(entry.score)}</span></button>:<span data-score-label>{scoreLabel(entry.score)}</span>}</span>
          <span class="entry-progress" role="group" aria-label="Progress">
            <span data-progress-label>{screenListProgress(entry)}</span>
            <span class="entry-mobile-progress" data-mobile-progress-label>{screenListProgress(entry,true)}</span>
            {owner && <button type="button" class="progress-increment" data-progress-increment={entry.id} data-next-progress={entry.type==='movie'?1:entry.progress+1} aria-label={entry.type==='movie'?`Mark ${entry.title} watched`:`Mark the next episode of ${entry.title} watched`} title={entry.type==='movie'?'Mark movie watched':'Mark next episode watched'} hidden={!canIncrementScreenList(entry)} disabled={!canIncrementScreenList(entry)}>+</button>}
          </span>
          {isCombined&&<span class="entry-type" role="group" aria-label="Type">{entry.type==='movie'?'Movie':'Series'}</span>}
        </article></div>})}
