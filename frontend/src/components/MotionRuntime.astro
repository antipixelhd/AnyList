<script>
  import {cancelLoadingReveals} from '../lib/loading-reveal';
  import { cancelUiMotion, dismiss, reveal } from '../lib/ui-motion';

  import {mountPressFeedback} from '../lib/press-feedback';
  import {cancelStateFeedback} from '../lib/state-feedback';
  mountPressFeedback(document, window);

  document.addEventListener('click', event => {
    const summary = (event.target as Element | null)?.closest<HTMLElement>('details[data-motion-details] > summary');
    const details = summary?.parentElement as HTMLDetailsElement | null;
    const content = details?.querySelector<HTMLElement>(':scope > :not(summary)');
    if (!details || !content) return;
    event.preventDefault();
    if (!details.open || content.inert) {
      details.removeAttribute('data-motion-closing');
      details.open = true;
      content.inert = false;
      reveal(content);
    } else {
      details.setAttribute('data-motion-closing', '');
      content.inert = true;
      void dismiss(content).then(current => {
        if (current) { details.open = false; details.removeAttribute('data-motion-closing'); content.inert = false; }
      });
    }
  });
  document.addEventListener('astro:before-swap', () => {
    cancelStateFeedback();
    cancelLoadingReveals();
    cancelUiMotion();
  });
  window.addEventListener('pagehide',()=>{cancelLoadingReveals();cancelStateFeedback();});
  matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change',event=>{if(event.matches){cancelLoadingReveals();cancelStateFeedback();}});
</script>
<style is:global>
  [data-score-label], [data-status-value] { display:inline-block; }
</style>
