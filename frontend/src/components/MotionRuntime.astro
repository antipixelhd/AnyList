<script>
  import { animate } from 'motion/mini';
  import { cancelUiMotion, dismiss, reveal } from '../lib/ui-motion';

  const active = new Map<HTMLElement, ReturnType<typeof animate>>();
  const hovered = new Set<HTMLElement>();
  const selector = 'button, [role="button"], input[type="button"], input[type="submit"], input[type="reset"], a.button-primary, a.button-secondary, a.button-quiet, a.button-danger, a.appbar-icon-link, a.personal-score-button, [data-motion-press]';
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = () => matchMedia('(hover: hover) and (pointer: fine)').matches && !reduced();

  function targetFor(event: Event) {
    const element = (event.target as Element | null)?.closest<HTMLElement>(selector);
    return element && !element.matches(':disabled, [aria-disabled="true"], [aria-expanded]') && !element.closest('[data-motion-static]') && element.getClientRects().length ? element : null;
  }

  function animateScale(element: HTMLElement, scale: number, duration: number) {
    active.get(element)?.stop();
    if (reduced()) {
      active.delete(element);
      element.style.removeProperty('scale');
      return;
    }
    const control = animate(element, { scale }, { duration, ease: 'easeOut' });
    active.set(element, control);
    if (scale === 1) void control.finished.then(() => {
      if (active.get(element) === control) {
        active.delete(element);
        element.style.removeProperty('scale');
      }
    }).catch(() => {});
  }

  let pressed: HTMLElement | null = null;
  function release() {
    if (!pressed) return;
    animateScale(pressed, hovered.has(pressed) && !pressed.matches(':disabled, [aria-disabled="true"]') ? 1.005 : 1, .14);
    pressed = null;
  }

  document.addEventListener('pointerover', event => {
    if (!canHover()) return;
    const target = event.target as Element | null;
    const related = event.relatedTarget as Node | null;
    const element = target?.closest<HTMLElement>(selector);
    if (!element || element.contains(related) || !element.getClientRects().length || element.matches(':disabled, [aria-disabled="true"]')) return;
    if (element.matches('.quick-search-trigger, [aria-expanded], [aria-haspopup="menu"], [aria-haspopup="listbox"]') || element.closest('[data-motion-static]')) return;
    if (element.closest('.list-shell .filters') || element.matches('.list-shell .mobile-filter-toggle')) return;
    hovered.add(element);
    if (element !== pressed) animateScale(element, 1.005, .17);
  });
  document.addEventListener('pointerout', event => {
    const target = event.target as Element | null;
    const related = event.relatedTarget as Node | null;
    const element = target?.closest<HTMLElement>(selector);
    if (!element || element.contains(related) || !hovered.delete(element)) return;
    if (element !== pressed) animateScale(element, 1, .16);
  });
  document.addEventListener('pointerdown', event => {
    if (event.button !== 0) return;
    pressed = targetFor(event);
    if (pressed) animateScale(pressed, .985, .09);
  });
  for (const eventName of ['pointerup', 'pointercancel']) {
    document.addEventListener(eventName, release);
  }
  document.addEventListener('keydown', event => {
    if (event.repeat || (event.key !== 'Enter' && event.key !== ' ')) return;
    const element = targetFor(event);
    if (element) { pressed = element; animateScale(element, .985, .09); }
  });
  document.addEventListener('keyup', event => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    release();
  });

  document.addEventListener('click', event => {
    const summary = (event.target as Element | null)?.closest<HTMLElement>('details[data-motion-details] > summary');
    const details = summary?.parentElement as HTMLDetailsElement | null;
    const content = details?.querySelector<HTMLElement>(':scope > :not(summary)');
    if (!details || !content) return;
    event.preventDefault();
    if (!details.open || content.inert) {
      details.open = true;
      content.inert = false;
      reveal(content);
    } else {
      content.inert = true;
      void dismiss(content).then(current => {
        if (current) { details.open = false; content.inert = false; }
      });
    }
  });
  document.addEventListener('astro:before-swap', () => {
    cancelUiMotion();
    for (const [element, control] of active) {
      control.stop();
      element.style.removeProperty('scale');
    }
    active.clear();
    hovered.clear();
    pressed = null;
  });
</script>
