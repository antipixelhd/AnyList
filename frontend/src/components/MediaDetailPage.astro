---
import Tracker from '../layouts/Tracker.astro';
import StatusControl from './StatusControl.astro';
import Icon from './Icon.astro';
import ImageLightbox from './ImageLightbox.astro';
import MediaDetailSeasons from './MediaDetailSeasons.astro';
import MediaDetailFacts from './MediaDetailFacts.astro';
import MediaDetailPerson from './MediaDetailPerson.astro';
import MediaDetailCredits from './MediaDetailCredits.astro';
import MediaDetailCastToggle from './MediaDetailCastToggle.astro';
import MediaDetailWork from './MediaDetailWork.astro';
import {scoreLabel,statuses} from '../lib/tracker';
import {responsiveArtwork} from '../lib/responsive-artwork';
import {detailSceneArtwork} from '../lib/detail-artwork';
import {prepareDetail,kindLabel,detailCredits,detailFacts,detailSynopsis,detailDate,moneyLabel} from '../lib/media-detail-data';
import '../styles/dev-details.css';
import '../styles/dev-marquee.css';
import '../styles/dev-marquee-25.css';
import '../styles/media-details.css';
const {media,library=null,libraryError='',canUseLibrary=false,error=''}=Astro.props;
const title=media?prepareDetail(media):null;
const signedIn=!!Astro.locals.user;
const trackable=title&&['movie','series'].includes(title.type)&&title.tracking_available!==false;
const poster=responsiveArtwork(title?.poster,{size:'w500',sizes:'(max-width:650px) 108px, (max-width:900px) 170px, (max-width:1100px) 190px, 210px',route:Astro.locals.imageCacheEnabled?'proxy':'direct'});
const backdrop=responsiveArtwork(title?.backdrop,{size:'w1280',sizes:'100vw',route:Astro.locals.imageCacheEnabled?'proxy':'direct'});
const reserveBackdrop=!!backdrop||!!(trackable&&title?.image_status?.state!=='ready');
const facts=title?detailFacts(title):[];
const synopsis=detailSynopsis(title?.overview);
const people=title?[...title.people,...title.organizations]:[];
const others=people.filter(person=>person.kind!=='actor');
const credits=title?detailCredits(title):null;
const preview=credits?.preview||[];
const artwork=[...new Set((title?.artwork||[]).filter(Boolean))].slice(0,10) as string[];
const scenes=artwork.filter(url=>url!==title?.backdrop);
const creator=others.filter(person=>person.roles.some(role=>/director|author|creator|developer/i.test(role))).slice(0,2).map(person=>person.name).join(', ');
const tabs=[{id:'overview',label:'Overview'},...(title?.type==='series'?[{id:'seasons',label:'Seasons'}]:[]),...(trackable||people.length?[{id:'people',label:trackable?'Cast & crew':'Creators'}]:[]),...(trackable||artwork.length?[{id:'artwork',label:'Artwork'}]:[])];
const initialTab=tabs.find(tab=>tab.id===Astro.url.searchParams.get('tab'))?.id||'overview';
const sources=[...(title?.sources||[]),...(title?.tmdb_id?[{name:'TMDB',url:`https://www.themoviedb.org/${title.type==='series'?'tv':'movie'}/${title.tmdb_id}`}]:[]),...(title?.imdb_id?[{name:'IMDb',url:`https://www.imdb.com/title/${title.imdb_id}/`}]:[])];
const ratings=[{name:'TMDB',field:'tmdb_score',value:title?.tmdb_score},{name:'IMDb',field:'imdb_score',value:title?.imdb_score},
  {name:'RT Critics',field:'rt_critic_score',value:title?.rt_critic_score},{name:'RT Audience',field:'rt_audience_score',value:title?.rt_audience_score}].filter(rating=>rating.value!=null||title?.scores_pending);
const price=title?.prices.find(row=>moneyLabel(row.current));
const login=`/login?next=${encodeURIComponent(Astro.url.pathname+Astro.url.search)}`;
const encode=(value:unknown)=>JSON.stringify(value).replaceAll('<','\\u003c');
---
<Tracker title={title?.title||'Media'} preloadBodyFonts predictionArtwork={[poster,backdrop].filter(Boolean)}>
{title?<article class="detail-lab concept-marquee concept-marquee-25 concept-marquee-27 media-detail" data-media-detail data-media-kind={title.type} data-has-backdrop={String(reserveBackdrop)} data-spoilers="false">
  {signedIn&&trackable&&<script id="title-editor-data" type="application/json" set:html={encode({...title,people:undefined,organizations:undefined,posters:undefined,artwork:undefined,relations:undefined,similar:undefined,editor_library:{available:!!library?.connections?.length,desired:library?.desired===true}})}/>}
  <header class="lab-hero">
    {(backdrop||trackable)&&<img class="lab-hero-image" src={backdrop?.src} srcset={backdrop?.srcset} sizes={backdrop?.sizes} hidden={!backdrop} alt="" fetchpriority="high"/>}<div class="lab-hero-shade"></div>
    <div class="lab-hero-content">
      {poster?<button class="lab-hero-poster lab-poster-button media-cover" type="button" data-detail-gallery="posters" data-detail-image={poster.src} data-detail-caption={`${title.title} · Cover`} aria-label={`Expand ${title.title} cover`}><img class="lab-poster" src={poster.src} srcset={poster.srcset} sizes={poster.sizes} alt={`${title.title} cover`} fetchpriority="high"/></button>:<div class="lab-hero-poster lab-poster-button media-cover media-cover-empty" aria-hidden="true">{title.title.slice(0,1)}</div>}
      <div class="lab-heading"><p class="lab-kicker"><span>{kindLabel[title.type]}</span>{title.year&&<span>{title.year}</span>}{creator&&<span>{creator}</span>}</p><h1>{title.title}</h1>{title.original_title&&title.original_title.trim().toLocaleLowerCase()!==title.title.trim().toLocaleLowerCase()&&<p class="media-original-title">{title.original_title}</p>}{title.tagline&&<p class="lab-tagline">{title.tagline}</p>}{!!title.genres.length&&<div class="lab-genres">{title.genres.slice(0,6).map(genre=>trackable?<a href={`/browse?type=${title.type}&genre=${encodeURIComponent(genre)}`}>{genre}</a>:<span>{genre}</span>)}</div>}</div>
      {(backdrop||trackable)&&<button class="lab-hero-art-button" type="button" data-detail-image={backdrop?.src} hidden={!backdrop} data-detail-caption={`${title.title} · Main artwork`} aria-label="Expand artwork"><Icon name="zoom-in"/></button>}
    </div>
  </header>
  <div class="lab-layout">
    <aside class="lab-sidebar">
      {trackable&&<section class="lab-tracking media-tracking" aria-label="Your tracking">
        {signedIn?<><div class="media-action-row"><StatusControl mediaId={title.id} status={title.entry?.status}/><button class="media-square media-favorite" type="button" data-favorite-toggle aria-pressed={!!(title.favorite??title.entry?.favorite)} aria-label={(title.favorite??title.entry?.favorite)?'Remove from favorites':'Add to favorites'} title={(title.favorite??title.entry?.favorite)?'Remove from favorites':'Add to favorites'}><Icon name="heart"/></button></div>
        <div class="media-rating-row"><div class="lab-rating-field"><span class="lab-field-label">{title.type==='series'?'Your show score':'Your score'}</span><button class="lab-rating-control media-personal-score" type="button" data-quick-rate-id={title.id} data-quick-rate-title={title.title} data-quick-rate-poster={poster?.src||''} data-quick-rate-score={title.entry?.score??''} data-quick-rate-mode={title.entry?.rating_mode??'manual'} aria-label={`Rate ${title.title}. Current score: ${scoreLabel(title.entry?.score??null)}`}><Icon name="star"/><strong data-score-label>{scoreLabel(title.entry?.score??null)}</strong><span>/ 10</span></button></div>{canUseLibrary&&<button class="media-square media-library" type="button" data-library-toggle aria-pressed={!!library?.desired} aria-label={library?.desired?'Remove from library':'Add to library'} title={library?.desired?'Remove from library':'Add to library'} disabled={!library}><Icon name="list"/></button>}</div>
        </>:<a class="lab-primary-button" href={login}>Sign in to add to your list <Icon name="plus"/></a>}
        {libraryError&&<p class="error-message" role="alert">{libraryError}</p>}
      </section>}
      <section class="lab-facts"><h2>Information</h2><MediaDetailFacts facts={facts} title={title}/></section>
      {!!sources.length&&<nav class="lab-source-links" aria-label="Metadata sources">{[...new Map(sources.map(source=>[source.url,source])).values()].map(source=><a href={source.url} target="_blank" rel="noreferrer">{source.name}<Icon name="external"/></a>)}</nav>}
    </aside>
    <div class="lab-main">
      <div class="lab-section-navigation"><div class="lab-tabs" role="tablist" aria-label="Media details">{tabs.map(tab=><button type="button" role="tab" id={`detail-tab-${tab.id}`} aria-controls={`detail-panel-${tab.id}`} aria-selected={tab.id===initialTab} tabindex={tab.id===initialTab?0:-1} data-detail-tab={tab.id}>{tab.label}</button>)}</div></div>
      <div data-detail-panels>
        <div class="lab-panel" id="detail-panel-overview" role="tabpanel" aria-labelledby="detail-tab-overview" data-detail-panel="overview" hidden={initialTab!=='overview'}>
          <div class="lab-overview-grid">
            <div class="lab-primary-column">
              <section class="lab-story lab-module" data-detail-synopsis><div class="lab-section-title"><h2>Overview</h2></div><p id="detail-synopsis" data-biography-text>{synopsis.lead||'No synopsis available yet.'}<span data-biography-ellipsis hidden={!synopsis.shortened}>…</span><span data-biography-rest hidden>{synopsis.rest}</span></p>{synopsis.expandable&&<button class="lab-text-button" type="button" data-biography-toggle aria-expanded="false" aria-controls="detail-synopsis">Read more</button>}<noscript><style>{`.media-detail [data-biography-rest][hidden] { display:inline!important; } .media-detail [data-biography-toggle],.media-detail [data-biography-ellipsis] { display:none!important; }`}</style></noscript></section>
              <section class="lab-inline-facts lab-module"><h2>Information</h2><MediaDetailFacts facts={facts} title={title}/></section>
              {(trackable||!!preview.length)&&<section class="lab-people-preview lab-module"><div class="lab-section-title"><h2>{trackable?'Cast & crew':'Creators'}</h2><div class="media-cast-controls">{(trackable||!!credits?.cast.length)&&<MediaDetailCastToggle/>}<button class="lab-text-button" type="button" data-detail-open-tab="people">View all <Icon name="arrow-right"/></button></div></div><p class="detail-load-status" data-detail-people-status hidden></p><div class="lab-person-grid" data-cast-content data-credit-preview>{preview.map(person=><MediaDetailPerson person={person} primary/>)}{!preview.length&&trackable&&Array.from({length:8},()=> <div class="detail-person-skeleton" aria-hidden="true"><span></span><div></div></div>)}</div></section>}
              {(trackable||!!scenes.length)&&<section class="lab-art-preview lab-module"><div class="lab-section-title"><h2>In the frame</h2></div><button class:list={['lab-art-image',{'detail-image-skeleton':!scenes.length}]} type="button" data-detail-image={scenes[0]||''} data-detail-caption={`${title.title} · Scene`} aria-label={`Expand ${title.title} scene`}><img {...(detailSceneArtwork(scenes[0],backdrop,Astro.locals.imageCacheEnabled?'proxy':'direct')||{})} hidden={!scenes.length} alt={`${title.title} scene`} loading="lazy"/></button></section>}
              {!!title.editions.length&&<section class="lab-module"><div class="lab-section-title"><h2>Editions</h2></div><div class="media-editions">{title.editions.map(edition=><article>{edition.image&&<img src={edition.image} alt="" loading="lazy"/>}<div><h3>{edition.name}</h3><p>{[edition.format,edition.language,edition.pages?`${edition.pages} pages`:null,detailDate(edition.release_date)].filter(Boolean).join(' · ')}</p></div></article>)}</div></section>}
              {!!title.releases.length&&<section class="lab-module"><div class="lab-section-title"><h2>Releases</h2></div><div class="media-releases">{title.releases.map(release=><p><strong>{release.platform}</strong><span>{[release.region,detailDate(release.release_date)].filter(Boolean).join(' · ')}</span></p>)}</div></section>}
            </div>
            <div class="lab-secondary-column">
              {!!ratings.length&&<section class="lab-public-score lab-module" aria-labelledby="detail-audience-heading"><div class="lab-section-title"><h2 id="detail-audience-heading">Audience score</h2></div><div class="media-provider-ratings">{ratings.map(({name,field,value})=><p><span>{name}</span><strong data-detail-score={field} class:list={{'detail-value-skeleton':value==null}}>{value==null?'':name.startsWith('RT')?`${Math.round(Number(value))}%`:scoreLabel(Number(value))}</strong></p>)}</div><p class="detail-load-status" data-detail-score-status hidden></p></section>}
              {price&&<section class="lab-game-offer lab-module"><div class="lab-offer-edition"><h2>Steam · {price.country}</h2><p>Updated {detailDate(price.fetched_at)}</p></div><div class="lab-offer-pricing"><strong>{moneyLabel(price.current)}</strong></div>{moneyLabel(price.historical_low)&&<p class="media-price-low">Lowest {moneyLabel(price.historical_low)}{price.historical_low_at&&` · ${detailDate(price.historical_low_at)}`}</p>}{price.url&&<a class="lab-primary-button" href={price.url} target="_blank" rel="noreferrer">View on Steam <Icon name="external"/></a>}</section>}
              {!!title.friends.length&&<section class="lab-friends lab-module"><div class="lab-section-title"><h2>People you follow</h2><span><Icon name="star"/>{scoreLabel(title.friends_average??null)}</span></div><div class="lab-friends-grid">{title.friends.map(friend=><a class="lab-friend" href={`/user/${encodeURIComponent(friend.username)}/${title.type==='movie'?'movies':'series'}`}><span class="lab-friend-avatar friend-one" aria-hidden="true">{friend.id&&friend.has_avatar?<img src={`/api/proxy/profile/avatar/${friend.id}`} alt="" loading="lazy"/>:friend.username.slice(0,1).toUpperCase()}</span><div><h3>{friend.display_name||friend.username}</h3><p>{statuses.find(([id])=>id===friend.status)?.[1]||friend.status}</p></div><strong>{scoreLabel(friend.score)}</strong></a>)}</div></section>}
              {signedIn&&trackable&&<section class="lab-note lab-module"><div class="lab-section-title"><h2><label for="detail-note">Personal note</label></h2><Icon name="comment"/></div><textarea id="detail-note" rows="3" placeholder="Something worth remembering…">{title.entry?.notes||''}</textarea><div class="lab-note-footer"><button class="lab-text-button" type="button" data-detail-save-note>Save <Icon name="check"/></button></div></section>}
            </div>
            <section class="lab-related lab-module" data-detail-related hidden={!title.relations.length}><div class="lab-section-title"><h2>Relations</h2></div><div class="lab-related-grid" data-detail-related-grid>{title.relations.map(work=><MediaDetailWork work={work}/>)}</div></section>
            <section class="lab-similar lab-module" data-detail-similar hidden={!title.similar.length}><div class="lab-section-title"><h2>Similar {title.type==='series'?'series':`${title.type}s`}</h2></div><div class="lab-similar-grid" data-detail-similar-grid>{title.similar.map(work=><MediaDetailWork work={work} similar/>)}</div></section>
          </div>
        </div>
        {title.type==='series'&&<section class="lab-panel" id="detail-panel-seasons" role="tabpanel" aria-labelledby="detail-tab-seasons" data-detail-panel="seasons" hidden={initialTab!=='seasons'}><MediaDetailSeasons title={title} signedIn={signedIn}/></section>}
        {(trackable||!!people.length)&&<section class="lab-panel" id="detail-panel-people" role="tabpanel" aria-labelledby="detail-tab-people" data-detail-panel="people" hidden={initialTab!=='people'}><p class="detail-load-status" data-detail-people-status hidden></p>{credits&&<><MediaDetailCredits label="Cast" rows={credits.cast} id="cast" loading={!!trackable&&!credits.cast.length}/><MediaDetailCredits label={trackable?'Crew':'Creators'} rows={credits.principal} id="crew"/><MediaDetailCredits label={credits.principal.length?'Other crew':'Crew'} rows={credits.supporting} id="supporting" secondary/><MediaDetailCredits label="Studios" rows={credits.studios} id="studios" limit={6}/></>}</section>}
        {(trackable||!!artwork.length)&&<section class="lab-panel" id="detail-panel-artwork" role="tabpanel" aria-labelledby="detail-tab-artwork" data-detail-panel="artwork" hidden={initialTab!=='artwork'}><p class="section-empty" data-detail-artwork-status hidden></p><div class="lab-gallery" data-detail-artwork-grid>{artwork.map((url,index)=><button type="button" data-detail-image={url} data-detail-caption={`${title.title} · Artwork ${index+1}`} aria-label={`Expand artwork ${index+1}`}><img data-gallery-src={responsiveArtwork(url,{size:'w500',route:Astro.locals.imageCacheEnabled?'proxy':'direct'})?.src} alt={`${title.title}, artwork ${index+1}`} loading="lazy"/></button>)}</div></section>}
      </div>
    </div>
  </div>
  <ImageLightbox id="detail-lightbox" gallery/>
  <script id="media-detail-data" type="application/json" set:html={encode({id:title.id,type:title.type,relatedPending:signedIn&&trackable&&title.related_pending,imagesAvailable:signedIn&&trackable,heroAvailable:trackable,backgroundAvailable:signedIn&&trackable,characterStatus:title.character_status,imageStatus:title.image_status,posters:title.posters,artwork})}/>
  <template data-detail-person-template><MediaDetailPerson person={{id:0,kind:'actor',name:'',image:null,url:'#',roles:[],characters:[]}}/></template>
  <template data-detail-work-icons><span class="media-work-placeholder" aria-hidden="true"><Icon name="film"/></span><Icon name="arrow-right"/></template>
</article>:<div class="page-width"><p class="error-message" role="alert">{error||'Media not found.'}</p><a class="button-secondary" href="/browse">Browse</a></div>}
</Tracker>
<script>
import {mountMediaDetail} from '../lib/media-detail';
mountMediaDetail();
document.addEventListener('astro:page-load',mountMediaDetail);
</script>
