---
import Tracker from '../layouts/Tracker.astro';
import StatusControl from './StatusControl.astro';
import Icon from './Icon.astro';
import MediaDetailSeasons from './MediaDetailSeasons.astro';
import MediaDetailPerson from './MediaDetailPerson.astro';
import MediaDetailWork from './MediaDetailWork.astro';
import {scoreLabel,statuses} from '../lib/tracker';
import {responsiveArtwork} from '../lib/responsive-artwork';
import {prepareDetail,kindLabel,detailFacts,detailSynopsis,progressTotal,detailDate,moneyLabel} from '../lib/media-detail-data';
import '../styles/dev-details.css';
import '../styles/dev-marquee.css';
import '../styles/dev-marquee-25.css';
import '../styles/dev-marquee-27.css';
import '../styles/media-details.css';
const {media,library=null,libraryError='',canUseLibrary=false,error=''}=Astro.props;
const title=media?prepareDetail(media):null;
const signedIn=!!Astro.locals.user;
const trackable=title&&['movie','series'].includes(title.type)&&title.tracking_available!==false;
const poster=responsiveArtwork(title?.poster,{size:'w500',sizes:'(max-width:360px) 92px, (max-width:650px) 110px, (max-width:900px) 170px, (max-width:1100px) 190px, 210px',route:'direct'});
const backdrop=responsiveArtwork(title?.backdrop,{size:'w1280',sizes:'100vw',route:'direct'});
const facts=title?detailFacts(title):[];
const synopsis=detailSynopsis(title?.overview);
const total=title?progressTotal(title):null;
const people=title?[...title.people,...title.organizations]:[];
const cast=people.filter(person=>person.kind==='actor');
const others=people.filter(person=>person.kind!=='actor');
const preview=[...cast.slice(0,4),...others.slice(0,4)];
const artwork=[...new Set([...(title?.artwork||[]),title?.backdrop].filter(Boolean))] as string[];
const scenes=artwork.filter(url=>url!==title?.backdrop);
const creator=others.filter(person=>person.roles.some(role=>/director|author|creator|developer/i.test(role))).slice(0,2).map(person=>person.name).join(', ');
const tabs=[{id:'overview',label:'Overview'},...(title?.type==='series'?[{id:'seasons',label:'Seasons'}]:[]),...(people.length?[{id:'people',label:trackable?'Cast & crew':'Creators'}]:[]),...(artwork.length?[{id:'artwork',label:'Artwork'}]:[])];
const sources=[...(title?.sources||[]),...(title?.tmdb_id?[{name:'TMDB',url:`https://www.themoviedb.org/${title.type==='series'?'tv':'movie'}/${title.tmdb_id}`}]:[]),...(title?.imdb_id?[{name:'IMDb',url:`https://www.imdb.com/title/${title.imdb_id}/`}]:[])];
const audience=title?.tmdb_score!=null?{name:'TMDB',value:title.tmdb_score}:title?.imdb_score!=null?{name:'IMDb',value:title.imdb_score}:null;
const price=title?.prices.find(row=>moneyLabel(row.current));
const login=`/login?next=${encodeURIComponent(Astro.url.pathname+Astro.url.search)}`;
const encode=(value:unknown)=>JSON.stringify(value).replaceAll('<','\\u003c');
---
<Tracker title={title?.title||'Media'} preloadBodyFonts>
{title?<article class="detail-lab concept-marquee concept-marquee-25 concept-marquee-27 media-detail" data-media-detail data-media-kind={title.type}>
  {signedIn&&trackable&&<script id="title-editor-data" type="application/json" set:html={encode({...title,editor_library:{available:!!library?.connections?.length,desired:library?.desired===true}})}/>}
  <header class="lab-hero">
    {backdrop&&<img class="lab-hero-image" src={backdrop.src} srcset={backdrop.srcset} sizes={backdrop.sizes} alt="" fetchpriority="high"/>}<div class="lab-hero-shade"></div>
    <div class="lab-hero-content">
      {poster?<button class="lab-hero-poster lab-poster-button media-cover" type="button" data-detail-image={poster.src} data-detail-caption={`${title.title} · Cover`} aria-label={`Expand ${title.title} cover`}><img class="lab-poster" src={poster.src} srcset={poster.srcset} sizes={poster.sizes} alt={`${title.title} cover`} fetchpriority="high"/></button>:<div class="lab-hero-poster lab-poster-button media-cover media-cover-empty" aria-hidden="true">{title.title.slice(0,1)}</div>}
      <div class="lab-heading"><p class="lab-kicker"><span>{kindLabel[title.type]}</span>{title.year&&<span>{title.year}</span>}{creator&&<span>{creator}</span>}</p><h1>{title.title}</h1>{title.original_title&&title.original_title!==title.title&&<p class="media-original-title">{title.original_title}</p>}{title.tagline&&<p class="lab-tagline">{title.tagline}</p>}{!!title.genres.length&&<div class="lab-genres">{title.genres.slice(0,6).map(genre=>trackable?<a href={`/browse?type=${title.type}&genre=${encodeURIComponent(genre)}`}>{genre}</a>:<span>{genre}</span>)}</div>}</div>
      {backdrop&&<button class="lab-hero-art-button" type="button" data-detail-image={backdrop.src} data-detail-caption={`${title.title} · Main artwork`} aria-label="Expand artwork"><Icon name="zoom-in"/></button>}
    </div>
  </header>
  <div class="lab-layout">
    <aside class="lab-sidebar">
      {trackable&&<section class="lab-tracking media-tracking" aria-label="Your tracking">
        {signedIn?<><div class="media-action-row"><StatusControl mediaId={title.id} status={title.entry?.status}/><button class="media-square media-favorite" type="button" data-favorite-toggle aria-pressed={!!title.entry?.favorite} aria-label={title.entry?.favorite?'Remove from favorites':'Add to favorites'} title={title.entry?.favorite?'Remove from favorites':'Add to favorites'}><Icon name="heart"/></button></div>
        <div class="media-rating-row"><div class="lab-rating-field"><span class="lab-field-label">{title.type==='series'?'Your show score':'Your score'}</span><button class="lab-rating-control media-personal-score" type="button" data-quick-rate-id={title.id} data-quick-rate-title={title.title} data-quick-rate-poster={poster?.src||''} data-quick-rate-score={title.entry?.score??''} data-quick-rate-mode={title.entry?.rating_mode??'manual'} aria-label={`Rate ${title.title}. Current score: ${scoreLabel(title.entry?.score??null)}`}><Icon name="star"/><strong data-score-label>{scoreLabel(title.entry?.score??null)}</strong><span>/ 10</span></button></div>{canUseLibrary&&<button class="media-square media-library" type="button" data-library-toggle aria-pressed={!!library?.desired} aria-label={library?.desired?'Remove from library':'Add to library'} title={library?.desired?'Remove from library':'Add to library'} disabled={!library}><Icon name="list"/></button>}</div>
        <div class="lab-progress-field media-progress" data-detail-progress hidden={!title.entry}><span class="lab-field-label">Progress</span><div class="media-progress-value"><span data-detail-progress-label>{title.type==='movie'?title.entry?.progress?'Watched':'Unwatched':`${title.entry?.progress||0}${total?` / ${total}`:''} episodes watched`}</span><button class="lab-text-button" type="button" data-edit-entry={title.id} aria-label="Edit progress"><Icon name="edit"/></button></div></div>
        </>:<a class="lab-primary-button" href={login}>Sign in to add to your list <Icon name="plus"/></a>}
        {libraryError&&<p class="error-message" role="alert">{libraryError}</p>}
      </section>}
      <section class="lab-facts"><h2>Information</h2><dl>{facts.map(fact=><div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}{title.organizations.map(person=><div><dt>{person.roles.join(', ')}</dt><dd>{person.url?<a href={person.url}>{person.name}</a>:person.name}</dd></div>)}{!!title.creators?.length&&<div><dt>Created by</dt><dd>{title.creators!.map(p=>p.name).join(', ')}</dd></div>}{!!title.networks?.length&&<div><dt>Networks</dt><dd>{title.networks!.map(p=>p.name).join(', ')}</dd></div>}</dl></section>
      {!!sources.length&&<nav class="lab-source-links" aria-label="Metadata sources">{[...new Map(sources.map(source=>[source.url,source])).values()].map(source=><a href={source.url} target="_blank" rel="noreferrer">{source.name}<Icon name="external"/></a>)}</nav>}
    </aside>
    <div class="lab-main">
      <div class="lab-section-navigation"><div class="lab-tabs" role="tablist" aria-label="Media details">{tabs.map((tab,i)=><button type="button" role="tab" id={`detail-tab-${tab.id}`} aria-controls={`detail-panel-${tab.id}`} aria-selected={i===0} tabindex={i===0?0:-1} data-detail-tab={tab.id}>{tab.label}</button>)}</div></div>
      <div data-detail-panels>
        <div class="lab-panel" id="detail-panel-overview" role="tabpanel" aria-labelledby="detail-tab-overview" data-detail-panel="overview">
          <div class="lab-overview-grid">
            <div class="lab-primary-column">
              <section class="lab-story lab-module" data-detail-synopsis><div class="lab-section-title"><h2>Overview</h2></div><p data-biography-text>{synopsis.lead||'No synopsis available yet.'}<span data-biography-ellipsis hidden={!synopsis.shortened}>…</span><span data-biography-rest hidden>{synopsis.rest}</span></p>{synopsis.expandable&&<button class="lab-text-button" type="button" data-biography-toggle aria-expanded="false">Read more</button>}</section>
              {!!title.friends.length&&<section class="lab-friends lab-module"><div class="lab-section-title"><h2>People you follow</h2><span><Icon name="star"/>{scoreLabel(title.friends_average??null)}</span></div><div class="lab-friends-grid">{title.friends.map(friend=><a class="lab-friend" href={`/user/${encodeURIComponent(friend.username)}/${title.type==='movie'?'movies':'series'}`}><span class="lab-friend-avatar friend-one" aria-hidden="true">{friend.id&&friend.has_avatar?<img src={`/api/proxy/profile/avatar/${friend.id}`} alt="" loading="lazy"/>:friend.username.slice(0,1).toUpperCase()}</span><div><h3>{friend.display_name||friend.username}</h3><p>{statuses.find(([id])=>id===friend.status)?.[1]||friend.status}</p></div><strong>{scoreLabel(friend.score)}</strong></a>)}</div></section>}
              <section class="lab-inline-facts lab-module"><h2>Information</h2><dl>{facts.map(fact=><div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}{title.organizations.map(person=><div><dt>{person.roles.join(', ')}</dt><dd>{person.url?<a href={person.url}>{person.name}</a>:person.name}</dd></div>)}</dl></section>
              {!!preview.length&&<section class="lab-people-preview lab-module"><div class="lab-section-title"><h2>{trackable?'Cast & crew':'Creators'}</h2><button class="lab-text-button" type="button" data-detail-open-tab="people">View all <Icon name="arrow-right"/></button></div><div class="lab-person-grid">{preview.map(person=><MediaDetailPerson person={person}/>)}</div></section>}
              {!!scenes.length&&<section class="lab-art-preview lab-module"><div class="lab-section-title"><h2>In the frame</h2></div><button class="lab-art-image" type="button" data-detail-image={scenes[0]} data-detail-caption={`${title.title} · Scene`} aria-label={`Expand ${title.title} scene`}><img src={scenes[0]} alt={`${title.title} scene`} loading="lazy"/></button></section>}
              {!!title.editions.length&&<section class="lab-module"><div class="lab-section-title"><h2>Editions</h2></div><div class="media-editions">{title.editions.map(edition=><article>{edition.image&&<img src={edition.image} alt="" loading="lazy"/>}<div><h3>{edition.name}</h3><p>{[edition.format,edition.language,edition.pages?`${edition.pages} pages`:null,detailDate(edition.release_date)].filter(Boolean).join(' · ')}</p></div></article>)}</div></section>}
              {!!title.releases.length&&<section class="lab-module"><div class="lab-section-title"><h2>Releases</h2></div><div class="media-releases">{title.releases.map(release=><p><strong>{release.platform}</strong><span>{[release.region,detailDate(release.release_date)].filter(Boolean).join(' · ')}</span></p>)}</div></section>}
            </div>
            <div class="lab-secondary-column">
              {audience&&<section class="lab-public-score lab-module" aria-label="Ratings"><p class="lab-kicker">Audience score · {audience.name}</p><div class="lab-big-score"><Icon name="star"/><strong>{scoreLabel(audience.value)}</strong><span>/ 10</span></div><div class="media-provider-ratings">{[['IMDb',title.imdb_score],['TMDB',title.tmdb_score],['RT Critics',title.rt_critic_score],['RT Audience',title.rt_audience_score]].filter(([name,value])=>value!=null&&name!==audience.name).map(([name,value])=><p><span>{name}</span><strong>{String(name).startsWith('RT')?`${Math.round(Number(value))}%`:scoreLabel(Number(value))}</strong></p>)}</div></section>}
              {price&&<section class="lab-game-offer lab-module"><div class="lab-offer-edition"><h2>Steam · {price.country}</h2><p>Updated {detailDate(price.fetched_at)}</p></div><div class="lab-offer-pricing"><strong>{moneyLabel(price.current)}</strong></div>{moneyLabel(price.historical_low)&&<p class="media-price-low">Lowest {moneyLabel(price.historical_low)}{price.historical_low_at&&` · ${detailDate(price.historical_low_at)}`}</p>}{price.url&&<a class="lab-primary-button" href={price.url} target="_blank" rel="noreferrer">View on Steam <Icon name="external"/></a>}</section>}
              {signedIn&&trackable&&<section class="lab-note lab-module"><div class="lab-section-title"><h2><label for="detail-note">Personal note</label></h2><Icon name="comment"/></div><textarea id="detail-note" rows="3" placeholder="Something worth remembering…">{title.entry?.notes||''}</textarea><div class="lab-note-footer"><button class="lab-text-button" type="button" data-detail-save-note>Save <Icon name="check"/></button></div></section>}
            </div>
            <section class="lab-related lab-module" data-detail-related hidden={!title.relations.length}><div class="lab-section-title"><h2>Relations</h2></div><div class="lab-related-grid" data-detail-related-grid>{title.relations.map(work=><MediaDetailWork work={work}/>)}</div></section>
            <section class="lab-similar lab-module" data-detail-similar hidden={!title.similar.length}><div class="lab-section-title"><h2>Similar {title.type==='series'?'series':`${title.type}s`}</h2></div><div class="lab-similar-grid" data-detail-similar-grid>{title.similar.map(work=><MediaDetailWork work={work} similar/>)}</div></section>
          </div>
        </div>
        {title.type==='series'&&<section class="lab-panel" id="detail-panel-seasons" role="tabpanel" aria-labelledby="detail-tab-seasons" data-detail-panel="seasons" hidden><MediaDetailSeasons title={title} signedIn={signedIn}/></section>}
        {!!people.length&&<section class="lab-panel" id="detail-panel-people" role="tabpanel" aria-labelledby="detail-tab-people" data-detail-panel="people" hidden>{[...(cast.length?[{label:'Cast',rows:cast}]:[]),...(others.length?[{label:trackable?'Crew & studios':'Creators',rows:others}]:[])].map(group=><section class="lab-module media-credit-group"><div class="lab-section-title"><h2>{group.label}</h2></div><div class="lab-person-grid">{group.rows.map(person=><MediaDetailPerson person={person}/>)}</div></section>)}</section>}
        {!!artwork.length&&<section class="lab-panel" id="detail-panel-artwork" role="tabpanel" aria-labelledby="detail-tab-artwork" data-detail-panel="artwork" hidden><div class="lab-gallery">{artwork.map((url,index)=><button type="button" data-detail-image={url} data-detail-caption={`${title.title} · Artwork ${index+1}`} aria-label={`Expand artwork ${index+1}`}><img src={url} alt={`${title.title}, artwork ${index+1}`} loading="lazy"/></button>)}</div></section>}
      </div>
    </div>
  </div>
  <dialog class="media-lightbox" id="detail-lightbox" aria-labelledby="detail-lightbox-caption"><button class="media-square media-lightbox-close" type="button" data-detail-close-lightbox aria-label="Close artwork"><Icon name="close"/></button><button class="media-square" type="button" data-detail-image-step="-1" aria-label="Previous artwork"><Icon name="chevron-left"/></button><img data-detail-lightbox-image alt=""/><button class="media-square" type="button" data-detail-image-step="1" aria-label="Next artwork"><Icon name="chevron-right"/></button><p id="detail-lightbox-caption"></p></dialog>
  <script id="media-detail-data" type="application/json" set:html={encode({id:title.id,type:title.type,total,relatedPending:signedIn&&trackable&&title.related_pending})}/>
</article>:<div class="page-width"><p class="error-message" role="alert">{error||'Media not found.'}</p><a class="button-secondary" href="/browse">Browse</a></div>}
</Tracker>
<script>
import {mountMediaDetail} from '../lib/media-detail';
mountMediaDetail();
document.addEventListener('astro:page-load',mountMediaDetail);
</script>
