---
import {statuses} from '../lib/tracker';
import Icon from './Icon.astro';
import CalendarDateInput from './CalendarDateInput.astro';
---
<dialog class="editor" id="tracking-editor" aria-labelledby="editor-title" data-motion-static>
  <div class="editor-hero">
    <img id="editor-backdrop" class="editor-backdrop" alt="" />
    <div class="editor-hero-shade"></div>
    <img id="editor-poster" class="editor-poster" alt="" />
    <div class="editor-heading"><span id="editor-media-type">Entry</span><h2 id="editor-title">Edit entry</h2></div>
    <div class="editor-hero-actions">
      <button type="button" class="editor-library editor-icon-button" data-editor-library hidden aria-label="Add to library" aria-pressed="false"><Icon name="list" /></button>
      <label class="editor-favorite" title="Favorite"><input name="favorite" type="checkbox" form="tracking-form" aria-label="Favorite"/><Icon name="heart" /></label>
      <button type="submit" form="tracking-form" class="button-primary editor-save">Save</button>
    </div>
    <button type="button" class="editor-close editor-icon-button" aria-label="Close editor"><Icon name="close" /></button>
  </div>
  <form id="tracking-form">
    <div class="editor-fields">
      <div class="editor-status-field"><label id="editor-status-label" for="editor-status-trigger">Status</label><select name="status" class="editor-status-native" tabindex="-1" aria-hidden="true">{statuses.map(([value,label]) => <option value={value}>{label}</option>)}</select><div class="editor-status-dropdown" data-motion-static><button type="button" id="editor-status-trigger" class="editor-status-trigger tracker-dropdown-trigger" aria-labelledby="editor-status-label editor-status-value" aria-haspopup="listbox" aria-expanded="false" aria-controls="editor-status-options"><span id="editor-status-value">Watching</span><Icon name="chevron-down" /></button><div id="editor-status-options" class="editor-status-options tracker-dropdown-menu" role="listbox" aria-labelledby="editor-status-label" hidden>{statuses.map(([value,label]) => <button type="button" role="option" aria-selected="false" data-editor-status={value}>{label}</button>)}</div></div></div>
      <div class="editor-score-field"><label for="editor-manual-score">Score</label><div class="score-stepper" data-score-stepper><input id="editor-manual-score" name="manual_score" type="number" min="0" max="10" step="0.1" value="0"/><span class="score-stepper-controls"><button type="button" data-score-step="up" aria-label="Increase score to the next half point"><Icon name="chevron-down" rotate={180} /></button><button type="button" data-score-step="down" aria-label="Decrease score to the previous half point"><Icon name="chevron-down" /></button></span></div></div>
      <div id="progress-field" class="editor-number-field"><label for="editor-progress">Episode progress</label><div class="score-stepper" data-number-stepper><input id="editor-progress" name="progress" type="number" min="0" step="1"/><span class="score-stepper-controls"><button type="button" data-score-step="up" aria-label="Increase episode progress"><Icon name="chevron-down" rotate={180}/></button><button type="button" data-score-step="down" aria-label="Decrease episode progress"><Icon name="chevron-down"/></button></span></div></div>
      <div class="editor-start-date"><label for="editor-start-date">Start date</label><CalendarDateInput id="editor-start-date" name="start_date" label="Start date"/></div><div class="editor-finish-date"><label for="editor-finish-date">Finish date</label><CalendarDateInput id="editor-finish-date" name="finish_date" label="Finish date"/></div>
      <label class="editor-rewatches editor-number-field" for="editor-rewatches">Total rewatches<span class="score-stepper" data-number-stepper><input id="editor-rewatches" aria-label="Total rewatches" name="rewatch_count" type="number" min="0" max="10000" step="1"/><span class="score-stepper-controls"><button type="button" data-score-step="up" aria-label="Increase total rewatches"><Icon name="chevron-down" rotate={180}/></button><button type="button" data-score-step="down" aria-label="Decrease total rewatches"><Icon name="chevron-down"/></button></span></span></label>
      <label class="wide editor-notes">Notes<textarea name="notes" rows="2"></textarea></label>
    </div>
    <p id="editor-error" role="alert" class="error-message" hidden></p>
    <div class="editor-actions">
      <button type="button" class="editor-delete-button" id="delete-tracked-entry"><Icon name="trash" />Delete entry</button>
    </div>
  </form>
</dialog>
<dialog class="editor-confirmation" id="editor-confirmation" aria-labelledby="editor-confirmation-title" aria-describedby="editor-confirmation-body" data-motion-static>
  <form method="dialog">
    <header><h2 id="editor-confirmation-title">Warning</h2><button type="submit" class="editor-confirmation-close" value="cancel" aria-label="Close confirmation"><Icon name="close" /></button></header>
    <p id="editor-confirmation-body"></p>
    <div class="editor-confirmation-actions"><button type="submit" value="cancel" autofocus>Cancel</button><button type="submit" value="confirm">OK</button></div>
  </form>
</dialog>
<dialog class="score-override-dialog" id="editor-score-override" aria-labelledby="score-override-title">
  <form method="dialog">
    <button type="submit" class="score-override-close editor-icon-button" value="cancel" aria-label="Close season rating confirmation"><Icon name="close" /></button>
    <span class="eyebrow">Season ratings</span>
    <h2 id="score-override-title">Use a separate show score?</h2>
    <p>Your current score is calculated from rated seasons. Saving this value will switch the show to a separate manual score; your season ratings stay unchanged.</p>
    <div class="season-mode-actions"><button class="button-primary" value="confirm">Use manual score</button><button class="button-secondary" value="cancel">Keep season average</button></div>
  </form>
</dialog>
<script>
import { setupScoreSteppers } from '../lib/scoreStepper';
import { setupCalendarDateInputs } from '../lib/calendar-date-input';
import { editorStore, seedEditorPage, type EditorTitle } from '../lib/editor-store';
import { showDialog, closeDialog, showMenu, hideMenu } from '../lib/ui-motion';
import {confirmEntryAction as confirmAction,watchRollbackWarning} from '../lib/entry-confirmation';
let pageListeners: AbortController;
document.addEventListener('astro:before-swap', () => pageListeners?.abort());
document.addEventListener('astro:page-load', () => {
  pageListeners?.abort();
  pageListeners = new AbortController();
  const sessionSignal = pageListeners.signal;
  if (!document.querySelector('#tracking-editor')) return;
  const dialog = document.querySelector<HTMLDialogElement>('#tracking-editor')!;
  const confirmEntryAction = (message:string) => confirmAction(message,sessionSignal);
  setupScoreSteppers(dialog, sessionSignal);
  const refreshDateInputs = setupCalendarDateInputs(dialog, sessionSignal);
  const form = document.querySelector<HTMLFormElement>('#tracking-form')!;
  let current: any = null;
  let currentTitle: EditorTitle | null = null;
  let opener: HTMLElement | null = null;
  let loadController: AbortController | null = null;
  let displayedScore = '';
  const libraryButton = dialog.querySelector<HTMLButtonElement>('[data-editor-library]')!;
  let libraryDesired = false;
  seedEditorPage();
  document.addEventListener('media-tracker:rating-changed', event => {
    const saved = (event as CustomEvent).detail;
    if (saved.status) editorStore.acceptSaved(saved);
    else editorStore.invalidate(saved.id);
  }, {signal:pageListeners.signal});
  document.addEventListener('anylist:entry-saved', event => {
    const saved = (event as CustomEvent).detail;
    editorStore.acceptSaved(saved);
  }, {signal:pageListeners.signal});
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const error = document.querySelector<HTMLElement>('#editor-error')!;
  const saveButton = dialog.querySelector<HTMLButtonElement>('.editor-save')!;
  const statusTrigger = dialog.querySelector<HTMLButtonElement>('#editor-status-trigger')!;
  const statusValue = dialog.querySelector<HTMLElement>('#editor-status-value')!;
  const statusOptions = dialog.querySelector<HTMLElement>('#editor-status-options')!;
  const statusButtons = [...statusOptions.querySelectorAll<HTMLButtonElement>('[data-editor-status]')];
  const closeStatus = () => { void hideMenu(statusOptions); statusTrigger.setAttribute('aria-expanded', 'false'); };
  const syncStatus = () => {
    const selected = statusButtons.find(button => button.dataset.editorStatus === field('status').value);
    statusValue.textContent = selected?.textContent || 'Status';
    statusButtons.forEach(button => button.setAttribute('aria-selected', String(button === selected)));
  };
  statusTrigger.addEventListener('click', () => {
    if (statusTrigger.getAttribute('aria-expanded') !== 'true') {
      showMenu(statusOptions);
      statusTrigger.setAttribute('aria-expanded', 'true');
    } else closeStatus();
  });
  statusTrigger.addEventListener('keydown', event => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault(); showMenu(statusOptions); statusTrigger.setAttribute('aria-expanded', 'true');
      (statusButtons.find(button => button.dataset.editorStatus === field('status').value) || statusButtons[0])?.focus();
    }
  });
  statusOptions.addEventListener('click', event => {
    const selected = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-editor-status]');
    if (!selected) return;
    field('status').value = selected.dataset.editorStatus!;
    syncStatus(); closeStatus(); statusTrigger.focus();
  });
  statusOptions.addEventListener('keydown', event => {
    const index = statusButtons.indexOf(document.activeElement as HTMLButtonElement);
    if (event.key === 'Escape') { event.preventDefault(); closeStatus(); statusTrigger.focus(); }
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp' || event.key === 'Home' || event.key === 'End') {
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? statusButtons.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + statusButtons.length) % statusButtons.length;
      statusButtons[next]?.focus();
    }
  });
  dialog.addEventListener('click', event => { if (!statusTrigger.contains(event.target as Node) && !statusOptions.contains(event.target as Node)) closeStatus(); });
  dialog.addEventListener('focusout', event => { if (!statusTrigger.contains(event.relatedTarget as Node) && !statusOptions.contains(event.relatedTarget as Node)) closeStatus(); });
  const closeEditor = () => {
    if (!dialog.open) return;
    void closeDialog(dialog);
  };
  function finishEditing() {
    // Keep the write optimistic while both dialogs use their normal close motion.
    const search = document.querySelector<HTMLDialogElement>('[data-quick-search]');
    return Promise.all([
      dialog.open ? closeDialog(dialog) : Promise.resolve(),
      search?.open ? closeDialog(search) : Promise.resolve(),
    ]);
  }
  function populateEditor(title: any) {
    const entry = title.entry;
    currentTitle = title;
    current = {id:title.id, type:title.type, ...(entry || {status:'planning', progress:0, rating_mode:'manual', manual_score:null})};
    document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.hidden = !entry;
    document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.disabled = false;
    document.querySelector('#editor-title')!.textContent = title.title;
    document.querySelector('#editor-media-type')!.textContent = title.type === 'series' ? 'TV series' : 'Movie';
    const poster = document.querySelector<HTMLImageElement>('#editor-poster')!;
    let backdrop = document.querySelector<HTMLImageElement>('#editor-backdrop')!;
    const artwork = editorStore.artwork(title);
    // Move the prepared node itself. Reassigning src can expose the previous entry while loading.
    const prepared=artwork.backdropImage;
    if(prepared&&prepared!==backdrop){
      prepared.id='editor-backdrop';prepared.className='editor-backdrop';prepared.alt='';
      backdrop.replaceWith(prepared);backdrop=prepared;
    }
    [poster, backdrop].forEach(image => { image.removeAttribute('srcset'); image.removeAttribute('sizes'); });
    if (artwork.poster) {
      poster.src = artwork.poster;
      poster.alt = `${title.title} poster`;
    } else {
      poster.removeAttribute('src'); poster.removeAttribute('srcset'); poster.removeAttribute('sizes'); poster.alt = '';
    }
    poster.hidden = !title.poster;
    const backdropPath = artwork.backdrop;
    if (backdropPath && !prepared) {
      // Never overwrite a retained entry's background with another entry's poster fallback.
      const fallback=new Image();fallback.id='editor-backdrop';fallback.className='editor-backdrop';fallback.alt='';
      fallback.src=backdropPath;backdrop.replaceWith(fallback);backdrop=fallback;
    }
    else if(!backdropPath) { backdrop.removeAttribute('src'); backdrop.removeAttribute('srcset'); backdrop.removeAttribute('sizes'); }
    backdrop.hidden = !backdropPath;
    for (const name of ['status','progress','start_date','finish_date','rewatch_count','notes']) field(name).value = current[name] ?? '';
    refreshDateInputs();
    syncStatus(); closeStatus();
    const calculatedScore = current.rating_mode === 'average' ? current.score : current.manual_score;
    field('manual_score').value = calculatedScore == null ? '0' : String(current.rating_mode === 'average' ? Number(Number(calculatedScore).toFixed(1)) : calculatedScore);
    displayedScore = field('manual_score').value;
    field('favorite').checked = Boolean(current.favorite);
    loadLibraryState(title);
    field('progress').disabled = title.type === 'movie';
    document.querySelector<HTMLElement>('#progress-field')!.hidden = title.type === 'movie';
    saveButton.disabled = false;
  }
  function loadLibraryState(title: EditorTitle) {
    libraryButton.hidden = true;
    libraryButton.disabled = false;
    if (title.editor_library?.available) {
      libraryDesired = title.editor_library.desired;
      renderLibraryButton();
      libraryButton.hidden = false;
      libraryButton.disabled = false;
    }
  }
  function renderLibraryButton() {
    libraryButton.setAttribute('aria-pressed', String(libraryDesired));
    libraryButton.setAttribute('aria-label', libraryDesired ? 'Remove from library' : 'Add to library');
    libraryButton.title = libraryDesired ? 'Remove from library' : 'Add to library';
    libraryButton.classList.toggle('is-active', libraryDesired);
  }
  libraryButton.addEventListener('click', () => {
    if (!current || libraryButton.disabled) return;
    const editing = currentTitle!;
    void editorStore.writeLibrary(editing, !libraryDesired).catch(cause => {
      if (sessionSignal.aborted) return;
      if (!dialog.open || currentTitle !== editing) { window.anyListToast?.(cause.message); return; }
      error.textContent = cause.message; error.hidden = false;
    });
  });
  document.addEventListener('anylist:editor-state', event => {
    const title = (event as CustomEvent<EditorTitle>).detail;
    if (dialog.open && currentTitle && (title === currentTitle || title.id && title.id === currentTitle.id)) {
      libraryDesired = title.editor_library?.desired === true;
      renderLibraryButton();
    }
  }, {signal:pageListeners.signal});
  async function openEditor(mediaId: number | null, button: HTMLElement, supplied?: EditorTitle) {
    if (!supplied && (!mediaId || !Number.isSafeInteger(mediaId) || mediaId <= 0)) return;
    error.hidden = true;
    form.reset();
    syncStatus(); closeStatus();
    current = null;
    libraryButton.hidden = true;
    opener = button;
    const listRow = button.closest<HTMLElement>('.entry-row');
    if (listRow) {
      listRow.dataset.editorDeselected = '';
      const preview = document.querySelector<HTMLElement>('#cover-preview');
      if (preview) preview.hidden = true;
    }
    loadController?.abort();
    const controller = new AbortController();
    loadController = controller;
    const cached = supplied ? editorStore.get(supplied) : editorStore.find(mediaId!);
    if (cached) {
      const image = button.closest('.browse-card, .entry-row, .quick-search-result')?.querySelector<HTMLImageElement>('img') || document.querySelector<HTMLImageElement>('.media-cover img');
      editorStore.warmArtwork(cached, image?.currentSrc || image?.src, document.querySelector<HTMLImageElement>('.lab-hero-image')?.currentSrc);
      populateEditor(cached);
      showDialog(dialog);
      return;
    }
    try {
      const title = await editorStore.load(mediaId!);
      if (loadController !== controller || opener !== button || sessionSignal.aborted) return;
      populateEditor(title);
      showDialog(dialog);
    } catch(e) { if ((e as Error).name !== 'AbortError') window.anyListToast?.((e as Error).message); }
  }
  document.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-edit-entry]');
    if (button) void openEditor(Number(button.dataset.editEntry), button);
  }, { signal: pageListeners.signal });
  document.addEventListener('anylist:open-editor', event => {
    const {mediaId, opener, title} = (event as CustomEvent<{mediaId:number|null;opener:HTMLElement;title?:EditorTitle}>).detail;
    if (opener instanceof HTMLElement) void openEditor(mediaId, opener, title);
  }, { signal: pageListeners.signal });
  function ratedSeasonScores() {
    return Object.entries(current?.season_scores || {}).filter(([season, score]) => Number(season) > 0 && Number(score) > 0).map(([, score]) => Number(score));
  }
  async function confirmScoreOverride() {
    const confirmation = document.querySelector<HTMLDialogElement>('#editor-score-override')!;
    confirmation.returnValue = 'cancel';
    showDialog(confirmation);
    return new Promise<boolean>(resolve => confirmation.addEventListener('close', () => resolve(confirmation.returnValue === 'confirm'), {once:true}));
  }
  const confirmation = document.querySelector<HTMLDialogElement>('#editor-score-override')!;
  confirmation.addEventListener('click', event => { if (event.target === confirmation) void closeDialog(confirmation, 'cancel'); });
  confirmation.addEventListener('cancel', () => { confirmation.returnValue = 'cancel'; });
  dialog.querySelectorAll('.editor-close').forEach(button => button.addEventListener('click', closeEditor));
  dialog.addEventListener('click', event => { if (event.target === dialog) closeEditor(); });
  dialog.addEventListener('close', () => {
    loadController?.abort(); loadController = null; libraryButton.hidden = true; current = null; currentTitle = null; displayedScore = ''; form.reset();
    const listRow = opener?.closest<HTMLElement>('.entry-row');
    if (listRow) {
      const sectionHeading = listRow.closest<HTMLElement>('.status-section')?.querySelector<HTMLElement>('h2');
      if (sectionHeading) {
        sectionHeading.tabIndex = -1;
        sectionHeading.focus({preventScroll:true});
      } else opener?.blur();
      if (!listRow.matches(':hover')) delete listRow.dataset.editorDeselected;
    } else if (!document.querySelector('[data-quick-search][data-motion-closing]')) opener?.focus();
    opener = null;
  });
  document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.addEventListener('click',async event=>{
    const button=event.currentTarget as HTMLButtonElement;
    const editing = currentTitle;
    if(!current||!editing||!await confirmEntryAction('Are you sure you want to delete this list entry?'))return;
    if(sessionSignal.aborted || currentTitle !== editing || !dialog.open)return;
    button.disabled=true;
    const previous = {...current};
    const previousOpener = opener;
    const closing = finishEditing();
    try {
      const id = await editorStore.remove(editing);
      if (!sessionSignal.aborted) document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:{id,status:null,score:null}}));
    } catch (e) {
      await closing;
      if (sessionSignal.aborted) return;
      if (dialog.open) { window.anyListToast?.((e as Error).message); return; }
      opener = previousOpener;
      populateEditor({...editing, entry:previous});
      error.textContent = (e as Error).message; error.hidden = false; button.disabled = false;
      showDialog(dialog);
    }
  });
  form.addEventListener('keydown', event => {
    if (event.key !== 'Enter' || event.isComposing || !(event.target instanceof HTMLInputElement)) return;
    event.preventDefault();
    event.target.blur();
  }, {signal:sessionSignal});
  form.addEventListener('submit', async event => {
    event.preventDefault(); if (!current) return;
    error.hidden = true;
    const status = field('status').value;
    const body: any = {status, notes:field('notes').value, favorite:field('favorite').checked,
      rewatch_count:Number(field('rewatch_count').value || 0)};
    const scoreChanged = field('manual_score').value !== displayedScore;
    if (scoreChanged) {
      if (current.rating_mode === 'average' && ratedSeasonScores().length && !(await confirmScoreOverride())) {
        field('manual_score').value = displayedScore;
        return;
      }
      body.manual_score = Number(field('manual_score').value || 0);
      if (current.rating_mode === 'average') body.rating_mode = 'manual';
    }
    for (const name of ['start_date','finish_date']) {
      // An untouched empty date must not suppress a transition's automatic date.
      if (field(name).value !== (current[name] || '')) body[name] = field(name).value || null;
    }
    if (!field('progress').disabled && Number(field('progress').value) !== current.progress) {
      body.progress = Number(field('progress').value);
      if (body.progress < current.progress) {
        if (!await confirmEntryAction(watchRollbackWarning) || sessionSignal.aborted || !current) return;
        body.confirm_rollback = true;
      }
    }
    const editing = currentTitle!;
    const previous = {...current};
    const previousScore = displayedScore;
    const previousOpener = opener;
    const closing = finishEditing();
    try {
      const saved = await editorStore.write(editing, body);
      if (sessionSignal.aborted) return;
      document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:saved}));
    } catch(e) {
      await closing;
      if (sessionSignal.aborted) return;
      if (dialog.open) { window.anyListToast?.((e as Error).message); return; }
      opener = previousOpener;
      populateEditor({...editing, entry:{...previous,...body}});
      current = {...previous, id:editing.id};
      document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.hidden = !editing.entry;
      displayedScore = previousScore;
      error.textContent = (e as Error).message; error.hidden = false;
      showDialog(dialog);
    }
  });
  const prepare = (event: Event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-edit-entry]');
    if (!button) return;
    const id = Number(button.dataset.editEntry);
    const image = button.closest('.entry-row')?.querySelector<HTMLImageElement>('img') || document.querySelector<HTMLImageElement>('.media-cover img');
    const title = editorStore.find(id);
    if (title) editorStore.warmArtwork(title, image?.currentSrc || image?.src, document.querySelector<HTMLImageElement>('.lab-hero-image')?.currentSrc);
    else void editorStore.load(id).then(title => editorStore.warmArtwork(title, image?.currentSrc || image?.src)).catch(() => {});
  };
  document.addEventListener('pointerover', prepare, {signal:pageListeners.signal});
  document.addEventListener('focusin', prepare, {signal:pageListeners.signal});
});
</script>
<style>
  .editor-delete-button { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:36px; border:0; border-radius:3px; padding:7px 12px; background:#0b1622; color:var(--muted,#a2b5c7); font-size:var(--type-meta-size,13px); cursor:pointer; transition:background-color .16s,color .16s; }
  .editor-delete-button:focus-visible { outline:none; background:#ed577a; color:#fff; }
  @media (hover:hover) { .editor-delete-button:hover { background:#ed577a; color:#fff; } }
  .editor-delete-button:disabled { opacity:.6; cursor:wait; }
  .editor-confirmation { position:fixed; inset:0; margin:auto; width:min(440px,calc(100vw - 32px)); max-height:calc(100dvh - 32px); padding:20px; border:0; border-radius:4px; background:var(--panel,#151f2e); color:var(--muted,#a2b5c7); box-shadow:0 20px 65px #02071199; }
  .editor-confirmation::backdrop { background:#03091280; }
  .editor-confirmation header { display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .editor-confirmation h2 { margin:0; font-size:18px; font-weight:500; line-height:1.4; }
  .editor-confirmation-close { display:grid; place-items:center; flex:none; width:30px; height:30px; margin:-5px -5px -5px 0; padding:0; border:0; border-radius:3px; background:transparent; color:inherit; cursor:pointer; }
  .editor-confirmation-close:hover,.editor-confirmation-close:focus-visible { outline:none; background:#ffffff12; color:var(--bright,#edf5fa); }
  .editor-confirmation p { margin:18px 0; font-size:14px; line-height:1.6; }
  .editor-confirmation-actions { display:flex; justify-content:flex-end; gap:10px; }
  .editor-confirmation-actions button { min-height:32px; padding:6px 15px; border:0; border-radius:3px; background:#0b1622; color:var(--muted,#a2b5c7); font-size:13px; cursor:pointer; transition:background-color .16s,color .16s; }
  .editor-confirmation-actions button[value=confirm] { background:var(--blue,#3db4f2); color:#fff; }
  .editor-confirmation-actions button:hover,.editor-confirmation-actions button:focus-visible { outline:none; color:var(--bright,#edf5fa); }
  .editor-confirmation-actions button[value=confirm]:hover,.editor-confirmation-actions button[value=confirm]:focus-visible { background:color-mix(in srgb,var(--blue,#3db4f2) 80%,white); color:#fff; }
  @media(prefers-reduced-motion:reduce) { .editor-delete-button,.editor-confirmation-actions button { transition:none; } }
</style>
