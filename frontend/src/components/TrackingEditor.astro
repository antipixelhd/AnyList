---
import {statuses} from '../lib/tracker';
import Icon from './Icon.astro';
import CalendarDateInput from './CalendarDateInput.astro';
import NumberStepper from './NumberStepper.astro';
import EditorSelect from './EditorSelect.astro';
import SeriesEditorPanel from './SeriesEditorPanel.astro';
---
<dialog class="editor" id="tracking-editor" aria-labelledby="editor-title" data-motion-static>
  <div class="editor-hero">
    <div class="editor-artwork" aria-hidden="true">
      <img id="editor-backdrop" class="editor-backdrop" alt="" />
      <div class="editor-hero-shade"></div>
    </div>
    <img id="editor-poster" class="editor-poster" alt="" />
    <div class="editor-heading"><span id="editor-media-type">Entry</span><h2 id="editor-title">Edit entry</h2></div>
    <div class="editor-hero-actions">
      <button type="button" class="editor-library editor-icon-button" data-editor-library hidden aria-label="Add to library" aria-pressed="false"><Icon name="list" /></button>
      <label class="editor-favorite" title="Favorite"><input name="favorite" type="checkbox" form="tracking-form" aria-label="Favorite"/><Icon name="heart" /></label>
      <div class="editor-scope" data-editor-scope hidden><EditorSelect id="editor-series-scope" name="series_scope" label="Editing" floating/></div>
      <button type="submit" form="tracking-form" class="button-primary editor-save">Save</button>
    </div>
    <button type="button" class="editor-close editor-icon-button" aria-label="Close editor"><Icon name="close" /></button>
  </div>
  <form id="tracking-form">
    <div class="editor-fields">
      <div class="editor-status-field"><div class="editor-field-heading"><span class="editor-field-label" id="editor-status-label">Status</span><button type="button" class="editor-category-info" data-game-category-info data-game-only hidden aria-label="Game category meanings"><Icon name="info"/></button></div><EditorSelect id="editor-status" name="status" label="Status" labelledBy="editor-status-label" options={statuses} value="watching"/></div>
      <div class="editor-score-field"><div class="editor-field-heading"><span class="editor-field-label" id="editor-score-label">Score</span></div><NumberStepper id="editor-manual-score" name="manual_score" label="Score" labelledBy="editor-score-label" min={0} max={10} step={0.1} value={0} score/></div>
      <SeriesEditorPanel/>
      <div class="editor-number-field" data-game-only data-game-main hidden><div class="editor-field-heading"><span class="editor-field-label" id="game-total-hours-label">Total time (hours)</span><button type="button" class="game-steam-sync" data-game-steam-playtime hidden><Icon name="shuffle" /></button></div><NumberStepper id="game-total-hours" name="game_total_hours" label="Total time in hours" labelledBy="game-total-hours-label" step="any"/>
        <div class="game-first-completion" data-game-first hidden><div class="editor-field-heading"><span class="editor-field-label" id="game-first-hours-label">First completion</span><button type="button" class="game-value-button" data-game-first-edit>Add</button></div><div class="editor-number-field" data-game-first-input hidden><NumberStepper id="game-first-hours" name="game_first_hours" label="First completion time in hours" labelledBy="game-first-hours-label" step="any"/></div></div>
      </div>
      <div class="editor-number-field" data-game-only data-game-main hidden><span class="editor-field-label" id="game-replays-label">Replay count</span><NumberStepper id="game-replays" name="game_replays" label="Replay count" labelledBy="game-replays-label" max={2147483647}/></div>
      <section class="wide game-achievement-editor" data-game-only data-game-main hidden aria-label="Achievement progress">
        <div class="editor-field-heading"><span>Achievements</span><button type="button" class="game-steam-sync" data-game-steam-achievements hidden><Icon name="shuffle" /></button><button type="button" class="game-value-button" data-game-achievement-add>Add</button><button type="button" class="game-value-button" data-game-achievement-remove hidden aria-label="Remove achievement progress">Remove</button></div>
        <div data-game-achievement-reveal hidden><div class="game-achievement-controls" data-game-achievement-controls hidden>
          <div data-game-achievement-mode-field hidden><EditorSelect id="game-achievement-mode" name="game_achievement_mode" label="Achievement tracking"/></div>
          <input name="game_achievement_count" type="hidden"/><input name="game_achievement_percentage" type="hidden"/>
          <div class="game-achievement-value editor-number-field"><NumberStepper id="game-achievement-value" name="game_achievement_value" label="Achievement progress"/><span id="game-achievement-maximum" data-game-achievement-maximum></span></div>
          <div data-game-targeted hidden><p class="game-achievement-guidance" data-game-achievement-guidance></p><div class="game-achievement-options" data-game-achievement-options></div><p role="status" data-game-achievement-status hidden></p><button type="button" class="lab-text-button" data-game-achievement-more hidden>Load more</button></div>
        </div></div>
      </section>
      <div class="editor-start-date"><span class="editor-field-label" id="editor-start-date-label">Start date</span><CalendarDateInput id="editor-start-date" name="start_date" label="Start date" labelledBy="editor-start-date-label"/></div><div class="editor-finish-date"><span class="editor-field-label" id="editor-finish-date-label">Finish date</span><CalendarDateInput id="editor-finish-date" name="finish_date" label="Finish date" labelledBy="editor-finish-date-label"/></div>
      <div class="wide editor-notes"><span class="editor-field-label" id="editor-notes-label">Notes</span><textarea name="notes" rows="2" aria-labelledby="editor-notes-label"></textarea></div>
      <div class="editor-rewatches editor-number-field"><span class="editor-field-label" id="editor-rewatches-label">Total rewatches</span><NumberStepper id="editor-rewatches" name="rewatch_count" label="Total rewatches" labelledBy="editor-rewatches-label" max={10000}/></div>
    </div>
    <p class="series-scope-message" data-season-field-message role="status" hidden>Season dates and rewatches are preview fields.</p>
    <p id="editor-error" role="alert" class="error-message" hidden></p>
    <div class="editor-actions">
      <button type="button" class="editor-delete-button" id="delete-tracked-entry"><Icon name="trash" />Delete entry</button>
    </div>
  </form>
</dialog>
<dialog class="editor-confirmation" id="editor-confirmation" aria-labelledby="editor-confirmation-title" aria-describedby="editor-confirmation-body" data-motion-static>
  <form method="dialog">
    <header><h2 id="editor-confirmation-title">Warning</h2><button type="submit" class="editor-confirmation-close" value="cancel" aria-label="Close confirmation"><Icon name="close" /></button></header>
    <p id="editor-confirmation-body"></p>
    <div class="editor-confirmation-actions"><button type="submit" value="cancel" autofocus>Cancel</button><button type="submit" value="alternative" hidden></button><button type="submit" value="confirm">OK</button></div>
  </form>
</dialog>
<dialog class="score-override-dialog" id="editor-score-override" aria-labelledby="score-override-title">
  <form method="dialog">
    <button type="submit" class="score-override-close editor-icon-button" value="cancel" aria-label="Close season rating confirmation"><Icon name="close" /></button>
    <span class="eyebrow">Season ratings</span>
    <h2 id="score-override-title">Use a separate show score?</h2>
    <p>Your current score is calculated from rated seasons. Saving this value will switch the show to a separate manual score; your season ratings stay unchanged.</p>
    <div class="season-mode-actions"><button class="button-primary" value="confirm">Use manual score</button><button class="button-secondary" value="cancel">Keep season average</button></div>
  </form>
</dialog>
<dialog class="editor-confirmation" id="editor-season-score-mode" aria-labelledby="editor-season-score-mode-title">
  <form method="dialog">
    <header><h2 id="editor-season-score-mode-title">Series score</h2><button type="submit" class="editor-confirmation-close" value="cancel" aria-label="Cancel"><Icon name="close"/></button></header>
    <div class="editor-confirmation-actions">
      <button type="submit" value="cancel" autofocus>Cancel</button>
      <button type="submit" value="manual">Keep a separate score</button>
      <button type="submit" value="average">Average season scores</button>
    </div>
  </form>
</dialog>
<script>
import { setupScoreSteppers } from '../lib/scoreStepper';
import {createSeriesEditor, type SeriesEditorSummary} from '../lib/series-editor';
import { setupCalendarDateInputs } from '../lib/calendar-date-input';
import { editorStore, seedEditorPage, type EditorTitle, type WorkSubject } from '../lib/editor-store';
import { showDialog, closeDialog } from '../lib/ui-motion';
import {showActionFailure} from '../lib/action-failure';
import {markFailureHandled} from '../lib/handled-failures';
import {createGameEditor} from '../lib/game-editor';
import {setupEditorSelect} from '../lib/editor-select';
import {gameDatePatch} from '../lib/game-editor-data';
import {gameCategoryChoices,showCategoryInfo} from '../lib/game-category-store.ts';
import {localToday} from '../lib/date-time';
import {dismissPosterControls} from '../lib/poster-controls';
import {seasonArtworkHint,seasonPosterSource} from '../lib/season-editor-artwork';
import {predictionAllowed} from '../lib/predictive-loading';
import {chooseEntryAction,confirmEntryAction as confirmAction,watchRollbackWarning} from '../lib/entry-confirmation';
let pageListeners: AbortController;
document.addEventListener('astro:before-swap', () => pageListeners?.abort());
document.addEventListener('astro:page-load', () => {
  pageListeners?.abort();
  pageListeners = new AbortController();
  const sessionSignal = pageListeners.signal;
  if (!document.querySelector('#tracking-editor')) return;
  const dialog = document.querySelector<HTMLDialogElement>('#tracking-editor')!;
  const confirmEntryAction = (message:string,options:{confirmLabel?:string}={}) => confirmAction(message,sessionSignal,options);
  setupScoreSteppers(dialog, sessionSignal);
  const refreshDateInputs = setupCalendarDateInputs(dialog, sessionSignal);
  dialog.addEventListener('anylist:series-dates-sync',refreshDateInputs,{signal:sessionSignal});
  const form = document.querySelector<HTMLFormElement>('#tracking-form')!;
  const gameFields=createGameEditor(dialog,form,sessionSignal,confirmEntryAction);
  let current: any = null;
  let currentTitle: EditorTitle | null = null;
  const movieDatePresets=new Map<string,string>();
  let opener: HTMLElement | null = null;
  let loadController: AbortController | null = null;
  let artworkTimer:ReturnType<typeof setTimeout>|undefined;
  let artworkPrediction:ReturnType<typeof setTimeout>|undefined;
  let seasonHint:ReturnType<typeof seasonArtworkHint>;
  let seasonPoster:{number:number;source?:string;pending:boolean}|undefined;
  sessionSignal.addEventListener('abort',()=>{clearTimeout(artworkTimer);clearTimeout(artworkPrediction);loadController?.abort();},{once:true});
  let displayedScore = '';
  let resumeExpansion:{subject:WorkSubject;button:HTMLElement}|null=null;
  const libraryButton = dialog.querySelector<HTMLButtonElement>('[data-editor-library]')!;
  let libraryDesired = false;
  seedEditorPage();
  document.addEventListener('media-tracker:rating-changed', event => {
    const saved = (event as CustomEvent).detail;
    if (saved.status) editorStore.acceptSaved(saved);
    else if(saved.series_rating)editorStore.acceptSeasonRating(saved.id,saved.series_rating);
    else editorStore.invalidate(saved.id);
  }, {signal:pageListeners.signal});
  document.addEventListener('anylist:entry-saved', event => {
    const saved = (event as CustomEvent).detail;
    editorStore.acceptSaved(saved);
  }, {signal:pageListeners.signal});
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const error = document.querySelector<HTMLElement>('#editor-error')!;
  const seriesFields = createSeriesEditor(dialog,form,sessionSignal,message=>{
    error.textContent=message;
    error.hidden=!message;
  });
  const saveButton = dialog.querySelector<HTMLButtonElement>('.editor-save')!;
  const statusSelect=field('status') as unknown as HTMLSelectElement;
  const originalStatuses=[...statusSelect.options].map(option=>({value:option.value,label:option.text}));
  const statusControl=setupEditorSelect(statusSelect.closest<HTMLElement>('[data-editor-select]')!,sessionSignal);
  const statusDomain=(game:boolean)=>{
    const currentValue=statusSelect.value;
    const choices=game?gameCategoryChoices(current?.revision!=null?current.status:undefined):originalStatuses.map(option=>[option.value,option.label]);
    statusSelect.replaceChildren(...choices.map(([value,label])=>new Option(label,value)));
    statusSelect.value=game&&currentValue==='watching'?'playing':currentValue;
    statusControl.sync();
  };
  dialog.querySelector<HTMLElement>('[data-game-category-info]')!.addEventListener('click',event=>showCategoryInfo(event.currentTarget as HTMLElement),{signal:sessionSignal});
  document.addEventListener('anylist:game-categories',()=>{if(currentTitle?.type==='game')statusDomain(true);},{signal:sessionSignal});
  const closeStatus = statusControl.close;
  const syncStatus = () => {
    statusControl.sync();
    gameFields.statusChanged(statusSelect.value);
    if(currentTitle?.type==='movie') {
      for(const [name,value] of movieDatePresets)if(field(name).value===value)field(name).value=current?.[name]??'';
      movieDatePresets.clear();
      const name=statusSelect.value==='watching'?'start_date':statusSelect.value==='completed'?'finish_date':null;
      if(name && statusSelect.value!==current?.status && !field(name).value) {
        field(name).value=localToday();movieDatePresets.set(name,field(name).value);
      }
      refreshDateInputs();
    }
    seriesFields.statusChanged();
  };
  statusSelect.addEventListener('change',syncStatus,{signal:sessionSignal});
  form.addEventListener('anylist:series-status-sync',()=>statusControl.sync(),{signal:sessionSignal});
  form.addEventListener('change',event=>{
    if(currentTitle?.type!=='movie' || !(event.target instanceof HTMLInputElement))return;
    const name=event.target.closest('[data-calendar-input]')?.querySelector<HTMLInputElement>('[data-date-iso]')?.name;
    if(name)movieDatePresets.delete(name);
  },{signal:sessionSignal});
  const closeEditor = () => {
    resumeExpansion=null;
    if (!dialog.open) return;
    void closeDialog(dialog);
  };
  function finishEditing() {
    // Keep the write optimistic while both dialogs use their normal close motion.
    const search = document.querySelector<HTMLDialogElement>('[data-quick-search]');
    return Promise.all([
      dialog.open ? closeDialog(dialog) : Promise.resolve(),
      search?.open ? closeDialog(search) : Promise.resolve(),
    ]);
  }
  function populateEditor(title: any, seriesSummary?:SeriesEditorSummary, season?:number) {
    movieDatePresets.clear();
    const entry = title.entry;
    const game=title.type==='game',child=game&&['expansion','dlc'].includes(title.game_class||'');
    dialog.dataset.editorDomain=game?'game':'movies-series';
    dialog.dataset.editorType=title.type;
    currentTitle = title;
    current = {id:title.id, type:title.type, status:'planning', ...(game?title.game_state||entry:entry)||{progress:0,rating_mode:'manual',manual_score:null}};
    current.status ||= 'planning';
    statusDomain(game);
    document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.hidden = game?!current.listed:!entry;
    document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.disabled = false;
    document.querySelector('#editor-title')!.textContent = title.title;
    document.querySelector('#editor-media-type')!.textContent = game?(title.game_class==='expansion'?'Expansion':'Game'):title.type === 'series' ? 'TV series' : 'Movie';
    dialog.querySelector<HTMLElement>('.editor-rewatches')!.hidden=game;
    dialog.querySelector<HTMLElement>('.editor-notes')!.hidden=child;
    dialog.querySelector<HTMLElement>('.editor-favorite')!.hidden=child;
    for (const name of ['status','start_date','finish_date','rewatch_count','notes']) field(name).value = current[name] ?? '';
    gameFields.populate(title);
    refreshDateInputs();
    syncStatus(); closeStatus();
    const calculatedScore = game?current.score:current.rating_mode === 'average' ? current.score : current.manual_score;
    field('manual_score').value = calculatedScore == null ? '0' : String(current.rating_mode === 'average' ? Number(Number(calculatedScore).toFixed(1)) : calculatedScore);
    displayedScore = field('manual_score').value;
    field('favorite').checked = Boolean(current.favorite);
    loadLibraryState(title);
    seriesFields.open(title,seriesSummary,season);
    paintArtwork();
    saveButton.disabled = false;
  }
  function paintImage(slot:'poster'|'backdrop',source?:string,prepared?:HTMLImageElement){
    const id=`editor-${slot}`;
    const previous=dialog.querySelector<HTMLImageElement>(`#${id}`)!;
    const alt=slot==='poster'&&source?`${currentTitle?.title} poster`:'';
    if(previous.getAttribute('src')===(source??null)&&(!prepared||prepared.isConnected)){
      previous.alt=alt;previous.hidden=!source;return;
    }
    // Keep detached decoded nodes intact so switching back reuses the same image.
    const image=prepared?(prepared.isConnected?prepared.cloneNode(false) as HTMLImageElement:prepared):document.createElement('img');
    if(source&&!prepared)image.src=source;
    image.id=id;image.className=id;image.alt=alt;image.hidden=!source;
    previous.replaceWith(image);
  }
  function paintArtwork(){
    if(!currentTitle)return;
    const base=editorStore.artwork(currentTitle);
    const poster=editorStore.decodedImage(seasonPoster?.source);
    const posterSource=poster?.getAttribute('src')??(!seasonPoster?.pending?base.poster:undefined);
    paintImage('poster',posterSource,poster??editorStore.decodedImage(posterSource));
    paintImage('backdrop',base.backdrop,base.backdropImage);
  }
  function warmNeighbor(){
    clearTimeout(artworkPrediction);
    if(!dialog.open||currentTitle?.type!=='series'||seasonPoster?.pending||!predictionAllowed())return;
    const {number,summary}=seriesFields.artworkScope();
    const choices=[0,...(summary?.seasons.map(season=>season.season_number)??[])];
    const index=choices.indexOf(number);
    if(index<0)return;
    const neighbor=choices[index+1]??choices[index-1];
    if(!neighbor)return;
    const title=currentTitle;
    artworkPrediction=setTimeout(()=>{
      if(!dialog.open||currentTitle!==title||seriesFields.artworkScope().number!==number)return;
      void editorStore.warmSeasonPoster(seasonPosterSource(neighbor,summary,seasonHint),false);
    },180);
  }
  function syncSeasonArtwork(){
    if(currentTitle?.type!=='series')return;
    const {number,summary}=seriesFields.artworkScope();
    const source=seasonPosterSource(number,summary,seasonHint);
    if(seasonPoster?.number===number&&seasonPoster.source===source)return;
    clearTimeout(artworkPrediction);
    const attempt={number,source,pending:!!source&&!editorStore.decodedImage(source)};
    seasonPoster=attempt;
    paintArtwork();
    if(attempt.pending){
      void editorStore.warmSeasonPoster(source).then(()=>{
        if(sessionSignal.aborted||seasonPoster!==attempt)return;
        attempt.pending=false;
        if(!dialog.open)return;
        paintArtwork();
        warmNeighbor();
      });
    }
    warmNeighbor();
  }
  form.addEventListener('anylist:series-artwork',syncSeasonArtwork,{signal:sessionSignal});
  const scopeMenu=dialog.querySelector('[data-editor-scope]')!;
  const predictScope=(event:Event)=>{
    const option=(event.target as Element).closest<HTMLElement>('[data-editor-option]');
    if(!option||!dialog.open||!predictionAllowed()||seasonPoster?.pending)return;
    const number=Number(option.dataset.editorOption),title=currentTitle;
    const {number:current,summary}=seriesFields.artworkScope();
    if(!number||number===current||!title)return;
    clearTimeout(artworkPrediction);
    artworkPrediction=setTimeout(()=>{
      if(!dialog.open||currentTitle!==title||!option.isConnected||
          (document.activeElement!==option&&!option.matches(':hover')))return;
      void editorStore.warmSeasonPoster(seasonPosterSource(number,summary,seasonHint),false);
    },90);
  };
  scopeMenu.addEventListener('pointerover',predictScope,{signal:sessionSignal});
  scopeMenu.addEventListener('focusin',predictScope,{signal:sessionSignal});
  editorStore.onArtworkReady(()=>{
    if(dialog.open&&currentTitle&&!dialog.hasAttribute('data-motion-closing'))paintArtwork();
  },sessionSignal);
  function loadLibraryState(title: EditorTitle) {
    libraryButton.hidden = true;
    libraryButton.disabled = false;
    if (title.editor_library?.available) {
      libraryDesired = title.editor_library.desired;
      renderLibraryButton();
      libraryButton.hidden = false;
      libraryButton.disabled = false;
    }
  }
  function renderLibraryButton() {
    libraryButton.setAttribute('aria-pressed', String(libraryDesired));
    libraryButton.setAttribute('aria-label', libraryDesired ? 'Remove from library' : 'Add to library');
    libraryButton.title = libraryDesired ? 'Remove from library' : 'Add to library';
    libraryButton.classList.toggle('is-active', libraryDesired);
  }
  libraryButton.addEventListener('click', () => {
    if (!current || libraryButton.disabled) return;
    const editing = currentTitle!;
    void editorStore.writeLibrary(editing, !libraryDesired).catch(cause => {
      if (sessionSignal.aborted) return;
      showActionFailure('library', editing.title, cause);
    });
  });
  document.addEventListener('anylist:editor-state', event => {
    const title = (event as CustomEvent<EditorTitle>).detail;
    if (dialog.open && currentTitle && title.type===currentTitle.type && (title === currentTitle || title.id && title.id === currentTitle.id)) {
      libraryDesired = title.editor_library?.desired === true;
      renderLibraryButton();
      // If the editor was opened while a progress write was pending, reconcile
      // its untouched fields when that write confirms or rolls back.
      if (current && title.entry && !dialog.hasAttribute('data-motion-closing')) {
        const series=title.type==='series';
        if(series)seriesFields.receiveDates(title.entry,current);
        for (const name of ['status','progress','start_date','finish_date']) {
          if (!(name in title.entry)) continue;
          const previous = current[name] ?? (name === 'progress' ? 0 : '');
          if ((name==='status'||!series&&name!=='progress') && field(name).value === String(previous)) field(name).value = String(title.entry[name] ?? '');
          current[name] = title.entry[name];
        }
        syncStatus(); refreshDateInputs();
      }
    }
  }, {signal:pageListeners.signal});
  async function openGame(subject:WorkSubject,button:HTMLElement,supplied?:EditorTitle) {
    try {
      if(supplied)editorStore.seed(supplied);
      const title=await editorStore.loadSubject(subject);
      if(sessionSignal.aborted)return;
      if(['expansion','dlc'].includes(title.game_class||'')&&title.base_work_id) {
        const baseSubject:WorkSubject={kind:'game',catalogue_id:title.base_work_id};
        const base=await editorStore.loadSubject(baseSubject);
        if(!base.game_state?.listed) {
          if(!await confirmEntryAction('Base game has to be added first',{confirmLabel:'Add'})||sessionSignal.aborted)return;
          resumeExpansion={subject,button};
          await openEditor(base.id,button,base,true);return;
        }
      }
      await openEditor(title.id,button,title,true);
    }catch(cause){if(!sessionSignal.aborted)window.anyListToast?.((cause as Error).message);}
  }
  async function openEditor(mediaId: number | null, button: HTMLElement, supplied?: EditorTitle,baseChecked=false) {
    if(supplied?.type==='game'&&!baseChecked&&supplied.subject)return openGame(supplied.subject,button,supplied);
    if (!supplied && (!mediaId || !Number.isSafeInteger(mediaId) || mediaId <= 0)) return;
    error.hidden = true;
    seriesFields.reset();
    form.reset();
    syncStatus(); closeStatus();
    current = null;
    libraryButton.hidden = true;
    opener?.removeAttribute('aria-busy');
    opener = button;
    const listRow = button.closest<HTMLElement>('.entry-row');
    if (listRow) {
      listRow.dataset.editorDeselected = '';
      const preview = document.querySelector<HTMLElement>('#cover-preview');
      if (preview) preview.hidden = true;
    }
    loadController?.abort();
    clearTimeout(artworkTimer);
    clearTimeout(artworkPrediction);
    seasonPoster=undefined;
    const hint=seasonArtworkHint(button);
    seasonHint=hint;
    const controller = new AbortController();
    loadController = controller;
    const cached = supplied ? editorStore.get(supplied) : editorStore.find(mediaId!);
    button.setAttribute('aria-busy','true');
    try {
      const title = cached || await editorStore.load(mediaId!);
      if(loadController!==controller||opener!==button||sessionSignal.aborted)return;
      if(hint)void editorStore.warmSeasonPoster(seasonPosterSource(hint.number,editorStore.cachedSeries(title.id),hint));
      const seriesSummary=await seriesFields.prepare(title,controller.signal);
      if(loadController!==controller||opener!==button||sessionSignal.aborted)return;
      const image = button.closest('.browse-card, .entry-row, .quick-search-result, .game-progress-card')?.querySelector<HTMLImageElement>('img') || document.querySelector<HTMLImageElement>('.media-cover img');
      const posterSource=button.dataset.editorSeason?undefined:image?.currentSrc||image?.src;
      const heroSource=document.querySelector<HTMLImageElement>('.lab-hero-image')?.currentSrc;
      if(hint){
        const ready=Promise.all([editorStore.warmSeasonPoster(seasonPosterSource(hint.number,seriesSummary,hint)),
          editorStore.warmArtwork(title,undefined,heroSource,true)]);
        await Promise.race([ready,new Promise<void>(resolve=>setTimeout(resolve,150))]);
      }
      const prepareArtwork=async()=>{
        if(controller.signal.aborted||!dialog.open||currentTitle!==title)return;
        clearTimeout(artworkTimer);
        await editorStore.prepareArtwork(title,posterSource,heroSource,sessionSignal).catch(()=>{});
        if(controller.signal.aborted||sessionSignal.aborted||!dialog.open||currentTitle!==title)return;
        const state=title.background_status?.state;
        if(!editorStore.artwork(title).backdropImage||state==='pending'||state==='deferred')
          artworkTimer=setTimeout(()=>void prepareArtwork(),Math.max(30,title.background_status?.retry_after||0)*1000);
      };
      if (loadController !== controller || opener !== button || sessionSignal.aborted) return;
      populateEditor(title,seriesSummary,hint?.number);
      showDialog(dialog);
      void prepareArtwork();
      warmNeighbor();
    } catch(e) { if ((e as Error).name !== 'AbortError') showActionFailure('open', supplied?.title, e); }
    finally {if(loadController===controller||opener!==button)button.removeAttribute('aria-busy');}
  }
  document.addEventListener('click', event => {
    const gameButton=(event.target as HTMLElement).closest<HTMLElement>('[data-edit-game]');
    if(gameButton){const id=Number(gameButton.dataset.editGame);if(Number.isSafeInteger(id)&&id>0)void openGame({kind:'game',catalogue_id:id},gameButton);return;}
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-edit-entry]');
    if (button) void openEditor(Number(button.dataset.editEntry), button);
  }, { signal: pageListeners.signal });
  document.addEventListener('anylist:open-editor', event => {
    const {mediaId, opener, title,subject} = (event as CustomEvent<{mediaId:number|null;opener:HTMLElement;title?:EditorTitle;subject?:WorkSubject}>).detail;
    if (opener instanceof HTMLElement){if(subject?.kind==='game')void openGame(subject,opener,title);else void openEditor(mediaId, opener, title);}
  }, { signal: pageListeners.signal });
  function ratedSeasonScores() {
    return Object.entries(current?.season_scores || {}).filter(([season, score]) => Number(season) > 0 && Number(score) > 0).map(([, score]) => Number(score));
  }
  async function confirmScoreOverride() {
    const confirmation = document.querySelector<HTMLDialogElement>('#editor-score-override')!;
    confirmation.returnValue = 'cancel';
    showDialog(confirmation);
    return new Promise<boolean>(resolve => confirmation.addEventListener('close', () => resolve(confirmation.returnValue === 'confirm'), {once:true}));
  }
  const confirmation = document.querySelector<HTMLDialogElement>('#editor-score-override')!;
  confirmation.addEventListener('click', event => { if (event.target === confirmation) void closeDialog(confirmation, 'cancel'); });
  confirmation.addEventListener('cancel', () => { confirmation.returnValue = 'cancel'; });
  const seasonScoreMode = document.querySelector<HTMLDialogElement>('#editor-season-score-mode')!;
  seasonScoreMode.addEventListener('click',event=>{
    if (event.target===seasonScoreMode) void closeDialog(seasonScoreMode,'cancel');
  },{signal:sessionSignal});
  function chooseSeasonScoreMode() {
    return new Promise<'average'|'manual'|null>(resolve=>{
      const abort=()=>seasonScoreMode.close('cancel');
      const close=()=>{
        sessionSignal.removeEventListener('abort',abort);
        const value=seasonScoreMode.returnValue;
        resolve(value==='average'||value==='manual'?value:null);
      };
      sessionSignal.addEventListener('abort',abort,{once:true});
      seasonScoreMode.addEventListener('close',close,{once:true});
      seasonScoreMode.returnValue='cancel';
      showDialog(seasonScoreMode);
    });
  }
  dialog.querySelectorAll('.editor-close').forEach(button => button.addEventListener('click', closeEditor));
  dialog.addEventListener('click', event => { if (event.target === dialog) closeEditor(); });
  dialog.addEventListener('close', () => {
    // The native close event is queued; a failed save may already have reopened the editor.
    if (dialog.open) return;
    clearTimeout(artworkTimer);
    clearTimeout(artworkPrediction);
    seasonPoster=undefined;seasonHint=undefined;
    dismissPosterControls(opener, pageListeners.signal);
    resumeExpansion=null;gameFields.reset();seriesFields.reset();
    loadController?.abort(); loadController = null; libraryButton.hidden = true; current = null; currentTitle = null; displayedScore = ''; form.reset();
    const listRow = opener?.closest<HTMLElement>('.entry-row');
    if (listRow) {
      const sectionHeading = listRow.closest<HTMLElement>('.status-section')?.querySelector<HTMLElement>('h2');
      if (sectionHeading) {
        sectionHeading.tabIndex = -1;
        sectionHeading.focus({preventScroll:true});
      } else opener?.blur();
      // Dismissal lasts until a fresh interaction, including after focus restoration.
    } else if (!document.querySelector('[data-quick-search][data-motion-closing]')) opener?.focus();
    opener = null;
  });
  document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.addEventListener('click',async event=>{
    const button=event.currentTarget as HTMLButtonElement;
    const editing = currentTitle;
    if(!current||!editing||saveButton.disabled)return;
    const season=editing.type==='series'?seriesFields.deleteTarget():null;
    const message=editing?.type==='series'?'Remove this series from your list?':
      editing?.type==='game'&&!['expansion','dlc'].includes(editing.game_class||'')?'Remove this game and its listed expansions? Saved expansion details will be kept.':'Are you sure you want to delete this list entry?';
    const choice=season
      ? await chooseEntryAction('Delete this season’s tracking history or the entire series?',sessionSignal,
        {alternativeLabel:'Delete Season',confirmLabel:'Delete Series'})
      : await confirmEntryAction(message)?'confirm':'cancel';
    if(choice==='cancel')return;
    if(sessionSignal.aborted || currentTitle !== editing || !dialog.open)return;
    button.disabled=true;
    if(choice==='alternative'&&season){
      saveButton.disabled=true;
      error.hidden=true;
      try {
        const saved=await editorStore.write(editing,{confirm_rollback:true,series_editor:{action:'delete_season',...season}});
        if(sessionSignal.aborted)return;
        document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:saved}));
        if(currentTitle===editing&&dialog.open)await finishEditing();
      } catch(cause) {
        if(currentTitle!==editing||sessionSignal.aborted)return;
        const stale=(cause as any).detail?.code==='series_editor_changed';
        error.textContent=stale?'Season progress changed. Review the selection and try again.':(cause as Error).message;
        error.hidden=false;
        if(stale)void seriesFields.refresh();
      } finally {
        if(currentTitle===editing){button.disabled=false;saveButton.disabled=false;}
      }
      return;
    }
    const previous = {...current};
    const previousOpener = opener;
    const closing = finishEditing();
    try {
      const id = await editorStore.remove(editing);
      if (!sessionSignal.aborted) document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:{id,subject:editing.subject,status:null,score:null}}));
    } catch (e) {
      markFailureHandled(e);
      await closing;
      if (sessionSignal.aborted) return;
      if (dialog.open) { showActionFailure('remove', editing.title, e); return; }
      opener = previousOpener;
      populateEditor({...editing, entry:previous});
      const detail = e instanceof Error && !(e instanceof TypeError) && e.message !== 'Unable to save this entry. Try again.' ? e.message : '';
      error.textContent = detail; error.hidden = !detail; button.disabled = false;
      showDialog(dialog);
      showActionFailure('remove', editing.title, e);
    }
  });
  form.addEventListener('keydown', event => {
    if (event.key !== 'Enter' || event.isComposing || !(event.target instanceof HTMLInputElement)) return;
    event.preventDefault();
    event.target.blur();
  }, {signal:sessionSignal});
  form.addEventListener('submit', async event => {
    event.preventDefault(); if (!current || saveButton.disabled) return;
    error.hidden = true;
    const status = field('status').value;
    if(currentTitle?.type==='game'&&!status){
      error.textContent='Choose a status.';
      error.hidden=false;
      document.querySelector<HTMLButtonElement>('#editor-status-trigger')!.focus();
      return;
    }
    if(currentTitle?.type==='game') {
      const editing=currentTitle,child=['expansion','dlc'].includes(editing.game_class||'');
      const previous=structuredClone(editing),previousOpener=opener,restoreGameFields=gameFields.snapshot();
      const draft=Array.from(form.elements).filter((node):node is HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement=>node instanceof HTMLInputElement||node instanceof HTMLSelectElement||node instanceof HTMLTextAreaElement).filter(node=>node.name).map(node=>({name:node.name,value:node.value,checked:node instanceof HTMLInputElement?node.checked:false}));
      const next=resumeExpansion;
      let closed:Promise<void>|undefined;
      try {
        const body={status,score:Number(field('manual_score').value||0),
          ...gameDatePatch(current,status,{start_date:field('start_date').value,finish_date:field('finish_date').value},gameFields.datesTouched,localToday()),
          ...(!child?{notes:field('notes').value,favorite:field('favorite').checked}:{}),...gameFields.patch()};
        saveButton.disabled=true;
        if(!await gameFields.confirmSyncChanges(body))return;
        if(!next){closed=new Promise<void>(resolve=>dialog.addEventListener('close',()=>resolve(),{once:true}));finishEditing();}
        const saved=await editorStore.write(editing,body);
        if(sessionSignal.aborted)return;
        document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:saved}));
        if(next){
          if(currentTitle!==editing||!dialog.open)return;
          resumeExpansion=null;
          closed=new Promise<void>(resolve=>dialog.addEventListener('close',()=>resolve(),{once:true}));finishEditing();
        }
        await closed;
        if(next)void openGame(next.subject,next.button);
      }catch(cause){
        if(sessionSignal.aborted)return;
        if(!next){
          await closed;
          if(dialog.open){window.anyListToast?.((cause as Error).message);return;}
          opener=previousOpener;populateEditor(previous);
          draft.forEach(saved=>{const node=form.elements.namedItem(saved.name) as HTMLInputElement|null;if(node){node.value=saved.value;if(node.type==='checkbox')node.checked=saved.checked;}});
          restoreGameFields();syncStatus();showDialog(dialog);
        } else if(currentTitle!==editing)return;
        error.textContent=(cause as any).detail?.code==='stale_game_entry'?'This entry changed. Close and reopen the editor to reload it.':(cause as Error).message;error.hidden=false;
      }finally{if(!sessionSignal.aborted)saveButton.disabled=false;}
      return;
    }
    const editing = currentTitle!;
    const values=editing.type==='series'?seriesFields.fields():{
      manual_score:field('manual_score').value,start_date:field('start_date').value,
      finish_date:field('finish_date').value,rewatch_count:field('rewatch_count').value,
    };
    const body: any = {status, notes:field('notes').value, favorite:field('favorite').checked,
      rewatch_count:Number(values.rewatch_count || 0)};
    const scoreChanged = values.manual_score !== displayedScore;
    if (scoreChanged) {
      if (current.rating_mode === 'average' && ratedSeasonScores().length && !(await confirmScoreOverride())) {
        return;
      }
      body.manual_score = Number(values.manual_score || 0);
      if (current.rating_mode === 'average') body.rating_mode = 'manual';
    }
    for (const name of ['start_date','finish_date'] as const) {
      // An untouched empty date must not suppress a transition's automatic date.
      if (values[name] !== (current[name] || '')) body[name] = values[name] || null;
    }
    if (editing.type==='series') {
      const scopedStatus = seriesFields.scopedStatusChange();
      const explicitStatus = scopedStatus ?? (!editing.entry || status!==current.status);
      if (!explicitStatus) delete body.status;
      saveButton.disabled=true;
      try {
        const patch=await seriesFields.patch(explicitStatus);
        if (!patch || currentTitle!==editing || !dialog.open || sessionSignal.aborted) return;
        if (patch.action==='position' && scopedStatus===undefined) body.status=status;
        if (scopedStatus!==undefined) delete body.status;
        if (seriesFields.rollbackNeeded(patch)) {
          const warning=patch.season_progress||patch.progress_season
            ? 'Reduce watched progress? The removed episodes will lose their recorded watch dates and evidence.'
            : watchRollbackWarning;
          if (!await confirmEntryAction(warning) || sessionSignal.aborted || currentTitle!==editing) return;
          body.confirm_rollback=true;
        }
        if (patch.order==='tmdb:aired' && !ratedSeasonScores().length && patch.seasons.some(season=>Number(season.score)>0)) {
          const ratingMode=scoreChanged?'manual':current.rating_mode==='average'?'average':await chooseSeasonScoreMode();
          if (!ratingMode || currentTitle!==editing || sessionSignal.aborted) return;
          body.rating_mode=ratingMode;
        }
        body.series_editor=patch;
        const saved=await editorStore.write(editing,body,seriesFields.optimisticProgress(patch));
        if (sessionSignal.aborted) return;
        document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:saved}));
        if (currentTitle===editing && dialog.open) await finishEditing();
      } catch (cause) {
        if (currentTitle!==editing || sessionSignal.aborted) return;
        const code=(cause as any).detail?.code;
        error.textContent=code==='series_editor_changed'||code==='series_editor_airing'
          ? 'Episode availability or progress changed. Review the updated progress and save again.'
          : (cause as Error).message;
        error.hidden=false;
        if (code==='series_editor_changed'||code==='series_editor_airing') void seriesFields.refresh();
      } finally {
        if (currentTitle===editing) saveButton.disabled=false;
      }
      return;
    }
    const wasNew = !editing.entry;
    const previous = {...current};
    const previousScore = displayedScore;
    const previousOpener = opener;
    const closing = finishEditing();
    try {
      const saved = await editorStore.write(editing, body);
      if (sessionSignal.aborted) return;
      document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:saved}));
    } catch(e) {
      markFailureHandled(e);
      await closing;
      if (sessionSignal.aborted) return;
      if (dialog.open) { showActionFailure(wasNew ? 'add' : 'update', editing.title, e); return; }
      opener = previousOpener;
      populateEditor({...editing, entry:{...previous,...body}});
      current = {...previous, id:editing.id};
      document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.hidden = !editing.entry;
      displayedScore = previousScore;
      const detail = e instanceof Error && !(e instanceof TypeError) && e.message !== 'Unable to save this entry. Try again.' ? e.message : '';
      error.textContent = detail; error.hidden = !detail;
      showDialog(dialog);
      showActionFailure(wasNew ? 'add' : 'update', editing.title, e);
    }
  });
  const prepare = (event: Event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-edit-entry],[data-edit-game]');
    if (!button) return;
    if (event instanceof PointerEvent && button.contains(event.relatedTarget as Node|null)) return;
    const game=button.dataset.editGame!=null;
    const id = Number(game?button.dataset.editGame:button.dataset.editEntry);
    const image = button.closest('.entry-row')?.querySelector<HTMLImageElement>('img') || document.querySelector<HTMLImageElement>('.media-cover img');
    const title = game?editorStore.findSubject({kind:'game',catalogue_id:id}):editorStore.find(id);
    const warm=(title:EditorTitle)=>{
      const poster=button.dataset.editorSeason?undefined:image?.currentSrc||image?.src,hero=document.querySelector<HTMLImageElement>('.lab-hero-image')?.currentSrc;
      if(!sessionSignal.aborted){
        const hint=seasonArtworkHint(button);
        if(hint)void editorStore.warmSeasonPoster(seasonPosterSource(hint.number,editorStore.cachedSeries(title.id),hint));
        void editorStore.warmArtwork(title,poster,hero,true);
        if(title.type==='series'&&title.id)void editorStore.prepareSeries(title.id,sessionSignal).then(summary=>{
          if(hint&&!sessionSignal.aborted)void editorStore.warmSeasonPoster(seasonPosterSource(hint.number,summary,hint));
        }).catch(()=>{});
      }
    };
    if (title) warm(title);
    else void (game?editorStore.loadSubject({kind:'game',catalogue_id:id}):editorStore.load(id)).then(warm).catch(() => {});
  };
  document.addEventListener('pointerover', prepare, {signal:pageListeners.signal});
  document.addEventListener('pointerdown', prepare, {signal:pageListeners.signal});
  document.addEventListener('focusin', prepare, {signal:pageListeners.signal});
  const primary=JSON.parse(document.querySelector('#title-editor-data')?.textContent||'null');
  if(primary?.type==='series'&&primary.id&&document.body.dataset.cacheUser&&document.body.dataset.cacheUser!=='anonymous')
    void editorStore.prepareSeries(primary.id,sessionSignal).catch(()=>{});
});
</script>
<style>
  :global([data-edit-entry][aria-busy=true]) { color:var(--blue); cursor:progress; }
  .editor-actions { min-height:36px; }
  .editor-delete-button { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:36px; border:0; border-radius:3px; padding:7px 12px; background:#0b1622; color:var(--muted,#a2b5c7); font-size:var(--type-meta-size,13px); cursor:pointer; transition:background-color .16s,color .16s; }
  .editor-delete-button:focus-visible { outline:none; background:#ed577a; color:#fff; }
  @media (hover:hover) { .editor-delete-button:hover { background:#ed577a; color:#fff; } }
  .editor-delete-button:disabled { opacity:.6; cursor:wait; }
  .editor-confirmation { position:fixed; inset:0; margin:auto; width:min(440px,calc(100vw - 32px)); max-height:calc(100dvh - 32px); padding:20px; border:0; border-radius:4px; background:var(--panel,#151f2e); color:var(--muted,#a2b5c7); box-shadow:0 20px 65px #02071199; }
  .editor-confirmation::backdrop { background:#03091280; }
  .editor-confirmation header { display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .editor-confirmation h2 { margin:0; font-size:18px; font-weight:500; line-height:1.4; }
  .editor-confirmation-close { display:grid; place-items:center; flex:none; width:30px; height:30px; margin:-5px -5px -5px 0; padding:0; border:0; border-radius:3px; background:transparent; color:inherit; cursor:pointer; }
  .editor-confirmation-close[hidden] { display:none; }
  .editor-confirmation-close:hover,.editor-confirmation-close:focus-visible { outline:none; background:#ffffff12; color:var(--bright,#edf5fa); }
  .editor-confirmation p { margin:18px 0; font-size:14px; line-height:1.6; }
  .editor-confirmation-actions { display:flex; justify-content:flex-end; gap:10px; }
  #editor-confirmation .editor-confirmation-actions { flex-wrap:wrap; }
  .editor-confirmation-actions button { min-height:32px; padding:6px 15px; border:0; border-radius:3px; background:#0b1622; color:var(--muted,#a2b5c7); font-size:13px; cursor:pointer; transition:background-color .16s,color .16s; }
  .editor-confirmation-actions button[value=confirm] { background:var(--blue,#3db4f2); color:#fff; }
  .editor-confirmation-actions button:hover,.editor-confirmation-actions button:focus-visible { outline:none; color:var(--bright,#edf5fa); }
  .editor-confirmation-actions button[value=confirm]:hover,.editor-confirmation-actions button[value=confirm]:focus-visible { background:color-mix(in srgb,var(--blue,#3db4f2) 80%,white); color:#fff; }
  @media(prefers-reduced-motion:reduce) { .editor-delete-button,.editor-confirmation-actions button { transition:none; } }
</style>
