---
import {statuses} from '../lib/tracker';
import Icon from './Icon.astro';
---
<dialog class="editor" id="tracking-editor" aria-labelledby="editor-title">
  <div class="editor-hero">
    <img id="editor-backdrop" class="editor-backdrop" alt="" />
    <div class="editor-hero-shade"></div>
    <img id="editor-poster" class="editor-poster" alt="" />
    <div class="editor-heading"><span id="editor-media-type">Entry</span><h2 id="editor-title">Edit entry</h2></div>
    <div class="editor-hero-actions">
      <button type="button" class="editor-library editor-icon-button" data-editor-library hidden aria-label="Add to library" aria-pressed="false"><Icon name="list" /></button>
      <label class="editor-favorite" title="Favorite"><input name="favorite" type="checkbox" form="tracking-form" aria-label="Favorite"/><Icon name="heart" /></label>
      <button type="submit" form="tracking-form" class="button-primary editor-save">Save</button>
    </div>
    <button type="button" class="editor-close editor-icon-button" aria-label="Close editor"><Icon name="close" /></button>
  </div>
  <form id="tracking-form">
    <div class="editor-fields">
      <div class="editor-status-field"><label id="editor-status-label" for="editor-status-trigger">Status</label><select name="status" class="editor-status-native" tabindex="-1" aria-hidden="true">{statuses.map(([value,label]) => <option value={value}>{label}</option>)}</select><div class="editor-status-dropdown"><button type="button" id="editor-status-trigger" class="editor-status-trigger" aria-labelledby="editor-status-label editor-status-value" aria-expanded="false" aria-controls="editor-status-options"><span id="editor-status-value">Watching</span><Icon name="chevron-down" /></button><div id="editor-status-options" class="editor-status-options" hidden>{statuses.map(([value,label]) => <button type="button" data-editor-status={value}>{label}</button>)}</div></div></div>
      <div class="editor-score-field"><label for="editor-manual-score">Score</label><div class="score-stepper" data-score-stepper><input id="editor-manual-score" name="manual_score" type="number" min="0" max="10" step="0.1" placeholder="Unrated"/><span class="score-stepper-controls"><button type="button" data-score-step="up" aria-label="Increase score to the next half point"><Icon name="chevron-down" rotate={180} /></button><button type="button" data-score-step="down" aria-label="Decrease score to the previous half point"><Icon name="chevron-down" /></button></span></div><span class="hint">0 means unrated</span></div>
      <label id="progress-field">Episode progress<input name="progress" type="number" min="0" step="1"/></label>
      <label class="editor-start-date">Start date<input name="start_date" type="date"/></label><label class="editor-finish-date">Finish date<input name="finish_date" type="date"/></label>
      <label class="editor-rewatches">Total rewatches<input name="rewatch_count" type="number" min="0" max="10000" step="1"/></label>
      <label class="wide editor-notes">Notes<textarea name="notes" rows="2" placeholder="Only you can see these notes"></textarea></label>
    </div>
    <p id="editor-error" role="alert" class="error-message" hidden></p>
    <div class="editor-actions">
      <button type="button" class="button-danger" id="delete-tracked-entry"><Icon name="trash" />Delete entry</button>
    </div>
  </form>
</dialog>
<dialog class="score-override-dialog" id="editor-score-override" aria-labelledby="score-override-title">
  <form method="dialog">
    <button type="submit" class="score-override-close editor-icon-button" value="cancel" aria-label="Close season rating confirmation"><Icon name="close" /></button>
    <span class="eyebrow">Season ratings</span>
    <h2 id="score-override-title">Use a separate show score?</h2>
    <p>Your current score is calculated from rated seasons. Saving this value will switch the show to a separate manual score; your season ratings stay unchanged.</p>
    <div class="season-mode-actions"><button class="button-primary" value="confirm">Use manual score</button><button class="button-secondary" value="cancel">Keep season average</button></div>
  </form>
</dialog>
<script>
import { setupScoreSteppers } from '../lib/scoreStepper';
import { applyResponsiveArtwork } from '../lib/responsive-artwork';
import { showDialog, closeDialog, showMenu, hideMenu } from '../lib/ui-motion';
let pageListeners: AbortController;
document.addEventListener('astro:page-load', () => {
  pageListeners?.abort();
  pageListeners = new AbortController();
  if (!document.querySelector('#tracking-editor')) return;
  const dialog = document.querySelector<HTMLDialogElement>('#tracking-editor')!;
  setupScoreSteppers(dialog);
  const form = document.querySelector<HTMLFormElement>('#tracking-form')!;
  let current: any = null;
  let opener: HTMLElement | null = null;
  let loadController: AbortController | null = null;
  let displayedScore = '';
  const libraryButton = dialog.querySelector<HTMLButtonElement>('[data-editor-library]')!;
  let libraryRequest: AbortController | null = null;
  let libraryDesired = false;
  let libraryCommitted = false;
  let libraryRevision = 0;
  let libraryEpoch = 0;
  let librarySyncing = false;
  const retained = new Map<number, any>((JSON.parse(document.querySelector('#list-editor-entries')?.textContent || '[]') as any[]).map(entry => [entry.id, entry]));
  // The embedded list entries are only a first-load shortcut. A quick rating or
  // another in-place write makes them stale even while this page stays mounted.
  document.addEventListener('anylist:data-changed', () => retained.clear(), { signal: pageListeners.signal });
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const error = document.querySelector<HTMLElement>('#editor-error')!;
  const saveButton = dialog.querySelector<HTMLButtonElement>('.editor-save')!;
  const statusTrigger = dialog.querySelector<HTMLButtonElement>('#editor-status-trigger')!;
  const statusValue = dialog.querySelector<HTMLElement>('#editor-status-value')!;
  const statusOptions = dialog.querySelector<HTMLElement>('#editor-status-options')!;
  const statusButtons = [...statusOptions.querySelectorAll<HTMLButtonElement>('[data-editor-status]')];
  const closeStatus = () => { void hideMenu(statusOptions); statusTrigger.setAttribute('aria-expanded', 'false'); };
  const syncStatus = () => {
    const selected = statusButtons.find(button => button.dataset.editorStatus === field('status').value);
    statusValue.textContent = selected?.textContent || 'Status';
    statusButtons.forEach(button => button.setAttribute('aria-current', String(button === selected)));
  };
  statusTrigger.addEventListener('click', () => {
    if (statusTrigger.getAttribute('aria-expanded') !== 'true') {
      showMenu(statusOptions);
      statusTrigger.setAttribute('aria-expanded', 'true');
    } else closeStatus();
  });
  statusTrigger.addEventListener('keydown', event => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault(); showMenu(statusOptions); statusTrigger.setAttribute('aria-expanded', 'true');
      (statusButtons.find(button => button.dataset.editorStatus === field('status').value) || statusButtons[0])?.focus();
    }
  });
  statusOptions.addEventListener('click', event => {
    const selected = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-editor-status]');
    if (!selected) return;
    field('status').value = selected.dataset.editorStatus!;
    syncStatus(); closeStatus(); statusTrigger.focus();
  });
  statusOptions.addEventListener('keydown', event => {
    const index = statusButtons.indexOf(document.activeElement as HTMLButtonElement);
    if (event.key === 'Escape') { event.preventDefault(); closeStatus(); statusTrigger.focus(); }
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp' || event.key === 'Home' || event.key === 'End') {
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? statusButtons.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + statusButtons.length) % statusButtons.length;
      statusButtons[next]?.focus();
    }
  });
  dialog.addEventListener('click', event => { if (!statusTrigger.contains(event.target as Node) && !statusOptions.contains(event.target as Node)) closeStatus(); });
  dialog.addEventListener('focusout', event => { if (!statusTrigger.contains(event.relatedTarget as Node) && !statusOptions.contains(event.relatedTarget as Node)) closeStatus(); });
  const closeEditor = () => {
    if (!dialog.open) return;
    void closeDialog(dialog);
  };
  function populateEditor(title: any) {
    const embedded = !Object.prototype.hasOwnProperty.call(title, 'entry');
    const entry = embedded ? title : title.entry;
    current = {id:title.id, type:title.type, ...(entry || {status:'planning', progress:0, rating_mode:'manual', manual_score:null})};
    document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.hidden = !entry;
    document.querySelector('#editor-title')!.textContent = title.title;
    document.querySelector('#editor-media-type')!.textContent = title.type === 'series' ? 'TV series' : 'Movie';
    const poster = document.querySelector<HTMLImageElement>('#editor-poster')!;
    const backdrop = document.querySelector<HTMLImageElement>('#editor-backdrop')!;
    if (title.poster) {
      applyResponsiveArtwork(poster,title.poster,{size:'w342',sizes:'(max-width:760px) 78px, 104px',route:'direct'});
      poster.alt = `${title.title} poster`;
    } else {
      poster.removeAttribute('src'); poster.removeAttribute('srcset'); poster.removeAttribute('sizes'); poster.alt = '';
    }
    poster.hidden = !title.poster;
    const backdropPath = title.backdrop || title.poster;
    if (backdropPath) applyResponsiveArtwork(backdrop,backdropPath,{size:'w1280',sizes:'(max-width:760px) calc(100vw - 18px), min(980px, calc(100vw - 32px))',route:'direct'});
    else { backdrop.removeAttribute('src'); backdrop.removeAttribute('srcset'); backdrop.removeAttribute('sizes'); }
    backdrop.hidden = !backdropPath;
    for (const name of ['status','progress','start_date','finish_date','rewatch_count','notes']) field(name).value = current[name] ?? '';
    syncStatus(); closeStatus();
    const calculatedScore = current.rating_mode === 'average' ? current.score : current.manual_score;
    field('manual_score').value = calculatedScore == null ? '' : String(current.rating_mode === 'average' ? Number(Number(calculatedScore).toFixed(1)) : calculatedScore);
    displayedScore = field('manual_score').value;
    field('favorite').checked = Boolean(current.favorite);
    loadLibraryState(current.id);
    field('progress').disabled = title.type === 'movie';
    document.querySelector<HTMLElement>('#progress-field')!.hidden = title.type === 'movie';
    saveButton.disabled = false;
  }
  async function loadLibraryState(mediaId: number) {
    libraryRequest?.abort();
    const epoch = ++libraryEpoch;
    librarySyncing = false;
    const controller = new AbortController();
    libraryRequest = controller;
    libraryButton.hidden = true;
    libraryButton.disabled = true;
    try {
      const response = await fetch(`/api/proxy/tracking/library/${mediaId}`, {signal: controller.signal});
      if (!response.ok) return;
      const state = await response.json();
      if (libraryRequest !== controller || libraryEpoch !== epoch || current?.id !== mediaId) return;
      if (!Array.isArray(state.connections) || state.connections.length === 0) return;
      libraryDesired = state.desired === true;
      libraryCommitted = libraryDesired;
      renderLibraryButton();
      libraryButton.hidden = false;
      libraryButton.disabled = false;
    } catch (cause) { if ((cause as Error).name !== 'AbortError') console.warn('Could not load streaming-library state.', cause); }
  }
  function renderLibraryButton() {
    libraryButton.setAttribute('aria-pressed', String(libraryDesired));
    libraryButton.setAttribute('aria-label', libraryDesired ? 'Remove from library' : 'Add to library');
    libraryButton.title = libraryDesired ? 'Remove from library' : 'Add to library';
    libraryButton.classList.toggle('is-active', libraryDesired);
  }
  libraryButton.addEventListener('click', () => {
    if (!current || libraryButton.disabled) return;
    libraryDesired = !libraryDesired;
    libraryRevision++;
    renderLibraryButton();
    void syncLibraryIntent(current.id, libraryEpoch);
  });
  async function syncLibraryIntent(mediaId: number, epoch: number) {
    if (librarySyncing || epoch !== libraryEpoch) return;
    librarySyncing = true;
    libraryButton.setAttribute('aria-busy', 'true');
    while (epoch === libraryEpoch && current?.id === mediaId && libraryDesired !== libraryCommitted) {
      const target = libraryDesired;
      const revision = libraryRevision;
      try {
        const response = await fetch(`/api/proxy/tracking/library/${mediaId}`, {method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({in_library:target})});
        if (!response.ok) { const data = await response.json().catch(() => null); throw new Error(typeof data?.detail === 'string' ? data.detail : 'Could not update the streaming library.'); }
        const state = await response.json();
        if (epoch !== libraryEpoch || current?.id !== mediaId) return;
        libraryCommitted = state.desired === true;
        if (revision === libraryRevision) libraryDesired = libraryCommitted;
        renderLibraryButton();
        document.dispatchEvent(new CustomEvent('anylist:data-changed'));
      } catch (cause) {
        if (epoch !== libraryEpoch || current?.id !== mediaId) return;
        if (revision === libraryRevision) {
          libraryDesired = libraryCommitted;
          renderLibraryButton();
          error.textContent = cause instanceof Error ? cause.message : 'Could not update the streaming library.';
          error.hidden = false;
          break;
        }
        // A newer click arrived during this failed write; try to apply that final intent.
      }
    }
    if (epoch === libraryEpoch) {
      librarySyncing = false;
      libraryButton.removeAttribute('aria-busy');
    }
  }
  async function openEditor(mediaId: number, button: HTMLElement) {
    if (!Number.isSafeInteger(mediaId) || mediaId <= 0) return;
    error.hidden = true;
    form.reset();
    syncStatus(); closeStatus();
    current = null;
    libraryRequest?.abort();
    libraryRequest = null;
    libraryEpoch++;
    librarySyncing = false;
    libraryButton.hidden = true;
    opener = button;
    const listRow = button.closest<HTMLElement>('.entry-row');
    if (listRow) {
      listRow.dataset.editorDeselected = '';
      const preview = document.querySelector<HTMLElement>('#cover-preview');
      if (preview) preview.hidden = true;
    }
    loadController?.abort();
    const controller = new AbortController();
    loadController = controller;
    const cached = retained.get(mediaId);
    if (cached) {
      populateEditor(cached);
      showDialog(dialog);
      return;
    }
    showDialog(dialog);
    document.querySelector('#editor-title')!.textContent = 'Loading entry…';
    saveButton.disabled = true;
    try {
      const res = await fetch(`/api/proxy/tracking/title/${mediaId}`, { signal: controller.signal });
      if (!res.ok) throw new Error('Unable to load this entry. Try again.');
      const title = await res.json();
      if (loadController !== controller || !dialog.open || opener !== button) return;
      populateEditor(title);
    } catch(e) { if ((e as Error).name !== 'AbortError') { error.textContent = (e as Error).message; error.hidden = false; } }
  }
  document.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-edit-entry]');
    if (button) void openEditor(Number(button.dataset.editEntry), button);
  }, { signal: pageListeners.signal });
  document.addEventListener('anylist:open-editor', event => {
    const {mediaId, opener} = (event as CustomEvent<{mediaId:number;opener:HTMLElement}>).detail;
    if (Number.isSafeInteger(mediaId) && mediaId > 0 && opener instanceof HTMLElement) void openEditor(mediaId, opener);
  }, { signal: pageListeners.signal });
  function ratedSeasonScores() {
    return Object.entries(current?.season_scores || {}).filter(([season, score]) => Number(season) > 0 && Number(score) > 0).map(([, score]) => Number(score));
  }
  async function confirmScoreOverride() {
    const confirmation = document.querySelector<HTMLDialogElement>('#editor-score-override')!;
    confirmation.returnValue = 'cancel';
    showDialog(confirmation);
    return new Promise<boolean>(resolve => confirmation.addEventListener('close', () => resolve(confirmation.returnValue === 'confirm'), {once:true}));
  }
  const confirmation = document.querySelector<HTMLDialogElement>('#editor-score-override')!;
  confirmation.addEventListener('click', event => { if (event.target === confirmation) void closeDialog(confirmation, 'cancel'); });
  confirmation.addEventListener('cancel', () => { confirmation.returnValue = 'cancel'; });
  dialog.querySelectorAll('.editor-close').forEach(button => button.addEventListener('click', closeEditor));
  dialog.addEventListener('click', event => { if (event.target === dialog) closeEditor(); });
  dialog.addEventListener('close', () => {
    loadController?.abort(); loadController = null; libraryRequest?.abort(); libraryRequest = null; libraryEpoch++; librarySyncing = false; libraryButton.hidden = true; libraryButton.disabled = true; libraryButton.removeAttribute('aria-busy'); current = null; displayedScore = ''; form.reset();
    const listRow = opener?.closest<HTMLElement>('.entry-row');
    if (listRow) {
      const sectionHeading = listRow.closest<HTMLElement>('.status-section')?.querySelector<HTMLElement>('h2');
      if (sectionHeading) {
        sectionHeading.tabIndex = -1;
        sectionHeading.focus({preventScroll:true});
      } else opener?.blur();
      if (!listRow.matches(':hover')) delete listRow.dataset.editorDeselected;
    } else opener?.focus();
    opener = null;
  });
  document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.addEventListener('click',async event=>{
    if(!current||!confirm('Delete this entry, including ratings, notes, dates, and watch history? Your streaming-library membership will be kept. Supported connected-service resets may remain pending.'))return;
    const button=event.currentTarget as HTMLButtonElement;button.disabled=true;
    try{const response=await fetch(`/api/proxy/tracking/entry/${current.id}?confirmed=true`,{method:'DELETE'});if(!response.ok)throw new Error('Could not delete the entry. Try again.');location.reload();}catch(e){error.textContent=(e as Error).message;error.hidden=false;button.disabled=false;}
  });
  form.addEventListener('submit', async event => {
    event.preventDefault(); if (!current) return;
    error.hidden = true;
    const submit = saveButton;
    const status = field('status').value;
    const body: any = {status, notes:field('notes').value, favorite:field('favorite').checked,
      rewatch_count:Number(field('rewatch_count').value || 0)};
    const scoreChanged = field('manual_score').value !== displayedScore;
    if (scoreChanged) {
      if (current.rating_mode === 'average' && ratedSeasonScores().length && !(await confirmScoreOverride())) {
        field('manual_score').value = displayedScore;
        return;
      }
      body.manual_score = Number(field('manual_score').value || 0);
      if (current.rating_mode === 'average') body.rating_mode = 'manual';
    }
    for (const name of ['start_date','finish_date']) {
      // An untouched empty date must not suppress a transition's automatic date.
      if (field(name).value !== (current[name] || '')) body[name] = field(name).value || null;
    }
    if (!field('progress').disabled && Number(field('progress').value) !== current.progress) {
      body.progress = Number(field('progress').value);
      if (body.progress < current.progress) {
        if (!confirm('Mark the later episodes unwatched?')) return;
        body.confirm_rollback = true;
      }
    }
    submit.disabled = true;
    try {
      const response = await fetch(`/api/proxy/tracking/entry/${current.id}`, {method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      if (!response.ok) { const data = await response.json(); throw new Error(typeof data.detail === 'string' ? data.detail : 'Check your entry and try again.'); }
      location.reload();
    } catch(e) { error.textContent = (e as Error).message; error.hidden = false; submit.disabled = false; }
  });
});
</script>
