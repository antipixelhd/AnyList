---
import {statuses} from '../lib/tracker';
import Icon from './Icon.astro';
import CalendarDateInput from './CalendarDateInput.astro';
import NumberStepper from './NumberStepper.astro';
import EditorSelect from './EditorSelect.astro';
---
<dialog class="editor" id="tracking-editor" aria-labelledby="editor-title" data-motion-static>
  <div class="editor-hero">
    <img id="editor-backdrop" class="editor-backdrop" alt="" />
    <div class="editor-hero-shade"></div>
    <img id="editor-poster" class="editor-poster" alt="" />
    <div class="editor-heading"><span id="editor-media-type">Entry</span><h2 id="editor-title">Edit entry</h2></div>
    <div class="editor-hero-actions">
      <button type="button" class="editor-library editor-icon-button" data-editor-library hidden aria-label="Add to library" aria-pressed="false"><Icon name="list" /></button>
      <label class="editor-favorite" title="Favorite"><input name="favorite" type="checkbox" form="tracking-form" aria-label="Favorite"/><Icon name="heart" /></label>
      <button type="submit" form="tracking-form" class="button-primary editor-save">Save</button>
    </div>
    <button type="button" class="editor-close editor-icon-button" aria-label="Close editor"><Icon name="close" /></button>
  </div>
  <form id="tracking-form">
    <div class="editor-fields">
      <div class="editor-status-field"><label id="editor-status-label" for="editor-status-trigger">Status</label><EditorSelect id="editor-status" name="status" label="Status" labelledBy="editor-status-label" options={statuses} value="watching"/></div>
      <div class="editor-score-field"><label for="editor-manual-score">Score</label><NumberStepper id="editor-manual-score" name="manual_score" label="Score" min={0} max={10} step={0.1} value={0} score/></div>
      <div id="progress-field" class="editor-number-field"><label for="editor-progress">Episode progress</label><NumberStepper id="editor-progress" name="progress" label="Episode progress"/></div>
      <div class="editor-number-field" data-game-only data-game-main hidden><label for="game-total-hours">Total time (hours)</label><NumberStepper id="game-total-hours" name="game_total_hours" label="Total time in hours" step="any"/></div>
      <div class="game-first-completion" data-game-only data-game-first hidden><div class="game-field-heading"><label for="game-first-hours">First completion time</label><button type="button" class="game-value-button" data-game-first-edit>Add</button></div><div class="editor-number-field" data-game-first-input hidden><NumberStepper id="game-first-hours" name="game_first_hours" label="First completion time in hours" step="any"/></div></div>
      <div class="editor-number-field" data-game-only data-game-main hidden><label for="game-replays">Replay count</label><NumberStepper id="game-replays" name="game_replays" label="Replay count" max={2147483647}/></div>
      <section class="wide game-achievement-editor" data-game-only data-game-main hidden aria-label="Achievement progress">
        <div class="game-field-heading"><span>Achievements</span><button type="button" class="game-value-button" data-game-achievement-add>Add</button><button type="button" class="game-value-button" data-game-achievement-remove hidden aria-label="Remove achievement progress">Remove</button></div>
        <div class="game-achievement-controls" data-game-achievement-controls hidden>
          <div data-game-achievement-mode-field hidden><EditorSelect id="game-achievement-mode" name="game_achievement_mode" label="Achievement tracking"/></div>
          <input name="game_achievement_count" type="hidden"/><input name="game_achievement_percentage" type="hidden"/>
          <div class="game-achievement-value"><button type="button" class="game-value-button" data-game-achievement-value aria-label="Edit achievement progress"></button><input type="number" min="0" step="1" inputmode="decimal" data-game-achievement-number aria-label="Achievement progress" hidden/></div>
          <input class="game-achievement-slider" type="range" min="0" step="1" data-game-achievement-slider aria-label="Achievement progress"/>
          <div data-game-targeted hidden><p class="game-achievement-guidance" data-game-achievement-guidance></p><div class="game-achievement-options" data-game-achievement-options></div><p role="status" data-game-achievement-status hidden></p><button type="button" class="lab-text-button" data-game-achievement-more hidden>Load more</button></div>
        </div>
      </section>
      <div class="editor-start-date"><label for="editor-start-date">Start date</label><CalendarDateInput id="editor-start-date" name="start_date" label="Start date"/></div><div class="editor-finish-date"><label for="editor-finish-date">Finish date</label><CalendarDateInput id="editor-finish-date" name="finish_date" label="Finish date"/></div>
      <label class="editor-rewatches editor-number-field" for="editor-rewatches">Total rewatches<NumberStepper id="editor-rewatches" name="rewatch_count" label="Total rewatches" max={10000}/></label>
      <label class="wide editor-notes">Notes<textarea name="notes" rows="2"></textarea></label>
    </div>
    <p id="editor-error" role="alert" class="error-message" hidden></p>
    <div class="editor-actions">
      <button type="button" class="editor-delete-button" id="delete-tracked-entry"><Icon name="trash" />Delete entry</button>
    </div>
  </form>
</dialog>
<dialog class="editor-confirmation" id="editor-confirmation" aria-labelledby="editor-confirmation-title" aria-describedby="editor-confirmation-body" data-motion-static>
  <form method="dialog">
    <header><h2 id="editor-confirmation-title">Warning</h2><button type="submit" class="editor-confirmation-close" value="cancel" aria-label="Close confirmation"><Icon name="close" /></button></header>
    <p id="editor-confirmation-body"></p>
    <div class="editor-confirmation-actions"><button type="submit" value="cancel" autofocus>Cancel</button><button type="submit" value="confirm">OK</button></div>
  </form>
</dialog>
<dialog class="score-override-dialog" id="editor-score-override" aria-labelledby="score-override-title">
  <form method="dialog">
    <button type="submit" class="score-override-close editor-icon-button" value="cancel" aria-label="Close season rating confirmation"><Icon name="close" /></button>
    <span class="eyebrow">Season ratings</span>
    <h2 id="score-override-title">Use a separate show score?</h2>
    <p>Your current score is calculated from rated seasons. Saving this value will switch the show to a separate manual score; your season ratings stay unchanged.</p>
    <div class="season-mode-actions"><button class="button-primary" value="confirm">Use manual score</button><button class="button-secondary" value="cancel">Keep season average</button></div>
  </form>
</dialog>
<script>
import { setupScoreSteppers } from '../lib/scoreStepper';
import { setupCalendarDateInputs } from '../lib/calendar-date-input';
import { editorStore, seedEditorPage, type EditorTitle, type WorkSubject } from '../lib/editor-store';
import { showDialog, closeDialog } from '../lib/ui-motion';
import {createGameEditor} from '../lib/game-editor';
import {setupEditorSelect} from '../lib/editor-select';
import {gameDatePatch,gameStatuses} from '../lib/game-editor-data';
import {localToday} from '../lib/date-time';
import {artworkIdentity} from '../lib/responsive-artwork';
import {confirmEntryAction as confirmAction,watchRollbackWarning} from '../lib/entry-confirmation';
let pageListeners: AbortController;
document.addEventListener('astro:before-swap', () => pageListeners?.abort());
document.addEventListener('astro:page-load', () => {
  pageListeners?.abort();
  pageListeners = new AbortController();
  const sessionSignal = pageListeners.signal;
  if (!document.querySelector('#tracking-editor')) return;
  const dialog = document.querySelector<HTMLDialogElement>('#tracking-editor')!;
  const confirmEntryAction = (message:string,options:{confirmLabel?:string}={}) => confirmAction(message,sessionSignal,options);
  setupScoreSteppers(dialog, sessionSignal);
  const refreshDateInputs = setupCalendarDateInputs(dialog, sessionSignal);
  const form = document.querySelector<HTMLFormElement>('#tracking-form')!;
  const gameFields=createGameEditor(dialog,form,sessionSignal,confirmEntryAction);
  let current: any = null;
  let currentTitle: EditorTitle | null = null;
  let opener: HTMLElement | null = null;
  let loadController: AbortController | null = null;
  let displayedScore = '';
  let resumeExpansion:{subject:WorkSubject;button:HTMLElement}|null=null;
  const libraryButton = dialog.querySelector<HTMLButtonElement>('[data-editor-library]')!;
  let libraryDesired = false;
  seedEditorPage();
  document.addEventListener('media-tracker:rating-changed', event => {
    const saved = (event as CustomEvent).detail;
    if (saved.status) editorStore.acceptSaved(saved);
    else editorStore.invalidate(saved.id);
  }, {signal:pageListeners.signal});
  document.addEventListener('anylist:entry-saved', event => {
    const saved = (event as CustomEvent).detail;
    editorStore.acceptSaved(saved);
  }, {signal:pageListeners.signal});
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const error = document.querySelector<HTMLElement>('#editor-error')!;
  const saveButton = dialog.querySelector<HTMLButtonElement>('.editor-save')!;
  const statusSelect=field('status') as unknown as HTMLSelectElement;
  const originalStatuses=[...statusSelect.options].map(option=>({value:option.value,label:option.text}));
  const statusControl=setupEditorSelect(statusSelect.closest<HTMLElement>('[data-editor-select]')!,sessionSignal);
  const statusDomain=(game:boolean)=>{
    [...statusSelect.options].forEach((option,index)=>{
      const original=originalStatuses[index];option.value=game&&original.value==='watching'?'playing':original.value;
      option.textContent=game?gameStatuses.find(([id])=>id===option.value)?.[1]||original.label:original.label;
    });
    statusControl.sync();
  };
  const closeStatus = statusControl.close;
  const syncStatus = () => {
    statusControl.sync();
    gameFields.statusChanged(statusSelect.value);
  };
  statusSelect.addEventListener('change',syncStatus,{signal:sessionSignal});
  const closeEditor = () => {
    resumeExpansion=null;
    if (!dialog.open) return;
    void closeDialog(dialog);
  };
  function finishEditing() {
    // Close immediately; background writes keep their own snapshot for retry.
    const search = document.querySelector<HTMLDialogElement>('[data-quick-search]');
    if (dialog.open) dialog.close();
    if (search?.open) search.close();
  }
  function populateEditor(title: any) {
    const entry = title.entry;
    const game=title.type==='game',child=game&&['expansion','dlc'].includes(title.game_class||'');
    dialog.dataset.editorDomain=game?'game':'movies-series';
    statusDomain(game);
    currentTitle = title;
    current = {id:title.id, type:title.type, status:'planning', ...(game?title.game_state||entry:entry)||{progress:0,rating_mode:'manual',manual_score:null}};
    current.status ||= 'planning';
    document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.hidden = game?!current.listed:!entry;
    document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.disabled = false;
    document.querySelector('#editor-title')!.textContent = title.title;
    document.querySelector('#editor-media-type')!.textContent = game?(title.game_class==='expansion'?'Expansion':'Game'):title.type === 'series' ? 'TV series' : 'Movie';
    dialog.querySelector<HTMLElement>('.editor-rewatches')!.hidden=game;
    dialog.querySelector<HTMLElement>('.editor-notes')!.hidden=child;
    dialog.querySelector<HTMLElement>('.editor-favorite')!.hidden=child;
    const poster = document.querySelector<HTMLImageElement>('#editor-poster')!;
    let backdrop = document.querySelector<HTMLImageElement>('#editor-backdrop')!;
    const artwork = editorStore.artwork(title);
    // Move the prepared node itself. Reassigning src can expose the previous entry while loading.
    const prepared=artwork.backdropImage;
    if(prepared&&prepared!==backdrop){
      prepared.id='editor-backdrop';prepared.className='editor-backdrop';prepared.alt='';
      backdrop.replaceWith(prepared);backdrop=prepared;
    }
    [poster, backdrop].forEach(image => { image.removeAttribute('srcset'); image.removeAttribute('sizes'); });
    if (artwork.poster) {
      poster.src = artwork.poster;
      poster.alt = `${title.title} poster`;
    } else {
      poster.removeAttribute('src'); poster.removeAttribute('srcset'); poster.removeAttribute('sizes'); poster.alt = '';
    }
    poster.hidden = !title.poster;
    const backdropPath = artwork.backdrop;
    if (backdropPath && !prepared) {
      // Never overwrite a retained entry's background with another entry's poster fallback.
      const fallback=new Image();fallback.id='editor-backdrop';fallback.className='editor-backdrop';fallback.alt='';
      fallback.src=backdropPath;backdrop.replaceWith(fallback);backdrop=fallback;
    }
    else if(!backdropPath) { backdrop.removeAttribute('src'); backdrop.removeAttribute('srcset'); backdrop.removeAttribute('sizes'); }
    backdrop.hidden = !backdropPath;
    for (const name of ['status','progress','start_date','finish_date','rewatch_count','notes']) field(name).value = current[name] ?? '';
    gameFields.populate(title);
    refreshDateInputs();
    syncStatus(); closeStatus();
    const calculatedScore = game?current.score:current.rating_mode === 'average' ? current.score : current.manual_score;
    field('manual_score').value = calculatedScore == null ? '0' : String(current.rating_mode === 'average' ? Number(Number(calculatedScore).toFixed(1)) : calculatedScore);
    displayedScore = field('manual_score').value;
    field('favorite').checked = Boolean(current.favorite);
    loadLibraryState(title);
    field('progress').disabled = title.type !== 'series';
    document.querySelector<HTMLElement>('#progress-field')!.hidden = title.type !== 'series';
    saveButton.disabled = false;
  }
  function loadLibraryState(title: EditorTitle) {
    libraryButton.hidden = true;
    libraryButton.disabled = false;
    if (title.editor_library?.available) {
      libraryDesired = title.editor_library.desired;
      renderLibraryButton();
      libraryButton.hidden = false;
      libraryButton.disabled = false;
    }
  }
  function renderLibraryButton() {
    libraryButton.setAttribute('aria-pressed', String(libraryDesired));
    libraryButton.setAttribute('aria-label', libraryDesired ? 'Remove from library' : 'Add to library');
    libraryButton.title = libraryDesired ? 'Remove from library' : 'Add to library';
    libraryButton.classList.toggle('is-active', libraryDesired);
  }
  libraryButton.addEventListener('click', () => {
    if (!current || libraryButton.disabled) return;
    const editing = currentTitle!;
    void editorStore.writeLibrary(editing, !libraryDesired).catch(cause => {
      if (sessionSignal.aborted) return;
      if (!dialog.open || currentTitle !== editing) { window.anyListToast?.(cause.message); return; }
      error.textContent = cause.message; error.hidden = false;
    });
  });
  document.addEventListener('anylist:editor-state', event => {
    const title = (event as CustomEvent<EditorTitle>).detail;
    if (dialog.open && currentTitle && title.type===currentTitle.type && (title === currentTitle || title.id && title.id === currentTitle.id)) {
      libraryDesired = title.editor_library?.desired === true;
      renderLibraryButton();
    }
  }, {signal:pageListeners.signal});
  async function openGame(subject:WorkSubject,button:HTMLElement,supplied?:EditorTitle) {
    try {
      if(supplied)editorStore.seed(supplied);
      const title=await editorStore.loadSubject(subject);
      if(sessionSignal.aborted)return;
      if(['expansion','dlc'].includes(title.game_class||'')&&title.base_work_id) {
        const baseSubject:WorkSubject={kind:'game',catalogue_id:title.base_work_id};
        const base=await editorStore.loadSubject(baseSubject);
        if(!base.game_state?.listed) {
          if(!await confirmEntryAction('Base game has to be added first',{confirmLabel:'Add'})||sessionSignal.aborted)return;
          resumeExpansion={subject,button};
          await openEditor(base.id,button,base,true);return;
        }
      }
      await openEditor(title.id,button,title,true);
    }catch(cause){if(!sessionSignal.aborted)window.anyListToast?.((cause as Error).message);}
  }
  async function openEditor(mediaId: number | null, button: HTMLElement, supplied?: EditorTitle,baseChecked=false) {
    if(supplied?.type==='game'&&!baseChecked&&supplied.subject)return openGame(supplied.subject,button,supplied);
    if (!supplied && (!mediaId || !Number.isSafeInteger(mediaId) || mediaId <= 0)) return;
    error.hidden = true;
    form.reset();
    syncStatus(); closeStatus();
    current = null;
    libraryButton.hidden = true;
    opener = button;
    const listRow = button.closest<HTMLElement>('.entry-row');
    if (listRow) {
      listRow.dataset.editorDeselected = '';
      const preview = document.querySelector<HTMLElement>('#cover-preview');
      if (preview) preview.hidden = true;
    }
    loadController?.abort();
    const controller = new AbortController();
    loadController = controller;
    const cached = supplied ? editorStore.get(supplied) : editorStore.find(mediaId!);
    if (cached) {
      const image = button.closest('.browse-card, .entry-row, .quick-search-result, .game-progress-card')?.querySelector<HTMLImageElement>('img') || document.querySelector<HTMLImageElement>('.media-cover img');
      const posterSource=image?.currentSrc||image?.src;
      const heroSource=document.querySelector<HTMLImageElement>('.lab-hero-image')?.currentSrc;
      editorStore.warmArtwork(cached,
        cached.type!=='game'||artworkIdentity(cached.poster||'')===artworkIdentity(posterSource||'')?posterSource:undefined,
        cached.type!=='game'||artworkIdentity(cached.backdrop||'')===artworkIdentity(heroSource||'')?heroSource:undefined);
      populateEditor(cached);
      showDialog(dialog);
      return;
    }
    try {
      const title = await editorStore.load(mediaId!);
      if (loadController !== controller || opener !== button || sessionSignal.aborted) return;
      populateEditor(title);
      showDialog(dialog);
    } catch(e) { if ((e as Error).name !== 'AbortError') window.anyListToast?.((e as Error).message); }
  }
  document.addEventListener('click', event => {
    const gameButton=(event.target as HTMLElement).closest<HTMLElement>('[data-edit-game]');
    if(gameButton){const id=Number(gameButton.dataset.editGame);if(Number.isSafeInteger(id)&&id>0)void openGame({kind:'game',catalogue_id:id},gameButton);return;}
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-edit-entry]');
    if (button) void openEditor(Number(button.dataset.editEntry), button);
  }, { signal: pageListeners.signal });
  document.addEventListener('anylist:open-editor', event => {
    const {mediaId, opener, title,subject} = (event as CustomEvent<{mediaId:number|null;opener:HTMLElement;title?:EditorTitle;subject?:WorkSubject}>).detail;
    if (opener instanceof HTMLElement){if(subject?.kind==='game')void openGame(subject,opener,title);else void openEditor(mediaId, opener, title);}
  }, { signal: pageListeners.signal });
  function ratedSeasonScores() {
    return Object.entries(current?.season_scores || {}).filter(([season, score]) => Number(season) > 0 && Number(score) > 0).map(([, score]) => Number(score));
  }
  async function confirmScoreOverride() {
    const confirmation = document.querySelector<HTMLDialogElement>('#editor-score-override')!;
    confirmation.returnValue = 'cancel';
    showDialog(confirmation);
    return new Promise<boolean>(resolve => confirmation.addEventListener('close', () => resolve(confirmation.returnValue === 'confirm'), {once:true}));
  }
  const confirmation = document.querySelector<HTMLDialogElement>('#editor-score-override')!;
  confirmation.addEventListener('click', event => { if (event.target === confirmation) void closeDialog(confirmation, 'cancel'); });
  confirmation.addEventListener('cancel', () => { confirmation.returnValue = 'cancel'; });
  dialog.querySelectorAll('.editor-close').forEach(button => button.addEventListener('click', closeEditor));
  dialog.addEventListener('click', event => { if (event.target === dialog) closeEditor(); });
  dialog.addEventListener('close', () => {
    resumeExpansion=null;gameFields.reset();
    loadController?.abort(); loadController = null; libraryButton.hidden = true; current = null; currentTitle = null; displayedScore = ''; form.reset();
    const listRow = opener?.closest<HTMLElement>('.entry-row');
    if (listRow) {
      const sectionHeading = listRow.closest<HTMLElement>('.status-section')?.querySelector<HTMLElement>('h2');
      if (sectionHeading) {
        sectionHeading.tabIndex = -1;
        sectionHeading.focus({preventScroll:true});
      } else opener?.blur();
      if (!listRow.matches(':hover')) delete listRow.dataset.editorDeselected;
    } else opener?.focus();
    opener = null;
  });
  document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.addEventListener('click',async event=>{
    const button=event.currentTarget as HTMLButtonElement;
    const editing = currentTitle;
    const message=editing?.type==='game'&&!['expansion','dlc'].includes(editing.game_class||'')?'Remove this game and its listed expansions? Saved expansion details will be kept.':'Are you sure you want to delete this list entry?';
    if(!current||!editing||!await confirmEntryAction(message))return;
    if(sessionSignal.aborted || currentTitle !== editing || !dialog.open)return;
    button.disabled=true;
    try{const id=await editorStore.remove(editing);if(sessionSignal.aborted)return;finishEditing();if(document.querySelector('[data-browse-page]'))document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:{id,status:null,score:null}}));else location.reload();}catch(e){if(sessionSignal.aborted)return;error.textContent=(e as Error).message;error.hidden=false;button.disabled=false;}
  });
  form.addEventListener('keydown', event => {
    if (event.key !== 'Enter' || event.isComposing || !(event.target instanceof HTMLInputElement)) return;
    event.preventDefault();
    event.target.blur();
  }, {signal:sessionSignal});
  form.addEventListener('submit', async event => {
    event.preventDefault(); if (!current) return;
    error.hidden = true;
    const status = field('status').value;
    if(currentTitle?.type==='game') {
      const editing=currentTitle,child=['expansion','dlc'].includes(editing.game_class||'');
      const previous=structuredClone(editing),previousOpener=opener,restoreGameFields=gameFields.snapshot();
      const draft=Array.from(form.elements).filter((node):node is HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement=>node instanceof HTMLInputElement||node instanceof HTMLSelectElement||node instanceof HTMLTextAreaElement).filter(node=>node.name).map(node=>({name:node.name,value:node.value,checked:node instanceof HTMLInputElement?node.checked:false}));
      const next=resumeExpansion;
      let closed:Promise<void>|undefined;
      try {
        const body={status,score:Number(field('manual_score').value||0),
          ...gameDatePatch(current,status,{start_date:field('start_date').value,finish_date:field('finish_date').value},gameFields.datesTouched,localToday()),
          ...(!child?{notes:field('notes').value,favorite:field('favorite').checked}:{}),...gameFields.patch()};
        saveButton.disabled=true;
        if(!next){closed=new Promise<void>(resolve=>dialog.addEventListener('close',()=>resolve(),{once:true}));finishEditing();}
        const saved=await editorStore.write(editing,body);
        if(sessionSignal.aborted)return;
        document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:saved}));
        if(next){
          if(currentTitle!==editing||!dialog.open)return;
          resumeExpansion=null;
          closed=new Promise<void>(resolve=>dialog.addEventListener('close',()=>resolve(),{once:true}));finishEditing();
        }
        await closed;
        if(next)void openGame(next.subject,next.button);else if(!dialog.open&&!document.querySelector('[data-media-detail]'))location.reload();
      }catch(cause){
        if(sessionSignal.aborted)return;
        if(!next){
          await closed;
          if(dialog.open){window.anyListToast?.((cause as Error).message);return;}
          opener=previousOpener;populateEditor(previous);
          draft.forEach(saved=>{const node=form.elements.namedItem(saved.name) as HTMLInputElement|null;if(node){node.value=saved.value;if(node.type==='checkbox')node.checked=saved.checked;}});
          restoreGameFields();syncStatus();showDialog(dialog);
        } else if(currentTitle!==editing)return;
        error.textContent=(cause as any).detail?.code==='stale_game_entry'?'This entry changed. Close and reopen the editor to reload it.':(cause as Error).message;error.hidden=false;
      }finally{if(!sessionSignal.aborted)saveButton.disabled=false;}
      return;
    }
    const body: any = {status, notes:field('notes').value, favorite:field('favorite').checked,
      rewatch_count:Number(field('rewatch_count').value || 0)};
    const scoreChanged = field('manual_score').value !== displayedScore;
    if (scoreChanged) {
      if (current.rating_mode === 'average' && ratedSeasonScores().length && !(await confirmScoreOverride())) {
        field('manual_score').value = displayedScore;
        return;
      }
      body.manual_score = Number(field('manual_score').value || 0);
      if (current.rating_mode === 'average') body.rating_mode = 'manual';
    }
    for (const name of ['start_date','finish_date']) {
      // An untouched empty date must not suppress a transition's automatic date.
      if (field(name).value !== (current[name] || '')) body[name] = field(name).value || null;
    }
    if (!field('progress').disabled && Number(field('progress').value) !== current.progress) {
      body.progress = Number(field('progress').value);
      if (body.progress < current.progress) {
        if (!await confirmEntryAction(watchRollbackWarning) || sessionSignal.aborted || !current) return;
        body.confirm_rollback = true;
      }
    }
    const editing = currentTitle!;
    const previous = {...current};
    const previousScore = displayedScore;
    const previousOpener = opener;
    finishEditing();
    try {
      const saved = await editorStore.write(editing, body);
      if (sessionSignal.aborted) return;
      document.dispatchEvent(new CustomEvent('anylist:entry-saved',{detail:saved}));
      if(!document.querySelector('[data-browse-page]')) location.reload();
    } catch(e) {
      if (sessionSignal.aborted) return;
      if (dialog.open) { window.anyListToast?.((e as Error).message); return; }
      opener = previousOpener;
      populateEditor({...editing, entry:{...previous,...body}});
      current = {...previous, id:editing.id};
      document.querySelector<HTMLButtonElement>('#delete-tracked-entry')!.hidden = !editing.entry;
      displayedScore = previousScore;
      error.textContent = (e as Error).message; error.hidden = false;
      showDialog(dialog);
    }
  });
  const prepare = (event: Event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-edit-entry],[data-edit-game]');
    if (!button) return;
    const game=button.dataset.editGame!=null;
    const id = Number(game?button.dataset.editGame:button.dataset.editEntry);
    const image = button.closest('.entry-row')?.querySelector<HTMLImageElement>('img') || document.querySelector<HTMLImageElement>('.media-cover img');
    const title = game?editorStore.findSubject({kind:'game',catalogue_id:id}):editorStore.find(id);
    const warm=(title:EditorTitle)=>{
      const poster=image?.currentSrc||image?.src,hero=document.querySelector<HTMLImageElement>('.lab-hero-image')?.currentSrc;
      editorStore.warmArtwork(title,!game||artworkIdentity(title.poster||'')===artworkIdentity(poster||'')?poster:undefined,
        !game||artworkIdentity(title.backdrop||'')===artworkIdentity(hero||'')?hero:undefined);
    };
    if (title) warm(title);
    else void (game?editorStore.loadSubject({kind:'game',catalogue_id:id}):editorStore.load(id)).then(warm).catch(() => {});
  };
  document.addEventListener('pointerover', prepare, {signal:pageListeners.signal});
  document.addEventListener('focusin', prepare, {signal:pageListeners.signal});
});
</script>
