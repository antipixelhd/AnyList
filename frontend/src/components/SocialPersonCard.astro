---
interface Person {
  id?: number;
  username: string;
  display_name: string;
  has_avatar?: boolean;
}

interface Props {
  person: Person;
}

const {person} = Astro.props;
const name = person.display_name || person.username;
---
<article class="social-person-card" data-social-person={person.username}>
  <a class="social-person-link" href={`/user/${encodeURIComponent(person.username)}`} aria-label={`View ${name}'s profile`} title={name}>
    {person.has_avatar && person.id
      ? <img src={`/api/proxy/profile/avatar/${person.id}`} alt="" loading="lazy"/>
      : <span class="social-person-placeholder" aria-hidden="true">{name.slice(0, 1).toUpperCase()}</span>}
    <span class="social-person-name">{name}</span>
  </a>
</article>
